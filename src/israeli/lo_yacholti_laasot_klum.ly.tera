{#
default_version = "My"

[attributes]
heb = true
title = "לא יכולתי לעשות כלום"
style = "Israeli"
composer = "אילן וירצברג"
poet = "יונה וולך"
piece = "בלדת רוק"
singer = "איןך ןירצברג"
