{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2:maj9 a:m7 | d:m9 g:7.5+ | c:6 a:m7 | d:m7 g:7.5+ | \myEndLine
		c2:maj7 a:m7 | d:m7 g4:7 g:7/f | e1:m7.5- | a:7.9- | \myEndLine

		\myMark "B"
		d1:m7.5- | g:7.9- | c | fis2:m7.5- b:7.9- | \myEndLine
		e1 | fis2:m7 b:7 | e1 | g2:7 f4/g f:m/g | \myEndLine

		\myMark "A"
		c2:maj9 a:m7 | d:m9 g:7 | c:6 a:m7 | d:m7 g:7.5+ | \myEndLine
		c2:maj7 a:m7 | d:m7 g4:7 g:7/f | e1:m7.5- | a:7.9- | \myEndLine

		\myMark "C"
		d1:m7.5- | g:7.9- | c | a:m7 | \myEndLine
		d1:7 | f2:m7+ g:7 |
	} \alternative {
		{
			c2 f4 f:m | c d:m7 g2:9 | \myEndLineVoltaNotLast
		}
		{
			c2 f4 f:m | c2. \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
