{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	c1*5/8 c4.:dim |
	c2. c4:dim |
	c1*5/6 c1*1/6:dim |
	c2. g4:aug7 | \myEndLine
	c1*5/8 c4.:dim |
	c2. a4:m7 |
	d1:7 |
	g1:7 | \myEndLine
	c1*5/8 c4.:dim |
	c1 |
	d1:7 |
	g1*1/6 a1*1/6:m ais1*5/12:dim g4:7 | \myEndLine
	\repeat volta 2 {
	c1 |
	s1 |
	s1 |
	c1:7 | \myEndLine
	f1 |
	f1:m |
	c4 f4/a c4/g f4:6 |
	c2/e d8:m7 c8 a4:m7 | \myEndLine
	d1:9 |
	g1:7 |
	} \alternative {
	{
	c4 c4/bes a4:dim f4:m/aes |
	c4/g fis4:dim g2:7 | \myEndLineVoltaNotLast
	}
	{
	c4 c4/bes a4:dim f4:m/aes | \myEndLineVoltaLast
	}
	}
	c4/g g2:11 c4 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	r8. g'16 a'8. e'16 g'8 a'4. |
	r8. g'16 a'8. e'16 g'4 r4 |
	r8. c''16 c''8. c''16 ~ \times 2/3 { c''4 b'4 a'4 } |
	e'2. r4 |
	r8. g'16 a'8. e'16 g'8 a'4. |
	r8. g'16 a'8. e'16 g'4 r4 |
	d'8. e'16 fis'8. g'16 a'4. d''8 |
	b'8 ( g'8 ~ g'2. ) |
	r8. g'16 a'8. e'16 g'8 a'4. |
	r8. g'16 a'8. e'16 g'4. g'8 |
	a'8. a'16 b'8. b'16 c''8 a'4. |
	\times 2/3 { b'4 c''4 cis''4 } d''4 g'4 ^\fermata |
	\repeat volta 2 {
	e''2. d''8 c''8 ~ |
	c''8 g'8 ~ g'2. |
	r4 e''8 e''8 ~ e''8 c''8 g'8 bes'8 ~ |
	bes'4 e''4 d''4 c''4 |
	r4 a'8. d''16 c''8 a'4. |
	r4 as'8. d''16 c''4 as'8 g'8 ~ |
	g'1 ~ |
	g'2 r4 e''8 e''8 ~ |
	e''4. d''8 c''8 a'4. |
	r4 f''8. e''16 g'4 a'8 c''8 ~ |
	} \alternative {
	{
	c''1 ~ |
	c''2 r2 |
	}
	{
	c''1 ~ |
	}
	}
	c''2. r4 |
	\endBar
}
{% endif %}
