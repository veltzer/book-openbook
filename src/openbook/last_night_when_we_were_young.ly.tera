	d''4 cis''4 r8 a'8 bes'8 a'8 |
	bes'2 r8 e'8 \once \omit TupletBracket \times 2/3 { e'8 g'8 a'8 } |
	bes'4 b'2 d'4 |
	a'2 ~ a'8 g'8 a'8 g'8 |
	fis'2 r8 fis'8 f'8 e'8 |
