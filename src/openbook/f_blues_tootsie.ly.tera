{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1:7 | bes:7 | f1*2:7 | \myEndLine
		bes1*2:7 | f1:7 | a4*3:m7 d4:7 | \myEndLine
		g1:m7 | c:7 | a2:7 d:7 | g:7 c:7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key f \major

	\partial 4. c8 f8.[ bes16] |

	% part "A"
	\repeat volta 2 {
		a8.\( f16 d8. c16 f4\)-- r8 aes->\(~ | aes8. f16 g8 f\) r c f8.[ bes16] |
		a8.\( f16 d8. c16\) f8\( g4-. ees8\)~ | ees2 r8 c f8.[ bes16] |
		aes8.\( f16 d8 c f4\)-- r8 aes->\(~ | aes8. f16 g8 f\) r c f8.[ bes16] |
		a8.\( f16 d8. c16 f8 g4-. d8\)~ | d2. r8 d\( |
		a'8. a16 \tuplet 3/2 { f8 d f } a8. a16 \tuplet 3/2 { f8 d f } | a8. c16 bes8 a f8. c16 e8 f\)~ |
		f1 | r2 r8 c f8.[ bes16] |
	}
}
{% endif %}
