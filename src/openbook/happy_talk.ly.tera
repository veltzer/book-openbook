{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1:maj7 | f:7.5+ | bes | g:7 | \myEndLine
		c1:7sus4 | g2:m7 c:7 | f1 | f2. f4:7 | \myEndLine
		bes1:maj7 | ees:9 | f | d2:7.9- d:7 | d:m7 g:9 | \myEndLine
		g2:m9 c:7 |
	} \alternative {
		{
			f1*2:maj9 | \myEndLineVoltaNotLast
		}
		{
			f1*2:maj9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f1*4:maj7 | \myEndLine
	g1:m7 | c:7 | f2 d:m7 | g:m7 c:7 | f1*2 | \myEndLine
	f1*2 | g1*2:m7 | c2 bes/d | dis:dim7 c:7/e | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
