	c4. g4. |
	c4. g4. |
	d2.:7 | \myEndLine
	} \alternative {
	{
	g2. | \myEndLineVoltaNotLast
	}
	{
	g2. | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
