{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	a1:m |
	s1 |
	a1:m7 |
	d1 | \myEndLine
	d1:m |
	g1:7 |
	c1 |
	} \alternative {
	{
	e1 | \myEndLineVoltaNotLast
	}
	{
	a1:7 | \myEndLineVoltaLast
	}
	}
	f1 |
	d2:m7 g2:7 |
	c1 | \myEndLine
	a1:7 |
	d1:m |
	g1:7 |
	e1:m | \myEndLine
	a1:7 |
	f1 |
	d2:m g2:7 |
	c1 | \myEndLine
	a1:7 |
	d1:m |
	g1:7 |
	c1 | \myEndLine
	e1:7 |
	a1:m |
	s1 |
	a1:m7 | \myEndLine
	d1 |
	d1:m |
	g1:7 |
	c1 | \myEndLine
	a1:7 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	\repeat volta 2 {
	e''8 a'8 ~ a'2. |
	r2 a'8 b'8 c''8 a'8 |
	e''8 a'8 ~ a'2. |
	r2 a'8 b'8 c''8 a'8 |
	e''2 a'2 |
	r2 r4 \once \omit TupletBracket \times 2/3 { b'8 c''8 d''8 } |
	e''1 |
	} \alternative {
	{
	R1 |
	}
	{
	R1 |
	}
	}
	a''4. d''8 c''2 ~ |
	c''4 r8 a''8 g''8 f''8 e''8 f''8 |
	g''2 g''8 r8 r4 |
	r4 r8 f''8 f''8 e''8 d''8 e''8 |
	f''4. e''8 f''2 |
	r4 r8 f''8 e''8 d''8 c''8 d''8 |
	e''1 |
	R1 |
	a''2 a''8 r8 r4 |
	r4 a''4 g''4 f''4 |
	g''2 g''8 r8 r4 |
	r4 g''4 f''4 e''4 |
	f''2 f''8 r8 r4 |
	r2 r8 b'8 \once \omit TupletBracket \times 2/3 { b'8 c''8 d''8 } |
	e''1 |
	R1 |
	r4 e''8 a'8 ~ a'2 |
	r2 e''8 d''8 d''8 c''8 |
	e''4. d''8 d''8 c''8 d''4 |
	r4 a'4 e''8 d''8 d''8 c''8 |
	e''4. d''8 c''8 d''8 ~ d''8 r8 |
	r4 r8 b'8 b'4 c''8 d''8 |
	e''2. r4 |
	R1 - "D.S.andfade" - "returnto" |
	\endBar
}
{% endif %}
