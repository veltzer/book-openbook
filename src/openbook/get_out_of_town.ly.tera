{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	g1*4:m6 | \myEndLine
	g1*2:m6 | d1:m7.5- | g:7 | \myEndLine
	c1:m9 | f:7 | bes:maj7 | ees:9 | \myEndLine
	e1:m7.5- | a:7 | a:m7.5- | d:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	g1*2:maj7 | g1*2:m6 | \myEndLine
	g1*2:m6 | d1:m7.5- | g:7 | \myEndLine
	c1:m9 | ees2:m7 aes:7 | bes:maj7 ees:7 | d:m7.5- g:7 | \myEndLine
	c1:m7 | c2:m7.5- f:7 | bes1:6 | a2:m7.5- d:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Allegro" 4 = 160
	\time 4/4
	\key bes \major

	% part "A"
	d8 d d d~ d2 | r4 d8 d~ d d d4 | e e8 e~ e2~ | e r |
	g8 g g g~ g2 | r4 g8 g~ g fis g4 | d'1~ | d2 r |
	d8 d d d~ d2 | r4 a gis a | c8 c c c~ c2 | r4 g fis g |
	bes8 bes bes bes~ bes2 | r4 a8 c~ c c4 bes8 | a1~ | a2 r |

	% part "A"
	d,8 d d d~ d2 | r4 d8 d~ d d d4 | e e8 e~ e2 | r r4 d |
	g8 g g g~ g2 | g8 g g fis~ fis4 g | d' d8 d~ d2 | r r4 d |
	\tuplet 3/2 { d b c } f4. ees8 | \tuplet 3/2 { ges,4 f ges } d'4. c8 | a c4 bes8 cis, d f aes~ | aes2. g4 |
	ees' ees8 ees~ ees4 ees | ees r \tuplet 3/2 { d des c } | bes1 | r |
}
{% endif %}
{% if part == "LyricsLaurent" %}\lyricmode {
	Get out of town be -- fore it's too late my love
	Get out of town, Be good to me, please.
	Why wish me harm? Why not re -- tire to a farm,
	and be con -- tent -- ed to charm The birds of the trees?
	Just dis -- ap -- pear, I care for you much too much, And when you are
	near, close to me dear, We touch too much,
	The thrill when we meet
	Is so bit -- ter sweet
	that dar -- ling, it's get -- ting me down.
	So on your mark, get
	set, Get out of town.
}
{% endif %}
