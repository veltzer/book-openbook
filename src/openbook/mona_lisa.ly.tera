{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\partial 4 s4 |
	\repeat volta 2 {
	ees1 |
	aes1/ees |
	s1 | \myEndLine
	f2:m7 bes2:7 |
	f1:m |
	bes1:7 |
	s1 | \myEndLine
	ees1 |
	s1 |
	aes1/ees |
	s1 | \myEndLine
	aes1 |
	aes1:m |
	ees1 |
	bes1:7 | \myEndLine
	ees2 ees2:7 |
	aes1 |
	ees1 |
	bes1:7 | \myEndLine
	} \alternative {
	{
	ees1 | \myEndLineVoltaNotLast
	}
	{
	ees1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	\partial 4 bes'8 a'8 |
	\repeat volta 2 {
	c''8 bes'8 bes'8 a'8 c''8 bes'8 g'8 es'8 |
	c'4 bes2 es''8 d''8 |
	d''8 c''8 c''8 bes'8 bes'8 g'8 as'8 bes'8 |
	f'2. c''8 b'8 |
	d''8 c''8 as'8 g'8 bes'8 as'8 ~ \once \omit TupletBracket \times 2/3 { as'8 f'8 e'8 } |
	g'4 f'2 bes8 c'8 |
	d'8 es'8 f'8 g'8 as'8 c''8 ~ \once \omit TupletBracket \times 2/3 { c''8 bes'8 as'8 } |
	g'2. bes'8 a'8 |
	c''8 bes'8 bes'8 a'8 c''8 bes'8 ~ \once \omit TupletBracket \times 2/3 { bes'8 g'8 es'8 } |
	c'8 bes4. ~ bes4 es''8 d''8 |
	d''8 c''8 c''8 bes'8 bes'8 g'8 as'8 bes'8 |
	c''2. as'8 bes'8 |
	ces''4 ces''8 des''8 es''4 des''8 ces''8 |
	ces''4 bes'2 c''8 bes'8 |
	bes'4 d'2 c''8 bes'8 |
	bes'4 g'4 ~ g'4 as'8 bes'8 |
	c''4 c''8 d''8 es''4 d''8 c''8 |
	c''4 bes'4 r8 bes8 c'8 bes8 |
	as'8 bes'8 g'8 f'8 as'8 bes'8 g'8 f'8 |
	} \alternative {
	{
	es'2 r4 bes'8 a'8 |
	}
	{
	es'1 |
	}
	}
	\endBar
}
{% endif %}
