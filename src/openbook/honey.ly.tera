{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	f1 |
	bes4/f f2. |
	g1:7 |
	s1 | \myEndLine
	c2:7 g2:m7 |
	c2.:7 a4 |
	d2:m g2:7 |
	c2:7 g2:m7 | \myEndLine
	f1 |
	bes4 f2. |
	a1:7 |
	d4:m f2.:7 | \myEndLine
	bes2. des4:7 |
	f4 c2:m7 d4:7 |
	g2.:7 c4:7 |
	} \alternative {
	{
	f2 g4:m7 c4:7 | \myEndLineVoltaNotLast
	}
	{
	f1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 2/2
	\key f \major

	\repeat volta 2 {
	c'8. f'16 a'8. d''16 c''2 |
	bes'4 a'2. |
	b8. d'16 f'8. a'16 g'2 |
	e'4 d'2. |
	e'8. g'16 bes'8. e''16 d''2 |
	a'4 g'2 a'4 |
	g'4 f'4 g'4 a'4 |
	c''1 |
	c'8. f'16 a'8. d''16 c''2 |
	bes'4 a'2. |
	cis'8. e'16 g'8. bes'16 a'2 |
	g'4 f'2. |
	d'8. f'16 bes'8. e''16 d''4 des''4 |
	c''4 a'2. |
	a'4 f'2 g'4 |
	} \alternative {
	{
	f'2 r4 r4 |
	}
	{
	f'2. r4 |
	}
	}
	\endBar
}
{% endif %}
