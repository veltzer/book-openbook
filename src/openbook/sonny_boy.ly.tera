{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees1 | g2:m7.5- c:7 | f1:m | f2:m7 bes:7 | \myEndLine
		ees1 | ges:dim7 | f:m7 | bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1 | g2:m7.5- c:7 | f1:m | f2:m7 bes:7 | \myEndLine
		c1:m | f2:m7 bes:7 | ees2 aes:7 | ees1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1:7 | g:7 | c:7.9- | c:7.9- | \myEndLine
		c1:m7 | f:7 | bes2:7 bes:dim7 | bes1:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1 | g2:m7.5- c:7 | f1:m | f2:m7 bes:7 | \myEndLine
		c1:m | f2:m7 bes:7 | ees1 | \myEndLine
	} \alternative {
		{
			f2:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			aes2:maj9 aes4:m6 ees | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
