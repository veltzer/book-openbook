{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1 | ees:7 | ees | ees:7 | \myEndLine
		aes1 | aes:7 | ees1*2 | \myEndLine
		bes1*2:7 | ees2 aes:7 | ees bes:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees1*3 | ees1:7 | \myEndLine
		aes1 | aes:7 | ees | c:7 | \myEndLine
		f1:7 | bes:7 | ees2 aes:7 | ees bes:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		ees1*3 | ees1:7 | \myEndLine
		aes1 | aes:7 | ees | c:7 | \myEndLine
		f1:7 | bes:7 | ees2 aes:7 | ees1 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
