{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	f2.:m7 | g:m7 | aes:maj7 | g:m7 | \myEndLine
	f:m7 | g:m7 | aes4.:maj7 g:m7 | f2.:m7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	ees2.:7sus4 | ees:7sus4 | des4.:7sus4 ees:7sus4 | f2.:m7 | \myEndLine
	ees2.:7sus4 | ees:7sus4 | des4.:7sus4 ees:7sus4 | f2.:m7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f2.:m7 | g:m7 | aes:maj7 | g:m7 | \myEndLine
	f:m7 | g:m7 | aes4.:maj7 g:m7 | f2.:m7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	ees2.:7sus4 | ees:7sus4 | des4.:7sus4 ees:7sus4 | f2.:m7 | \myEndLine
	ees2.:7sus4 | ees:7sus4 | des4.:7sus4 ees:7sus4 | f2.:m7 | \myEndLine
	\endPart

	\myMark "Instr"
	\startPart
	\repeat volta 2 {
		f2.:m7 | f:m7 | f:m7 | f:m7 | \myEndLine
		f:m7 | f:m7 | f:m7 | f:m7 | \myEndLine
		f:m7 | f:m7 | f:m7 | f:m7 | \myEndLine
		f:m7 | f:m7 | f:m7 | f:m7 | \myEndLine
		ees:7.9+ | ees:7.9+ | c:7.9+ | c:7.9+ | \myEndLine
		ees:7.9+ | ees:7.9+ | c:7.9+ | c:7.9+ | \myEndLine
		f:m7 | f:m7 | f:m7 | f:m7 | \myEndLine
		f:m7 | f:m7 | f:m7 | f:m7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Allegro" 4 = 180
	\time 3/4
	\key f \minor

	% part "A"
	f4 c'4. aes8 | bes2. | aes4. bes4. | f2 r8 c8 |
	f4 c'4. aes8 | bes2. | aes4. bes4. | f2. |

	% part "B"
	ees4 ees g | ees2. | des4. ees4. | f2. |
	ees4 ees g | ees2. | des4. aes'4. | f2 f8 aes |

	% part "A"
	c8 ees r ees4 des8 | c4 c bes8 g | aes aes r g4 ees8 | f2 f8 aes |
	c8 ees r ees4 des8 | c4 c bes8 g | aes aes r g4 ees8 | f2. |

	% part "B"
	ees4 ees g | ees2. | des4. ees4. | f2. |
	ees4 ees g | ees2. | des4. aes'4. | f2. |

	% part "Instr"
	\repeat volta 2 {
		r2.^\markup { Solos } | r2. | r2. | r2. |
		r2. | r2. | r2. | r2. |
		r2. | r2. | r2. | r2. |
		r2. | r2. | r2. | r2. |
		r2. | r2. | r2. | r2. |
		r2. | r2. | r2. | r2. |
		r2. | r2. | r2. | r2. |
		r2. | r2. | r2. | r2. |
	}
}
{% endif %}
