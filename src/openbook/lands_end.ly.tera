		{
			c4 gis8 a~ a4^\markup { \italic { Fine } } \grace { b16 c } d8. e16 |
		}
	}

	% part "B"
	f8 f e16 d g8~ g4 g16 f e d | g8 d r4 g16 a g f e8 d |
	b16 c8 e16~ e8 gis,16 a e'8 g,!16 aes e'4~ | e2. \grace { b16 c } d8 e |
