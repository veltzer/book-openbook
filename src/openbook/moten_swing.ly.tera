{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		aes1*2:6 | ees1*3:7 | \myEndLine
		bes2:m7 bes:m7/ees | aes1 |
	} \alternative {
		{
			bes2:m7 ees:7 | \myEndLineVoltaNotLast
		}
		{
			aes2:7 g:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	c1:6 | g:7 | c:6 | g:7 | \myEndLine
	c1:6 | g:7 | c4:6 c b8:dim7 bes4.:m7 | bes2:m7 ees:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	aes1*2 | ees1*4:7 | \myEndLine
	bes2:m7 bes:m7/ees | aes2:6 des:7 | aes1:6.9 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
