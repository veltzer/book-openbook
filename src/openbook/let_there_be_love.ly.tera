{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key ees \major

	\partial 2 \tuplet 3/2 { g'4 aes bes } |

	\repeat volta 2 {

		% part "A"
		bes1~ | bes4 g \tuplet 3/2 { g aes bes } | bes1~ | bes2 \tuplet 3/2 { g4 aes bes } |
		aes2 aes~ | aes2 \tuplet 3/2 { f4 g aes } | bes1~ | bes2 \tuplet 3/2 { a!4 d c } |

		% part "B"
		bes1~ | \tuplet 3/2 { bes4 f f } \tuplet 3/2 { f g aes } | bes1~ | bes2 \tuplet 3/2 { ees,4 d c } |
		aes'2 aes~ | aes4 f \tuplet 3/2 { f ees d } | g1~ | g2 \tuplet 3/2 { g4 aes bes } |

		% part "A"
		bes1~ | bes4 g \tuplet 3/2 { g aes bes } | bes1~ | bes2 \tuplet 3/2 { g4 aes bes } |
		aes2 aes~ | aes4 f \tuplet 3/2 { f g aes } | bes1~ | bes2 \tuplet 3/2 { g4 aes bes } |

		% part "C"
		bes2 bes~ | bes4 bes \tuplet 3/2 { bes g bes } | d1~ | d4 c \tuplet 3/2 { c b! c } |
		ees1~ | ees2 \tuplet 3/2 { d,4 ees f } |
	} \alternative {
		{
			ees1 | r2 \tuplet 3/2 { g4 aes bes } |
		}
		{
			ees,1~ | ees2 r |
		}
	}
}
{% endif %}
