{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees1:maj7 | g:m7 | g:m7.5- | c:7.9- | \myEndLine
		f1:m7.5- | bes:7.9- | ees2:maj9 f:m7 | g:m7 ges:dim7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f1:m7 | bes:7.9- | ees:maj9 | ees2:6 ges:dim7 | \myEndLine
		f1:m7 | bes:7.9- | ees:6 | f2:m7 bes:7.9- | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1:maj9 | g:m7 | g:m7.5- | c:7.9- | \myEndLine
		f1:m7.5- | bes:7.9- | ees2:maj9 e:dim7 | f:m7 bes:7.9- | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		ees1:maj9 | g:m7 | c2:9 g:m7 | c1:7 | \myEndLine
		f1:m7 | bes:7.9- |
	} \alternative {
