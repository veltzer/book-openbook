{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2 a:m7 | d:m7 g:7 | c a:m7 | d:m7 g:7 | \myEndLine
		c2:maj9/e ees:dim7 | d:m7 g:7 | c:maj7/e ees:dim7 | d:m7 g:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2 a:m7 | d:m7 g:7 | c a:m7 | d:m7 g:7 | \myEndLine
		c2:maj9 ees:dim7 | e:m7.5- a:7.9- | d:m7 g:7.9- | \myEndLine
		c2:maj7 e4:m7.5- a:7 | d2:m7 g:7.9- |
	} \alternative {
		{
			c2 d4:m7 g:7 | \myEndLineVoltaNotLast
		}
		{
			c1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
