{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	g1 |
	s1 |
	a1 |
	s1 | \myEndLine
	d1 |
	s1 |
	c4./g g1*5/8 |
	s1 | \myEndLine
	bes1 |
	s1 |
	} \alternative {
	{
	s1 |
	s1 | \myEndLine
	g1 |
	s1 |
	a1 |
	d1 | \myEndLineVoltaNotLast
	}
	{
	s1 | \myEndLineVoltaLast
	}
	}
	\repeat volta 2 {
	s1 |
	g1 |
	d1 | \myEndLine
	g1 |
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	\repeat volta 2 {
	b'4. ^ "Moderately Slow" b'8 c''8 b'8 a'8 g'8 |
	b'4. b'8 c''8 b'8 a'8 g'8 |
	a'4. e'8 a'2 |
	r2 r4 a'4 |
	a'4. a'8 b'8 a'8 g'8 fis'8 |
	a'4. a'8 b'8 a'8 g'8 fis'8 |
	e'4. d'8 d'2 |
	r2 r4 d''4 |
	d''4. d''8 es''8 d''8 c''8 bes'8 |
	r8 d''8 d''8 d''8 es''8 d''8 c''8 bes'8 |
	} \alternative {
	{
	c''4. a'8 c''2 |
	r2 r4 c''4 |
	b'4. b'8 c''8 b'8 a'8 g'8 |
	b'4. b'8 c''8 b'8 a'8 g'8 |
	a'2. r8 g'8 |
	fis'16 ( e'16 d'4. ) r2 |
	}
	{
	d''1 |
	}
	}
	\repeat volta 2 {
	r4 - "Repeat 3 times" d''4 ^ "N.C." d''4 c''4 |
	b'4. b'8 c''8 b'8 a'8 g'8 |
	a'4. a'8 b'8 a'8 g'8 fis'8 |
	g'1 |
	}
	\endBar
}
{% endif %}
