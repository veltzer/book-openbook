{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g1:m | bes:7 | ees:maj7 | a2:m7.5- d:7 | \myEndLine
		g1:m | e:m7.5- |
	} \alternative {
		{
			a1:m7.5- | d:7 | \myEndLineVoltaNotLast
		}
		{
			a1:m7.5- | d:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	d1*2:m7.5- | e1*2:m7.5- | \myEndLine
	f1*2:m7 | a1:m7.5- | d:7.9- | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	g1:m | bes:7 | ees:maj7 | a2:m7.5- d:7 | \myEndLine
	g1:m | e:m7.5- | a:m7.5- | d:7 | g:m | \myEndLine
	\endPart

	\endSong
	\endChords
}
