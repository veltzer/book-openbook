	- the old mako draft of the Own version had: style "Jazz-Rock",
		copyright "1975 By Hancock Music CO., New York, N.Y.",
		remark "Not to be found in the Real Books" and youtube id 8B1oIXGX0Io.
{% endif %}
{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1*4:m | \myEndLine
		des1*4:7 | \myEndLine
		d1*4:m11 | \myEndLine
		f1*4:m | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 112
	\time 4/4
	\key c \major

	\partial 4 f8 f |

	% part "A"
	\repeat volta 2 {
		r2 aes8 bes bes4~ | bes4. aes8 bes c ees, f | R1 | r2 r4 f8 f |
		r2 aes8 bes bes4~ | bes4. aes8 bes c ees, f | R1 | r2 c'8 ees c ees |
		f,4. f8~ f2 | r2 c'8 ees c ees | f,4. f8~ f2 | R1 |
		R1 | R1 | R1 | r2 r4 f8 f |
	}
}
{% endif %}
{% if part == "Own" %}onCue = <>^\markup \italic { on CUE }

PartChords=\chordmode {
	\set ChordNames.midiInstrument = #"electric guitar (jazz)"
	\startChords

	\startSong

	\myMark "Intro"

	\startPart
		\repeat volta 2{
			f1:m7 | f1:m7 | f1:m7 | f1:m7 |
		}
	\endPart

	\myMark "A"

	\startPart
		\repeat volta 2{
			f1:m7 | f1:m7 | f1:m7 | f1:m7 |
			des1:7 | des1:7 | des1:7 | des1:7 |
			d1:m11 | d1:m11 | d1:m11 | d1:m11 |
			f1:m7 | f1:m7 | f1:m7 | f1:m7 |
		}
	\endPart

	\endSong

	\endChords
}

