{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2. s2. |

	\myMark "A"
	\startPart
	f2:m7 bes:7 | f:m7 bes:7 | ees1 | s2 c:m | \myEndLine
	f2:m7 bes:7 | f:m bes:7 | ees1 | s2 f4:m7 ges:dim7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f2:m7 bes:7 | f:m7 bes:7 | ees1 | s2 ees4:maj7 ees:7 | \myEndLine
	aes1 | f:m7 | f2:9 bes4:9 bes:7.9- | ees4 r2. | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		c1*2:7 | f1*2:7 | \myEndLine
		bes1*2:7 | ees1*2 | \myEndLine
		c1*2:7 | f1*2:7 | \myEndLine
		bes1*2:7 | ees1*2 | \myEndLine
		c1*2:7 | f1*2:7 | \myEndLine
		bes1*2:7 |
	} \alternative {
		{
			ees1 | r1 | \myEndLineVoltaNotLast
		}
		{
			ees1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
