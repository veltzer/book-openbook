{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		a1:m7 | f:7 | g:maj7/b | bes:dim7 | \myEndLine
		a:m7 | b2:m7 e:7.9- |
	} \alternative {
		{
			a2:m7 d:7.9- | b:m7.5- e:7.9- | \myEndLineVoltaNotLast
		}
		{
			a2:m7 d:7.9- | g:7sus4 g:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	c1:maj7 | f:7sus4 | g:maj7 | cis2:m7.5- c:m | \myEndLine
	g1/b | a:m7 | b2:7.5+.9+ e4:7sus4 e:7 | a2:m7 b4:m7.5- e:7.9- | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	a1:m7 | f:7 | g:maj7/b | bes:dim7 | \myEndLine
	a:m7 | b2:m7 e:7.9- | a:m7 d:7.9- | b:m7.5- e:7.9- | \myEndLine
	\endPart

	\myMark "End"
	\startPart
	a4:m7 b:m9 g2:maj7 | a:m7 d:7.9- | g1:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
