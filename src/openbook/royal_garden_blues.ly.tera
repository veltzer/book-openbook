	bes:6 f:7.5+ | bes:6 f:7.5+ | bes:6 f:7.5+ | bes:dim bes:7 | \myEndLine
	c:7 d4:dim7 c:dim7 | c:7 des:7 c2:7 | f1 | f2 c:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f2 bes4 bes:m | f2 bes4 bes:m | f2 bes4 bes:m | f2 f:9 | \myEndLine
	bes:6 f:7.5+ | bes:6 f:7.5+ | bes:6 f:7.5+ | bes bes:7 | \myEndLine
	c:7 d4:dim7/c c:dim7 | c:7 des:7 c2:7 | f1 | f2 c:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		f2 f:7 | f f:7 | f f:7 | c1:7 | \myEndLine
		bes:6 | bes2:6 des4:7 c:7 | f1 | f2 f:m7.5- | c1:7/g | \myEndLine
	} \alternative {
		{
			c1:7 | f | f2 c:7 | \myEndLineVoltaNotLast
		}
		{
			c1:7 | f | f2 c:7.5+ | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "C"
	\startPart
	f1:7 | bes | bes:m | f2 f:7 | \myEndLine
	\endPart

	\myMark "D"
	\startPart
	\repeat volta 2 {
		bes1*3 | bes1:7 | \myEndLine
		ees | ees:m | bes | g:7 | \myEndLine
		c:7 | f:7 | bes2 ees:m6 | bes4 ees:m6 bes2 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
