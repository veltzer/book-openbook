{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key f \major

	as'4 r8 f'8 f'4 r4 |
	as'4 r8 f'8 f'4 r4 |
	as'4 r8 f'8 f'4 r4 |
	as'4 r8 f'8 f'4 r8 f'8 |
	\repeat volta 2 {
	\mark \markup { \musicglyph "scripts.segno" } as'8 es''8 ~ es''2. ~ |
	es''2. c''8 f'8 |
	as'4. f'8 ~ f'2 ~ |
	f'1 |
	r4 r8 f'8 as'8 es''4 es''8 ~ |
	es''2 ~ es''8 c''8 bes'8 f'8 |
	as'4 f'8 es'8 ~ es'2 ~ |
	} \alternative {
	{
	es'2. r8 f'8 |
	}
	{
	es'1 |
	}
	}
	\repeat volta 2 {
	f''8 f''8 r8 f''8 r8 cis''8 d''4 |
	bes'4 r4 d''4 d''4 |
	d''8 c''8 r8 c''8 ~ c''2 ~ |
	c''2. r8 f'8 |
	as'8 es''8 ~ es''2. ~ |
	es''2. c''8 f'8 |
	as'4. f'8 ~ f'2 ~ |
	\mark \markup { \musicglyph "scripts.coda" } f'1 ^ "D.S. al Coda" |
	}
	\mark \markup { \musicglyph "scripts.coda" } f'2 r8 c'8 es'8 e'8 |
	\repeat volta 2 {
	f'4 r4 r2 ^ "Vamp til Cue" |
	r2 r8 c'8 es'8 e'8 |
	}
	f'4 r4 r2 |
	\endBar
}
{% endif %}
