{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	s1 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g1:maj7 | g:maj7 | \myEndLine
		bes1/a | bes/a | d:9^7 | d/c | \myEndLine
	} \alternative {
		{
			bes1:maj7 | bes2:maj7 g/a | \myEndLineVoltaNotLast
		}
		{
			g1 | d | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		g1/a | g/a | f/g | f/g | \myEndLine
		a/e | a/e | d/fis | d/fis | \myEndLine
	}
	\endPart

	\myMark "Coda"
	\startPart
	a1:7 | d | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 132
	\time 4/4
	\key g \major

	% part "Intro"
	e8 b' a e' d b' a d, |

	% part "A"
	\repeat volta 2 {
		d2..^\markup { \musicglyph #"scripts.segno" } b'8~ | b4. b16 a \tuplet 3/2 { g8 a b } \tuplet 3/2 { g a b } |
		d,1 | e4 r8 g8~ g4. fis16 e | e16 fis d8~ d2.~ | d1^\markup { To Coda \musicglyph #"scripts.coda" } |
	} \alternative {
		{ <ees, c'>8 <g d'> r8 <a f'>8 r8 <a e'>8 <b d>4~ | <b d>2 r2 | }
		{ <d b'>8 <b b'> r8 <a g'>8 r8 <g b'>8 <b fis'>4~ | <b fis'>2. r4 | }
	}

	% part "B"
	\repeat volta 2 {
		r4 r8 b8 d, fis a, e''~ | e8 d b2. | e4. d16 c b4 d8 a~ | a1 |
		r2 c8 cis, fis a, | c'4 b8 a~ a g4. | fis8 a r d~ d cis4. | e,8 b' a e' d b' a d,^\markup { D.S. al Coda } |
	}

	% part "Coda"
	cis4.^\markup { \musicglyph #"scripts.coda" } b8 a4. g8 | fis4 <cis' d>2.-^^\markup { \italic { Fine } } |
}
{% endif %}
