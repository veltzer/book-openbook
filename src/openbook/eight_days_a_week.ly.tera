{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 60
	\time 4/4
	\key c \major

	\repeat volta 2 {
	e''4 _ "Rock" d''4 c''4 d''4 |
	d''2 a'2 |
	a'4 c''4 f''4 f''4 |
	e''1 |
	e''4 d''4 c''4 d''4 |
	d''2 a'2 |
	a'4 c''4 f''4 f''4 |
	e''1 |
	e''2 c''2 |
	d''2 a'2 |
	e''2 c''2 |
	d''2 a'2 |
	e''4 d''4 c''8 c''8 d''4 |
	d''2 a'2 |
	r4 f''4 f''4 f''4 |
	} \alternative {
	{
	e''8 d''8 c''2. ^ "To Coda" |
	}
	{
	e''8 d''8 c''2. |
	}
	}
	d''2 d''4. e''8 |
	d''2. c''4 |
	d''4 c''4 d''4 c''4 |
	d''8 c''8 a'2. |
	d''2 d''4. e''8 |
	d''2. c''4 |
	d''4 c''4 d''4 c''4 |
	d''4 d''4 f''2 ^ "D.S. al Coda" |
	\repeat volta 2 {
	\mark \markup { \musicglyph "scripts.coda" } e''8 d''8 c''2. |
	r4 f''4 f''4 f''4 |
	e''8 d''8 c''2. |
	r4 f''4 ^ "repeat and fade" f''4 f''4 |
	}
	\endBar
}
