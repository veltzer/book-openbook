{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1 | c | c | c2. f4:9 | f1:9 | f2.:9 c4 | \myEndLine
		c1 | c2. d4:m7 | d1:m7 | d:m7 |
	} \alternative {
		{
			c1*2 | \myEndLineVoltaNotLast
		}
		{
			c1 | c2. \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 200
	\time 4/4
	\key c \major

	\partial 4 c'4~ |

	% part "A"
	\repeat volta 2 {
		c4 c c r | c r8 c r4 c~ | c c c r | c r8 c r4 c~ | c c c r | c r8 c r4 c~ |
		c c c r | c r8 c r4 c~ | c c c r | c r8 c r2 |
	} \alternative {
		{
			r4^\markup { (Optional Repeats) } c2.~ | c2. c4\laissezVibrer |
		}
		{
			r4 c2.~ | c2.
		}
	}
}
{% endif %}
