		\myMark "A"
		\startPart
		f2 d:7 | g1:7 | c:7 | f2 g4:m7 c:7 | \myEndLine
		f2. f4:m | c2 a:7 | g1:7 | c:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f4 d:7 g:7 c:7 | f1 | f4 d:7 g:7 c:7 | a1:7 | bes2 b:dim7 | \myEndLine
		f4 a:7 d2:7 | g2:7 bes4:m6 c:7 |
	} \alternative {
