	\tempo "Andante" 4 = 80
	\time 4/4
	\key aes \major

	% part "A"
	\repeat volta 2 {
		bes'4 g ees c8 ees~ | ees4. g8~ g4 r | bes4 g ees c8 ees~ | ees4. f8~ f4 r8 ees |
		aes4 f8 c~ c2 | \tuplet 3/2 { r4 aes bes } \tuplet 3/2 { ces8 bes aes~ } aes bes | c!8 ees~ ees2.~ | ees2. r4 |
		ees'16 ees r8 c4 aes f8 ees~ | ees2 \tuplet 3/2 { r8 aes bes } \tuplet 3/2 { ces bes aes~ } | aes2 \tuplet 3/2 { r8 des, ees } \tuplet 3/2 { fes ees des^\markup { To Coda \musicglyph #"scripts.coda" } } |
	} \alternative {
		{
			c8 g'4. aes4 a! |
		}
		{
			c,8 g'4. aes4 a!^\markup { D.C. al Coda } |
		}
	}

	% part "Coda"
	r1 |
	\key a \major
	b4 gis e cis8 e~ | e4. gis8~ gis4 r | b4 gis e cis8 e~ | e4. fis8~ fis4 r8 e |
	a4 fis8 cis~ cis2 | \tuplet 3/2 { r4 a b } \tuplet 3/2 { c!8 b a~ } a b | cis8 e~ e2.~ | e2. r4 |
	e'16 e r8 cis4 a fis8 e~ | e2 \tuplet 3/2 { r8 a b } \tuplet 3/2 { c! b a~ } | a2 \tuplet 3/2 { r8 d, e } \tuplet 3/2 { f! e d } |
	cis8 gis'~ gis4 fis f! | e fis! a b | e1\fermata |
}
