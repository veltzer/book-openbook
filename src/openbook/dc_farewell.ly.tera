{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		e4:maj7.11+ f:m7 bes:m7 ees:13.9- | aes2:maj7 ees:13.9- | e4:maj7.11+ f:m7 bes:m7 ees:13.9- | aes2:maj7 ees4:m7 aes:7 | \myEndLine
		des1:maj7 | des:m7 | aes2:maj7 bes:m7 | c:m7 f:7.9+ | \myEndLine
		bes4:m7 c:m7 f:7.9+ b:7.9+ | bes1:m7 | e2:maj7 a:maj7 | \myEndLine
	} \alternative {
		{
			aes2:maj7 bes4:m7 ees:7.11+ | \myEndLineVoltaNotLast
		}
		{
			aes2:maj7 bes4:m7 ees:7.11+ | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "Coda"
	\startPart
	aes2:maj7 e:maj7 | f4:maj7.11+ fis:m7 b:m7 e:13.9- | \myEndLine
	a2:maj7 e:13.9- | f4:maj7.11+ fis:m7 b:m7 e:13.9- | a2:maj7 e4:m7 a:7 | \myEndLine
	d1:maj7 | d:m7 | a2:maj7 b:m7 | cis:m7 fis:7.9+ | \myEndLine
	b4:m7 cis:m7 fis:7.9+ c:7.11+ | b1:m7 | f2:maj7 bes:maj7 | \myEndLine
	a2:maj7 b4:m7 e:7.9- | f4:maj7.11+ d:maj7 c:maj7 f:maj7 | a1:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
