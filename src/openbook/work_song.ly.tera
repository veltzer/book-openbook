{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 4 {

		\myMark "A"
		\startPart
		c1*4:m7 | \myEndLine
		c1*2:m7 | g2..:m7 g8:7 | g1:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c1*4:m7 | \myEndLine
		c1:7 | f:7 | d4.:7 g8*5:7.5+ |
	} \alternative {
		{
			c1:m6 | \myEndLineVoltaNotLast
		}
		{
			c1:m6.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \minor

	\repeat volta 4 {
		% part "A"
		r4 c8 c ees f4 g8~ | g4 g8 f g4 bes | r4 c,8 c ees f4. | c4 c8 bes c2 |
		r4 c8 c ees f4 g8~ | g4 g8 f g4 bes | r4 g8 g bes g4 b8~ | b4 g8 f g2 |

		% part "B"
		r4 c8 bes \tuplet 3/2 { g f ees } f ees~ | ees4 ees8 c ees4 f | r4 c8 c ees f4 c8~ | c4 c8 bes c c c4 |
		ges'8 g4. r4 c, | ges'8 f4. r8 c ees ges~ | ges8 f4 ees8 \tuplet 3/2 { f8 ees c } bes c~ |
	} \alternative {
		{
			c2. r4 |
		}
		{
			c2. r4 |
		}
	}
}
{% endif %}
