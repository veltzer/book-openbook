{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	r1 | a1*2:maj7 | c1:maj7.5- | \myEndLine
	des1:maj7 | s2.. e8:maj7.5- | e2:maj7.5- ees:maj7 | d1:maj7.5- | \myEndLine
	\endPart

	\repeat volta 2 {

		\myMark "A"
		\startPart
		des1*2:m | s2 d4:maj7.5- des:m | c4.:m7.5- a8:maj7.5- s2 | \myEndLine
		des1*2:m | s2 d:maj7.5- | c2:maj7.5- a4.:maj7.5- ees8:5.9 | s1 | \myEndLine
		s4 e2.:maj7.5- | s2 ges:maj7 | s2 e4. ees8:maj7 | s2 e4:7 ees:7 | s1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		a1:maj7.5- | c:maj7.5- | des:maj7.5- | e8:maj7.5- ees4:maj7 e8*5:maj7.5- | \myEndLine
		e1*4/f | \myEndLine
		ees1*4:m7 | \myEndLine
		d1*4:maj7.5- | \myEndLine
		\endPart

	}

	\myMark "Coda"
	\startPart
	s2 a:maj7.5- | s1 | s1 | c1:maj7.5- | \myEndLine
	des1:maj7.5- | s2.. e8:maj7.5- | s2 ees:maj7.5- | d4.:maj7.5- f8*5:maj7.5- | \myEndLine
	e2:maj7.5- ees:maj7.5- | d4.:maj7.5- f8*5:maj7.5- | e2:maj7.5- ees:maj7.5- | d1:maj7.5- | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
