{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	\repeat volta 2 {
	es'4. bes'8 d'2 |
	c'8 d'8 \once \omit TupletBracket \times 2/3 { es'8 f'8 g'8 ~ } g'2 |
	es'8 f'8 \once \omit TupletBracket \times 2/3 { g'8 as'8 bes'8 ~ } bes'8 bes'4. |
	f'8 g'8 \once \omit TupletBracket \times 2/3 { as'8 bes'8 c''8 ~ } c''2 |
	d''4 d''8 c''8 bes'8 as'4 g'8 |
	c''4 bes'8 as'8 g'4. f'8 |
	bes'4 as'8 g'8 f'8 es'8 d'8 es'8 |
	f'2. r4 |
	es'4. bes'8 d'2 |
	c'8 d'8 \once \omit TupletBracket \times 2/3 { es'8 f'8 g'8 ~ } g'2 |
	es'8 f'8 \once \omit TupletBracket \times 2/3 { g'8 as'8 bes'8 } bes'8 ~ bes'4. |
	f'8 g'8 \once \omit TupletBracket \times 2/3 { as'8 bes'8 c''8 ~ } c''2 |
	d''4 d''8 c''8 bes'8 as'4 g'8 |
	c''4 bes'8 as'8 g'4. f'8 |
	bes'4 as'8 g'8 f'8 es'8 d'8 f'8 |
	es'2. \once \omit TupletBracket \times 2/3 { es'8 f'8 e'8 } |
	es'8 c''4 es'8 d'8 f'8 as'8 c''8 |
	bes'8 c''8 \once \omit TupletBracket \times 2/3 { as'8 bes'8 g'8 ~ } g'2 |
	g'8 as'8 f'8 g'8 es'4 d'8 es'8 |
	c'2. \once \omit TupletBracket \times 2/3 { bes8 c'8 d'8 } |
	es'8 bes'4 es'8 d'8 f'8 as'8 c''8 |
	bes'8 c''8 as'8 bes'8 g'4. c'8 |
	f'8 f'8 \once \omit TupletBracket \times 2/3 { f'8 c'8 f'8 ~ } f'4. c'8 |
	f'8 g'8 as'8 bes'8 c''4 bes'4 |
	es'4. bes'8 d'2 |
	c'8 d'8 \once \omit TupletBracket \times 2/3 { es'8 f'8 g'8 ~ } g'2 |
	es'8 f'8 \once \omit TupletBracket \times 2/3 { g'8 as'8 bes'8 ~ } bes'8 bes'4. |
	f'8 g'8 \once \omit TupletBracket \times 2/3 { as'8 bes'8 c''8 ~ } c''2 |
	d''4 d''8 c''8 bes'8 as'4 g'8 |
	c''4 bes'8 as'8 g'4. f'8 |
	bes'4 as'8 g'8 f'8 es'8 d'8 f'8 |
	} \alternative {
	{
	es'2. r4 |
	}
	{
	es'1 |
	}
	}
	\endBar
}
{% endif %}
