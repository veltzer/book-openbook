{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\repeat volta 3 {

		\myMark "A"
		\startPart
		ees2. | bes:7 | ees | bes:7 | \myEndLine
		ees2. | bes:7 | c:m7 | aes2:m7 des4:7 | \myEndLine
		ees2. | bes:7 | ees | aes | \myEndLine
		ees2. | c:m7 | cis:dim7 | bes2:7/d bes4:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees2. | s | g2:m7.5- c4:7.9- | f2:m7 bes4:7 | \myEndLine
		ees2. | c:m7 | f:m7 | bes:7 | \myEndLine
		ees2. | s | aes | a:dim7 | \myEndLine
		ees2./bes | bes:7 |

	} \alternative {
		{
			ees2. | bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees2. | f:m7 | ees/bes | bes:7 | ees | s | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
