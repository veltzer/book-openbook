		g4 f ees | f g aes | g ees2~ | ees2 f4 |
		g4 f ees | f g aes | bes aes g | c2 c8 c |
		bes4 bes bes | bes bes bes | bes bes bes | bes2. |

		% part "B"
		bes4 g d | ees g bes | des2. | c2. |
		bes4 g d | ees g bes | f2.~ | f2. |
		bes4 g d | ees g bes | d2. | ees2. |
		ees4 bes g | d' aes f |
	} \alternative {
		{
			ees2.~ | ees4 bes' aes |
		}
		{
			ees2. | f2. | ees'4 bes g | d' aes f | ees2.~ | ees4 r r |
		}
	}
}
