{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2:7.9- f:7.5+ | bes1:6 | c2:7.9- f:7 | bes1 | \myEndLine
		c2:7.9- f:7 | bes4 aes:7 g2:7 | c2:7 f:7 |
	} \alternative {
		{
			bes1 | \myEndLineVoltaNotLast
		}
		{
			bes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	d1*2:7 | g1*2:7 | \myEndLine
	c1:7 | g2:m7 c:7 | f2:7 c:m7 | f1:7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	bes1 | c2:7 f:7 | bes4:7 aes:7 g2:7 | \myEndLine
	c2:7 f:7 | bes1 | f2:m7 bes:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
