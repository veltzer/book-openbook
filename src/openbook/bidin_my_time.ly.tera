{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Swing" 4 = 144
	\time 4/4
	\key es \major

	\repeat volta 2 {
	g'2 as'8 g'8 as'4 |
	bes'4. ( f'8 ) ~ - "7" f'4. f'8 |
	g'4. g'8 as'8 g'8 as'4 |
	bes'4. ( f'8 ) ~ f'4 bes'4 |
	es''8 es''8 es''8 es''8 e''8 c''4. |
	es''4 c''4 bes'8 as'4. |
	g'2 f'8 f'4. |
	es'1 |
	g'4. g'8 ~ g'2 |
	g'4. g'8 ~ g'2 |
	a'4 a'4 g'4 f'4 |
	a'4. g'8 ~ g'2 |
	bes'4. bes'8 ~ bes'2 |
	bes'4. bes'8 ~ bes'2 |
	es''4 es''4 d''4 c''4 |
	c''4. bes'8 ~ bes'4 as'4 |
	g'2 as'8 ( g'8 ) as'4 |
	bes'4. ( f'8 ) ~ f'4. f'8 |
	g'4. g'8 as'8 g'8 as'4 |
	bes'4. ( f'8 ) ~ f'4 bes'4 |
	es''4 es''4 e''8 c''4. |
	es''4 c''4 bes'8 as'4. |
	g'2 f'8 f'4. |
	} \alternative {
	{
	es'2 r2 |
	}
	{
	es'2 r2 |
	}
	}
	\endBar
}
{% endif %}
{% if part == "LyricsWikifonia" %}\lyricmode {
	I'm bid -- in' my time, __ _ "'Cause" that's the kind -- a guy I'm.
	__ _ While oth -- er folks grow diz -- zy I keep bus -- y bid -- in' my time.
	Next year, __ Next year, __ some -- thin's bound to hap -- pen.
	__ This year, __ this year, __ I'll just keep on nap -- pin' __ and bid -- in' __ _ my time __ _ "'Cause" that's the kind -- a guy I'm.
	__ _ There's no re -- gret -- tin' when I'm set -- tin' bid -- in' my time.
}
{% endif %}
{% if part == "LyricsmoreWikifonia" %}\lyricmode {
	I'm bid -- in' my time, __ _ "'Cause" that's the kind -- a guy I'm.
	__ _ Be -- gin -- nin' on a Mon -- day right thru Sun -- day,
	bid -- in' my time. Give me, __ give me, __ glass that's full of tin -- kle.
	__ Let me, __ let me, __ dream like Rip Van Win -- kle.
	__ _ He bid -- ed his time. __ _ And like that Win -- kle guy I'm.
	__ _ Just chas -- in' way flies, how the day flies, bid -- in' my _ time.
}
