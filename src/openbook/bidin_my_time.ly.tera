	\key es \major

	\repeat volta 2 {
	g'2 as'8 g'8 as'4 |
	bes'4. ( f'8 ) ~ - "7" f'4. f'8 |
	g'4. g'8 as'8 g'8 as'4 |
	bes'4. ( f'8 ) ~ f'4 bes'4 |
	es''8 es''8 es''8 es''8 e''8 c''4. |
	es''4 c''4 bes'8 as'4. |
	g'2 f'8 f'4. |
	es'1 |
	g'4. g'8 ~ g'2 |
	g'4. g'8 ~ g'2 |
	a'4 a'4 g'4 f'4 |
	a'4. g'8 ~ g'2 |
	bes'4. bes'8 ~ bes'2 |
	bes'4. bes'8 ~ bes'2 |
	es''4 es''4 d''4 c''4 |
	c''4. bes'8 ~ bes'4 as'4 |
	g'2 as'8 ( g'8 ) as'4 |
	bes'4. ( f'8 ) ~ f'4. f'8 |
	g'4. g'8 as'8 g'8 as'4 |
	bes'4. ( f'8 ) ~ f'4 bes'4 |
	es''4 es''4 e''8 c''4. |
	es''4 c''4 bes'8 as'4. |
	g'2 f'8 f'4. |
	} \alternative {
	{
