	f2:m7 bes2:7 |
	ees2:maj7 c2:7.9- |
	f2:m7 bes2:7 | \myEndLine
	ees2:6 c2:aug7 |
	f2:m7 des2:9 |
	ees2:6/bes f8:m7 bes4.:7 |
	} \alternative {
