	f2:m7 des2:9 |
	ees2:6/bes f8:m7 bes4.:7 |
	ees1:6 | \myEndLine
	g2:7 c2:6 |
	g2:7 c2:6 |
	d2:m7 g2:7 |
	c1:6 | \myEndLine
	bes2:7 ees2:6 |
	bes2:7 ees2:6 |
	c2:m7 f2:7 |
	f2:m7 bes2:7 | \myEndLine
