{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	f1 |
	s1 |
	s1 | \myEndLine
	s1 |
	s1 |
	s1 |
	c1:7 | \myEndLine
	s1 |
	f1 |
	f1:7 |
	bes1 | \myEndLine
	bes1:m |
	f2 d2:7 |
	g2:m7 c2:7 |
	} \alternative {
	{
	f1 | \myEndLine
	c1:7 | \myEndLineVoltaNotLast
	}
	{
	f1 | \myEndLineVoltaLast
	}
	}
	s1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Swing" 4 = 144
	\time 4/4
	\key f \major

	r4 f'4 a'4 bes'4 |
	\repeat volta 2 {
	c''2. r4 |
	r4 f'4 a'4 bes'4 |
	c''2. r4 |
	r4 f'4 a'4 bes'4 |
	c''2 a'2 |
	f'2 a'2 |
	g'2. r4 |
	r4 a'4 a'4 g'4 |
	f'2. f'4 |
	a'2 c''2 |
	c''4 bes'2. |
	r4 bes'4 a'4 bes'4 |
	c''2 a'2 |
	f'2 g'2 |
	} \alternative {
	{
	f'2. r4 |
	r4 f'4 a'4 bes'4 |
	}
	{
	f'1 ~ |
	}
	}
	f'4 r4 r2 |
	\endBar
}
{% endif %}
