		\startPart
		c2 c:maj7 | c:6 c | c2.:6 cis4:dim7 | d2:m7 g:7 | \myEndLine
		d2:m7 g:7 | d:m7 g:7 | d:7 g:7 | c c:7 | \myEndLine
		\endPart

		\myMark "B"
