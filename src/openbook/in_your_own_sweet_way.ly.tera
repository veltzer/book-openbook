{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		a2:m7.5- d:7.9- | g:m7 c:7 | c:m7 f:7 | bes:6 ees:maj7 | \myEndLine
		aes:m7 des:7 | ges:maj7 ces:maj7 | c:m7.5- f:7.9- |
	} \alternative {
		{
			c1:maj7.11+ | \myEndLineVoltaNotLast
		}
		{
			c1:maj7.11+ | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	e2:m7.5- a:7.9- | d1:maj7 | e2:m7 a:7 | d1:maj7 | \myEndLine
	d2:m7 g:7 | c1:maj7 | ees2:m7 aes:7 | g1:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	a2:m7.5- d:7.9- | g:m7 c:7 | c:m7 f:7 | bes:6 ees:maj7 | \myEndLine
	aes:m7 des:7 | ges:maj7 ces:maj7 | c:m7.5- f:7.9- | c1:maj7.11+ | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\partial 4 ees'8 d~ |

	% part "A"
	\repeat volta 2 {
		d2. c8 bes~ | bes1 | r8 d ees f ees4 d8 bes~ | bes4 c8 d~ d2 |
		r8 ces des ees des4 ces8 bes~ | bes4 des8 ges,~ ges4 bes8 aes~ | aes2. ges8 fes~ |
	} \alternative {
		{
			fes4. f8 r4 ees'8 d\laissezVibrer |
		}
		{
			fes,4. f8 r2 |
		}
	}

	% part "B"
	r4 a c4. bes8 | a1 | r4 a cis a8 fis~ | fis1 |
	r4 r8 e c d e f | g2. ges8 f~ | f2. ees8 d~ | d2. ees'8 d~ |

	% part "A"
	d2. c8 bes~ | bes1 | r8 d ees f ees4 d8 bes~ | bes4 c8 d~ d2 |
	r8 ces des ees des4 ces8 bes~ | bes4 des8 ges,~ ges4 bes8 aes~ | aes2. ges8 fes~ | fes4. f8 r2 |
}
{% endif %}
