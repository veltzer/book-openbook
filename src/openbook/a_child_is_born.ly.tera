{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes2.:maj7 | ees:m/bes | bes:maj7 | ees:m6/bes | \myEndLine
		bes:maj9 | ees2:m/bes bes4 | a2.:m7.5- | d:7.9+ | \myEndLine
		g:m7 | d:7.5+ | g:m7 | d:7.5+ | \myEndLine
		g:m7 | c:9 | f:7sus4 | f:7.13 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	bes:maj7 | ees:m/bes | bes:maj7 | ees:m/bes | \myEndLine
	bes:maj9 | d:7.5+.9+ | ees:maj7 | aes2:9 c4:m7.5- | \myEndLine
	bes2./f | ges:6.11+ | g:m7 | c:9 | \myEndLine
	f:7sus4 | f:7.13 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	f:7sus4 | f:7.9- | bes:maj7 | ees:7 | bes:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Adagio" 4 = 80
	\time 3/4
	\key bes \major

	% part "A"
	\repeat volta 2 {
		d2. | ees4 f c' | d,2. | ees4 f c' |
		d,2. | ees4 f c' | c2. | << { c2. } \\ { f,4 ees f } >> |
		d2. | ees4 f c' | d,2. | ees4 f c' |
		d,2. | e!4 g c | c2. | <d, f>2~ <d f>8 c |
	}

	% part "B"
	d2. | ees4 f c' | d,2. | ees4 f c' |
	d,2. | f4 bes d | d2. | ees2 r8 g, |
	f2. | ees4 f c' | d,2. | e!4 g c^\markup { To Coda \musicglyph #"scripts.coda" } |
	c2. | f,2.^\markup { D.C. al Coda } |

	% part "Coda"
	c'2. | a2. | c2.\fermata | c2.\fermata | d2.\fermata |
}
{% endif %}
