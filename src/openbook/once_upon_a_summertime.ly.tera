{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f2.:m | f:m | g:m7.5- | c:7 | \myEndLine
		f2.:m7 | d:m7.5- | g:7 | c:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2.:m7 | f2:7 f4:7.9- | bes2. | ees:9 | f:maj7 | \myEndLine
		d2.:m7 | g:7 | c2:7 c4:7.9- | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		f2.:maj7 | d:m7 | g:m7 | c:9 | \myEndLine
		f2. | d:m7 | g:m7 | c:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2.:m7 | f2:9 f4:7.9- | bes2. | ees:9 | f:maj7 | \myEndLine
		d2.:m7 | g:7 | g4:m7 c:9 c:7.9- | \myEndLine
	} \alternative {
		{
			f2 d4:m7 | g:m7 c2:7.9- | \myEndLineVoltaNotLast
		}
		{
			f2.*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Andante" 4 = 92
	\time 3/4
	\key aes \major

	\repeat volta 2 {
		% part "A"
		c'4. des8 c b! | c8 des c b! c aes | bes4. c8 bes a! | bes8 c bes a! bes g |
		aes4. bes8 aes g | aes8 bes aes g aes f | g4. f8 ees d! | d!4 c2 |

		% part "B"
		c'4. d!8 c b! | c8 d! c b! c a! | bes4. c8 bes a! | bes8 c bes a! bes g | a!4. bes8 a gis |
		a!8 bes a gis a f | g2.~ | g2. |

		% part "C"
		\key f \major
		a4. bes8 a gis | a8 bes a gis a f | g4. a8 g fis | g8 a g fis g e |
		f4. g8 f e | f8 g f e d c | d2 c4 | d4 c2 |

		% part "B"
		c'4. d8 c b! | c8 d c b! c a | bes4. c8 bes a | bes8 c bes a bes g | a4. bes8 a gis |
		a8 bes a gis a f | g4. a8 g fis | g8 a g fis g e |
	} \alternative {
		{
			f2.~ | f4 r r |
		}
		{
			f2.~ | f2. |
		}
	}
}
{% endif %}
