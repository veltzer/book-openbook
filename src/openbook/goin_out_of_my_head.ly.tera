{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		c1:m7 | c:maj7 | c:m7 | c2:maj7 c:7.5+ | \myEndLine
		f1:maj7 | f:maj7 | f:m7 | bes:9 | \myEndLine
		ees:maj7 | g:m7 | ees2:maj7 g:m7 | aes bes:9 | \myEndLine

	} \alternative {
		{
			c1:maj7 | c:maj7 | \myEndLineVoltaNotLast
		}
		{
			c1:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	d2:m7 g:7 | c1:maj7 | f:maj7 | c:maj7 | \myEndLine
	d:m7 | c4.:maj7 f8*5:6 | c8:maj7 f4.:6 c4:maj7 f:6 | c4.:maj7 f8*5:6 | \myEndLine
	c1:maj7 | d:/fis | f:m | c:/e | ees:dim7 | \myEndLine
	g:7/d | a2:m7/d d:7 | g1:7sus4 | g:7 | \myEndLine
	\endPart

	\myMark "End"
	\startPart
	\repeat volta 2 {
		c1:m7 | c:maj7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
