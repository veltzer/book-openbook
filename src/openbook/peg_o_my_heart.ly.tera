	\key bes \major

	\repeat volta 2 {
	d'8 f'8 g'8 a'8 ~ a'2 ~ |
	a'4 g'4 f'4 d'4 |
	e'8 g'8 bes'8 d''8 ~ d''2 ~ |
	d''4 c''4 bes'4 g'4 |
	g'8 f'8 a'8 g'8 ~ g'2 |
	g'8 f'8 a'8 g'8 ~ g'2 |
	d''8 a'8 c''8 bes'8 d'8 f'8 a'8 g'8 |
	f'8 fis'8 a'8 g'8 f'8 e'8 es'8 c'8 |
	d'8 f'8 g'8 a'8 ~ a'2 ~ |
	a'4 g'4 f'4 d'4 |
	e'8 g'8 bes'8 d''8 ~ d''2 ~ |
	d''4 c''4 bes'4 g'4 |
	g'8 f'8 a'8 g'8 ~ g'2 |
	g'8 f'8 c''8 g'8 ~ g'8 f'8 d''4 |
	bes'1 ~ |
	bes'2 r2 |
	}
	bes'1 |
	\endBar
}
