{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	bes1:maj7 |
	s1 |
	c1:7 |
	s1 | \myEndLine
	c2:m7 f2:7 |
	c2:m7 f2:7 |
	bes2:maj7 g2:7 |
	c2:m7 f2:7 | \myEndLine
	bes1:maj7 |
	s1 |
	c1:7 |
	s1 | \myEndLine
	c2:m7 f2:7 |
	c2:m7 f2:7 |
	bes1 |
	c2:m7 f2:7 | \myEndLine
	}
	bes1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
