{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1 | bes2 bes4/d des:dim7 | c2:m7 f:7 | c1:m7 | \myEndLine
		f1:7 | c2:m7 f:7 | bes1:maj7 | bes2.:maj7 f4:aug | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		bes1*2 | f2:9 f:dim7 | f1:9 | \myEndLine
		g2:m7 c:7 | g:m7 c:7.9- | c1:m7 | f:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		bes1 | bes2 bes4/d des:dim7 | c2:m7 f:7 | c:m7 f:9 | \myEndLine
		f1:7 | c2:m7 f:7 | d1:m7.5- | g:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		c1:m7 | ees:m6 | bes2:maj7 g:m7 | c1:7 | \myEndLine
		bes2 fis4:dim7 g:m | c2:7 c4:m7 f:7.9- |
	} \alternative {
		{
			bes2 g:m7 | c:m7 f:7.9- | \myEndLineVoltaNotLast
		}
		{
			bes2 g:m7 | c4:m7 f:7.9- bes2:6.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
