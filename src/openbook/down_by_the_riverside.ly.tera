{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key f \major

	\partial 4 gis'4 |

	% part "A"
	a4^\markup { \musicglyph #"scripts.segno" } c, d f | f8 f4 a8~ a2 | r4 a a4. gis8 | a8 g4 f8~ f2 | r4 g g4. fis8 | g8 f4 e8~ e2 | r4 a a4. gis8 |
	a8 g4 f8~ f4 a8 gis | a4 c, d f | f8 f4 a8~ a2 | r4 a a4. gis8 | a8 g4 f8~ f2 | a4 g2 bes4 | a2 g2^\markup { To Coda \musicglyph #"scripts.coda" } | f1~ | f4 f g a |

	% part "B"
	r4 bes bes8 bes4. | bes4 f g gis | a4 a a8 g4. | f1 | a4 g2. | f2 g2 | a1~ | a4 f g a |
	r4 bes bes8 bes4. | bes4 f g gis | a4 a a8 g4. | f2. f4 | a4 g2 g4 | a2 b!2 | c1~ | c2. gis4^\markup { D.S. al Coda } |

	% part "Coda"
	f1~^\markup { \musicglyph #"scripts.coda" } | f2. r4 |
}
{% endif %}
