{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	f1*4 | g1:m | c:7 | f | \myEndLine
	f1*5 | g1:m | c:7 | f1*2 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	bes1*2 | f | c:7 | f1 | f:7 | \myEndLine
	bes1*2 | f1 | d:m7 | g1*2:7 | c:7 | \myEndLine
	\endPart

	\myMark "Coda"
