{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	c1:maj9 |
	g1:m7 |
	c1:maj9 |
	g2.:m7 fis4:9 | \myEndLine
	c2.:m9 f4:9 |
	d2:m7 ees2:m7 |
	e2.:m7 a4:7 |
	d2:m7 g4:7.9- g4:9 | \myEndLine
	c1:maj9 |
	g1:m7 |
	c1:maj9 |
	g2.:m7 fis4:9 | \myEndLine
	c2.:m9 f4:9 |
	d2:m7 ees2:m7 |
	d2.:m7 des4:9 |
	c1:maj9 | \myEndLine
	a2:m6 b2:aug7 |
	e2.:m9 a4:7.9- |
	fis2.:m7 d4 |
	f1:9 | \myEndLine
	b2:m6 cis2:9.5+ |
	a2:m6 b2:7.9- |
	g2:m6 a2:7.5- |
	d2:m7 g2:7.9- | \myEndLine
	c1:maj9 |
	g1:maj7 |
	c1:maj9 |
	g1:m7 | \myEndLine
	c2.:m9 f4:9 |
	d2:m7 ees2:m7 |
	d2.:m7 des4:9 |
	c1:maj9 | \myEndLine
	}
	c1:maj9 |
	s1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
