	\time 4/4
	\key c \major

	\repeat volta 2 {
	e'2. g'4 |
	a'8 d'8 ~ d'2. |
	e'2. g'4 |
	c''2. cis''4 |
	d''2. c''4 |
	f'1 |
	a'2. g'4 |
	g'4 f'4 cis'4 d'4 |
	e'2. g'4 |
	a'8 d'8 ~ d'2. |
	e'2. g'4 |
	c''2. cis''4 |
	d''2. c''4 |
	f'1 |
	e'2. g'4 |
	d'2. g'8 a'8 |
	b'8. a'16 \once \omit TupletBracket \times 2/3 { c''8 b'8 a'8 } g'4. dis'8 |
	fis'4 fis'2 e'4 |
	a'2. d'4 |
	d''1 |
	cis''8 b'8 d''8 cis''8 g'4. gis'8 |
	b'4. a'8 c'2 |
	a'8 g'8 bes'8 a'8 d'4. e'8 |
	g'4 f'4 cis'4 d'4 |
	e'2. g'4 |
	a'8 d'8 ~ d'2. |
	e'2. g'4 |
	c''2. cis''4 |
	d''2. c''4 |
	f'1 |
	e'2. g'4 |
	d'1 |
	}
	d'1 ~ |
	d'1 |
	\endBar
