{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 91
	\time 4/4
	\key as \major

	\repeat volta 2 {
	\once \override NoteHead.style = #'slash bes'4 _ "(voice/gtr solo)" \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 |
	\once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 _ "(vamp till cue)" \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 |
	}
	\textMark \markup { \musicglyph "scripts.segno" } \mark \markup { \box { A } } r4 ^ "(On Cue)" f'8 g'8 as'8 bes'4 c''8 ~ |
	c''8 g''4 f''8 ~ f''4 c''8 bes'8 |
	as'4. bes'8 c''4 as'8 f'8 ~ |
	f'2 r2 |
	r4 r8 as'8 as'8 g'8 as'8 es''8 ~ |
	es''2. es''8 c''8 ~ |
	c''2 r2 |
	R1 |
	r8 c'8 f'8 g'8 as'8 bes'4 c''8 ~ |
	c''8 g''4 f''8 ~ f''8 ces''8 bes'8 as'8 ~ |
	as'4 bes'8 c''8 ~ c''8 as'4 f'8 ~ |
	f'2 r4 c'8 f'8 ~ |
	f'2 r8 as'8 bes'8 ces''8 ~ |
	ces''8 bes'8 ~ bes'2 as'8 f'8 ~ |
	f'1 |
	r2 r4 r4 |
	\mark \markup { \box { B } } r4 des''8 es''8 f''4 ges''8 f''8 ~ |
	f''4 es''8 des''8 ~ des''4 es''8 f''8 ~ |
	f''8 as'8 f'8 as'8 ~ as'2 |
	R1 |
	r8 as'8 des''8 es''8 f''4 ges''8 f''8 ~ |
	f''8 es''4. des''4 as''8 as''8 |
	f''1 |
	r2 r4 r8 f''8 |
	d''4 e''8 f''8 ~ f''4 g''8 as''8 ~ |
	as''8 g''4. r8 g''8 f''8 g''8 ~ |
	g''4 g'8 g'8 ~ g'8 g'8 e'8 g'8 ~ |
	g'2 r4 g'8 bes'8 ~ |
	bes'2 r4 g'8 b'8 ~ |
	b'2 r4 g'8 c''8 ~ |
	c''4 d''8 bes'8 ~ bes'4 c''8 g'8 ~ |
	g'4 r4 r2 ^ "D.S. al Coda" |
	\textMark \markup { \musicglyph "scripts.coda" } f''1 |
	R1 |
	\repeat volta 2 {
	\once \override NoteHead.style = #'slash bes'4 ^ "(Solo - Funkier)" _ "Solo on vamp or on head (ABA); after solos, play head, take Coda, vamp, solo & fade" \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 |
	\once \override NoteHead.style = #'slash bes'4 ^ "(Vamp till cue)" \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 |
	}
	\endBar
}
