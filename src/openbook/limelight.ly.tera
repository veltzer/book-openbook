{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2 bes4 aes | g2 f | e:m7 a:7.9- | d:m7 g:7 | \myEndLine
		c1 | c:m7 | d2:m c |
	} \alternative {
		{
			f2:7.9- fis:dim7 | \myEndLineVoltaNotLast
		}
		{
			f2:7.9- fis:dim7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	e1*2:7 | a1*2:m | \myEndLine
	d1*2:7 | g2:7 g:7.5+ | g1:7.5+ | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c2 bes4 aes | g2 f | e:m7 a:7 | d1:m7 | \myEndLine
	c1 | f2:7.9- fis:dim7 | c1 | s4 d:m7.5+ g:7 g:m7 | \myEndLine
	s2 c:7 | f:7.9- fis:dim7 | s2 d4:m7 g8:7 c | s1 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	s2 c:7 | f2.:7.9- g4:m7 | s2 c:7 | f:7.9- fis:dim7 | s2 d4:m7 g8:7 c | \myEndLine
	\endPart

	\endSong
	\endChords
