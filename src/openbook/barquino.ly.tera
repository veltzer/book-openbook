{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	bes1*2:maj | e2:m7.5- a:7 | e2:m7.5- a:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	aes1*2:maj | d2:m7.5- g:7 | d2:m7.5- g:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	ges1*2:maj | c2:m7.5- f:7 | c2:m7.5- f:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	d1:m7 | g:7.9- | c:m7 | f:7.9- | \myEndLine
	\endPart

	\myMark "End"
	\startPart
	d1:m7 | g:7.9- | c:m7 | f:7.9- | \myEndLine
	d1:m7 | g:7.9- | c:m7 | f:7.9- | bes:maj | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Bossa Nova" 4 = 144
	\time 4/4
	\key bes \major

	% part "A"
	a'8 bes4 a8 c4 a8 bes ~ | bes a c4 b bes | a8 a a a a4 ees8 e | a8 a a a a2 |

	% part "A"
	g8 aes4 g8 bes4 g8 aes ~ | aes g bes4 a aes | g8 g g g g4 cis,8 d | g8 g g g g2 |

	% part "A"
	f8 ges4 g8 aes4 f8 ges ~ | ges f aes4 g ges | f8 f f f f4 b,8 c | f2 r8 c'4 bes8 |

	% part "B"
	f2. g4 | aes2 ~ aes8 ees'4 d8 | ees,2. f4 | ges2. r4 |

	% part "End"
	r1 | r1 | r1 | r1 |
	r1 | r1 | r1 | r1 | r1\fermata |
}
{% endif %}
