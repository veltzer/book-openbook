	\times 2/3 { as'8 es'8 g'8 ~ } g'2 es'4 |
	r8 es''8 ~ es''8 des''8 bes'8 as'8 ges'8 es'8 |
	<fis' a'>8 <fis' a'>8 ^ "pedal" <f' as'>8 <f' as'>8 <es' ges'>4 <c' es'>8 ^\markup{ \italic {last time} } bes8 \mark \markup { \musicglyph "scripts.coda" } |
	des'4 bes4 des'8 _\prall bes8 d'8 es'8 |
	} \alternative {
	{
	r8 g'8 ges'8 f'8 r8 g'8 as'8 bes'8 |
