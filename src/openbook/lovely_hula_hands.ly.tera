	f''4 f''4 d''8 c''8 bes'8 g'8 |
	bes'4 f'4 es'8 f'8 a'8 c''8 |
	bes'1 |
	d'8 d'8 es'8 d'8 bes'4 a'4 |
	d''4 d''4 bes'8 a'8 fis'8 d'8 |
	g'1 |
