	f2 c2:7 | \myEndLineVoltaNotLast
	}
	{
	f1 | \myEndLineVoltaLast
	}
	}
	f1:7 |
	s1 |
	bes2 f2:7 | \myEndLine
	bes1 |
	d1:7 |
	s1 |
	g1:m | \myEndLine
	c1:7 |
	f1 |
	s1 |
	g2:m7 c2:7 | \myEndLine
	g1:m7 |
	c1:7 |
	s1 |
	f2 c2:7 | \myEndLine
	f1 |
	\endBar
	\endPart

	\endSong
