{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	f1 |
	s1 |
	g2:m7 c2:7 |
	g1:m7 | \myEndLine
	c1:7 |
	s1 |
	f2 c2:7 |
	} \alternative {
