{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 16*5 s16*5 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1 | c | c | c:7 | \myEndLine
		f1:7 | f:7 | c | c | \myEndLine
		g1:7 | f2 g:7 | c1 | c | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c1 | c | c:7 | c:7 | \myEndLine
		f1 | f:7 | c | c | \myEndLine
		g1:7 | g:7 | c4 c:7/bes f/a f:m/aes | c4/g g:7 c2 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		c1 | c | c | c:7 | \myEndLine
		f1 | f | c | c | \myEndLine
		g1:7 | g:7 | c | c | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c1 | c | c:7 | c:7 | \myEndLine
		f1 | f:7 | c | c | \myEndLine
		g1:7 | g:7 |
	} \alternative {
