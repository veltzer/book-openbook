			c1 | g:7 | \myEndLineVoltaNotLast
		}
		{
			c4 c:7/bes f/a f:m/aes | c4/g g:7 c2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
