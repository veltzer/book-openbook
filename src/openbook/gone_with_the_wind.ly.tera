{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f2:m7 bes:7 | ees:maj9 ees:6 | f:m7 bes:7 | ees:maj7 ees:6 | \myEndLine
		a:m7 d:7 | g1 | a2:m7 d:7 | g:maj9 g:6 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1:m7 | c:dim | f2:m7 bes2*3:7 | \myEndLine
		ees2 des:9 | c1:7.9- | f:m7 | f2.:m7/bes bes4:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f2:m7 bes:7 | ees:maj7 ees:6 | f:m7 bes:7 | ees:maj9 ees:6 | \myEndLine
		a:m7 d:7 | g1 | a2:m7 d:7 | g:maj9 g:6 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		f1:m7 | c:m7 | f2:m6 bes:7 | c1:7 | \myEndLine
		f:m7 | des2:9 e:9.11+ |
	} \alternative {
		{
			ees2:maj9 c:9 | b:9 bes:9 | \myEndLineVoltaNotLast
		}
		{
			ees1*2:maj9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
