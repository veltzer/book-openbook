{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g1*4 | \myEndLine
		g1 | g2 gis2:dim7 | d4:7/a d2.:7 | d1:7 | \myEndLine

		\myMark "B"
		d1*4:7 | \myEndLine
		d1:7 | d2:7 d2:9.5+ | g1*2 | \myEndLine

		\myMark "A"
		g1*4 | \myEndLine
		g1 | g2 b2:dim | a2:m e2:7 | a1:m | \myEndLine

		\myMark "C"
		c1 | cis1:dim7 | g1/d | e1:7 | \myEndLine
		a1:7 | d2:9 d2:7 | \myEndLine
	} \alternative {
		{
			g1 | a2:7 d2:7 | \myEndLineVoltaNotLast
		}
		{
			g1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 2 = 112
	\time 2/2
	\key g \major

	\repeat volta 2 {
		% part "A"
		d4 e2 g4 | b4. ais8 b4 d | d,4 e2 g4 | b1 |
		d,4 e2 g4 | b2 d | d4 fis,2.~ | fis1 |

		% part "B"
		d4 fis2 a4 | c4 b c d | d,4 fis2 a4 | c1 |
		d,4 fis2 a4 | d2 e | e4 b2.~ | b1 |

		% part "A"
		d,4 e2 g4 | b4. ais8 b4 d | d,4 e2 g4 | b2. d,4 |
		d4 d g b | d2 f | e1~ | e2. g,4 |

		% part "C"
		g4 g2 g4 | a2 g | d'4 d2 e4 | b2. b4 |
		b4 a gis a | c2 b |
	} \alternative {
		{
			g1~ | g4 r r2 |
		}
		{
			g1~ | g4 r r2 |
		}
	}
}
{% endif %}
