{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1*3 | ees1:7 | \myEndLine
		aes1 | aes:7 | ees1*2 | \myEndLine
		bes1*2:7 |
	} \alternative {
		{
			ees2 aes:9 | ees bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 100
	\time 4/4
	\key ees \major

	\partial 4 c'4 |

	% part "A"
	\repeat volta 2 {
		\tuplet 3/2 { bes8 fis g } ees2 g8 g | ees bes \tuplet 3/2 { c bes c } bes4 c'8 c | \tuplet 3/2 { bes g ees~ } ees g ees4 bes8 des~ | des4 c' bes ges |
		r4 c,8 f16 f ees4 f | r4 ges8 f ees4 c8 bes~ | bes1~ | bes2. c'8 g |
		bes4. g16 g bes4 c | r4 g8 bes bes, c ees4 |
	} \alternative {
		{
			ees1~ | ees2. c'8 bes |
		}
		{
			ees,1~ | ees2. r4 |
		}
	}
}
{% endif %}
