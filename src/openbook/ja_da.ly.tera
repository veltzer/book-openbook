{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	f2. f4:7 |
	d1:7 |
	g2:9 c2:7 |
	f2 c4:dim c8:7 c8:aug7 | \myEndLine
	f2. f4:7 |
	d1:7 |
	g2.:9 g4:7.9- |
	c2:7 g4:m7 c4:7.9- | \myEndLine
	f2 f2:dim |
	c1:7 |
	f2 f2:dim |
	c1:7 | \myEndLine
	f2. f4:7 |
	d1:7 |
	g2:9 c2:7 |
	} \alternative {
	{
	f2 c4:dim c8:7 c8:aug7 | \myEndLineVoltaNotLast
	}
	{
	f1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Swing" 4 = 144
	\time 2/2
	\key f \major

	\repeat volta 2 {
	a'8 c''4. ~ c''4 r4 |
	d''8 a'4. ~ a'4 r4 |
	a'8 g'8 a'8 g'8 c''4 a'4 |
	f'2. r4 |
	a'8 c''4. ~ c''4 r4 |
	d''8 a'4. ~ a'4 r4 |
	a'8 g'8 a'8 g'8 a'4 as'4 |
	g'2. r4 |
	c''8 c''8 c''8 c''8 b'8 b'8 b'8 b'8 |
	bes'8 a'8 bes'8 g'8 ~ g'4 r4 |
	c''4 c''4 b'8 b'8 b'8 b'8 |
	bes'8 a'8 bes'8 g'8 ~ g'8 f'8 g'4 |
	a'8 c''4. ~ c''4 r4 |
	d''8 a'4. ~ a'4 r4 |
	a'8 g'8 a'8 g'8 c''4 a'4 |
	} \alternative {
	{
	f'2. r4 |
	}
	{
	f'2. r4 |
	}
	}
	\endBar
}
