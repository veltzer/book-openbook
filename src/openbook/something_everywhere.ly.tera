	% part "B"
	c4.^\markup { \musicglyph #"scripts.segno" } aes8~ aes f4 des'8~ | des c4 g8 e2 | ees4. bes'8~ \tuplet 3/2 { bes4 bes bes } | \tuplet 3/2 { bes4 c bes } aes4 bes8 c~ | c1 | \tuplet 3/2 { a4 gis a } g4 f8 e~ | e2 cis4 e |
	fis2 d4 fis | gis1~ | gis1 | r1 | r1 | e8 e4 e8 e4 e8 e~ | e2 <e c'>4 <d b'> | e8 e4 e8 e4 e8 e~ | e2 a |
	gis2 f4. e8~ | e2 cis4 e | fis2^\markup { To Coda \musicglyph #"scripts.coda" } d4 fis | g1~ | g1 | r1 | r1 |
	\repeat volta 2 {
		\improvisationOn b4^\markup { ad lib } b b b | b b b b \improvisationOff |
	}
	r8 c, des ees f g aes bes^\markup { D.S. al Coda } |

