{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	r1 | s1*4 | \myEndLine
	s1*7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	ees1*4:m11 | f1*4:m11 | \myEndLine
	ees1*4:m11 | f1*3:m11 | d1:7.5- | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	f1:m7 | c:7.9-/e | ees:m7 | d:7.5+.9+ | des:maj7 | c:7 | cis:7.9+ | \myEndLine
	ees:maj7.9+ | b1*4:13sus4 | e1*2:m | d1:m9 | cis:7.5+.9+ | \myEndLine
	d2:7.9+.11+ g4.:m7.5- a8:maj7 | a1:maj7 | d:maj7 | bes1*4:13sus4 | \myEndLine
	\repeat volta 2 {
		bes1*2:13sus4 |
	}
	s1 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	ees1*4:m7 | d1*4:m7 | \myEndLine
	\repeat volta 2 {
		ees1*4:m7 | d1*4:m7 |
	}
	cis1:m11 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
