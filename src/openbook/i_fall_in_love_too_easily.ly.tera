		d2:m7.5- g:7.9- | c:m7 c:m7/bes | a:m7.5- d:7 | g1:7 | \myEndLine
		a2:m7.5- d:7 | g1:7 | g2:m7.5- c:7 | f1:m7 | \myEndLine
		f2:m7 bes:9 | g:m7 c:7 | f:m7 bes:7 |
	} \alternative {
		{
			ees2:6 g4:m7.5- c:7 | \myEndLineVoltaNotLast
		}
		{
			ees1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
