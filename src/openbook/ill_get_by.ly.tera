		\endPart

		\myMark "B"
		\startPart
		g1:7 | g2:7 ees:dim7 | g:7/d g:7 | g:7 g:7.5+ | \myEndLine
		c2 cis:dim7 | d:m7 g:9 | c1:6 | c2:6 g:7.9- | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		c2:maj7 b:m7 | b:m7 e:7.5+ | f1:6 | f2:6 a:7.9-/e | \myEndLine
		d2:m7 e:7.9- | e1:7.9- | a2:m a:7 | a:7 a:7.5+ | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		d1:m7 | d2:m7 g:7.9- |

	} \alternative {
