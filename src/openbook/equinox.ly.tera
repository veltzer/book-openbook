{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1*4:m7 | \myEndLine
		f1*2:m7 | c1*2:m7 | \myEndLine
		aes1:7 | g:7 | c:m7 |
	} \alternative {
		{
			c1:m7 | \myEndLineVoltaNotLast
		}
		{
			c1:m7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 100
	\time 4/4
	\key c \minor

	\partial 8 g'8 |

	% part "A"
	\repeat volta 2 {
		ees'4. c8~ c2~ | c2. c8 g | ees' c~ c2~ c8 g | c ees r4 r r8 ees |
		f4. c8~ c2~ | c2.. f8 | ees4. c8~ c4. g8 | c ees r4 r2 |
		r8 d r4 d4. c8 | d4. c8 ees c ees4 | c1~ |
	} \alternative {
		{
			c2.~ c8 g |
		}
		{
			c1\fermata |
		}
	}
}
{% endif %}
