{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1 | g2:m7 c:7 | f1:7 | c2:m7 f:7 | \myEndLine
		bes1*2:7 | f1*2 | \myEndLine
		g1:m7 | c:7.9- | f | g2:m7 c:7 | \myEndLine
	}
	\endPart


	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 220
	\time 4/4
	\key f \major

	% part "A"
	\repeat volta 2 {
		g4 r8 c a4. bes8 | \tuplet 3/2 { c4 a bes } \tuplet 3/2 { des4 a'4. g8 } | e8 g f c bes d c c | r8 a16 bes c8 d ees f d a |
		c8 f, g aes r4 r8 f | g8 f bes a c bes ees c | r4 r8 c c2 | r8 c4 a8 bes a c bes |
		a8 f g a c4 r8 bes16 c | des8 a'~ a2 g4 | r8 e, f g a g f e | r8 e f g a g f e |
	}
}
