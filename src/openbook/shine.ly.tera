{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees1 | ees:m/ges | f:m7 | bes:7 | \myEndLine
		ees | ees:m/ges | f:m7 | bes:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g2:7 d:m7 | g1:7 | c1*2:m7 | \myEndLine
		f2:7 c:m7 | f1:7 | bes1*2:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1 | ees:m/g | f:m7 | bes:7 | \myEndLine
		g1*2:7 | c2:m g:7 | c1:m | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		f:m7 | bes:7 | ees | c:7 | \myEndLine
		f:m7 | bes2:7 bes:7.5+ |
	} \alternative {
		{
			ees1 | f2:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees2 aes:7 | ees1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
