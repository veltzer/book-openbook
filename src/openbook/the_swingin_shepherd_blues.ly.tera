{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	r2 r8. g'16 a'8. c''16 |
	\repeat volta 2 {
	e''4 e''4 c''8. g'16 a'8. c''16 |
	e''4 e''4 c''8. g'16 a'8. c''16 |
	e''4 e''4 c''8. g'16 \times 2/3 { a'8 g'8 bes'8 ~ } |
	bes'2. r8. c''16 |
	f''8. c''16 ges''8. f''16 ~ f''8 f''4 c''8 |
	ges''8. f''16 ~ f''8. es''16 es''8. c''16 g'8. f'16 |
	e'8. c'16 e'8. c'16 f'8. c'16 fis'8. g'16 |
	g'4 r4 a'8. c''16 d''8. c''16 |
	dis''4 dis''4 c''8. g'16 f'8. g'16 |
	dis''4 dis''4 c''8. g'16 f'8. g'16 |
	} \alternative {
	{
	c''8. bes'16 ~ bes'4 a'8. as'16 as'4 |
	g'8. f'16 e'8. c'16 r8. g'16 a'8. c''16 |
	}
	{
	c''8. bes'16 ~ bes'4 a'8. as'16 ~ as'4 |
	g'8. f'16 e'8. c'16 ~ c'2 |
	}
	}
	\endBar
}
