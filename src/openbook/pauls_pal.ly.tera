{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g2:m7 c:7 | f d:m7 | g:m7 c:7 | \myEndLine
		f1 | b2:m7 e:7 | a:m7 d:7 | g:m7 c:7 |
	} \alternative {
		{
			f d:m7 | \myEndLineVoltaNotLast
		}
		{
			f d:m7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	g2:m7 c:7 | f1 | g2:m7 c:7 | f1 | \myEndLine
	b2:m7.5- e:7.9+ | a:m7 d:7.9+ | g1:m7 | c:7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	f1:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 140
	\time 4/4
	\key f \major

	\partial 2 f8 g r a |

	% part "A"
	\repeat volta 2 {
		bes4^\markup { \musicglyph #"scripts.segno" } r bes8 a r g | f4 r f8 g r a | bes4 bes8 bes bes a r g |
		f4 r a8 bes r c | d4 r \tuplet 3/2 { d4 ees e! } | a,4 r a8 bes r a | g4 r g8 a r g^\markup { To Coda \musicglyph #"scripts.coda" } |
	} \alternative {
		{
			a4 r f8 g r a |
		}
		{
			a4 r8 d r e r f |
		}
	}

	% part "B"
	g,4 g a4. f8 | r4 r8 d' r e r f | g,4 g a8 g a c | r4 r8 c r d r e |
	f2 g | e f | d~ d8 bes g f | e4 r f8 g r a^\markup { D.S. al Coda } |

	% part "Coda"
	a2 r2 |
}
{% endif %}
