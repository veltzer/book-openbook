{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\partial 4 s4 |
	\repeat volta 2 {
	bes1:7 |
	s1 |
	s1 | \myEndLine
	s1 |
	ees1:7 |
	s1 |
	bes1:7 | \myEndLine
	s1 |
	f1:7 |
	s1 |
	bes1:7 | \myEndLine
	f1:7 |
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\partial 4 f'4 |
	\repeat volta 2 {
	as'4. bes'8 ~ bes'4 f'4 |
	as'4. bes'8 ~ bes'4 f'4 |
	as'8 bes'8 as'4 bes'4 as'4 |
	r2 r4 bes'4 |
	des''4. es''8 ~ es''4 bes'4 |
	des''4. es''8 ~ es''4 f'4 |
	as'8 bes'8 as'4 bes'4 as'8 f'8 |
	r2 r4 bes'4 |
	des''4. bes'8 ~ bes'4 des''4 ~ |
	des''8 bes'4. as'8 f'8 a'8 bes'8 |
	R1 |
	R1 |
	}
	\endBar
}
{% endif %}
