{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		aes4 a:dim7 | ees:7/bes ees:7 | aes a:dim7 | ees:7/bes ees | \myEndLine
		fes4 ees | fes ees | r2 | r2 | \myEndLine
		d2:dim7 | aes/ees | fes4 aes/ees | ees:7 aes | \myEndLine
		d2:dim7 | aes/ees | fes4 aes/ees | ees:7 aes | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		ees4:7/bes ees | ees2 | aes | aes4 f | \myEndLine
		ees4:7/bes ees:7 | ees:7 d:dim7 | aes2 | aes4 f | \myEndLine
		ees4/bes ees | ees2 | aes | aes4:7 g8 ges:7 | \myEndLine
		f2 | bes:m | bes4:9 ees:7 |
	} \alternative {
		{
			aes4 a:dim | \myEndLineVoltaNotLast
		}
		{
			aes4 ees:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "Coda"
	\startPart
	ees4:7 aes | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	\repeat volta 2 {
		aes4:7/ees aes:7 | aes2:7 | des | des | \myEndLine
		aes2:7 | aes:7 | des | des4 f:7 | \myEndLine
		bes2:7 | bes:7 | ees:m | ees:m | \myEndLine
		g2:dim7 | des4/aes bes:7 | ees:7 aes:7 |
	} \alternative {
		{
			des4 d:dim7 | \myEndLineVoltaNotLast
		}
		{
			des2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "D"
	\startPart
	\repeat volta 2 {
		des2 | des4 b:dim | aes2 | aes4 f | \myEndLine
		ees4:7/bes ees:7 | ees2:7 | aes | aes | \myEndLine
		des2 | des4 d:dim7 | aes2 | aes | \myEndLine
		des4 des:m | aes2 | bes4:7 ees:7 |
	} \alternative {
		{
			aes2 | \myEndLineVoltaNotLast
		}
		{
			aes8 ees:7 aes4 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
