		c2. bes4~ | bes4 c2 bes4 | c1 | bes2. r4 | r4 bes2 aes4 |
	} \alternative {
		{
			f2 ees4 c~ | c1~ | c2. r4 |
		}
		{
			f2 ees4 f~ | f1~ | f4 r ees f |
		}
	}

	% part "B"
	aes2 aes4 aes~ | aes2. f4 | aes2 aes4 aes~ | aes4 r r2 | f2 f4 f~ | f2. ees4 | f2 f4 f~ | f4 r r2 |
	bes2 bes4 bes~ | bes2. g4 | bes2 bes4 bes~ | bes4 r r2 | r4 ees,2 ees4 | ees4. ees8~ ees4 ees | ees ees ees ees~ | ees4 r r2 |

	% part "A"
	r4 c2 d4 | f2 aes4 c~ | c1~ | c2. r4 | bes1 | aes1 | bes1 | c2. r4 |
	c2. bes4~ | bes4 c2 bes4 | c1 | bes2. r4 |
	r4 c2 bes4 | aes2 f4 ees~ | ees1~ | ees4 r f2 | aes2. c4~ | c2. bes4 | aes1~ | aes2. r4 |
}
