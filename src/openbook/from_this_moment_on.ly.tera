{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1:m | d:m7.5- | g:m7 | c:7 | bes:m6 | f:m | ees:m7 | aes:7 | \myEndLine
		des1*2:maj7 | ges1*2:9 | aes1 |
	} \alternative {
		{
			aes1:dim7 | g:m7 | c:7 | \myEndLineVoltaNotLast
		}
		{
			bes2:m7 ees:7 | aes1*2:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	des1*2 | ges1*2:9 | aes1 | aes2. ees4:m7/ges | f1*2:7 | \myEndLine
	ees1*2/bes | bes1*2:7 | ees1:7 | ees:dim7 | ees:7 | c:7.9+ | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f1:m | d:m7.5- | g:m7 | c:7 | bes:m6 | f:m | ees:m7 | aes:7 | \myEndLine
	des1*2 | des1:m7 | ges:9 | \myEndLine
	aes1 | b:dim7 | c:m7 | s2 f:7 | bes2.:7 bes4:m7/ees | s2. ees4:7 | aes1*2 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
