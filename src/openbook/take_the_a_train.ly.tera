{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1*2:6 | d:7.5- | \myEndLine
		d1:m7 | g:7 | c |
	} \alternative {
		{
			c | \myEndLineVoltaNotLast
		}
		{
			c | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f1*4:maj7 | \myEndLine
	d1*2:7 | d2:m9 g:9 | g:9 des:9 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1*2:6 | d:7.5- | \myEndLine
	d1:m7 | g:7 | c8 c:7/e f4 aes2:7/ges | c4/g g:9 c:6 c:maj7.9 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 168
	\time 4/4
	\key c \major

	% part "A"
	\repeat volta 2 {
		g'1~ | g8 e'4. g,4 c | e8 aes,~ aes2.~ | aes1 |
		a! | a8 bes b e g, fis f cis' | c! e,~ e2.~ |
	} \alternative {
		{
			e1 |
		}
		{
			e2\repeatTie r |
		}
	}

	% part "B"
	a8 c~ c2. | e8 f,4. a4 c | e8 a,4.~ a2~ | a1 |
	a8 c~ c2. | e4 fis, a c | e8 a,~ a2.~ | a2 aes |

	% part "A"
	g1~ | g8 e'4. g,4 c | e8 aes,~ aes2.~ | aes1 |
	a! | a8 bes b e g, fis f cis' | c! e,~ e2.~ | e2 r2 |
	% These small cue notes were in the fake book, but splitting the voices
	% breaks the tie from the previous measure. Maybe some can find a fix?
	%<< { \teeny g8 a_\markup { \italic "(Instrumental)" } b c~ c4 c, } \\ { \normalsize e2 r2 } >> |
}
{% endif %}
{% if part == "LyricsFake" %}\lyricmode {

	% part "A"
	You __ must take the "\"A\"" Train __ To go to Sug -- ar Hill way up in Har -- lem. __
	_

	% part "B"
	Hur -- ry, __ get on now it's com -- ing. __ Lis -- ten __ to those rails a --
	thrum -- ming. __ All

	% part "A"
	'board! __ Get on the "\"A\"" Train, __ soon
	you will be on Sug -- ar Hill in Har -- lem. __
}
{% endif %}
{% if part == "LyricsmoreFake" %}\lyricmode {

	% part "A"
	If __ you miss the "\"A\"" Train, __ You'll find you've missed the quick -- est way to Har -- lem. __
}
{% endif %}
{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	c2/+g aes:7.5+/ges | c/+g aes:7.5+/ges | c/+g aes:7.5+/ges | c/+g aes:7.5+/ges | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1*2:6 | d1*2:9.11+ | \myEndLine
	d1:m7 | g:7 | c:6 | d2:m7 g:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1*2:6 | d1*2:9.11+ | \myEndLine
	d1:m7 | g:7 | c:6 | c:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	g1*4:maj7 | \myEndLine
	d1*2:9 | d1:m9 | g2:9 g:9- | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1*2:6 | d1*2:9.11+ | \myEndLine
	d1:m7 | g:7 | c:6 | d2:m7 g:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Allegro" 4 = 168
	\time 4/4
	\key c \major

	% part "Intro"
	r8 e' ~ e \tuplet 3/2 { d16 c bes } aes2 | e'4 ~ e8 \tuplet 3/2 { d16 c bes } aes8 aes r4 |
	r8 e' ~ e \tuplet 3/2 { d16 c bes } aes2 | e'4 ~ e8 \tuplet 3/2 { d16 c bes } aes8 aes r4 |

	% part "A"
	\repeat unfold 2 {
		g1 ~ | g8 e'4. g,4 c | e8 gis, ~ gis2. ~ | gis1 |
		a1 | a8 ais b e g, ges f des' | c e, ~ e2. ~ | e1 |
	}

	% part "B"
	a8 c ~ c2. | e8 f,4. a4 c | e8 a, ~ a2. ~ | a1 |
	a8 c ~ c2. | e8 fis,4. a4 c | e8 a, ~ a2. ~ | a2 aes |

	% part "A"
	g1 ~ | g8 e'4. g,4 c | e8 gis, ~ gis2. ~ | gis1 |
	a1 | a8 ais b e g, ges f des' | c e, ~ e2. ~ | e1 |
}
{% endif %}
