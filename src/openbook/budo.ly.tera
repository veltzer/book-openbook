{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1 | ees:7 | bes | bes:7 | \myEndLine
		ees1*2:7 | bes2 c:m7 | d:m7 g:7 | \myEndLine
		c1:m7 | f:7 | bes1*2 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 160
	\time 4/4
	\key bes \major

	% part "A"
	\repeat volta 2 {
		f'8 f e4 ees d | f4. d8 bes f a bes | r1 | r1 |
		f'8 f e4 ees d | f4. d8 bes f a bes | r1 | r1 |
		f'8 f e4 ees d | f4. d8 bes f a bes | r1 | r1 |
	}
}
{% endif %}
