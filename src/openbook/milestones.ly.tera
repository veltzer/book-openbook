		g1*4:m7 | \myEndLine
		g1*2:m7 |
	} \alternative {
		{
			f1*2:maj7 | \myEndLineVoltaNotLast
		}
		{
			f1*2:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	a1*4:m | \myEndLine
	a1*4:m | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	a1*4:m | \myEndLine
	a1*4:m | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	g1*4:m7 | \myEndLine
	g1*2:m7 | f1*2:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
