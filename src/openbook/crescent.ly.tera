	\tempo "Adagio" 4 = 70
	\time 4/4
	\key c \major

	% part "Intro"
	g''2~^\markup { Rubato } g8 f ees d | aes'2~ aes8 g bes aes | g4 f \tuplet 3/2 { d8 f d } c4 | aes8 c aes g f d f g |
	f4 bes aes2 | c8 d f g bes g bes4~ | bes8 aes g f d'4.\fermata c8 | bes8 a ees4 \tuplet 3/2 { a8 g e! } \tuplet 3/2 { g e d } |
	\tuplet 3/2 { c8 f ees } \tuplet 3/2 { d c a } \tuplet 3/2 { g ees d } \tuplet 3/2 { c a c } | d8 f g a c a c4 | a4 f' d2 |

	\repeat volta 2 {

		% part "A"
		bes'2^\markup { A Tempo } a | g2. \tuplet 3/2 { g8 a g } | aes2 g | ees2. \tuplet 3/2 { r8 ees ees } |
		ees2 g | ges aes | a! a | c2. \tuplet 3/2 { r8 c bes } |

		% part "A'"
		bes2 a | g2. \tuplet 3/2 { g8 a g } | aes2 g | ees2. ees4 |
		ees2 g | g bes4. bes8 | c4 g f ees | c1^\markup { \italic { Fine } } |

	}

	% part "Instr"
	r1^\markup { Double X } | r1 | r1 | r1 |
	r1 | r1 | r1 | r1 |

	% part "Instr"
	\repeat volta 2 {
		r1^\markup { Solos } | r1 | r1 | r1 |
