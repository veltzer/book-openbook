{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	bes1 |
	d1:m |
	c1:m7 | \myEndLine
	f1:7 |
	bes1 |
	d1:m |
	c1:m7 | \myEndLine
	f1:7 |
	ees1 |
	ees1:m6 |
	bes1 | \myEndLine
	c2:9 ees2:dim |
	bes2 des2:dim |
	c2:m7 f2:7 |
	bes2 b2:dim | \myEndLine
	c2:m7 f2:7 |
	bes1 |
	d1:m |
	c1:m7 | \myEndLine
	f1:7 |
	bes1 |
	d1:m |
	c1:m7 | \myEndLine
	f1:7 |
	ees1 |
	ees1:m6 |
	bes1 | \myEndLine
	g1:m |
	c1:9 |
	c2:m7 f2:7 |
	} \alternative {
	{
	bes2 g2:m | \myEndLine
	c2:m7 f2:7 | \myEndLineVoltaNotLast
	}
	{
	bes1 | \myEndLineVoltaLast
	}
	}
	g1:m |
	c2:m7 f2:7 | \myEndLine
	s2 bes2 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	r2 r4 d'8 d'8 |
	\repeat volta 2 {
	d'4. d'8 d'8 d'8 d'8 d'8 |
	f'4 d'2 d'8 f'8 |
	es'1 ~ |
	es'2. d'8 d'8 |
	d'4. d'8 d'8 d'8 d'8 d'8 |
	f'4 d'2 f'8 a'8 |
	g'1 ~ |
	g'2. g'8 a'8 |
	bes'4 bes'8 bes'8 bes'4 bes'8 bes'8 |
	bes'4 bes'8 bes'8 c''4 bes'8 c''8 |
	d''2 d''2 |
	r4 c''8 bes'8 c''2 |
	r4 bes'8 a'8 bes'2 |
	r4 a'8 g'8 a'4. f'8 |
	g'4. f'8 g'4. d'8 |
	f'4 f'8 es'8 f'4 d'8 d'8 |
	d'4. d'8 d'8 d'8 d'8 d'8 |
	f'4 d'2 d'8 f'8 |
	es'1 ~ |
	es'2. d'8 d'8 |
	d'4. d'8 d'8 d'8 d'8 d'8 |
	f'4 d'2 f'8 a'8 |
	g'1 ~ |
	g'2. g'8 a'8 |
	bes'4 bes'8 bes'8 bes'4 bes'8 bes'8 |
	bes'4 bes'8 bes'8 c''4 bes'8 c''8 |
	d''2 d''2 |
	r4 bes'8 c''8 d''2 |
	r4 bes'8 c''8 d''2 |
	r4 bes'8 c''8 d''4 d''4 |
	} \alternative {
	{
	bes'1 ~ |
	bes'2 r4 d'8 d'8 |
	}
	{
	bes'2 \times 2/3 { a'4 bes'4 c''4 } |
	}
	}
	bes'2 \times 2/3 { a'4 bes'4 c''4 } |
	bes'2 \times 2/3 { c''4 d''4 c''4 } |
	d''4. ^\fermata c''8 bes'2 ^\fermata |
	\endBar
}
{% endif %}
