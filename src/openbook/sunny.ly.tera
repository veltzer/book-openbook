{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	a1:m7 |
	g2:m7 c2 |
	f1:maj7 |
	b2:m7 e2 | \myEndLine
	a1:m7 |
	g2:m7 c2 |
	f1:maj7 |
	b2:m7 e2 | \myEndLine
	a1:m7 |
	g2:m7 c2 |
	f1:maj7 |
	bes1 | \myEndLine
	b1:m7.5- |
	e1:7.9+ |
	a1:m7 |
	e1:7.9+ | \myEndLine
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	\repeat volta 2 {
	e'4. e'8 ~ e'2 ~ |
	e'2 c''8 a'8 g'8 e'8 |
	d'4 c'8 a8 c'8 d'4 e'8 ~ |
	e'2. r4 |
	e'4. e'8 ~ e'2 ~ |
	e'2 c''8 a'8 g'8 e'8 |
	d'4 c'8 a8 c'8 d'4 e'8 ~ |
	e'2. e'8 d'8 |
	e'8 c'8 d'8 c'8 ~ c'4 d'4 |
	e'8 c'8 d'8 c'8 ~ c'4. d'8 |
	e'8 d'4 c'8 ~ c'4 d'8 c'8 |
	e'8 c'8 d'8 c'8 ~ c'4. r8 |
	r4 e'8 e'8 e'8 e'4 d'8 ~ |
	d'4 r4 d'8 d'4 c'8 ~ |
	c'2. r4 |
	R1 |
	}
	\endBar
}
{% endif %}
