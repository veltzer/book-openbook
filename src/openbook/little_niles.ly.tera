		g2.*2:m9 | ees2.:7 | d:7 | g2.*2:m9 | ees2.:7 | \myEndLine
		d2.:7 | g:m | g2.*2:m5+ | g2.:m6 | \myEndLine
		g2.:m5+ | b:7.5- | e:7 | a:7.5- | d:7 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		des2.*4:7.9+ | \myEndLine
	}
	\repeat volta 2 {
		d2.*4:7.9+ | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	g2.*2:m9 | ees2.:7 | d:7 | g2.*2:m9 | ees2.:7 | \myEndLine
	d2.:7 | g:m | g2.*2:m5+ | g2.:m6 | \myEndLine
	g2.:m5+ |
	\repeat volta 2 {
		b2.:7.5- | e:7 | a:7.5- | d:7 | \myEndLine
	}
	\endPart

	\endSong
