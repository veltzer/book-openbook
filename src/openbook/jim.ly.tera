{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1:maj7 | f2:maj7 f:m | c1:maj7 | c2/e ees:dim7 | \myEndLine
		d1:m7 | g:7 | c2 cis:dim7 | d:m7 g:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1:maj7 | f2:maj7 f:m | c1:maj7 | c2/e ees:dim7 | \myEndLine
		d1:m7 | d2:m7 g:7 | g1:m7 | g2:m7 g:m7/f | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		e1:7 | a:m | e:7 | a:m | \myEndLine
		d:7 | g | d:7 | g:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1:maj7 | f2:maj7 f:m | c1:maj7 | c2/e ees:dim7 | \myEndLine
		d1:m7 | d2:m7 g:7.9- |
	} \alternative {
		{
			c2 a:m7 | d:m7 g:7 | \myEndLineVoltaNotLast
		}
		{
			c2 d4:m7 g:7sus4 | c1:6.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
