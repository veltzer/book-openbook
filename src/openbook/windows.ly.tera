	f:maj | s | f:5.7+.11+ | s | s | s | s | s | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	a:7 | bes:7 | a:7 | bes:7 | a:7 | bes:7 | a:7 | s | \myEndLine
	f:maj | e:m7 | d:m7 | d:m7/c | b:3-.5-.7 | b:3-.5-.7/a | e:7/gis | e:5+.7 | \myEndLine
	a:m7 | a:m7/g | d:7/fis | d:7 | f:maj | e:m7 | d:m7 | des:5.7+.11+ | \myEndLine
