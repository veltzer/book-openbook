{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		aes2:maj7 f:m7 | bes:m7 ees:7 | c:m7 f:m7 | bes:m7 ees:7 | \myEndLine
		aes1:7 | des2 d:dim | aes ees:7 |
	} \alternative {
		{
			f2:7 bes4:m7 ees:7 | \myEndLineVoltaNotLast
		}
		{
			aes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	c1*2:7 | f1*2:7 | \myEndLine
	bes1*2:7 | ees1*2:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	aes2:maj7 f:m7 | bes:m7 ees:7 | c:m7 f:m7 | bes:m7 ees:7 | \myEndLine
	aes1:7 | des | aes2 ees:7 | aes1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
