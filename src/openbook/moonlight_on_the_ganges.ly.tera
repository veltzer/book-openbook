{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		g2:9 fis:9 | fis2:9 f4:9 e:9 | ees2:9 d:9 | d2:9.5- g:7.5+ | \myEndLine
		c2:6 c:maj7 | c2:maj7 c:7 | c1:6 | c1:6 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		d1:m7 | d1:m7 | g1:7 | g2:7 gis:dim7 | \myEndLine
		a1:m | d1:7 | g1:7sus4 | g1:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		g2:9 fis:9 | fis2:9 f4:9 e:9 | ees2:9 d:9 | d2:9.5- g:7.5+ | \myEndLine
		c1 | c2 c:7.5+ | f2:6 c:aug | f1:6 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		fis2:m7.5- f:dim7 | c2/e ees:dim7 | g1:7 | a1:7 | \myEndLine
		d1:m7 | g1:7 |
	} \alternative {
		{
			c2 f:7 | e2:9 ees:9 | \myEndLineVoltaNotLast
		}
		{
			c2 ees:9 | aes4:7 g:7 c2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
