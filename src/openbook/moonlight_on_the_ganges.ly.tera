		% part "B"
		c2 a~ | a2 c4 a | e4 g e2~ | e2 d4 e |
		c2 d4 e | a2 b | g1~ | g1 |

		% part "A"
		a2 gis~ | gis2 g!4 fis | f!2 e~ | e2 dis |
		e2 g~ | g2 c | d1~ | d2 c4 d |

		% part "C"
		e2 d~ | d2 c4 a | b2 a~ | a2 dis,4 e |
		g4 f c' f, | e2 e |
	} \alternative {
		{
			c2. r4 | r1 |
		}
		{
			c1~ | c4 r r2 |
		}
	}
}
{% endif %}
