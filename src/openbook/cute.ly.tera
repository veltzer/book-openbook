	d1:m7 | g:9 | g2:m7 c:7 | g:m7 c:9 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	f1:maj7 | bes:9 | c | a:m7 | \myEndLine
	fis:m7.5- | b:7 | e:maj7 | e2:m7.5- a:7.9- | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	d1:m7 | g:9 | c:6 | e2:m7.5- a:7.9- | \myEndLine
	d1:m7 | g:9 | g2:m7 c:7 | g:m7 c:9 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	f1:maj7 | bes:9 | c | a:m7 | \myEndLine
	d:m7 | g:7.9- | c1*2:6 | \myEndLine
	\endPart

	\endSong
