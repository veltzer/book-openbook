{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\myMark "Intro"
	\startPart
	f2 bes | f1 | bes2 ees | bes c:7 | \myEndLine
	f2. des4:7 | g2:m7 ges:maj7 | f bes | f1 | \myEndLine
	\endPart

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f2 d:m7 | g:m7 g:m7/c | f bes | f1 | \myEndLine
		f1 | f | g:m7 | c:13 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f1:7.9+ | f:7 | b2:13 bes:13 | bes1:m6 | \myEndLine
		f2. d4:m7 | g2:m7 g:m7/c | f bes |
	} \alternative {
		{
			f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 2 = 110
	\time 2/2
	\key f \major

	\partial 2 c4 d |

	% part "Intro"
	f1~ | f2 f4 g | bes1~ | bes2 b!8 bes a4 |
	f8 c4. c4 des | d!2 f | f1~ | f2 c4 d |

	\repeat volta 2 {

		% part "A"
		f2 f4 f | a c f, f | f1~ | f2 a4 a |
		f2 f4 f | a c f, f | a1 | a4 c c d |

		% part "B"
		aes4 f2 f4 | a!2 f4 f | b!4. bes8~ bes2~ | bes2 f4 f |
		a8 c~ c2 a4 | f8 c4. f4 f | f1~ |
	} \alternative {
		{
			f2 c4 d |
		}
		{
			f2 r |
		}
	}
}
{% endif %}
