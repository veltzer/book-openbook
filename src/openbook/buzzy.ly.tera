{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1*4:7 | \myEndLine
		ees1*2:7 | bes1:7 | g:7 | \myEndLine
		c1:m7 | f:7 | bes:7 | c2:m7 f:7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 220
	\time 4/4
	\key bes \major

	% part "A"
	\repeat volta 2 {
		d'8 c bes a bes a4 c8~ | c bes r4 r r8 f | d' c bes a bes f g aes | r1 |
		des8 c bes a bes a4 c8~ | c bes r4 r r8 f | d' c bes a bes f g aes | r1 |
		d8 c bes a bes a4 c8~ | c bes r4 r r8 f | d' c bes a bes f g aes | r1 |
	}
}
{% endif %}
