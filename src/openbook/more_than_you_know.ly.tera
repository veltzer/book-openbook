{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees2:6 bes:7.5+ | bes:m7 ees:7 | aes:6 g4:m7.5- c:7 | f2:m7 f:m7.5- | \myEndLine
		bes:7 f:7 | f:m9 bes:7 | g:m7 c:7 | f:m7 bes:7.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees2:6 bes:7.5+ | bes:m7 ees:7 | aes:6 g4:m7.5- c:7 | f2:m7 des:9 | \myEndLine
		g:m7 c:7 | f:7 bes:7 | ees1 | a2:m7.5- d:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1:m7 | a2.:m7.5- aes4:7.5- | g1:m | g2:m c4:m7.5- f:7 | \myEndLine
		bes2 g:m7 | c:7 c4:m7/f f:7 | bes2.:7 bes4:dim7 | bes2:7 bes:7.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees2:6 bes:7.5+ | bes:m7 ees:7 | aes:6 g4:m7.5- c:7 | f2:m7 des:9 | \myEndLine
		g:m7 c:7 | f:7 bes:7 |
	} \alternative {
		{
			ees2 ges:dim7 | f:m7 bes:7.5+ | \myEndLineVoltaNotLast
		}
		{
			ees2 ces | ees1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
