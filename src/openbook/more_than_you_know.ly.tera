{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 110
	\time 4/4
	\key ees \major

	\partial 2 \tuplet 3/2 { bes'4 b c } |

	\repeat volta 2 {

		% part "A"
		c2 \tuplet 3/2 { bes4 b c } | c2 \tuplet 3/2 { bes4 b c } | ees4 c bes g | f2 \tuplet 3/2 { f4 fis g } |
		g2 \tuplet 3/2 { f4 fis g } | g2 \tuplet 3/2 { f4 fis g } | bes1~ | bes4 r \tuplet 3/2 { bes4 b c } |

		% part "A"
		c2 \tuplet 3/2 { bes4 b c } | c2 \tuplet 3/2 { bes4 b c } | ees4 c bes g | f2 \tuplet 3/2 { f4 fis g } |
		bes2 \tuplet 3/2 { bes4 b c } | ees2 f | ees1~ | ees4 r d8 c bes a! |

		% part "B"
		c4 bes8 a! g4 bes | a!8 g f ees g4 f | ees4 d2.~ | d4 r f'8 ees d c |
		ees4 d8 c bes4 d | c8 bes a! g bes4 aes | g4 f2 r4 | r2 \tuplet 3/2 { bes4 b c } |

		% part "A"
		c2 \tuplet 3/2 { bes4 b c } | c2 \tuplet 3/2 { bes4 b c } | ees4 c bes g | f2 \tuplet 3/2 { f4 ges g! } |
		bes2 \tuplet 3/2 { bes4 b c } | f2 g |
	} \alternative {
		{
			ees1~ | ees4 r \tuplet 3/2 { bes4 b c } |
		}
		{
			ees1~ | ees2. r4 |
		}
	}
}
