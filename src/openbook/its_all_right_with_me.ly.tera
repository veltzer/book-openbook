{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1*2:m | f:9 | \myEndLine
		c:m | f:m | \myEndLine
		bes2 bes2.:9 bes:7 | bes2.:m6 c4*5:9 | \myEndLine
	} \alternative {
		{
			f1..:9 f4:7 | g2 f:m6 | g f4 g:7 | \myEndLineVoltaNotLast
		}
		{
			f1:9 | f2.:m7 bes4:7 | ees1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	ees1*2:9 | ees:dim7 | \myEndLine
	a1:m/+ees | f:dim7/ees | ees1 | ees2:maj ees:6 | \myEndLine
	bes1:m6 | c:7.9- | f1*2:7 | \myEndLine
	f:m6 | g2:7 c:m6 | g f4 g:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1*2:m | f:9 | \myEndLine
	c:m | f:m | \myEndLine
	bes2 bes2.:9 bes:7 | bes2.:m6 c4*5:9 | \myEndLine
	f1..:9 f4:7 | bes2:9 g2.:m d4 f:m7 bes:7 | \myEndLine
	ees1:maj | ees2.:7 ees4:7.5+ | aes1:maj | aes:7 | \myEndLine
	f:9 | f:m7 | ees1 | g:7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	ees1*2 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Allegro" 4 = 200
	\time 4/4
	\key ees \major

	\partial 2 c4 d |

	% part "A"
	\repeat volta 2 {
		ees2 g ~ | g c,4 d | ees2 g ~ | g c,4 d |
		ees2 f4 g ~ | g ees f g | aes2 c ~ | c b4 c |
		d2 c ~ | c4 d,4 des d | c'2 ces4 bes ~ | bes2 c,4 d |
	} \alternative {
		{
			ees2 g ~ | g2. f4 | d1 ~ | d4 r c4 d |
		}
		{
			ees2 g ~ | g2. f4 | ees1 ~ | ees2 r4 ees |
		}
	}

	% part "B"
	bes'2 bes4 c | des des2 bes4 | a2 a4 bes | c2. a4 |
	aes!2 aes4 bes | ces ces2 aes4 | g1 ~ | g2 r4 ees |
	bes'2 bes4 c | des des2 bes4 | a2 a4 bes | c2. a4 |
	aes!2 aes8 aes4 aes8 | aes4 bes2 aes4 | g1 ~ | g4 r4 c, d |

	% part "A"
	ees2 g ~ | g c,4 d | ees2 g ~ | g c,4 d |
	ees2 f4 g ~ | g ees f g | aes2 c ~ | c b4 c |
	d2 c ~ | c4 d,4 des d | c'2 ces4 bes ~ | bes2 c,4 d |
	ees2 g ~ | g2. f4 | d1 ~ | d4 r ees4 f |
	g2 bes ~ | bes r4 b | c2 ees ~ | ees2. c4 | ees1 ~ | ees ~ |
	ees4 r r2 | r c,4 d |

	% part "Coda"
	ees'1 ~ | ees4 r r2 |
}
{% endif %}
