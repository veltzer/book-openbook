{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	s2. ees8. fis16:dim |
	bes2:7 f2:m7 |
	bes2.:7 bes4:aug |
	ees2. bes4:aug | \myEndLine
	} \alternative {
	{
	ees2... fis16:dim | \myEndLineVoltaNotLast
	}
	{
	ees2. bes4:7 | \myEndLineVoltaLast
	}
	}
	ees1:7 |
	aes2. des4:7 | \myEndLine
	c1:7 |
	f2:m7 bes4:7 ees8. fis16:dim |
	bes2:7 f2:m7 |
	bes1:7 | \myEndLine
	c4:7 f4:7 bes2:7 |
	ees1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	\repeat volta 2 {
	r2 r4 bes'8. c''16 |
	d''8. f''16 d''8. bes'16 as'8. c''16 as'8. g'16 |
	f'8. as'16 f'8. es'16 d'4 bes'8. b'16 |
	c''4 g'2 bes'8. b'16 |
	} \alternative {
	{
	c''4 g'2 bes'8. bes'16 |
	}
	{
	c''4 g'2 g'8. f'16 |
	}
	}
	es'8. e'16 f'8. fis'16 g'8. es''16 des''8. g'16 |
	bes'8 as'8 g'8 as'8 ~ as'4 as'8. as'16 |
	as'4 g'4 c''4 g'4 |
	f'2 r4 bes'8. c''16 |
	d''8. f''16 d''8. bes'16 as'8. c''16 as'8. g'16 |
	f'8. as'16 f'8. es'16 d'4 r4 |
	r4 es''8. c''16 d''8. c''16 bes'4 |
	es''2. r4 |
	\endBar
}
{% endif %}
