{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	e2:m7 f:7 | bes:maj7 des:7 | ges:maj7 a:7 | d1:maj7 | \myEndLine
	d2:7 ees:7 | aes:maj7 b:7 | e:maj7 g:7 | c1:maj7 | \myEndLine
	c2:m7 des:7 | ges:maj7 a:7 | d:maj7 f:7 | bes1:maj7 | \myEndLine
	e1:m7 | f:7 | bes:maj7 | ees:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Presto" 4 = 280
	\time 4/4
	\key c \major

	% part "A"
	a'2 a | a bes | des c4 bes | a1 |
	g2 g | g gis | b bes4 aes | g1 |
	d4 ees bes' aes | des2 c4 bes | a2 c | f, g |
	a1~ | a4. g8 a c a g | a1~ | a |
}
{% endif %}
