{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1 | f | b:m7 | e:7 | \myEndLine
		bes:maj7 | bes:6 | ees:9 | ees:9 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		a:m7 | d:7.9- | g:m7 | e2:m7.5- a:7.5+ | \myEndLine
		d1:m11 | g:7 | g:m7 | des4:9 c2.:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | f | b:m7 | e:7 | \myEndLine
		bes:maj7 | bes:6 | ees:9 | ees:9 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		a:m7 | d:7.9- | g:m7 | c:7.9- | \myEndLine
		f | bes:9 |
	} \alternative {
		{
			f1 | g2:m7 c:7.9- | \myEndLineVoltaNotLast
		}
		{
			f1*2:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
