{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	ees2.*2 | f2.*2:m7 | f2.*2:m9 | bes2.:13 | bes:13.9- | \myEndLine
	ees2.*2 | f2.*3:m7 | f2.:m7/ees | d:m7.5- | g:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	c2.*2:m | c2.*2:m6 | c2.*2:m | c2.*2:m7 | \myEndLine
	c2.:m | c:m/bes | a2.*2:m7.5- | aes2.:6 | f:m7 | bes:13 | bes:13.9- | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	c2.*2:m | bes2.:m7 | ees:7 | aes2.*2 | des2.*2:9 | \myEndLine
	ees2. | c:m7 | f:m7 | bes2:7 bes4:7.9- | ees2. | aes:m6 | ees2.*2:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
