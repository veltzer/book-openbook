{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1*4:6 | \myEndLine
		e1*2:6 | ees1:6 |
	} \alternative {
		{
			bes1:7 | \myEndLineVoltaNotLast
		}
		{
			ees2.:6 c4:m7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f1:m7 | f:m7/bes | g:m7 | c:m7 | \myEndLine
	f1:m7 | bes:7 | ees | c:7.9- | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	f1:m7 | f2:m7/bes bes:7 | ees1 | ees2 c:m7 | \myEndLine
	f1:m7 | bes:7 | ees:6 | f2:m7 bes:7 | ees1*2:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 160
	\time 2/2
	\key ees \major

	\partial 4 bes4 |

	% part "A"
	\repeat volta 2 {
		ees2. f4 | g2 bes | g8 bes g f ees2~ | ees2 bes |
		des1~ | des2 \tuplet 3/2 { ces4 des ces } | bes1~ |
	} \alternative {
		{
			bes2. bes4 |
		}
		{
			bes2. r4 |
		}
	}

	% part "B"
	f'2 g4 aes | c4 ees2 c4 | d2 c8 d c bes | g2 f8 g f ees |
	c2. d4~ | d2 bes2 | ees1~ | ees2 r2 |

	% part "C"
	\tuplet 3/2 { f2 g aes } | \tuplet 3/2 { c2 ees d } | g2 \tuplet 3/2 { f4 g f } | \tuplet 3/2 { d4 c bes } \tuplet 3/2 { g f ees } |
	c2. d4~ | d2 bes2 | ees1~ | ees4 c d4. bes8 | ees1~ | ees2. r4 |
}
{% endif %}
