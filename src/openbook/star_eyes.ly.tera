{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:maj7 | f2:m7 bes:7 | ees1:maj7 | ees2:m7 aes:7 | \myEndLine
		des1:maj7 | g2:m7.5- c:7.9+ | f1:maj7 |
	} \alternative {
		{
			f2:m7.5- bes:7 | \myEndLineVoltaNotLast
		}
		{
			f2:m7.5- bes4:7 a:7.9- | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	aes1*2:maj7 | aes1:m7 | des:7 | \myEndLine
	ges1*2:maj7 | f1:m7.5- | bes:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	ees1:maj7 | f2:m7 bes:7 | ees1:maj7 | ees2:m7 aes:7 | \myEndLine
	des1:maj7 | g2:m7.5- c:7.9+ | f1:maj7 | f2:m7.9- bes:7 | \myEndLine
	ees2:7 d:7 | des:7 c:7.9- | f:m7 f:m7/bes | ees1:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
