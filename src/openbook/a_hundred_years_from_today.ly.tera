	g'8 c''4. \times 2/3 { g'4 g'4 g'4 } ^ "To Coda" |
	es'2. es'4 |
	f'4. as'8 g'4. es'8 |
	f'4. c''8 bes'4. es'8 |
	f'8 f'8 f'8 f'8 f'2 ~ |
	f'2 r4 f'4 |
	g'4. bes'8 a'4. f'8 |
	g'4. d''8 c''4. f'8 |
