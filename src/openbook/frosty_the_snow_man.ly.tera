{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		c1 | c2 c:7 | f2 fis:dim7 | c1/g | \myEndLine
		f2 fis:dim7 | c1/g | g1:7 | c2 g:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		c1 | c2 c:7 | f2 fis:dim7 | c1/g | \myEndLine
		f2 fis:dim7 | c2/g a:7 | d:m7 g:7 | c1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f2 fis:dim7 | c1/g | d2:m7 g:7 | c1 | \myEndLine
		g1 | e:7.9- | a2:m7 d:7 | d:m7 g:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		c1 | c2 c:7 | f2 fis:dim7 | c1/g | \myEndLine
		f2 fis:dim7 | c2/g a:7 | d:m7 g:7 |
	} \alternative {
		{
			c1 | \myEndLineVoltaNotLast
		}
		{
			c1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "End"
	\startPart
	c1 | c | c | g:7 | \myEndLine
	g1:7 | g:7 | g:7 | c | \myEndLine
	\endPart

	\endSong
	\endChords
}
