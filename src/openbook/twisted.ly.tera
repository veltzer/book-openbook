{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	bes2 aes4. f8:m | s8 aes4. bes2 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1:7 | ees2:7 f:7 | bes1:7 | bes1:7 | \myEndLine
		ees1:9 | ees1:9 | bes1:7 | bes2:7 g:7 | \myEndLine
		c1:m7 | f1:7 | bes2 g:7 |
	} \alternative {
		{
			c2:m7 f:7 | \myEndLineVoltaNotLast
		}
		{
			c2:m7 f:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	bes1:7 | ees1:7 | bes1:7 | bes1:7 | \myEndLine
	ees1:7 | ees1:7 | bes1 | d2:m7 g:7 | \myEndLine
	c1:m7 | f1:7 | bes2 g:7 | c2:m7 f:7 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	bes2:7 ees:7 | bes2:7 ees:7 | bes2:7 ees:7 | bes1:7 | \myEndLine
	ees1:7 | ees1:7 | bes1:7 | g1:7 | \myEndLine
	c1:m7 | f1:7 | bes1 | c2:m7 f:7 | \myEndLine
	\endPart

	\myMark "D"
	\startPart
	bes1 | ees1:7 | bes1:7 | bes1:7 | \myEndLine
	ees1:7 | ees1:7 | bes1 | d2:m7 cis:m7 | \myEndLine
	c1:m7 | f1:7 | bes2:7 g:7 | c2:m7 f:7 | \myEndLine
	bes1 | bes1 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1:7 | ees2:7 f:7 | bes1:7 | bes1:7 | \myEndLine
		ees1:9 | ees1:9 | bes1:7 | bes2:7 g:7 | \myEndLine
		c1:m7 |
	} \alternative {
		{
			f1:7 | bes2 g:7 | c2:m7 f:7 | \myEndLineVoltaNotLast
		}
		{
			f1:7 | bes1:7 | bes1:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
