{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1:m | f:m7+ | f:m7 | bes2:7 ees:7 | \myEndLine
		aes2:6 f:7 | bes2:m7 ees:7 | aes1:6 |
	} \alternative {
		{
			g2:m7.5- c:7 | \myEndLineVoltaNotLast
		}
		{
			aes1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f1*2:m7 | des1*2:7 | \myEndLine
	f1*2:m7 | des1:7 | des2:7 c:7.9- | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f1:m | f:m7+ | f:m7 | bes2:7 ees:7 | \myEndLine
	aes2:6 f:7 | bes2:m7 ees:7 | aes1*2:6 | \myEndLine
	\endPart

	\endSong
	\endChords
