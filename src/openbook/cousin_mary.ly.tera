{% endif %}
{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2:7.9+ ees4.:7.9+ aes8:7 | aes1:7 | c2:7.9+ ees4.:7.9+ aes8:7 | aes1:7 | \myEndLine
		aes2:7 d4.:7 des8:7 | des1:7 | c2:7.9+ ees4.:7.9+ aes8:7 | aes1:7 | \myEndLine
		d1:7.5- | des:7 | c2:7.9+ ees4.:7.9+ aes8:7 | aes1:7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Allegro" 4 = 200
	\time 4/4
	\key des \major

	% part "A"
	\repeat volta 2 {
		r4 ees' ges4. ees8~ | ees1 | r4 ees ges4. ees8~ | ees1 |
		r4 ees ges4. aes8~ | aes1 | r4 ees ges4. ees8~ | ees1 |
		r8 aes ges aes~ aes4 ges8 aes~ | aes4. ges8 ees4 des | r4 ees ges4. ees8~ | ees1 |
	}
}
{% endif %}
{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	aes1*4:7 | \myEndLine
	des1*2:7 | aes1*2:7 | \myEndLine
	d1:7 | des:7 | aes1*2:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Allegro" 4 = 200
	\time 4/4
	\key des \major

	% part "A"
	r4 ees8 r ges4. ees8~ | ees1 | r4 ees8 r ges4. ees8~ | ees1 |
	r4 ees8 r ges4. aes8~ | aes1 | r4 ees8 r ges4. ees8~ | ees1 |
	r8 aes ges aes~ aes4 ges8 aes~ | aes4 aes8 ges ees ees des r |
	r4 ees8 r ges4. ees8~ | ees1 |
}
{% endif %}
