		c2/e ees:dim | d1:m7 | g2:9 f:dim |
	} \alternative {
		{
			e4:m7 a:m7 d:m7 g:7 | \myEndLineVoltaNotLast
		}
		{
			c1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	d2:m7 g:13.9- | c:maj7 c:6 | d:m7 g:7.9- | c:dim c:maj7 | \myEndLine
	a2:m a:m7 | d:9.11+ d:9 | d1:m7.5- | g2:7 d4:m7 g:7.9- | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c2:maj7 a:7.5+.9- | d:m d:m7 | g1:7 | c2:dim c | \myEndLine
	c2/e ees:dim | d1:m7 | d2:m7 g:7.9- | c1:6 | \myEndLine
