{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		\repeat volta 2 {
			f1 | c | d:m | \myEndLine
			a:m | bes |
		} \alternative {
			\volta 1,3 {
				c2:7 c:7sus4 | \myEndLineVoltaNotLast
			}
			\volta 2,4 {
				c1:7 | \myEndLineVoltaLast
			}
		}
		f1 | c:7 | \myEndLine
		c1:7 | f | f | c:7 | c:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f1 | f | g:m7/c | g:m7/c | \myEndLine
		f1:6 | f:6 | g:m7/c | g:m7/c | \myEndLine
		f1 | f | g:m7/c | g:m7/c | \myEndLine
	} \alternative {
		{
			f1 | f | \myEndLineVoltaNotLast
		}
		{
			f1 | f | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key f \major

	% part "A"
	\repeat volta 2 {
		\repeat volta 2 {
			a'2 a | g8 g g g~ g2 | f8 f f f~ f2 |
			e8 e e e~ e c4 bes8~ | bes8 f'~ f2 d4 |
		} \alternative {
			\volta 1,3 {
				c4. e8 f4 g8 f |
			}
			\volta 2,4 {
				c2 \tuplet 3/2 { a'4 a a } |
			}
		}
		\tuplet 3/2 { a8 g f~ } f2 g8 a | bes4 bes8 g~ g e4 c8~ |
		c4. c8 \tuplet 3/2 { a'4 a a } | a4 f2. | r2 r4 g8 a | bes4 bes8 g~ g e4 c8~ | c4. c8 a'8 a4 a8~ |

		% part "B"
		a8 a \tuplet 3/2 { a g f~ } f2 | r2 r4 r8 f | g2. r8 f | g8 f g f g f4 d8~ |
		% << { r2 r8 a bes c | f8 e4 d8~ d c4 f,8 } \\ { d8 c~ c4. r4 | f2 r4 r8 s8 } >>
		d8 c~ c4. a'8 bes c | f8 e4 d8~ d c4 f,8 | g2. r8 f | g8 f g f g f4 a8~ |
		% << { a8 s8 r4 r4 r8 c8 | f8 e4 d8~ d c4 f,8 } \\ { a8 f~ f2. | f2 r4 r8 s8 } >>
		a8 f~ f2 r8 c' | f8 e4 d8~ d c4 f,8 | g2. r8 f | g8 f g f g f4 f8~ |
	} \alternative {
		{
			f8 d c2.~ | c4 r r2 |
		}
		{
			f8 d c2.~ | c8 r r4 r2 |
		}
	}
}
{% endif %}
