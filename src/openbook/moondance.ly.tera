{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key as \major

	r2 r8 c'8 f'8 g'8 |
	\repeat volta 2 {
	as'8 g'8 f'8 g'8 ~ g'8 f'8 es'8 f'8 ~ |
	f'4 c'4 f'4 g'4 |
	as'4 g'8 f'8 g'8 f'8 es'8 f'8 ~ |
	f'2 r8 f'8 g'4 |
	as'8 g'8 f'8 g'8 ~ g'8 f'8 es'8 f'8 ~ |
	f'4 c'4 f'4 g'4 |
	as'8 g'8 f'8 g'8 ~ g'8 f'8 es'8 f'8 ~ |
	f'2 r8 c'8 f'8 g'8 |
	as'4 g'8 f'8 g'8 ( f'8 ) es'8 f'8 ~ |
	f'4 c'4 f'4 g'4 |
	as'4 g'8 f'8 g'8 f'8 es'8 f'8 ~ |
	f'2 r8 f'8 g'4 |
	as'8 g'8 f'8 g'8 ~ g'8 f'8 es'8 f'8 ~ |
	f'4 c'4 f'4 g'4 |
	\times 2/3 { as'4 g'4 f'4 } \times 2/3 { g'4 f'4 es'4 } |
	f'2 f'8 ~ f'8 g'8 as'8 |
	des''2 es''8 des''4 c''8 ~ |
	c''4 f'4 g'4 as'4 |
	bes'2 ~ bes'8 as'8 bes'8 c''8 ~ |
	c''2 r8 f'8 g'8 as'8 |
	des''2 es''8 des''4 c''8 ~ |
	c''4 f'4 g'4 as'4 |
	bes'2 ~ bes'8 as'8 bes'8 c''8 ~ |
	c''2 r4 f''8 es''8 ~ |
	es''4 c''8 f''8 ~ f''8 c''8 as'8 bes'8 ~ |
	bes'8 ( as'8 ) bes'8 ( as'8 ) bes'8 ( as'8 ) bes'8 ( as'8 ) |
	bes'8 ( f'8 ) r4 r4 f'8 as'8 ~ |
	as'4 r4 r4 f''8 es''8 ~ |
	es''4 c''8 f''8 ~ f''8 c''8 ( as'8 ) bes'8 ~ |
	bes'8 ( as'8 ) bes'8 ( as'8 ) c''8 bes'8 as'8 bes'8 ~ |
	bes'8 ( as'8 ) r4 r4 f'8 f'8 ~ |
	} \alternative {
	{
	f'4 r4 r4 f'8 g'8 |
	}
	{
	f'4 r4 r8 c'8 f'8 g'8 |
	}
	}
	c''4 c''4 bes'2 |
	r2 bes'4. as'8 |
	bes'4 c''4 r2 |
	r2 r4 bes'8 as'8 |
	bes'16 as'16 f'8 f'4 r2 |
	r2 r2 |
	f'4. f'8 ~ f'4 f'4 ~ |
	f'4 f'4 r8 f''4 f''8 |
	f''8 es''8 c''4 r2 |
	r2 r4 bes'8 as'8 |
	bes'8 as'8 bes'16 as'16 f'8 f'4 r4 |
	r2 r4 f'4 |
	\times 2/3 { f''4 ( es''4 ) c''4 } \times 2/3 { f''4 ( es''4 ) c''4 } |
	\times 2/3 { f''4 ( es''4 ) c''4 } \times 2/3 { bes'4 as'4 bes'4 } |
	bes'4 r4 c''16 bes'16 as'8 bes'16 as'16 f'8 ~ |
	f'4 r4 r2 |
	\endBar
}
