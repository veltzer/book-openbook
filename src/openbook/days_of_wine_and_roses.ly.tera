{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\repeat volta 2 {

	\myMark "A"
	\startPart
	f1:maj7 | ees:7 | d2:7.5-.9- d:9 | d1:9 | \myEndLine
	g1*2:m7 | bes1:m | ees:7 | \myEndLine
	a1:m7 | d:m7 | g:m7 | c:7 | \myEndLine
	e2:m7.5- a:7.9- | d:m7 g:7 | g1:m7 | c:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	f1:maj7 | ees:7 | d2:7.5-.9- d:9 | d1:9 | \myEndLine
	g1*2:m7 | bes1:m | ees:7 | \myEndLine
	a1:m7 | d:m7 | b:m7.5- | bes:7 | \myEndLine
	a2:m7 d:m7 | g:m7 c:7 |
	\endPart

	} \alternative {
		{
			f1:6 | g2:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			f2 g:m7/c | f1:maj9 | \myEndLineVoltaLast
		}
	}

	\endSong
	\endChords
}
