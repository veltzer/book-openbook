{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	\repeat volta 2 {
	\textMark \markup { \musicglyph "scripts.segno" } d''2 bes'2 |
	g'2 f'4 e'8 es'8 ~ |
	es'2. f'8 g'8 |
	r2 r4 f'8 es'8 ~ |
	es'2. f'8 g'8 ~ |
	g'2. as'8 bes'8 ~ |
	bes'1 |
	r2 r2 |
	d''2 bes'2 |
	g'2 f'4 e'8 es'8 ~ |
	es'2. f'8 g'8 |
	r2 r4 f'8 es'8 ~ |
	es'2. f'8 g'8 ~ |
	g'2. d'8 es'8 ~ |
	es'1 ~ |
	es'2 r2 |
	r8 d'8 \once \omit TupletBracket \times 2/3 { fis'8 a'8 e''8 } ais'4 b'4 |
	r8 des'8 \once \omit TupletBracket \times 2/3 { f'8 as'8 es''8 } a'8 bes'8 c''8 des''8 |
	es''2 bes''8 as''8 g''8 f''8 |
	es''4. des''8 c''2 |
	r8 fes'8 \once \omit TupletBracket \times 2/3 { as'8 ces''8 ges''8 } c''4 des''4 |
	r8 es'8 \once \omit TupletBracket \times 2/3 { g'8 bes'8 f''8 } b'4 c''4 |
	es''2 ~ es''8 f''8 \once \omit TupletBracket \times 2/3 { g''8 as''8 bes''8 } |
	ces'''2. r4 |
	d''2 bes'2 |
	g'2 f'4 e'8 es'8 ~ |
	es'2. f'8 g'8 |
	r2 r4 f'8 es'8 ~ ^ "To Coda" |
	es'2. f'8 g'8 ~ |
	g'2. d'8 es'8 ~ |
	es'1 |
	r2 r2 ^ "D.S. al Coda" |
	}
	\textMark \markup { \musicglyph "scripts.coda" } es'2. f'8 g'8 ~ |
	g'2 g'4 as'4 |
	d''2 c''2 |
	ais'2 as'2 |
	es'2 des'2 |
	c'2 b2 |
	bes1 |
	\endBar
}
{% endif %}
