{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:m11 | des:m11 | e2:9sus4 fis:9sus4 | aes2:9sus4 bes:7sus4 | \myEndLine
		ees1:m11 | des:m11 | e2:9sus4 fis:9sus4 |
	} \alternative {
		{
			aes2:9sus4 bes:7sus4 | \myEndLineVoltaNotLast
		}
		{
			aes2:9sus4 bes:7sus4 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	ees1:m11 | des:m11 | e2:9sus4 fis:9sus4 | aes2:9sus4 bes:7sus4 | \myEndLine
	ees1:m11 | des:m11 | e2:9sus4 fis:9sus4 | aes2:9sus4 bes:7sus4 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	ees1:m11 | des:m11 | e2:9sus4 fis:9sus4 | aes2:9sus4 bes:7sus4 | \myEndLine
	ees1:m11 | des:m11 | e2:9sus4 fis:9sus4 | aes2:9sus4 bes:7sus4 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	e2:9sus4 fis:9sus4 | aes2:9sus4 bes:7sus4 | s2. ees4:m11 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key ees \minor

	\partial 8 ees'8~ |

	% part "A"
	\repeat volta 2 {
		ees8^\markup { \musicglyph #"scripts.segno" } des ees des bes aes ges aes~ | aes4. ges8~ ges2 | r8 e fis a b4 gis8 fis | des'4 bes8 aes ees'4 aes |
		r2 aes8 ges16 ees des8 aes | bes8 ges ees aes~ aes ges4.~ | ges1 |
	} \alternative {
		{
			ges2. r8 ees' |
		}
		{
			ges,2. r4 |
		}
	}

	% part "B"
	r2 aes2 | r4 r8 ges~ ges2 | r4 a r b | r4 des r8 ees r4 |
	r2 aes,2 | r4 r8 ges~ ges2 | r4 a r b | r4 des r8 ees4 ees8~ |

	% part "A"
	ees8 des ees des bes aes ges aes~ | aes4. ges8~ ges2 | r8 e fis a b4 gis8 fis | des'4 bes8 aes ees'4 aes |
	r2 aes8 ges16 ees des8 aes | bes8 ges ees aes~ aes ges4.~ | ges2.^\markup { To Coda \musicglyph #"scripts.coda" } r4 | r2 r4 r8 ees'^\markup { D.S. al Coda } |

	% part "Coda"
	ges,1~^\markup { \musicglyph #"scripts.coda" } | ges2. r4 | r2 r4\fermata aes'4\fermata |
}
{% endif %}
