{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		\repeat volta 2 {
			ees1 | aes2 ees | ees1 | aes2 ees | \myEndLine
			aes a:dim7 | ees:/bes c:7 | f:7 bes:7 | ees1 | \myEndLine
		}
		\endPart

		\myMark "B"
		\startPart
		g1:7.5+ | g:7 | c:7 | c:7 | \myEndLine
		f:7 | f:7 | bes2:7 bes:dim7 | bes1:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1 | aes2 ees | ees1 | aes2 ees | \myEndLine
		aes a:dim7 | ees:/bes c:7 | f:7 bes:7 |
	} \alternative {
		{
			ees2 f4:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees4 aes ees2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
