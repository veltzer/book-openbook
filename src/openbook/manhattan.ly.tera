{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f2 f4/a aes:dim7 | g2:m7 c:7 | f:maj7 bes:6 | a:m7 aes:dim7 | \myEndLine
		c:7/g fis:dim7 | c:7/g c:7.5+ | f d:7 | g:m7 c:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f2 f4/a aes:dim7 | g2:m7 c:7 | f1:maj7 | d:m7 | \myEndLine
		g1*2:7 | g4:m7 c2.:7 | c2:7 c:7.9- | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f2 d:7 | g:m7 c:7 | f bes:6 | a:m7 aes:dim7 | \myEndLine
		c:7/g fis:dim7 | c:7/g c4:7 c:7/bes | a1:m7.5- | d:7.9- | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		g1:m7 | ees:9 | f2 d:m7 | g1:7 | \myEndLine
		f2 f4/a aes:dim7 | g2:m7 c4:7 c:7.9- | \myEndLine
	} \alternative {
		{
			f2 aes:dim7 | g:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			f2 bes:6 | f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
