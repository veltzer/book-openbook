{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes2 b:dim7 | c:m7 f:7 | bes b:dim7 | c:m7 f:7 | \myEndLine
		bes bes:7/d | ees e:dim7 | bes/f f:7.5+ | bes1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		d2 a:7/e | d/fis a:7/e | d a:7 | d c:7 | \myEndLine
		f c:7/g | f/a fis:dim7 | c:7/g c:7 | f1:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		bes2:7 e:dim7 | f:m7 bes:7 | ees bes:7 | ees1 | \myEndLine
		c1*2:7 | f2:9 c:7.5+ | f1:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		bes2 b:dim7 | c:m7 f:7 | bes b:dim7 | c:m7 f:7 | \myEndLine
		bes bes:7/d | ees e:dim7 |
	} \alternative {
		{
			bes/f f:7.5+ | bes f:7 | \myEndLineVoltaNotLast
		}
		{
			bes ees4:7 f:7 | bes2 f:7.5+ | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "End"
	\startPart
	bes2 b:dim7 | c:m7 f:9 | bes b:dim7 | c:m7 f:7 | \myEndLine
	bes bes:7/aes | ees:m/g ees:m/ges | bes/f ees4:7 f:7 | bes2 f:7.5+ | \myEndLine
	bes bes:7/aes | ees/g ees:m/ges | bes4/f bes:aug/fis g2:m7 | c4:7.9- f:7.5+ bes2:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
