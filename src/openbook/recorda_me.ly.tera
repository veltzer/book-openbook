{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	a1:m7 |
	s1 |
	s1 | \myEndLine
	s1 |
	c1:m7 |
	s1 |
	s1 | \myEndLine
	s2 f2:7 |
	bes1:maj7 |
	bes2:m7 ees2:7 |
	aes1:maj7 | \myEndLine
	aes2:m7 des2:7 |
	ges1:maj7 |
	g2.:m7 c4:7 |
	f2.:maj7 e4:7.9+ | \myEndLine
	} \alternative {
	{
	s1 | \myEndLineVoltaNotLast
	}
	{
	e1:7.9+ | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
