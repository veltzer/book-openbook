		f8 a c f, a c f, a | c f, a c~ c bes4 bes8~ | bes8 bes bes bes bes bes bes bes | bes8 bes4 bes8~ bes4 r4 |
	}

	% part "B"
	\repeat volta 2 {
		bes8 g4 bes8~ bes4 r4 | r8 ees, g bes d d4. | bes8 g4 bes8~ bes4 r4 | r8 ees, g bes d d4. |
		bes8 g4 bes8~ bes4 r4 | r8 ees, g bes d f4 d8 | f8 f f f f f f f | f4 des8 c~ c bes4. |
		bes8 g4 bes8~ bes4 r4 | r8 ees, g bes d d4. | bes8 g4 bes8~ bes4 r4 | r8 ees, g bes d d4. |
		bes8 g4 bes8~ bes4 r4 | r8 ees, g bes d f4 d8 | f8 f f f f f f f |
	} \alternative {
