{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1*4 | \myEndLine
		ees1*2 | bes1*2 | \myEndLine
		f1*2:7 | bes2 ees | ges2:7 bes | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		bes2. des4:dim7 | c2:m7 f:7.9- | bes2. des4:dim7 | c2:m7 f:7.9- | \myEndLine
		bes2. des4:dim7 | c1:m7 | f2:7 f:dim7 | f4:7 ges8:9 f4:9 bes4. | \myEndLine
		s2. des4:dim7 | c2:m7 f:7.9- | bes2. des4:dim7 | c2:m7 f:7.9- | \myEndLine
		bes2. des4:dim7 | c1:m7 | f2:7 f:dim7 | \myEndLine
	} \alternative {
		{
			f4:7 ges8:9 f4:9 bes4. | \myEndLineVoltaNotLast
		}
		{
			f4:7 ges8:9 f4:9 bes4. | \myEndLineVoltaLast
		}
	}
	s1 | b4 bes2. | f1:7 | bes1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
