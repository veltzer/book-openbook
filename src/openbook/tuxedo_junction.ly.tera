		bes2 bes/d | ees e:dim7 | bes/f f:7 | bes f:7 | \myEndLine

		\myMark "A"
		bes2 bes/d | ees:7 f:7 | bes bes/d | ees:7 f:7 | \myEndLine
		bes2 bes/d | ees:7 e:dim7 | bes/f f:7 | bes1 | \myEndLine

		\myMark "B"
