{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1 | g2:m7 c:7 | f d:7 | g:m7 c:7 | f1 | \myEndLine
		g2:m7 c:7 | f1 | d:7 | b2:m7 e:7 | a:m7 d:7 | \myEndLine
		g2:m7 c:7 |
	} \alternative {
		{
			f1 | e2:m7 a:7 | d1:m | bes2:m7 ees:7 | \myEndLine
			g2:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			f1 | g2:m7 c:7 | g:m7 c:7 | f1 | s1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 220
	\time 4/4
	\key f \major

	% part "A"
	\repeat volta 2 {
		r8 c f g a bes a f | g4 r8 g a bes a g | c8 bes a g fis ees' d c | bes8 g f dis e des' c bes | a8 r r4 r4 r8 a8 |
		bes8 cis, d f a g e c | c'4 a8 c aes e4. | fis8 a c ees d b \tuplet 3/2 { c8 b c } | d8 c b a gis b, d f | e8 c' b a gis fis e d |
		g8 a bes fis \tuplet 3/2 { bes8 a g } ges8 e |
	} \alternative {
		{
			f8 r r4 r8 c' a g | e8 d \tuplet 3/2 { cis8 e g } \tuplet 3/2 { bes8 c bes } a8 e | f4 d8 e f g e d | des8 r r4 r2 |
			\tuplet 3/2 { d'8 ees d } des8 c bes a g4 |
		}
		{
			f8 r r4 r4 c'8 bes | r2 r8 cis,8 d f | a8 a aes aes g g ges ges | f8 r r4 r2 | r1 |
		}
	}
}
{% endif %}
