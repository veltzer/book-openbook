{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		d1:m7.5- | g:7 | c:m7 | a:m7.5- | \myEndLine
		d1:m7.5- | g:7 | c:m7 | a:m7.5- | \myEndLine
		f1:m7 | b2:m7 e:7 | ees:m7 d:7.9+ | aes1:maj7 | \myEndLine
		e1:7.9+ | a:7.5- |
	} \alternative {
		{
			bes2:m7 ees:7 | aes1:maj7 | \myEndLineVoltaNotLast
		}
		{
			f2:m7 bes:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	ees1:maj7 | f:m7 | bes:7 | ees:maj7 | \myEndLine
	des1:maj7 | c2:m7 bes:m7 | a:m7 d:7 | g1:m7 | \myEndLine
	e1:m7.5- | ees2:7 d:7 | cis:m7 fis:7 | b1:maj7 | \myEndLine
	bes2:m7 ees:7 | aes1:maj7 | g2:m7.5- c:7 | f:m7 bes:7 | ees:m7 aes:7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	ees1:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
