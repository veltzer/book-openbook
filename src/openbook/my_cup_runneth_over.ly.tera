{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 3/4
	\key c \major

	r4 e''8 f''8 g''4 |
	r4 e''8 f''8 g''4 |
	r4 e''8 f''8 g''8. g''16 |
	g''4 r4 g'4 |
	\repeat volta 2 {
	e'4 c'4 g'4 |
	e'4 c'4 g'4 |
	a'4 g'4 g'4 |
	g'2 g'4 |
	c''4 d''4 e''4 |
	b'4 g'4 e'4 |
	a'4 g'4 g'4 |
	g'2 g'4 |
	c''4 d''4 e''4 |
	b'4 g'4 e'4 |
	f'4 g'4 a'4 |
	g'2 g'4 |
	e'4 c'4 g'4 |
	\once \omit TupletBracket \times 2/3 { dis'8 e'8 d'8 } c'4 c'4 |
	} \alternative {
	{
	c'4 e''8 f''8 g''4 |
	r4 e''8 f''8 g''4 |
	r4 e''8 f''8 g''8. g''16 |
	\once \omit TupletBracket \times 2/3 { f''8 g''8 f''8 } e''4 g'4 |
	}
	{
	c''4 e''8 f''8 g''4 |
	}
	}
	r4 e''8 f''8 g''4 |
	r4 e''8 f''8 g''8. g''16 |
	g''2. ~ |
	g''4 r2 |
	\endBar
}
