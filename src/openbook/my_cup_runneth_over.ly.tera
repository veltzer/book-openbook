{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	c2. |
	a2.:m |
	d2.:m7 |
	g2.:7 | \myEndLine
	\repeat volta 2 {
	c2. |
	a2.:m7 |
	d2.:m7 |
	g2.:7 | \myEndLine
	c2. |
	a2.:m |
	d2.:m7 |
	g2.:7 | \myEndLine
	c2. |
	e2.:m |
	d2.:m |
	e2.:m | \myEndLine
	d2.:m7 |
	s2. |
	} \alternative {
	{
	c2. |
	a2.:m | \myEndLine
	d2.:m7 |
	g2.:7 | \myEndLineVoltaNotLast
	}
	{
	c2. | \myEndLineVoltaLast
	}
	}
	a2.:m | \myEndLine
	d2:m7 g4:7 |
	c2. |
	s2. |
	\endBar
	\endPart

	\endSong
	\endChords
}
