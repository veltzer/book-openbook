{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	a1:m |
	c1/g |
	f1 |
	c1/e | \myEndLine
	d1:7 |
	f1 |
	e1:7 |
	s1 | \myEndLine
	a1:m |
	c1/g |
	f1 |
	c1/e | \myEndLine
	d1:7 |
	f1 |
	e1:7 |
	s1 | \myEndLine
	f2 e4:m d4:m |
	c1 |
	f2 e4:m d4:m |
	c1 | \myEndLine
	f2 e4:m d4:m |
	c1 |
	bes1 |
	} \alternative {
	{
	f1 | \myEndLine
	a1:m |
	c1/g |
	f1 |
	c1/e | \myEndLine
	d1:7 |
	g2 f2 |
	s2 e2:m7 |
	a1:m | \myEndLine
	s1 | \myEndLineVoltaNotLast
	}
	{
	c1 | \myEndLineVoltaLast
	}
	}
	c1:7 |
	f1 | \myEndLine
	s1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	\repeat volta 2 {
	b'4. a'8 e'2 ~ |
	e'2 \times 2/3 { a'4 g'4 a'4 } |
	c'4. c'8 c'2 ~ |
	c'4 r4 r8 a'8 g'8 a'8 |
	c'8 c'8 c'2. ~ |
	c'2 r8 a8 c'8 d'8 |
	e'8 g'8 e'2. ~ |
	e'2. r4 |
	b'4. a'8 e'2 ~ |
	e'2 \times 2/3 { a'4 g'4 a'4 } |
	c'8 c'8 c'2. ~ |
	c'4 r4 \times 2/3 { a'4 g'4 a'4 } |
	c'8 d'8 c'2. ~ |
	c'4 r4 r8 a8 c'8 d'8 |
	e'8 g'8 e'2. ~ |
	e'2. r4 |
	\textMark \markup { \musicglyph "scripts.segno" } a'8 c''16 c''16 c''8 c''16 c''16 c''8 b'16 b'16 b'8 a'8 |
	a'8 g'8 ~ g'2 r8. g'16 |
	a'8 c''16 c''16 c''8 c''8 b'8 b'8 b'16 a'16 a'8 |
	a'8 g'8 ~ g'2 r4 |
	a'8 c''8 d''8 c''8 b'8 b'8 a'16 a'16 a'8 |
	a'16 g'16 g'8 ~ g'2 r8 c'8 |
	e'8. d'16 c'8 d'8 ~ d'2 ^ "To Coda" |
	} \alternative {
	{
	e'4 e'8 d'8 c'2 |
	b''4. a''8 e''2 |
	e''2 r8 b''8 a''8 b''8 |
	c'''8 b''8 a''2. |
	a''8 g''8 c''2. |
	c''2 r8 a'8 b'8 c''8 |
	d''2 c''2 |
	a'2 g'2 |
	a'2 b'2 |
	a'2 b'4 e'8 a'8 |
	}
	{
	e'4 e'8 g'8 e'2 ~ |
	}
	}
	\textMark \markup { \musicglyph "scripts.segno" } e'2. r4 ^ "D.S. al Coda" |
	\textMark \markup { \musicglyph "scripts.coda" } e'4 ^ "Coda" e'8 d'8 c'2 ~ |
	c'2. r4 |
	\endBar
}
{% endif %}
