	b'4 ~ \once \omit TupletBracket \times 2/3 { b'8 c''8 b'8 } a'2 |
	r4 r8 b'8 a'4 b'4 |
	d''2 ~ d''8 b'8 b'4 |
	g'1 |
	R1 |
	b8 d'8 a'8 g'8 ~ g'2 |
	b8 d'8 a'8 g'8 ~ g'4. b8 |
	c'8 e'8 b'8 a'8 ~ a'2 |
	r4 \once \omit TupletBracket \times 2/3 { b'8 a'8 b'8 } b'8 a'8 g'8 d'8 |
	b8 d'8 a'8 g'8 ~ g'2 |
	b8 d'8 a'4 g'2 |
	\times 2/3 { c'4 e'4 b'4 } a'2 |
	r8 fis'8 fis'8 fis'8 g'8 a'4. |
	a'2 g'4. fis'8 |
	fis'2 g'2 |
	r8 d'8 a'4 g'4. fis'8 |
	fis'2 g'4. d'8 |
	b'2 a'4 \times 2/3 { r8 e'8 g'8 } |
	b'2 a'4. e'8 |
	b'8 a'8 b'8 b'8 ~ b'4. a'8 |
	b'8 a'8 b'8 es''8 ~ es''8 es'8 f'16 as'8. |
	\key as \major bes'2 as'4. g'8 |
	g'2 as'2 |
	r8 es'8 bes'4 as'4. g'8 |
	g'2 as'4. es'8 |
	c''4 ~ \once \omit TupletBracket \times 2/3 { c''8 des''8 c''8 } bes'4. f'8 |
	c''4 ~ \once \omit TupletBracket \times 2/3 { c''8 des''8 c''8 } bes'2 |
	r4 r8 c''8 bes'8 c''4. |
	es''2 ~ es''4. es''8 |
	es''8 des''8 es''8 des''8 ~ des''2 |
	es''8 des''8 es''8 des''8 ~ des''4 r4 |
	des''4 ~ \once \omit TupletBracket \times 2/3 { des''8 c''8 des''8 } c''4 bes'8 es'8 ( |
	f'16 as'8. ~ as'2 ) \times 2/3 { r8 des''8 des''8 } |
	des''8 c''8 des''8 c''8 ~ c''2 |
	des''8 c''8 des''4 c''4 bes'8 es''8 ~ |
	es''1 |
	e''2 \times 2/3 { r8 e''8 e''8 } \times 2/3 { e''8 e''4 } |
	\key a \major b'2 a'4. gis'8 |
	gis'2 a'2 |
	r8 b'8 b'4 a'4. gis'8 |
	gis'2 a'4. a'8 |
	cis''2 b'4 \times 2/3 { r8 fis'8 a'8 } |
	cis''2 b'4. b'8 |
	cis''8 b'8 cis''4 cis''4 r8 b'8 |
	cis''8 b'8 cis''8 f''8 ~ f''8 f'8 gis'16 bes'8. |
	\repeat volta 2 {
	\key bes \major c''2 bes'4. a'8 |
	a'2 bes'2 |
	r8 g'8 c''4 bes'4. a'8 |
