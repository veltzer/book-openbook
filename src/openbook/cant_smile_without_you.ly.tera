{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	r4 fis'4 g'4 a'4 |
	a'2 g'4. fis'8 |
	fis'2 g'2 |
	r8 d'8 a'4 g'4. fis'8 |
	fis'2 g'4. d'8 |
