{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2. s2. |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		aes1/ees | ees | f:m7.5- | bes:7.9- | \myEndLine
		aes1/ees | ees | aes:m7 | des:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees1 | c:7.9- | f:m7 | bes2.:7 bes4:7/aes | \myEndLine
		g1:m7 | c:7.9- | f:m7 | bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		aes1/ees | ees | f:m7.5- | bes:7.9- | \myEndLine
		aes1/ees | ees | g:m7 | c:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		aes1:sus4 | a2:m7.5- d:7.9- | g:7.5+ des:9 | c1:7 | \myEndLine
		f2:m c:7/g | f:m/aes bes:7 |
	} \alternative {
		{
			ees1 | f2:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees2 des4:6 d:6 | ees1:6.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
