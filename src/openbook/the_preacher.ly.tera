{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2. s2. |

	\myMark "A"
	\startPart
	f2. f4:dim7 | f1 | bes1*2:9 | \myEndLine
	f2. f4:dim7 | f1 | c1:7 | f1 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 3 {
		f2. f4:dim7 | f1 | bes2 b:dim7 | f1 | \myEndLine
		f2. f4:dim7 | f1 | g1:7 | c:7 | \myEndLine
		f2. f4:dim7 | f2 f:7 | bes1 | a2.:7 f4:7 | \myEndLine
		g2:m7 gis:dim7 | a:m7 d:m7 | g:m7 c:7 |
	} \alternative {
		{
			f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | f2. f4:dim7 | f1 | bes1*2:9 | \myEndLine
			f2. f4:dim7 | f1 | c1:7 | f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | bes2 b:dim7 | f1 | d2:m7 g:m7 | f1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
