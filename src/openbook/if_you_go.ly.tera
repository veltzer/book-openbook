{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	d1:m7 |
	s1 |
	d1:7 |
	aes1:7 | \myEndLine
	bes1:maj7 |
	s1 |
	e1:7 |
	s1 | \myEndLine
	e1:m7.5- |
	a1:7.9+ |
	d1:m7 |
	b1:m7.5- | \myEndLine
	bes1:7.11+ |
	s1 |
	e1:m7.5- |
	a1:7 | \myEndLine
	d1:m7 |
	s1 |
	d1:7 |
	aes1:7 | \myEndLine
	bes1:maj7 |
	s1 |
	e1:7 |
	s1 | \myEndLine
	e1:m7.5- |
	a1:7.9+ |
	d1:m7 |
	b1:m7.5- | \myEndLine
	bes1:7.11+ |
	s1 |
	a1:7 |
	d1:7 | \myEndLine
	f2:m7 bes2:7 |
	a1:7 |
	} \alternative {
	{
	d1:m7 |
	e2:m7.5- a2:7 | \myEndLineVoltaNotLast
	}
	{
	d1:m7 |
	s1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
