	gis'2 r2 |
	g'4 fis'4 a'4 g'4 |
	bes'4 a'4 c''4 bes'4 |
	d''4 cis''4 e''4 d''4 |
	f''2 \times 2/3 { f''4 e''4 d''4 } |
	e''1 ~ |
	e''4 r8 f''8 \times 2/3 { f''4 e''4 d''4 } |
	e''1 ~ |
	e''2 r2 |
	d''4. cis''8 e''2 ~ |
	\times 2/3 { e''4 d''4 cis''4 } \times 2/3 { e''4 d''4 cis''4 } |
	c''1 ~ |
	c''2 r2 |
	bes'4. a'8 c''2 ~ |
	\times 2/3 { c''4 bes'4 a'4 } \times 2/3 { c''4 bes'4 a'4 } |
	gis'1 ~ |
	gis'2 r2 |
