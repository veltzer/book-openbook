{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 2. s2. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1:m7 | f:7 | bes:maj | ees:maj7.11+ | \myEndLine
		a:m7.5- |
	} \alternative {
		{
			d1:7.9+ | g1*2:m7 | \myEndLineVoltaNotLast
		}
		{
			d1:7.9+ | g1*2:m7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	a1:m7.5- | d:7.9- | g1*2:m7 | \myEndLine
	c1:m7 | f:7 | bes:maj | ees:maj7.11+ | \myEndLine
	a:m7.5- | d:7.9+ | g2:m7 c:7 | f:m7 bes:7 | \myEndLine
	ees1:7 | a2:m7.5- d:7.9+ | g1:m7 | g:7.9+ | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\partial 2. g'4 a bes |

	% part "A"
	\repeat volta 2 {
		ees1 ~ | ees4 f, g a | d2 d ~ | d4 ees, f g |
		c1 ~ |
	} \alternative {
		{
			c4 d, e fis | bes1 | r4 g a bes |
		}
		{
			c4 a c bes | g1 | r2 fis4 g |
		}
	}

	% part "B"
	a4 d, a'2 ~ | a4 a g a | bes1 ~ | bes4 bes a bes |
	c1 ~ | c4 f, f'4. ees8 | d1 ~ | d2 cis4 d |
	ees ees c! c | a2. ees'4 | d2 d ~ | d g, |
	c2. bes4 | a2 bes4 d, | g1 | r |
}
{% endif %}
