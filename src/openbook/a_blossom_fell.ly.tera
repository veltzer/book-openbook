{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	bes1 |
	c1*5/8:m7 f4.:7 |
	s1 | \myEndLine
	bes1 |
	s1 |
	ees1*5/8 f4. |
	c2:m7 f2:7 | \myEndLine
	bes2 f2:7 |
	bes1 |
	c2:m7 f2:7 |
	s1 | \myEndLine
	bes1:maj7 |
	ees1 |
	bes1 |
	f1:7 | \myEndLine
	s2 bes2 |
	ees2. d4:7 |
	g1*5/8:m c4:7 bes8 |
	f1:7 | \myEndLine
	} \alternative {
	{
	bes2 f2:7 | \myEndLineVoltaNotLast
	}
	{
	bes1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	r2 r8 d'8 f'8 d'8 |
	\repeat volta 2 {
	g'2 ~ g'8 d'8 f'8 d'8 |
	g'2 ~ g'8 es'8 g'8 es'8 |
	a'8 es'8 g'8 es'8 a'8 es'8 g'8 es'8 |
	bes'2 ~ bes'8 bes'8 a'8 bes'8 |
	c''4 bes'4 f'4 a'4 |
	g'2 ~ g'8 a'8 gis'8 a'8 |
	bes'4 a'4 es'4 a'4 |
	g'8 a'8 g'8 d'8 f'8 d'8 f'8 d'8 |
	g'2 ~ g'8 d'8 f'8 d'8 |
	g'2 ~ g'8 es'8 g'8 es'8 |
	a'8 es'8 g'8 es'8 a'8 f'8 g'8 f'8 |
	d''2 ~ d''8 d''8 d''8 d''8 |
	d''4 c''4 ~ c''8 es'8 g'8 c''8 |
	c''4 bes'4 ~ bes'8 d'8 f'8 bes'8 |
	bes'4 a'4 ~ a'8 b8 c'8 a'8 |
	g'2 f'8 d''8 d''8 d''8 |
	d''4 c''4 ~ c''8 es''8 d''8 c''8 |
	bes'2 ~ bes'8 bes'8 a'8 g'8 |
	g'8 f'8 g'8 f'8 g'8 f'8 c''8 d''8 |
	} \alternative {
	{
	bes'2 r8 d'8 f'8 d'8 |
	}
	{
	bes'2 ~ bes'4 r4 |
	}
	}
	\endBar
