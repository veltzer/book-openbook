		f1:m7 | bes:7 | ees2:6 f:m7 | g:m7.5- c:7.9- | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1:m7 | bes:9 | ees2:maj7 f:m7 | g:m7 ges:dim7 | \myEndLine
		f1:m7 | bes:7 | ees1*2:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		aes2 aes:aug | aes:m6 aes:m7 | g1:m7 | c:7.9- | \myEndLine
		f1:m7 | f:9 | bes:7 | g2:m7.5- c:7.9- | \myEndLine
		\endPart

