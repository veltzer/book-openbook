{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\partial 4 s4 |
	\repeat volta 2 {
	c4..:7.9+ g1*9/16:m7 |
	c1*9/16:7.9+ f4..:7.9+ |
	c4..:7.9+ g2:m7 c16:7.9+ | \myEndLine
	} \alternative {
	{
	s8 c2..:7.9+ | \myEndLineVoltaNotLast
	}
	{
	s8 c2..:7.9+ | \myEndLineVoltaLast
	}
	}
	f1:7.9+ |
	s1 | \myEndLine
	s1 |
	s1 |
	s1 |
	s1 | \myEndLine
	s2... g16:7.9+ |
	s1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\partial 4 r16 c''16 c''16 c''16 |
	\repeat volta 2 {
	\mark \markup { \musicglyph "scripts.segno" } es''8 -> c''8 r16 g'16 c''16 bes'16 ~ -> bes'8 r8 r16 c''16 c''16 c''16 |
	es''8 -> c''8 r16 c''16 c''16 es''16 r16 f''8. -> r16 c''16 c''16 c''16 |
	es''8 -> c''8 r16 g'16 c''16 bes'16 ~ -> bes'8 r8 r16 g'16 bes'16 c''16 ~ -> |
	} \alternative {
	{
	c''8 r8 r4 r4 r16 c''16 c''16 c''16 ^ "Fine" |
	}
	{
	c''8 r8 r4 r2 |
	}
	}
	f'8 f'8 -. a'8 a'8 -. bes'8 bes'8 -. c''8 c''16 f''16 ~ -> |
	f''8 f''8 -. es''8 es''8 -. d''8 d''16 c''16 ~ -> c''8 r16 f'16 ~ -> |
	f'8 f'8 -. a'8 a'8 -. bes'8 bes'8 -. c''8 c''16 f''16 ~ -> |
	f''8 r8 r4 r2 |
	f'8 f'8 -. a'8 a'8 -. bes'8 bes'8 -. c''8 c''16 f''16 ~ -> |
	f''8 f''8 -. es''8 es''8 -. d''8 d''16 c''16 ~ -> c''8 r16 f'16 ~ -> |
	f'8 f'8 -. a'8 a'8 -. bes'8 bes'8 -. c''8 c''16 b'16 ~ -> |
	b'8 r8 r4 r4 r16 c''16 c''16 c''16 ^ "D.S. al Fine" |
	\endBar
}
{% endif %}
