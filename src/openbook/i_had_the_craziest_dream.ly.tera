{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	c1 |
	g2:m6 e8:m7 a4.:aug7 |
	d2:m g2:dim |
	d1:m | \myEndLine
	d1:m7 |
	s1*5/8 g4.:7.9- |
	c4. c1*5/8:dim |
	d2:m7 g2:7 | \myEndLine
	g2:m6 a2:7 |
	g2:m6 a2:7 |
	d2:m g4:m a4:7 |
	d1:m | \myEndLine
	a2:m6 b2:7 |
	a2:m6 b2:7 |
	e2:m ees2:dim |
	d4.:m7 g1*5/8:aug7 | \myEndLine
	c1 |
	g2:m6 e8:m7 a4.:aug7 |
	d2:m g2:dim |
	d2:m f2:m6 | \myEndLine
	c4. e1*5/8:7/gis |
	d2:7 d4.:m7/g g8:7.9- |
	} \alternative {
	{
	c1 |
	d2:m g4:7 g4:aug7 | \myEndLineVoltaNotLast
	}
	{
	c2 aes2:7 | \myEndLineVoltaLast
	}
	}
	des2 c2 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
