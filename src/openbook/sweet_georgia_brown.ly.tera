	- check the tune and chords against a real book.
	- the source has a "To Coda" with a one bar coda (the last F held); this is written as a second ending.
	- the source gives no chord for that bar, F is my choice.
	- add the lyrics.
	- add youtube performances.
	- hear the tune to check that it is right and adjust the tempo.
{% endif %}
{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		d1*2:7 | d1*2:7 | \myEndLine
		g1*2:7 | g1*2:7 | \myEndLine
		c1*2:7 | c1*2:7 | \myEndLine
		f1:maj7 | c:7.5+ | f:maj7 | e2:m7 a:7 | \myEndLine
		d1*2:7 | d1*2:7 | \myEndLine
		g1*2:7 | g1:7 | a:7 | \myEndLine
		d:m7 | a:7 | d:m7 | a:7 | \myEndLine
		f2:maj7 e:7 | ees:7 d:7 | g:7 c:7 |
	} \alternative {
		{
			f:7 e4:7 ees:7 | \myEndLineVoltaNotLast
		}
		{
			f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Allegro" 4 = 160
	\time 4/4
	\key f \major

	% part "A"
	\repeat volta 2 {
		d4 e fis d | a' fis b a | d2 a8 fis4 d8 ~ | d1 |
		d4 e f! d | a' f b! a | d2 b8 a4 g8 ~ | g1 |
		c,4 d e c | g' e a g | c2 g8 e4 c8 ~ | c4 c8 d ~ d c d4 |
		a'1 ~ | a4 c,8 d ~ d c d4 | a'2 ~ a8 a4. | g a8 ~ a2 |
		d,4 e fis d | a' fis b a | d2 a8 fis4 d8 ~ | d1 |
		d4 e f! d | a' f b! a | d2 b8 a4 g8 ~ | g2 a |
		a4. a8 ~ a2 | g8 e4 a8 ~ a2 | a4. a8 ~ a2 | g8 e4 a8 ~ a2 |
		c,8 d4 f8 ~ f a4 c8 ~ | c a cis d ~ d4 a | g2 c8 a4 f8 ~ |
	} \alternative {
		{
			f4 r r2 |
		}
		{
			f1\fermata |
		}
	}
}
{% endif %}
