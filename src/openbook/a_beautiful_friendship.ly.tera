{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		c1:maj7 | fis:7 | f:maj7 | bes2:7 a:7 | \myEndLine
		a1:m7 | d:7 | d:m7/g | g2:9 g:9.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		c1:maj7 | fis:7 | f:maj7 | bes2:7 a:7 | \myEndLine
		a1:m7 | d:7 | d:m7 | g:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g:m9 | c:9 | f:maj7 | f2:m7 bes:7 | \myEndLine
		e1:m7 | a:7 | a:m7 | aes4:7 g2.:7.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		c1:maj7 | fis:7 | f:maj7 | e2:m7.5- a:7 | \myEndLine
		d1:m7 | d2:m7/g g:7.9- |

	} \alternative {
		{
			c1 | bes4:7 a:7 aes:7 g:7.5+ | \myEndLineVoltaNotLast
		}
		{
			c1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
