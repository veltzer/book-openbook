		g2 c4:maj7 b:7.5+ | e1:m7 | a:9 | a2:m7 d:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		g1 | b:7 | e2:m7 bes:7 | a1:7 | \myEndLine
		g2 fis4.:m7 f8:7 | e1:m | a4.:9 d8*5:9 | g1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1*2:7 | c1:6 | c2.:6 bes4:7 | \myEndLine
		a1*2:7 | d1:7 | d2.:7 d4:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		g1 | b:7 | e:m7 | a2..:7 c8:m6 | \myEndLine
		g2 fis4.:m7.5- b8:7 | e1:m7 | a2..:7.9- d8:7 |
	} \alternative {
		{
			g2 f:9 | a:7.5+ d:9 | \myEndLineVoltaNotLast
		}
		{
			g1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
