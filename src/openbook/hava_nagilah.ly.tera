{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	e1:m |
	s1 |
	s1 |
	s1 | \myEndLine
	a1:m |
	s1 |
	e2 d2:m |
	e1 | \myEndLine
	}
	e1 |
	s1 |
	d1:m |
	s1 | \myEndLine
	s1 |
	s1 |
	e2 d2:m |
	e1 | \myEndLine
	a1:m |
	s1 |
	s2 d2:m6 |
	a2:m d2:m6 | \myEndLine
	a2:m a2:m7 |
	f2 a2:m |
	a2:m a2:m7 |
	f2 a2:m | \myEndLine
	d2:m6 e2:7 |
	d1:m6 |
	s2 e2:7 |
	d1:m6 | \myEndLine
	e1 |
	s1 |
	e1:7 |
	a1:m | \myEndLine
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	\repeat volta 2 {
	e'2 e'2 ~ |
	e'4 gis'4 f'4 e'4 |
	gis'2 gis'2 |
	g'4 b'4 a'4 gis'4 |
	a'2 a'2 ~ |
	a'4 c''4 b'4 a'4 |
	gis'2 \times 2/3 { f'4 e'4 f'4 } |
	gis'1 _\markup{ \bold\tiny {Fine} } |
	}
	gis'4 gis'2 f'4 |
	e'4 e'4 e'2 |
	f'4 f'2 e'4 |
	d'4 d'4 d'2 |
	d'2 f'4. e'8 |
	d'4 d'4 a'2 |
	gis'2 \times 2/3 { f'4 e'4 f'4 } |
	gis'1 |
	a'1 |
	a'1 |
	a'2 a'2 |
	a'2 a'2 |
	a'8 a'8 a'4 c''4. b'8 |
	a'4 c''4 b'4 a'4 |
	a'8 a'8 a'4 c''4. b'8 |
	a'4 c''4 b'4 a'4 |
	b'8 b'8 b'4 d''4. c''8 |
	b'4 d''4 c''4 b'4 |
	b'8 b'8 b'4 d''4. c''8 |
	b'4 d''4 c''4 b'4 |
	b'8 b'8 b'4 e''2 |
	r1 |
	e'4. e'8 c''8 b'8 a'8 gis'8 |
	a'1 _\markup{ \bold\tiny {D.C. al Fine} } |
	\endBar
}
