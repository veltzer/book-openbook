{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\partial 4 s4 |
	\repeat volta 2 {
	des2..:7 ges8:7 |
	s1 |
	s4. des1*5/8:7 | \myEndLine
	s1 |
	ges2:7 des4.:7 ges8:7 |
	s1 |
	des1:7 | \myEndLine
	s1 |
	s8 ges2.:7 aes8:7 |
	s1 |
	des1:7 | \myEndLine
	} \alternative {
	{
	s1 | \myEndLineVoltaNotLast
	}
	{
	s1 | \myEndLineVoltaLast
	}
	}
	\repeat volta 2 {
	s1 |
	ges1:7 |
	des1:7 |
	s1 | \myEndLine
	s1 |
	s8 ges2..:7 |
	aes1:7 |
	s4. des1*5/8:7 | \myEndLine
	}
	\repeat volta 2 {
	s1 |
	ges1:7 |
	des1:7 |
	s1 | \myEndLine
	ges1:7 |
	s1 |
	des1:7 |
	s1 | \myEndLine
	s1 |
	aes1:7 |
	des2:7 bes2:7 |
	s2 aes2:7 | \myEndLine
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
