{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f2:6 d:m7 | g:m7 c:7 | f1:maj7 | g2:m7 c:9 | \myEndLine
		f1:6 | g2:m7 c:7 | f:6 ees4:9 d:7 | g2:m7 c:7 | \myEndLine
	} \alternative {
		{
			aes2:6 f:m7 | bes:m7 ees:9 | aes1:maj7 | g:7 | \myEndLine
			c1:maj7 | a2.:m7 d4:7.9- | g1:m7 | c:7 | \myEndLineVoltaNotLast
		}
		{
			c1:m7 | f:7 | bes:maj7 | bes2:maj7 ees:9 | \myEndLine
			f2:6/a aes:dim | g:m7 c:7 | f1*2:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
