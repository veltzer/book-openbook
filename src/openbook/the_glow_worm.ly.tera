{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 3 {

		\myMark "A"
		\startPart
		c1 | g:7 | g:7 | c | \myEndLine
		c2/e ees:dim7 | g1:7/d | d2:m7 g:7 | c1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c1 | g:7 | g:7 | c | \myEndLine
		c | d:7 |

	} \alternative {
		{
			g:7 | c | \myEndLineVoltaNotLast
		}
		{
			c/g | c/g | des:9 | des:9 | \myEndLine
			c | d2:m7 des:7.9+ | c1 | c | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "End"
	\startPart
	g1:7 | c | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
