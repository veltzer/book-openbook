		f1*3 | f1:7 | \myEndLine
		bes1*2 | f4 aes:dim7 g:m7 c:7 | f1 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1*3 | f1:7 | \myEndLine
		bes1*2 | f4 aes:dim7 g:m7 c:7 | f2 ges4:maj7 f | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2:m7 f:7 | c:m7 f:7 | bes f:7.5+ | bes1 | \myEndLine
		d2:m7 g:7 | d:m7 g:7 | g1:m7 | c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1*3 | f1:7 | \myEndLine
		bes1*2 | f4 aes:dim7 g:m7 c:7 |
	} \alternative {
		{
			f2 g4:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
