{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees2.*2 | ees2.:maj7 | ees2.:6 | \myEndLine
		ees2. | e2.:dim7 | f2.:m7 | bes2.:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f2.:m7 | bes2.:7 | f2.:m7 | bes2.*2:7 | \myEndLine
		bes2.:7.5+ | ees2 e4:dim7 | f2:m7 bes4:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees2.*2 | g2.:m7.5- | c2.:7 | \myEndLine
		f2.:m | c2.:7 | f2.:m | f2:m c4:7.9- | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		f2.:m | des2.:9 | ees2. | c2.:7.5+ | \myEndLine
		f2.:9 | f4:m7 bes:7 bes:7.5+ |
	} \alternative {
		{
			ees2. | f2:m7 bes4:7.5+ | \myEndLineVoltaNotLast
		}
		{
			ees2.*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Andante" 4 = 80
	\time 3/4
	\key ees \major

	\partial 4 bes'4 |

	\repeat volta 2 {
		% part "A"
		ees d c | bes g ees | d2. | c2 bes4 |
		g'2.~ | g4 bes, bes | aes'2.~ | aes2 c4 |

		% part "B"
		ees d c | bes aes f | c2. | d2 bes4 |
		f'2 bes4 | fis2 bes4 | g2.~ | g2 c4 |

		% part "A"
		ees d c | bes g ees | des2. | c2 c'4 |
		aes2 c4 | g2 c4 | f,2.~ | f2 e!4 |

		% part "C"
		f g aes | ces4 ees4. f8 | f4 ees bes | aes2\fermata c8 c |
		g4 c c, | g' bes c |
	} \alternative {
		{
			ees2.~ | ees4 r bes |
		}
		{
			ees2.~ | ees2\fermata r4 |
		}
	}
}
{% endif %}
