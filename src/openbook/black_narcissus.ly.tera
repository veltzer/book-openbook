{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	aes2.:m7 | des:7 | aes:m7 | des:7 | \myEndLine
	aes:m7 | des:7 | aes:m7 | des:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	ges:m7 | ces:7 | ges:m7 | ces:7 | \myEndLine
	ges:m7 | ces:7 | ges:m7 | ces:7 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	ees:maj7.11+ | f:maj7.11+ | bes:maj7.11+ | c:maj7 | \myEndLine
	ees:maj7.11+ | f:maj7.11+ | bes:maj7.11+ | bes4:maj7.11+ c2:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
