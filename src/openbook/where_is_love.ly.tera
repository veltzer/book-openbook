		c8 d e f d4. e8 | e1 | e8 f g a f4. g8 | g1 |
		f8 g a b g4. a8 | a4 bes8 f~ f4. g8 | g4 aes8 ees~ ees4 c | g'1 |
	}

	% part "B"
	\repeat volta 2 {
		c,8 d e f f4. g8 | g1 | f8 g a b b4. c8 | g1 |
		f8 g a b b4. a8 | b4 c g2 | a4 bes f2 | gis4 a e2 |
		f8 g a b c2 | a8 b c d a4 b |
	} \alternative {
		{
			c1~ | c2. r4 |
		}
		{
			c1~ | c1 |
		}
	}
}
{% endif %}
