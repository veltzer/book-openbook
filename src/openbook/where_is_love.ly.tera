{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2 d4:m7 g:7 | c2:maj7 c:6 | c2 d4:m7 g:7 | c2:maj7 c:6 | \myEndLine
		d4:m7 g:7 c4.:7 f8:7 | bes2:maj7 ees:9 | aes1:maj7 | d2:m7 g:7 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		c2:6 d4:m7 g:7 | c2:maj7 cis:dim7 | d2:m7 g:7 | c2 a:7.9- | \myEndLine
		d2:m7 g:7 | c2:maj7 f:9 | bes2:maj7 bes:6 | a2 a:7 | \myEndLine
		d1:m7 | d2:m7 g:7 |
	} \alternative {
		{
			c1*2 | \myEndLineVoltaNotLast
		}
		{
			c1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
