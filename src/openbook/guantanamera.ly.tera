{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	g2 c2 |
	d2:7 c2 |
	g2 c2 |
	d1:7 c1 | \myEndLine
	g2 c2 |
	d2:7 c2 |
	g2 c2 |
	d2:7 c2 | \myEndLine
	g2 c2 |
	d2:7 c2 |
	g2 c2 |
	d2:7 c2 | \myEndLine
	g2 c2 |
	d2:7 c2 |
	g2 c2 |
	d2:7 c2 | \myEndLine
	g2 a2:m |
	d2:7 c2 |
	g2 a2:m |
	d2:7 c2 | \myEndLine
	}
	d2:7 c2 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	\repeat volta 2 {
	\mark \markup { \box { A } } e''4 e''8 e''8 e''8 e''4. |
	r2 r8 c''8 e''8 c''8 |
	d''4 e''8 c''8 d''8 d''4. |
	R1 |
	b'4 c''8 d''8 e''4. d''8 ~ |
	d''2 r8 e''8 c''8 a'8 |
	g'4 g'8 fis'8 e'4. d'8 ~ ^ "To Coda" |
	d'2 r8 g'8 a'8 g'8 |
	\mark \markup { \box { B } } a'4 a'8 g'8 a'8 a'4. |
	r2 r8 a'8 b'8 c''8 |
	b'4 g'8 e'8 a'8 a'4. |
	r2 r8 g'8 a'8 g'8 |
	a'4 a'8 g'8 a'8 a'4. |
	r2 r8 d''8 d''8 d''8 |
	d''2 ~ d''8 a'4 g'8 |
	a'8 a'8 r4 r8 a'8 b'8 c''8 |
	d''4 d''8 d''8 e''4. d''8 ~ |
	d''2 r8 e''8 c''8 a'8 |
	g'4 g'8 fis'8 e'4. d'8 ~ |
	d'2 r2 |
	}
	\mark \markup { \musicglyph "scripts.coda" } d'2 r2 |
	\endBar
}
{% endif %}
