{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees1*2:9.11+ | bes1*2:6 | \myEndLine
		c1:m7 | f:7 | bes2:6 a4:7 aes:maj7 | s4 a4:7 bes2:6 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		d2:m7.5- g:7 | g1:7 | c2:m/ees g:7/d | c1:m | \myEndLine
		g2:m7 c:7 | c1:7 | ges:9.11+ | f:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1*2:9.11+ | bes1*2:6 | \myEndLine
		c1:m7 | f2:7 c:m6/ees | d1:7 | g:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		c1:m7 | ees:m7 | bes2:6/f d:m7.5- | g2:7.9- c4:7.5- f:7 | \myEndLine
	} \alternative {
		{
			bes2 c:9 | f2:7.5+ r2 | \myEndLineVoltaNotLast
		}
		{
			bes2:6 ges | bes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 2/2
	\key bes \major

	\partial 2 \tuplet 3/2 { bes4 d f } |

	\repeat volta 2 {

		% part "A"
		a4 a2. | r4 c \tuplet 3/2 { c4 bes a } | g1~ | g4 r \tuplet 3/2 { c,4 ees g } |
		d'4 d2. | r4 c \tuplet 3/2 { c4 bes a } | g1~ | g2 r4 f |

		% part "B"
		\tuplet 3/2 { aes4 bes aes } g4 d~ | d4 d \tuplet 3/2 { d4 cis d } | g1~ | g2 r4 a |
		\tuplet 3/2 { bes4 a bes } a4 g~ | g4 a \tuplet 3/2 { bes4 a bes } | c1~ | c4 r \tuplet 3/2 { bes,4 d f } |

		% part "A"
		a4 a2. | r4 c \tuplet 3/2 { c4 bes a } | g1~ | g4 r \tuplet 3/2 { c,4 ees g } |
		d'4 d2. | r4 c \tuplet 3/2 { c4 a c } | d1~ | d2 r4 d |

		% part "C"
		\tuplet 3/2 { c4 d c } \tuplet 3/2 { g4 g bes } | \tuplet 3/2 { ees,4 ges bes } des4. ces8 |
		\tuplet 3/2 { bes4 f d } aes'8 aes4.~ | aes4 r8 g ges des'4 f,8 |
	} \alternative {
		{
			bes1 | r2 \tuplet 3/2 { bes,4 d f } |
		}
		{
			bes1~ | bes2. r4 |
		}
	}
}
{% endif %}
