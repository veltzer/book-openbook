{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\repeat volta 3 {

		\myMark "A"
		\startPart
		f2 c:7 | f1 | f2/a aes:dim7 | c2/g c4:7 d:7 | \myEndLine
		g2:m d:7 | g2.:m aes4:dim7 | g2:m7 c:7 | \myEndLine
	} \alternative {
		{
			f2 g4:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	c1 | cis:dim7 | d2:m7 g:7 | c1 | \myEndLine
	c1 | e2:m7 a:7 | d:7 g:7 | c2 c4:dim7 c:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 2/2
	\key f \major

	\partial 4 c8 c |

	\repeat volta 3 {

		% part "A"
		c'8^\markup { \musicglyph #"scripts.segno" } c bes4 a g | f c2 c8. c16 | g'4. f8 g4. f8 | e4 c2 d8 d |
		d'8 d c4 bes a | g2. e'8. d16 | c4 c8. bes16 a4 a8. g16 |
	} \alternative {
		{
			f2. c4 |
		}
		{
			f2. e8.^\markup { To next Strain } f16 |
		}
		{
			f2. r4^\markup { \italic { Fine } } |
		}
	}

	% part "B"
	g8. a16 g4 e c' | g2. e8. bes'16 | f4 f8. e16 d4 c8. d16 | e2. e8. f16 |
	g4 a8. g16 e4 c' | g1 | c8. b!16 a4 bes a8. bes16 | c2. c,4^\markup { \italic { D.S. al Fine } } |
}
{% endif %}
