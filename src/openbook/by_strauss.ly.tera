{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s4 c2:7 |
	\repeat volta 2 {
	g2.:m7 |
	c2.:9 |
	f2. | \myEndLine
	s2. |
	g2.:m7 |
	c2:7 c4:9.5+ |
	f2.:6 | \myEndLine
	s2 d4:m6 |
	e2:7 e4:m7 |
	a2:7 a4:m7 |
	d2.:7 | \myEndLine
	g2.:m |
	d2.:m7 |
	g2.:7 |
	g2.:7.5- | \myEndLine
	c2.:7 |
	g2.:m7 |
	c2.:9 |
	f2. | \myEndLine
	s2. |
	g2.:m7 |
	c2:7 c4:9.5+ |
	f2.:6 | \myEndLine
	s2 f4:7 |
	bes2 des4 |
	s2 ees4:7 |
	f2. | \myEndLine
	s2 f4:dim |
	g2.:m7 |
	c2:9 c4:aug7 |
	f2. | \myEndLine
	f2:7 d4:7 |
	g2.:m |
	c2:7 bes4 |
	} \alternative {
	{
	f2. | \myEndLine
	des4:7 c2:7 | \myEndLineVoltaNotLast
	}
	{
	f2 c4:9 |
	f2. | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
