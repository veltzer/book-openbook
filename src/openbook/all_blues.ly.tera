{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	g2.*4:7 | \myEndLine
	c2.*2:7 | g2.*2:7 | \myEndLine
	d2.:7.9+ | ees4.:7.9+ d:7.5+.9+ | g2.*2:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4. = 50
	\time 6/8
	\key c \major

	% part "A"
	b'4.~ b4~ b16 d, | b'16 c b4~ b4~ b16 d, | b'16 c b4~ b4~ b16 d, | b'4.~ b4 r8 |
	a4 bes8 c4 d8 | c4 bes8 a4~ a16 d, | b'!2. | g4.~ g4~ g16 gis |
	a2. | bes2. | a4. b! | a4. g |
}
{% endif %}
{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	g2.*4:7 | \myEndLine
	c2.*2:7 | g2.*2:7 | \myEndLine
	d2.:7.9+ | ees4.:7.9+ d:7.9+ | g2.*2:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4. = 50
	\time 6/8
	\key c \major

	% part "A"
	b'4. ~ b4 ~ b16 d, | b' c b4 ~ b ~ b16 d, | b' c b4 ~ b ~ b16 d, | b'4. ~ b4 r8 |
	a4 bes8 c4 d8 | c4 bes8 a4 ~ a16 d, | b'!2. | g4. ~ g4 ~ g16 gis |
	a2. | bes | a4. b! | a g |
}
{% endif %}
