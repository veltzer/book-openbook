{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	g2.:maj7 |
	gis2.:dim7 |
	a2.:m7 |
	d2:13 d4:9 | \myEndLine
	g2./b |
	bes2.:dim7 |
	a2.:m7 |
	d2:sus4.7 d4:7 | \myEndLine
	g2.:6 |
	g2 f4:9 |
	e2.:9 |
	f2:9 e4:7 | \myEndLine
	a4:m a2:m9 |
	} \alternative {
	{
	a2:9 dis4:7 |
	d2.:7 |
	d2.:aug7 | \myEndLineVoltaNotLast
	}
	{
	d4:13 d2:9 | \myEndLineVoltaLast
	}
	}
	g2.:maj7 |
	s2. |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Swing" 4 = 144
	\time 3/4
	\key g \major

	\repeat volta 2 {
	d''2 b'4 |
	d''2 b'4 |
	d''4 b'4 d''4 |
	b'2 a'4 |
	g'2 e'4 |
	g'2 e'4 |
	g'4 e'4 g'4 |
	e'2 d'4 |
	e'4 g'2 ~ |
	g'4 r4 g'4 |
	gis'4 b'2 ~ |
	b'4 r4 b'4 |
	c''4 e''2 |
	} \alternative {
	{
	e'2 g'4 |
	a'2. ( |
	bes'2. ) |
	}
	{
	b'4 b'2 |
	}
	}
	g'2. ~ |
	g'2 r4 |
	\endBar
}
{% endif %}
