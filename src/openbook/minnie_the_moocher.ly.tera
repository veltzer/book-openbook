{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	e1:m |
	a2:m e2:m |
	b1:7 | \myEndLine
	e2:m b2:7 |
	e1:m |
	a4.:m e2:m b8:7/fis |
	e4:m/g a4:m6/fis b2:7 | \myEndLine
	e4:m b8:7 e1*5/8:m |
	e1:m |
	s1 |
	e1:m | \myEndLine
	s1 |
	e1:m |
	s1 |
	} \alternative {
	{
	e4:m b4:7 e2:m | \myEndLine
	s4 a4:m6/fis e4:m b4:7 | \myEndLineVoltaNotLast
	}
	{
	s4 b8:7 e1*5/8:m |
	s2. b4:7 |
	e4:m a4:m6/fis b4:7 b4:7 | \myEndLine
	e1:m | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	r4 r4 r4 b'4 |
	\repeat volta 2 {
	e'4 g'4 b'8 b'4 b'8 |
	e''8 e''4 c''8 b'8 g'4. |
	b'8 b'4 c''8 b'4 a'4 |
	g'4 c''4 b'8 fis'4. |
	e'8 e'4 g'8 b'8 b'4. |
	e''8 c''4 b'2 b'8 |
	e''8 e''8 c''8 c''8 b'4 a'4 - "Ddim" |
	g'8 e'8 fis'8 e'8 ~ e'8 e''4 b'8 |
	e''8 b'4 e''8 ~ e''2 ~ |
	e''2 ~ e''8 b'4 g'8 |
	b'8 g'4 b'8 ~ b'2 ~ |
	b'2 ~ b'8 e''4 b'8 |
	e''8 b'4 e''8 ~ e''2 ~ |
	e''2 ~ e''8 g'4 e'8 |
	} \alternative {
	{
	g'8 e'8 fis'8 e'8 ~ e'2 ~ |
	e'4 ~ e'4 ~ e'4 b'4 |
	}
	{
	g'8 e'8 fis'8 e'8 ~ e'2 ~ |
	e'2. g'4 |
	e'4 c''4 b'4 b'4 |
	e''1 |
	}
	}
	\endBar
}
{% endif %}
