{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes2. | c:m7 | d:m7 | g:7.9- | c:m7 | f:7 | c:m7 | f:7 | c:m7 | f:7 | \myEndLine
		c:m7 | f:7 | bes:maj7 | bes:6 | bes:maj7 | bes:6 | bes:maj7 | bes:6 | bes:maj7 | bes:6 | \myEndLine
	} \alternative {
		{
			a:m7 | d:7 | a:m7 | d:7 | g:m | g:m7+ | g:m7 | c:7 | c2.*2:m7 | f2.*2:7 | \myEndLineVoltaNotLast
		}
		{
			a2.:m7 | d:7 | g:maj7 | g:7 | c:m7 | g:7.9- | c:m7 | f:7 | bes2.*4 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
