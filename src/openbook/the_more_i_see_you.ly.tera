{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 2. bes2.:7 |

	\repeat volta 2 {

	\myMark "A"
	\startPart
	ees2:6 f:m7 | ees2:6/g c:7.9- | f1:m7 | bes:7 | \myEndLine
	ees2:6 f:m7 | ees2:6/g c:7.9- | f1:m7 | bes:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	ees2:m7 bes:7/d | des2:m7 ges:9 | ces1:maj7 | bes:7.5+ | \myEndLine
	ees2:m7 ees:m7/des | c2:m7 f:9 | bes1:9sus4 | bes:7 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	ees2:6 f:m7 | ees2:6/g c:7.9- | f1:m7 | bes:7 | \myEndLine
	ees2:6 f:m7 | ees2:6/g bes:9.5+ | bes1:m9 | ees:9 | \myEndLine
	\endPart

	\myMark "D"
	\startPart
	aes1:maj7 | des:9 | g:m7 | c2:m7 f:7 | \myEndLine
	ees1:6/bes | bes2:9sus4 bes:9 | ees1:6 | f2:m7 bes:9sus4 | \myEndLine
	\endPart

	}

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Medium Ballad" 4 = 100
	\time 4/4
	\key ees \major

	\partial 2. bes4 ees4. d8 |

	\repeat volta 2 {

	% part "A"
	ees2 bes~ | bes4 ees bes'4. a8 | bes2 f~ | f4 bes, ees4. d8 |
	ees2 bes~ | bes4 ees bes'4. a8 | bes1 | r4 bes bes bes |

	% part "B"
	bes2 bes4 bes | bes4 des bes4. aes8 | ges2 ges~ | ges4 bes ges4. f8 |
	ees2 ees~ | ees4 g! ees4. c8 | bes'1 | r4 bes, ees4. d8 |

	% part "C"
	ees2 bes~ | bes4 ees bes'4. a8 | bes2 f~ | f4 bes, ees4. d8 |
	ees2 bes~ | bes4 ees c'4. bes8 | c1 | r4 bes aes g |

	% part "D"
	ees'4 c bes aes | ces4 aes ees f | bes2 bes,~ | bes4 bes ees4. aes8 |
	g2 bes,~ | bes4 g' ees f | ees1 | r4 bes ees4. d8 |

	}
}
{% endif %}
