{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	c2 a2:m |
	e1:m |
	f2:6 g2:7 |
	c2 a2:7 | \myEndLine
	d4:m d4:m7 g2:7 |
	c2 c4 a4:m |
	e4:m c4 f4 c4 |
	g4 g4:7 e8:m7 c8 g8:7 c8 | \myEndLine
	} \alternative {
	{
	c2:m a2:m |
	d2:m7 g2:7 | \myEndLineVoltaNotLast
	}
	{
	c2:m a2:m | \myEndLineVoltaLast
	}
	}
	d1:m7 | \myEndLine
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	\repeat volta 2 {
	\once \omit TupletBracket \times 2/3 { c''8 c''8 c''8 } \once \omit TupletBracket \times 2/3 { c''8 c''8 c''8 ~ } c''4 \once \omit TupletBracket \times 2/3 { a'8 b'8 c''8 } |
	\once \omit TupletBracket \times 2/3 { b'8 b'8 ~ b'8 ~ } b'2. |
	\once \omit TupletBracket \times 2/3 { a'8 a'8 a'8 } \once \omit TupletBracket \times 2/3 { a'8 a'8 a'8 } a'4 \once \omit TupletBracket \times 2/3 { f'8 g'8 a'8 } |
	g'2 a'2 |
	f'8 r8 \once \omit TupletBracket \times 2/3 { e'8 f'8 e'8 } d'4 ~ \once \omit TupletBracket \times 2/3 { d'8 e'8 f'8 } |
	\times 2/3 { g'8 -. g'4 ~ } \once \omit TupletBracket \times 2/3 { g'8 e'8 g'8 } \times 2/3 { a'8 -. a'4 ~ } \once \omit TupletBracket \times 2/3 { a'8 e'8 a'8 } |
	\times 2/3 { b'8 -. b'4 ~ } \once \omit TupletBracket \times 2/3 { b'8 g'8 b'8 } \times 2/3 { c''8 -. c''4 ~ } \once \omit TupletBracket \times 2/3 { c''8 g'8 c''8 } |
	d''2 \once \omit TupletBracket \times 2/3 { b'8 b'8 c''8 } \once \omit TupletBracket \times 2/3 { d''8 c''8 b'8 } |
	} \alternative {
	{
	c''1 ~ |
	c''1 |
	}
	{
	c''1 ~ |
	}
	}
	c''1 |
	\endBar
}
{% endif %}
