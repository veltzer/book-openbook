{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		g2.*2 | a2.:m7 | d2.:7 | \myEndLine
		d2.*2:7 | g2.*2 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g2. | bes2.:dim7 | a2.:m7 | d2.:7 | \myEndLine
		a2.:m7 | d2.:7 | g2.*2 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		g2.*2 | a2.:m7 | d2:7 d4:7/c | \myEndLine
		b2.*2:7.9- | e2:7 f4:7 | e2.:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		e2.*2:7 | a2.:9 | cis2.:dim7 | \myEndLine
		g2. | d2.:7 |
	} \alternative {
		{
			g2 bes4:dim7 | a2:m7 d4:7.9- | \myEndLineVoltaNotLast
		}
		{
			a2:m7 a4:m7/d | g2. | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Adagio" 4 = 80
	\time 3/4
	\key g \major

	\repeat volta 2 {
		% part "A"
		b'8. d,16 g8. b16 a8. g16 | b8. d,16 g8. b16 a8. g16 | a2.~ | a2. |
		a8. d,16 fis8. a16 g8. fis16 | a8. d,16 fis8. a16 g8. fis16 | g2.~ | g2. |

		% part "B"
		d4 e g | fis4 e d | c'2.~ | c4 b a |
		c2. | d2. | b2.~ | b2. |

		% part "A"
		b8. d,16 g8. b16 a8. g16 | b8. d,16 g8. b16 a8. g16 | a2.~ | a2. |
		c8. dis,16 fis8. c'16 b8. a16 | c8. dis,16 fis8. c'16 b8. a16 | b2.~ | b2. |

		% part "C"
		e,4 gis b | d4 c b | b4. a8 g8. fis16 | e2. |
		b'8. d,16 g8. b16 a8. g16 | a8. d,16 fis8. a16 g8. fis16 |
	} \alternative {
		{
			g2.~ | g4 r r |
		}
		{
			g2.~ | g2 r4 |
		}
	}
}
{% endif %}
