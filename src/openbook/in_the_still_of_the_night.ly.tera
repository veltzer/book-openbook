{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1*2 | f1*2:m6 | f1*2 | f1*2:m6 | \myEndLine
		g1*2:m7 | c1*2:7 | f1*2 | g1:m7 | c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1*2 | f1*2:m6 | f1*2 | f1:m6 | e:7 | \myEndLine
		a1*2:m | e1*2:7 | a1*2:m | c1*2:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f1*2 | bes1*2 | g2:m7 c:7 | c1:7 | f1*2 | \myEndLine
		f1 | f1:aug | bes1*2 | c1*2:7 | a1:m7.5- | d:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		a2:m7 d:7 | a2:m7 d:7 | g1*2:m | bes1*2:m6 | \myEndLine
		f1*2 | b1*2:dim7 | c1*2:9 | f1*2 | \myEndLine
		aes1*2:dim7 | g1*2:m7 | c1*2:7 |

	} \alternative {
		{
			f1*2 | f1*2:m6 | \myEndLineVoltaNotLast
		}
		{
			f1*2 | f1*2:m6 | f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 132
	\time 2/2
	\key f \major

	\repeat volta 2 {

		% part "A"
		r2 c4 d | f2 e4 f | d1~ | d1 | r2 c4 d | f2 e4 f | d1 | d1 |
		r2 cis4 d | bes'2 a4 bes | g2. a4 | bes2 c | c2. c4 | c1~ | c1~ | c4 r r2 |

		% part "A"
		r2 c,4 d | f2 e4 f | d1~ | d1 | r2 c4 d | f2 e4 f | d1 | e1 |
		r2 dis4 e | a2 gis4 a | fis2. gis4 | a4 b! c d | e2. e4 | e1~ | e1~ | e2. r4 |

		% part "B"
		f1~ | f2. e4 | e1 | d1 | r2 e,2 | d'2. c4 | c1~ | c2. r4 |
		f1 | f2. e4 | e2. d4 | d1 | r2 e,2 | d'2. c4 | c1~ | c2. r4 |

		% part "C"
		r2 a2 | d2. c4 | c2. bes4 | bes1 | bes1~ | bes2 f4 g | a1~ | a2 c,4 d |
		f1~ | f2 e4 f | d1~ | d2 c4 d | f1~ | f2 e4 f |
		d1~ | d2 c4 d | f1~ | f1 | g1~ | g2 a4 bes |
	} \alternative {
		{
			c1~ | c1~ | c1~ | c2 r2 |
		}
		{
			c1~ | c1~ | c1~ | c1~ | c4 r r2 |
		}
	}
}
{% endif %}
