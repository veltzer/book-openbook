{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1 | bes2./f f4 | f1 | g2:m7 c:7 | \myEndLine
		f1/a | aes1:dim7 | c1:7/g | c1:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1:m | d1:7 | g1:m | c1:7 | \myEndLine
		c1:7 | g2:m7 c:7.5+ | f2 fis:dim7 | g2:m7 c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | bes2./f f4 | f1 | g2:m7 c:7 | \myEndLine
		f1/a | aes1:dim7 | bes1 | bes1 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		bes1 | bes1:m6 | f2 ees:9 | d2:7.5+ d:7 | \myEndLine
		g1:7 | g2:m7 c:7 |
	} \alternative {
		{
			f1 | g2:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			f1 | f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 2 = 80
	\time 2/2
	\key f \major

	\repeat volta 2 {

		% part "A"
		a'1 | bes2. a4 | g2 f~ | f4 r c2 |
		d4 e f2 | d4 e f2 | e1~ | e2. r4 |

		% part "B"
		bes'1 | c2. bes4 | a2 g~ | g4 r d2 |
		e4 f g2 | d2 e | c1~ | c2 r |

		% part "A"
		a'1 | bes2. a4 | g2 f~ | f4 r c2 |
		d4 e f2 | d4 e f2 | g1~ | g2. r4 |

		% part "C"
		d'1 | c2. bes4 | a2 bes~ | bes2 a |
		g2 d~ | d2 e |
	} \alternative {
		{
			f1~ | f4 r r2 |
		}
		{
			f1~ | f4 r r2 |
		}
	}
}
{% endif %}
