{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		d1:maj7 | bes:dim7 | a:m7 | d:7.9- | \myEndLine
		g1:maj7 | g:m6 | fis2:13 fis:7.5+ | b:9sus4 b:7.9- | \myEndLine
		e2:9sus4 e:9 | bes:7 a:7 | d:m7 g:7 | d:m7 g:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		d1:maj7 | bes:dim7 | a:m7 | d:7.9- | \myEndLine
		g1:maj7 | g:m6 | fis2:13 fis:7.5+ | b:9sus4 b:7.9- | \myEndLine
		e2:9sus4 e:9 | bes:7 a:7 | d:m7 g:7 | d:m7 g:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1:m7 | c:9/bes | a:m7 | a:m7 | \myEndLine
		bes1:9sus4 | bes:9/aes | g:m7 | a:7.5+.9- | \myEndLine
		\endPart

