{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1:7 | c1:7 | c1:7 | c1:7 | \myEndLine
		f1:7 | f1:7 | c1:7 | e2:m7 a:7 | \myEndLine
		d1:m7 | g1:7 | c1:7 | d2:m7 g:7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
