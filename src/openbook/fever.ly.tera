{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 5 {
		a1*4:m | \myEndLine
		a1*2:m | e1:7 | \myEndLine
		a4:m r2. | a1*2:m | f1:6 | \myEndLine
		a1*3:m | e1:7 |
	} \alternative {
		\volta 1,3,4 {
			a1:m | \myEndLineVoltaNotLast
		}
		\volta 2 {
			a1*4:m | \myEndLine
			a1*2:m | e1:7 | a1:m | \myEndLineVoltaNotLast
		}
		\volta 5 {
			a1:m | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 132
	\time 2/2
	\key a \minor

	% part "A"
	\repeat volta 5 {
		r8 d \tuplet 3/2 { c d c } d4 a | c4 d r2 | d8. c16 d8. c16 d8. c16 a4 | a4 r r2 |
		d8. c16 d8. c16 d4 a8 a | c4 d \parenthesize a a8 a | d8. c16 d8. c16 d8. c16 a4 |
		a8. a16 a8 a c4 a | r1 | r4 ees'8. c16 d4 c | d8. c16 d8. c16 d8. c16 a4 |
		a4 r r2 | gis'8 a4 r8 r4 d,8. c16 | d8 c4 r8 r2 | d8. c16 ees4 d8. c16 a4 |
	} \alternative {
		\volta 1,3,4 {
			a4 r r2 |
		}
		\volta 2 {
			r4 c8. a16 a4 g | r4 a8. g16 a4 c | r4 c8. a16 a4 g | a4 g a2 |
			r4 c8. a16 a4 g | r4 a8. g16 a4 c | d8. c16 d8. c16 d8. c16 a4 | a4 r r2 |
		}
		\volta 5 {
			a4 r r2 |
		}
	}
}
{% endif %}
