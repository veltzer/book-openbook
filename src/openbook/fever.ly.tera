{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 5 {
		a1*4:m | \myEndLine
		a1*2:m | e1:7 | \myEndLine
		a4:m r2. | a1*2:m | f1:6 | \myEndLine
		a1*3:m | e1:7 |
	} \alternative {
		\volta 1,3,4 {
			a1:m | \myEndLineVoltaNotLast
		}
		\volta 2 {
			a1*4:m | \myEndLine
			a1*2:m | e1:7 | a1:m | \myEndLineVoltaNotLast
		}
		\volta 5 {
			a1:m | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
