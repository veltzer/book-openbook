{% endif %}
{% if part == "Doc" %}	DONE:
	- converted the Laurent Martelli version from staging/openbook/laurent/line_for_lyons.ly.
	TODO:
	- check the tune and chords against a real book.
	- the source has no tempo marking, the tempo is a guess.
	- the source goes to the coda after bar 6 of the last A; here the last A is written in full and the coda follows it.
	- the octave of the second ending and of the B section are taken so they continue from the main body (the old lilypond octave rules), check them.
	- add youtube performances.
{% endif %}
{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g2:6 g:7.9- | c:m7 f:7 | b:m7 e:7 | a:m7 d:7 | \myEndLine
		g:maj7 e:7 | a:m7 d:7 |
	} \alternative {
		{
			g:6 e:7 | a:m7 d:7 | \myEndLineVoltaNotLast
		}
		{
			g1:6 | g:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	c1:maj7 | cis2:m7.5- fis:7.9- | b1:m7 | b2:m7 e:7.9- | \myEndLine
	a1:m7 | a2:m7 d:7.9- | b:m7 e:7 | a:m7 d:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	g2:6 g:7.9- | c:m7 f:7 | b:m7 e:7 | a:m7 d:7 | \myEndLine
	g:maj7 e:7 | a:m7 d:7 | g1:6 | a2:m7 d:7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	g2:6 e:7 | a:m7 d:7 | g:6 e:7 | a:m7 d:7 | g1:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 132
	\time 4/4
	\key g \major

	% part "A"
	\repeat volta 2 {
		g'8 b d g f4 d8 ees ~ | ees2 r8 f ees d |
		r ees d d r e d des | c d c c ~ c2 |
		b8 c b d ~ d4 g,-. | a8 b a c ~ c4 fis,8 g ~ |
	} \alternative {
		{
			g4. d'8 ~ d2 ~ | d2. r4 |
		}
		{
			g,1 | r4 g8 a b c d dis |
		}
	}

	% part "B"
	e1 ~ | \tuplet 3/2 { e4 dis e } g fis |
	d1 ~ | \tuplet 3/2 { d4 cis d } f e |
	c1 | r8 b c ees ~ ees4 d | b2 r8 d c a ~ | a2. r4 |

	% part "A"
	g8 b d g f4 d8 ees ~ | ees2 r8 f ees d |
	r ees d d r e d des | c d c c ~ c2 |
	b8 c b d ~ d4 g,-. | a8 b a c ~ c4 fis,8 g ~ |
	g1 | r1 |

	% part "Coda"
	g4. d'8 ~ d2 | r8 gis, a b c4 fis,8 g ~ |
	g4. d'8 ~ d2 | r8 gis, a b c4-. g8 fis ~ | fis1\fermata |
}
{% endif %}
