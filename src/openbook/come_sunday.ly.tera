	\endPart

	\repeat volta 3 {

		\myMark "B"
		\startPart
		d2:7 ees:7 | d:9 d:7.9-.5+ | g1:m7 | c:9 | \myEndLine
		f2:7 c:m7 | f:7 bes4:sus4 g:7.5+ | c1:9 | f:7.5+ | \myEndLine
		\endPart

