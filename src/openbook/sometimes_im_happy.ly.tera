	\tempo "Allegro" 2 = 110
	\time 2/2
	\key f \major

	\repeat volta 2 {
		% part "A"
		r4 gis' a a | a bes2. | r4 gis a a | a g2. |
		r4 gis a a | a bes2. | r4 gis a a | a g2. |

		% part "B"
		r4 gis a c | ees2 ees | d4 e, f des'~ | des1 |
		r4 e, f a | c2 c | bes4 f a g~ | g1 |

		% part "A"
		r4 gis a a | a bes2. | r4 gis a a | a g2. |
		r4 gis a a | a bes2. | r4 gis a a | a g2. |

		% part "C"
		r4 gis a c | ees2 ees | d4 e, f des'~ | des1 |
		r4 gis, a c | bes g a2 |
	} \alternative {
		{
			f1~ | f2 r |
		}
		{
			f1~ | f2 r |
		}
	}
}
{% endif %}
