{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1:maj7 | g:m7/c | f:maj7 | c:7 | \myEndLine
		f1:maj7 | g:m7/c | f:maj7 | c:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f2 f:maj7 | c:m7 ces:7 | bes1:maj7 | bes2:m7 ees:9 | \myEndLine
		f1 | ees2:11 d:9 | g1:m7 | des2:7.11+ c:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1:maj7 | g:m7/c | f:maj7 | c:7 | \myEndLine
		f1:maj7 | g:m7/c | f:maj7 | c:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		f2 f:maj7 | c:m7 ces:7 | bes1:maj7 | bes2:m7 ees:9 | \myEndLine
		f2 f:maj7 | g:m7 c:7.9- | \myEndLine
	} \alternative {
		{
			f1*2:6 | \myEndLineVoltaNotLast
		}
		{
			f1:6 | f:6.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
