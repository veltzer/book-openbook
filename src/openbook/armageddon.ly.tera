{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1:m7 | ges:7 | bes:m7 | ges:7 | \myEndLine
		ees2:7 e:7 | e1:7 | ees:7 | ges:7 | \myEndLine
		bes2:m7 aes:m7 | aes:m7 des:7 | ees1:7 | ges:7 | \myEndLine
		bes:m7 | ges:7 |
	} \alternative {
		{
			bes2.:m7 b4:7 | b1:7 | \myEndLineVoltaNotLast
		}
		{
			bes1:m7 | b:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
