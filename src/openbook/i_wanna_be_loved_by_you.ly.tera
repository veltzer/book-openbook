	}
	c''4 r4 e''8 c''4 d''8 ^ "Fine" |
	c''4 c''4 d''8. des''16 c''4 |
	a'4 ( c''2. ~ |
	c''4 ) c''4 d''8. des''16 c''4 |
	c''4 g'4 ~ g'2 ~ |
	g'4 c''4 d''8. des''16 c''4 |
	a'4 ( c''2 ) a'4 |
	c''2 e''4 c''4 |
	g'4 g'8 g'8 ~ g'8 a'8 b'4 |
	d'8 d'4 e'8 g'4 r4 ^ "D.C. al Fine" |
