{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	d1*4:m7 | d1*4:m7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	d1*4:m7 | d1*4:m7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	ees1*4:m7 | ees1*4:m7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	d1*4:m7 | d1*4:m7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	d1*5:m7 | d1*5:m7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
