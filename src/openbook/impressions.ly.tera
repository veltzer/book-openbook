{% if part == "VoiceReal" %}{
	\tempo "Presto" 4 = 280
	\time 4/4
	\key d \minor

	% part "A"
	d'1~ | d2 e8 g f d~ | d1 | r4 r8 e f4 g |
	a4 c e,2 | d4 f b, d8 a~ | a1 | r2 g'4 f |

	% part "A"
	d1~ | d2 e8 g f d~ | d1 | r4 r8 e f4 g |
	a4 c e,2 | d4 f b, d8 a~ | a1 | r2 f'4. f8~ |

	% part "B"
	f1~ | f4. ees8 aes4 ges | f2 ees | des2 ges4. c,8~ |
	c2 bes8 ees4. | aes,2 ges4 des'8 f,~ | f1 | r2 f'2 |

	% part "A"
	d1~ | d2 e8 g f d~ | d1 | r4 r8 e f4 g |
	a4 c e,2 | d4 f b, d8 a~ | a1^\markup {To Coda \musicglyph #"scripts.coda"} | r1^\markup {D.C. al Coda} |

	% part "Coda"
	a1 | r2 g4. f8~ | f1 | r2 r4 e | d1 |
	r2 r4 c' | b1 | r2 e | a,1~ | a1 |
}
{% endif %}
