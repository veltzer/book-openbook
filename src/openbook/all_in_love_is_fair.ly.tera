{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	d1:m | d:m/c | bes2:maj7 aes:maj7 | g:7sus4 c:7sus4 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		d1:m | d:m/c | b:m7.5- | bes:maj7 | \myEndLine
		a:m7.5- | d:7 | g:m7 | c:7sus4 | \myEndLine

		\myMark "A"
		d1:m | d:m/c | b:m7.5- | bes:maj7 | \myEndLine
		a:m7.5- | d:7.9+ | g:m7 | a2:7sus4 a:7.5+.9+ | \myEndLine

		\myMark "B"
		d1:m | d:m/c | b:m7.5- | bes2:m6 ees:9 | \myEndLine
		f/c d:7 | g:9 c:7sus4 | f1 |
	} \alternative {
		{
			a1:7.9- | \myEndLineVoltaNotLast
		}
		{
			bes2:m6 ees:9 | f/c d:7 | g:7 c:7sus4 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "End"
	\startPart
	f2. | f2.:7/ees | bes2/d a:7/cis | d1:m | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
