{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f2:m f:m/aes | c2:7/g c:7 | aes2:aug aes | g2:m c:7 | \myEndLine
		f1:m | bes:7 | aes4:m c:7 des:7 c:7 | f1:m | \myEndLine
		g2:7.5+ c:9 | f1:m | c:7 | f:m | \myEndLine
	} \alternative {
		{
			des2:7 c:7 | \myEndLineVoltaNotLast
		}
		{
			des2:7 c:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	aes2 a:dim7 | bes2:m7 ees:7 | aes2. bes4:7 | des2:9 c:9 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f2:m f:m/aes | c2:7/g c:7 | f2:m f:m/ees | bes2/d des:7 | \myEndLine
	f1:m/c | g2:7.5+ c:9 | f1:m | c:7 | f:m | \myEndLine
	g2:7.5+.9+ c:9 | f1:m | c:9 | f:m | \myEndLine
	\endPart

	\endSong
	\endChords
}
