		ees4 c c2 | bes4 g g2 | f4 c c c | ees2. r4 |

		% part "A"
		bes4 c c2 | c4 d d2 | d4 ees g bes | f'1 |
		ees4 c c2 | bes4 g g2 | f4 c c c | ees2 r2 |

		% part "B"
		g4 c d ees | aes, c d ees | g, c d ees | g,1 |
		g4 c d ees | ees c c g | bes1~ | bes2 r2 |

		% part "A"
		bes,4 c c2 | c4 d d2 | d4 ees g bes | f'1 |
		ees4 c c2 | bes4 g g2 | f4 c c c |
	} \alternative {
		{
			ees2. r4 |
		}
		{
