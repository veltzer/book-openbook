{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees2 e:dim7 | f:m7 fis:dim7 | ees/g c:m7 | f1:7 | \myEndLine
		ees2/bes c:m7 | g:m7 c:9 | f:7 bes:9 | ees f4:m7 bes:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees2 e:dim7 | f:m7 fis:dim7 | ees c:m7 | f1:7 | \myEndLine
		ees2/bes c:m7 | g:m7 c:9 | f:7 bes:9 | ees g:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c1:m | f:m7 | c:m | f:9 | \myEndLine
		ees2 c:m7 | f1:9 | g2:m7 ges:7 | f:m7 bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees2 e:dim7 | f:m7 fis:dim7 | ees/g c:m7 | f1:7 | \myEndLine
		ees2 c:m7 | g:m7 c:9 | f:7 bes:9 |

	} \alternative {
		{
			ees2 f4:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees2:6 e4:maj7 bes:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
