{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f2.*2 | c2.*2:7 | c2.:7 | c2:7 c4:7.5+ | f2.*2 | \myEndLine
		d2.*2:7 | g2.*2:m | g2.*2:7 | g2.:m7 | c:7.9- | \myEndLine
		f2.*2 | c2.*2:7 | d2.*2:7 | g2.*2:m | \myEndLine
		e2.*2:7 | f4:13 e:7.5+ ees:7.5+ | d2.:7.5+ | g2.:m | c2:sus7 c4:9 |
	} \alternative {
		{
			f2. | g2:m7 c4:7 | \myEndLineVoltaNotLast
		}
		{
			f2.*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
