	}
	}
	aes1 |
	a1:dim |
	ees2..:6 ees8:7 |
	s1 | \myEndLine
	aes1 |
	a1:dim |
	ees1 |
	e4:dim bes2.:7 | \myEndLine
	b1:9 |
	bes1:9 |
	b1:9 |
	bes1:9 | \myEndLine
