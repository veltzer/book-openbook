{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	s8 b2..:9 |
	bes1:9 |
	b1:9 |
	bes1:9 | \myEndLine
