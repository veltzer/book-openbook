	}
	{
	g'4 g'8 es'8 ~ es'4 r4 |
	}
	}
	es'4 es'4 es'4 es'4 |
	es'8 ges'4. r2 |
	c''4 c''4 c''8 bes'8 c''8 bes'8 ~ |
	bes'2 r2 |
	es'4 es'8 c'8 es'4 es'4 |
	es'8 ges'4. ~ ges'4 r8 bes'8 |
	c''4 r4 c''4 r4 |
	des''8 bes'8 des''4 bes'8 c''8 r4 |
	r8 ces'4 des'8 es'8. ges'16 as'8. ges'16 |
	c''4 g'8 c'8 ~ c'4 r4 |
	r8 ces'4 des'8 es'8. ges'16 as'8. ges'16 |
