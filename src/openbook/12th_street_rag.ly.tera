{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1*2 | bes1*2:7 | \myEndLine
		bes1*2:7 | ees1*2 | \myEndLine
	} \alternative {
		{
			ees1*2 | bes1*2:7 | \myEndLine
			f1*2:9 | bes1*2:7 | \myEndLineVoltaNotLast
		}
		{
			ees1 | ees1:7/des | aes1/c | b1:7 | \myEndLine
			ees2/bes c:m7 | f2:9 bes:7 | ees1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		ees1*2 | bes1*2:7 | \myEndLine
		bes1*2:7 | ees1*2 | \myEndLine
	} \alternative {
		{
			ees1*2 | bes1*2:7 | \myEndLine
			f1*2:7 | bes1*2:7 | \myEndLineVoltaNotLast
		}
		{
			ees1 | g1:7 | aes2 a:dim7 | ees2/bes c:m7 | \myEndLine
			f1:9 | bes1:7 | ees1*2 | \myEndLineVoltaLast
		}
	}
	bes1*4:7 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	\repeat volta 2 {
		ees1*2 | bes1*2:7 | \myEndLine
		bes1*2:7 | ees1*2 | \myEndLine
	} \alternative {
		{
			ees1*2 | bes1*2:7 | \myEndLine
			f1*2:7 | bes1*2:7 | \myEndLineVoltaNotLast
		}
		{
			ees1 | ees1:7/des | aes1/c | b1:7 | \myEndLine
			ees2/bes c:m7 | f2:9 bes:7 | ees1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
