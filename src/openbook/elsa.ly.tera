{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	ees2.:7/bes | des:7/bes | ees:m7/bes | f:m7/bes | ees:7/bes | des:7/bes | ees:m7/bes | f:m7/bes | \myEndLine
	e:7/aes | ees:m7/aes | e:7/aes | ees:m7/aes | e:7/aes | ees:m7/aes | e2.*2:7.11+ | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		ees2.:m7 | aes:7 | ees:m7 | aes:7 | des:m7 | ges:7 | des:m7 | ges:7 | b:m7 | \myEndLine
		e:7 | bes:m7 | ees:7 | a:m7 | d:7 | f2.*2:7.11+ | b2.:m7 | \myEndLine
		e:7 | bes2.*2:7 | c2.:m7/bes | bes:m7 | c:m7/bes | bes:m7 | c:m7/bes | bes:m7 | c:m7/bes | bes:m7 | e:maj7/aes | \myEndLine
		ees:m7/aes | e:maj7/aes | ees:m7/aes | e:maj7/aes | ees:m7/aes | e:7 | r2. | \myEndLine
	}
	\endPart

	\myMark "Coda"
	\startPart
	\repeat volta 2 {
		e2.:maj7/aes | ees:m7/aes | e:maj7/aes | ees:m7/aes | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Andante" 4 = 100
	\time 3/4
	\key ees \major

	\partial 4 bes4 |

	% part "A"
	g'2 ees4 | f des2~ | des2.~ | des4 r bes | g'2 ees4 | f bes2~ | bes2.~ | bes4 r r |
	aes2 b!4 | bes ges'2~ | ges2.~ | ges4 r r | aes,2 b!4 | bes ges2 | ees2.~ | ees2. |

	% part "B"
	\key ees \minor
	\repeat volta 2 {
		bes2^\markup { \musicglyph #"scripts.segno" } des4 | c! aes'2 | bes,4. des8 bes des | c!4 aes'2 | aes,2 ces4 | bes ges'2 | aes,4. ces8 aes ces | bes4 ges'2 | fis4. d!8 cis b |
		cis8 d! e!4 fis | f!2 ees8 des | f4 bes2 | e,!4 fis g! | fis g! a! | c2 a!8 f | c'2 a!8 f | cis'4 b! fis |
		cis'2 b!8 fis | d'!2 c!4 | g!2 c,!4 |
		\key ees \major
		r2. | r2. | r2. | r2. | r2. | r2. | r2. | r2. | r2.^\markup { To Coda \musicglyph #"scripts.coda" } |
		r2. | r2. | r2. | r2. | r2. | r2. | r2.^\markup { D.S. al Coda } |
	}

	% part "Coda"
	\repeat volta 2 {
		r2.^\markup { \musicglyph #"scripts.coda" } | r2. | r2. | r2.^\markup { Repeat and Fade } |
	}
}
{% endif %}
