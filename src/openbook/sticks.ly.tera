{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\partial 4 bes'8 ^ "blues shuffle" as'8 |
	bes'4 r4 r4 r8 bes'8 |
	R1 |
	r4 bes'8 bes'8 des''8 es''8 ~ es''4 |
	f''8 as''8 ~ as''4 \once \omit TupletBracket \times 2/3 { fes''8 es''8 des''8 } bes'8 as'8 |
	bes'4 r4 r4 r8 bes'8 |
	R1 |
	r4 bes'8 bes'8 des''8 es''8 ~ es''4 |
	f''8 as''8 ~ as''4 \once \omit TupletBracket \times 2/3 { fes''8 es''8 des''8 } bes'8 as'8 |
	es''4 r8 e''4 r8 f''4 |
	R1 ^ "drum fill" |
	es''4 r8 e''4 r8 - "" f''4 - "" |
	R1 ^ "drum fill" |
	es''4 r4 ^ "drum fill" r4 f''4 |
	r2 _ "Solo on Bb 12 bar Blues" r4 bes'8 <as' a'>8 |
	\endBar
}
{% endif %}
