	c2 c2:6 |
	ees2:9 d2:7.9- |
	g2 g2:maj7 | \myEndLine
	g1:9 |
	c2 c2:6 |
	ees1:9 |
	a2:m7 d2:7 | \myEndLine
	a2:m7 d2:7.9- |
	g2 e2:m7 |
	a2:m7 d2:7.9- |
	g2:maj7 b2:m | \myEndLine
	a2:m7 d2:9 |
	g2 gis2:dim |
	a2:m7 d8:aug d4.:7 |
	} \alternative {
	{
	g2 e2:m7 | \myEndLine
