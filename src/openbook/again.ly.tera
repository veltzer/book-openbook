{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\partial 8 s8 |
	\repeat volta 2 {
	g2 e2:m7 |
	a2:m7 d2:7.9- |
	g2:maj7 b2:m | \myEndLine
	a2:m7 d2:9 |
	g2 gis2:dim7 |
	a2:m7 d2:7.9- |
	g4 e2.:m7 | \myEndLine
	a2.:m7 d4:9 |
	g2 e2:m7 |
	a2:m7 d2:7.9- |
	g2:maj7 b2:m | \myEndLine
	a2:m7 d2:9 |
	g2 gis2:dim7 |
