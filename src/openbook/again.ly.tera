{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	\partial 8 d'8 |
	\repeat volta 2 {
	g'1 |
	r8 e'8 ~ \once \omit TupletBracket \times 2/3 { e'8 fis'8 g'8 } a'8 b'4 d''8 |
	fis'1 |
	r8 e'8 fis'8 g'8 a'4 ~ \once \omit TupletBracket \times 2/3 { a'8 fis'8 a'8 } |
	e'8 d'4. ~ d'2 |
	\times 2/3 { c'4 d'4 c'4 } e'4. d'8 |
	b1 |
	r2 r4 r8 d'8 |
	g'1 |
	r8 e'8 ~ \once \omit TupletBracket \times 2/3 { e'8 fis'8 g'8 } a'8 b'4 d''8 |
	fis'1 |
	r8 e'8 fis'8 g'8 a'4 ~ \once \omit TupletBracket \times 2/3 { a'8 fis'8 a'8 } |
	e'8 d'4. ~ d'2 |
	\times 2/3 { c'4 d'4 c'4 } e'4. d'8 |
	b'4. b'8 b'4. b'8 |
	b'1 |
	b'4 d''4 c''4 ~ \once \omit TupletBracket \times 2/3 { c''8 g'8 a'8 } |
	\times 2/3 { bes'4 bes'4 bes'4 } bes'4. a'8 |
	g'2 \times 2/3 { fis'4 d'4 b4 } |
	f'1 |
	b'4 d''4 c''4 ~ \once \omit TupletBracket \times 2/3 { c''8 g'8 a'8 } |
	\times 2/3 { bes'4 bes'4 bes'4 } es''4 ~ \once \omit TupletBracket \times 2/3 { es''8 bes'8 c''8 } |
	d''1 |
	c''4 b'8 c''8 b'4. a'8 |
	g'1 |
	r8 e'8 ~ \once \omit TupletBracket \times 2/3 { e'8 fis'8 g'8 } a'8 b'4 d''8 |
	fis'1 |
	r8 e'8 fis'8 g'8 a'4 ~ \once \omit TupletBracket \times 2/3 { a'8 fis'8 a'8 } |
	e'8 d'4. ~ d'2 |
	r8 c'8 d'8 es'8 bes'8 bes'4 d'8 |
	} \alternative {
	{
	g'1 |
	r2 r4 r8 d'8 |
	}
	{
	g'1 ~ |
	g'2. r4 |
	}
	}
	\endBar
}
{% endif %}
