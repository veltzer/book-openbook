		ees1:maj7 | d:m9 | ees:maj7 | d:m9 | aes:7 | \myEndLine
		c:7.5+.9+ | aes:7 |
	} \alternative {
		{
			c:7.5+.9+ | \myEndLineVoltaNotLast
		}
		{
			c:7.5+.9+ | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	ees1:m9 | ees:m9 | ees:m9 | ees:m9 | \myEndLine
	fis:m9 | fis:m9 | fis:m9 | fis:m9 | \myEndLine
	a:m9 | a:m9 | a:m9 | a:m9 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	aes1:7 | g:m6.9 | aes:7 | g:m6.9 | \myEndLine
	aes:7 | g:m6.9 | aes:7 | g:m6.9 | \myEndLine
	\endPart

	\myMark "End"
	\startPart
	\repeat volta 2 {
		aes1:7 | g:m6.9 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
