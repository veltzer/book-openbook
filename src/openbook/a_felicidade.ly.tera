	bes2. g4 | a!2. fis4 | g1~ | g2 r |
	g1~ | g4 bes aes g | g f e! f | aes4. aes8~ aes4 g |
	f4 ees d ees | g f ees f | des1~ | des2 r |

	% part "B"
	r4 c ees f | g g2 ees4 | c ees f g | f f2 g4 |
	c4 b! bes ees, | g fis8 f!~ f4 ees^\markup { To Coda \musicglyph #"scripts.coda" } | c1~ | c2 r |

	% part "C"
	bes4 c d ees | c d ees f | d c8 d~ d2 | d2. r4 |
	ees4 f g aes | f g ees g | f1~ | f2 r4 bes |
	bes2 f4 bes | bes bes2 c4 | c2 g4 c | c c2 d4 |
	d4 c \tuplet 3/2 { bes a! bes } | c c~ \tuplet 3/2 { c bes a! } | bes2 \tuplet 3/2 { bes4 aes g } | aes aes2 g4 |
	ees2~ ees8 f g4 | c g8 f~ f ees c4 | f f2.~ | f2 r4 g |
	c4 b! bes ees, | g fis8 f!~ f4 ees | c c2.~ | c4 r r g'^\markup { D.S. al Coda } |

	% part "Coda"
	c,1~^\markup { \musicglyph #"scripts.coda" } | c2 r4 g' | c b! bes ees, | g fis8 f!~ f4 ees |
	c1~ | c2 r4 g' | c b! bes ees, | g fis8 f!~ f4 ees |
	c1~ | c2 r4 g' | c1~ | c4 ees d bes |
	g1~ | g1~ | g1~ | g1 | r1 |
}
