{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	c1:m | aes:9 | c2:m c:m7+ | c:m7 c:m6 | \myEndLine
	g1:m/d | d:7.9- | g:m | f2:m7 bes:7 | \myEndLine
	ees1:maj7 | ees2:6 c:7.9- | f:m7 f:m7/ees | d:m7.5- g:7 | \myEndLine
	c1:m | f:m | bes:m7 | ees2:7 a:7.5- | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	aes1 | g:7 | c:m | d2:m7.5- g:7 | \myEndLine
	c1:m | d2:m7.5- g4:7 g:7.5+ | c1:m | f2:m7 bes:7.9- | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	ees1 | aes:7 | ees1*2 | \myEndLine
	bes1:m7 | ees2:7 ees:7.5+ | aes1*2:6 | \myEndLine
	f1:m7 | bes:7 | ees1*2 | \myEndLine
	a2:m7.5- d:7.5+ | a:m7.5- d:7.5+ | g:m7.5- c:7.9- | f:m7.5- bes:7 | \myEndLine
	ees1*2 | d1:m7.5- | g:7 | \myEndLine
	c1:m | d2:m7.5- g4:7 g:7.5+ | c1*2:m | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	c1*3:m | d2:m7.5- g4:7 g:7.5+ | \myEndLine
	c1*3:m | d2:m7.5- g4:7 g:7.5+ | \myEndLine
	c1*3:m | aes1:9 | \myEndLine
	c2:m c:m7+ | c:m c:m6 | c:m c:m7+ | c:m7 c:m6 | c1:m | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
