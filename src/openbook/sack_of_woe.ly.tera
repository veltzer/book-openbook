{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1*4:m7 | \myEndLine
		bes1*4:7 | \myEndLine
		c1*2:7 | f1*2:m7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		bes2:m7 ees:7.5+ | aes1 | g2:m7.5- c:7 | f1:m | \myEndLine
		bes2:m7 ees:7.5+ | aes1 | g2:m7.5- c:7 | f1:m | \myEndLine
		bes2:m7 ees:7.5+ | aes2 c:7 | f1*2:m7 | \myEndLine
	} \alternative {
		{
			f1*2:m7 | \myEndLineVoltaNotLast
		}
		{
			f1*2:m7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 140
	\time 2/2
	\key f \minor

	% part "A"
	\repeat volta 2 {
		r2 c'8 ees4. | \tuplet 3/2 { c8 b bes } aes8 f aes4 bes | f1~ | f1 |
		r2 c'8 ees4. | \tuplet 3/2 { c8 b bes } aes8 f aes4 bes | f1~ | f1 |
		r2 c'8 ees4. | \tuplet 3/2 { c8 b bes } aes8 f aes4 bes | f1~ | f2. r4 |

		% part "B"
		des'8 ees des ees~ ees4 b | c4 aes bes r | r4 c8 b bes aes \tuplet 3/2 { f8 des f~ } | f1 |
		des'8 ees des ees~ ees4 b | c4 aes bes r | r4 c8 b bes aes \tuplet 3/2 { f8 des f~ } | f1 |
		des'8 ees des ees~ ees4 b | c4 aes bes r | r2 c8 ees4. | \tuplet 3/2 { c8 b bes } aes8 f aes4 bes |
	} \alternative {
		{
			f1~ | f1 |
		}
		{
			f1~ | f1 |
		}
	}
}
{% endif %}
