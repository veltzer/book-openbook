{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2.. g8:sus7 | s2 s8 f4.:9 | c2.. g8:sus7 | s2 s8 f4.:9 | c2.. g8:sus7 | s2 s8 f4.:9 | \myEndLine
		d4:7 d:7/g des:maj7 des8:maj7/g c |
	} \alternative {
		{
			g2:sus7 f:9 | \myEndLineVoltaNotLast
		}
		{
			f1:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	s4. e4.:7 s4 | s2 b4:7.5+ e:7 | e4.:m7 a8:9 s2 | s2 ees4:7/a e:m7 | ees4.:7 d8:7 s2 | \myEndLine
	s4. aes8:9 s2 | ees4.:7 d2:7 g8:sus7 | s2 s8 f4.:9 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c2.. g8:sus7 | s2 s8 f4.:9 | c2.. g8:sus7 | s2 s8 f4.:9 | \myEndLine
	c2.. g8:sus7 | s2 s8 f4.:9 | d4:7 d:7/g des:maj7 des8:maj7/g c | s1 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	c1:m7.9+.11+ | \myEndLine
	\endPart

	\endSong
	\endChords
}
