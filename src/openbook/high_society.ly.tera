	c1 | s2 f | c1 | s2 cis:dim7 | \myEndLine
	g1:7/d | s2 dis:dim7 | c1/e | s2 a:m7 | \myEndLine
	d1*2:7 | d1:m7 | g2:7 g:7.5+ | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1 | s2 g:7.5+ | c1 | s2 g:7.5+ | \myEndLine
	c1 | s2 f | c1 | s2 c:7 | \myEndLine
	f1:6 | fis:dim7 | c2/g e:7/gis | a1:7 | \myEndLine
	d1:7 | g:7 | c2 d:m7 | dis2.:dim7 c4/e | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	g1:m7 | c:7 | f:maj7 | f:6 | \myEndLine
	g:m7 | c:7 | f:maj7 | f:6 | \myEndLine
	a:m7 | d:7 | g:maj7 | g:6 | \myEndLine
	a:m7 | d:7 | a2:m7 d:7 | g g:7.5+ | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
