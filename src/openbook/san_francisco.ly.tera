{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	c2 e2:m |
	c1:7 |
	f1 |
	s2 f2:7 | \myEndLine
	c1 |
	a2:m e2:m |
	d2:m7 f4:m6 g4:7 |
	s1 | \myEndLine
	c2 e2:m |
	c1:7 |
	f1 |
	s2 f2:7 | \myEndLine
	c2. d4:7 |
	s2 g2:7 |
	c2 f2:7 |
	c1 | \myEndLine
	e1:m |
	a2:m6 b4:aug7 b4:7 |
	e1 |
	a2:7 fis2:m | \myEndLine
	g2 a4:dim e4:m |
	a2:m7 d2:7 |
	g2:7 d2:m |
	bes2:7 g2:7 | \myEndLine
	c2 e2:m |
	c1:7 |
	f1 |
	s2 f2:7 | \myEndLine
	c2 a4:m f4:6 |
	s4 f4 f2:6 |
	d2:7 g2:7 |
	} \alternative {
	{
	c2 f2 | \myEndLineVoltaNotLast
	}
	{
	c1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 2/2
	\key c \major

	\repeat volta 2 {
	g'2 g'2 |
	e'4 g'2. |
	a'4 b'4 c''4 d''4 ~ |
	d''4 c''4 a'2 |
	g'4 a'4 g'4 c''4 ~ |
	c''4 a'4 g'2 |
	e'4 d'4 d'4 d'4 ~ |
	d'2. r4 |
	g'2 g'2 |
	e'4 g'2. |
	a'4 b'4 c''4 d''4 ~ |
	d''4 c''4 a'2 |
	g'4 a'4 g'4 c''4 ~ |
	c''4 c'4 d'2 |
	c'1 |
	c'2 r2 |
	b4 e'4 fis'4 g'4 |
	a'4 b'4 g'4 fis'4 |
	b'2 b'2 |
	b'1 |
	d'4 g'4 a'4 b'4 |
	c''4 d''4 b'4 a'4 |
	d''2 d''2 |
	d''1 |
	g'2 g'2 |
	e'4 g'2. |
	a'4 b'4 c''4 d''4 ~ |
	d''4 c''4 a'2 |
	g'4 a'4 c''4 d''4 ~ |
	d''4 c''4 d''2 |
	e''4 c''4 d''2 ^\fermata |
	} \alternative {
	{
	c''2 r2 |
	}
	{
	c''2 ~ c''4 r4 |
	}
	}
	\endBar
}
{% endif %}
