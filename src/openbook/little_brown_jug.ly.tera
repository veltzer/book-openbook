{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1:6 | f:6 | g:7 | c:6 | \myEndLine
		c:6 | f:6 | g:7 | c:6 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
		c:6 | f:6 | g:7 | c4:6 g:7 c2:6 | \myEndLine
	} \alternative {
		{
			c1:6 | f:6 | g:7 | c:6 | \myEndLineVoltaNotLast
		}
		{
			c1:6 | f:6 | g:7 | c | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 160
	\time 4/4
	\key c \major

	\partial 4 g'4 |

	% part "A"
	\repeat volta 2 {
		e g g g | f a a a8 a | b b b4 a b | c d e2 |
		e,4 g g g | f a a a | b b a b | d c c2 |

	% part "B"
		g4 g g2 | a4 a a2 | b8 b b4 a b | c d e2 |
	} \alternative {
		{
			g,4 g g2 | a4 a a2 | b8 b b4 a b | c g c g |
		}
		{
			g4 g g2 | a4 a a2 | b8 b b4 a b | c g c2 |
		}
	}
}
{% endif %}
