{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	g1 |
	s1 |
	e1:7 | \myEndLine
	s1 |
	a1:7 |
	s1 |
	s1 | \myEndLine
	s1 |
	} \alternative {
	{
	d1:7 |
	s1 |
	e1:m | \myEndLine
	s1 |
	a1:7 |
	s1 |
	s1 | \myEndLine
	d1:7 | \myEndLineVoltaNotLast
	}
	{
	c1 | \myEndLineVoltaLast
	}
	}
	s1 |
	c1:m | \myEndLine
	s1 |
	g1 |
	s2 e2:7 |
	a1:7 | \myEndLine
	d1:7 |
	g1 |
	s1 |
	e1:7 | \myEndLine
	s1 |
	a1:m |
	s2 d2:7 |
	g1 | \myEndLine
	s1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	r2 r4 d'4 |
	\repeat volta 2 {
	b'2 c''4 d''4 |
	b'2 d''2 |
	b'1 ~ |
	b'4 r4 r4 e'4 |
	g'2 a'4 b'4 |
	g'2 b'2 |
	g'1 ~ |
	g'2 r2 |
	} \alternative {
	{
	fis'2 fis'4 fis'4 ~ |
	fis'2. r4 |
	g'2 fis'4 g'4 ~ |
	g'2 g'4 ^ "N.C." gis'4 |
	a'2 gis'4 a'4 ~ |
	a'2 dis'4 e'4 |
	b'2 bes'2 |
	a'2 cis'4 ^ "N.C." d'4 |
	}
	{
	e''2 c''4 e''4 ~ |
	}
	}
	e''4 r4 r2 |
	es''2 c''4 es''4 ~ |
	es''4 r4 r2 |
	b'2 c''4 d''4 |
	b'2 d''2 |
	b'2 g'4 a'4 ~ |
	a'2 r4 d'4 |
	b'2 d''2 |
	b'2 d''2 |
	b'1 ~ |
	b'4 r4 dis'4 e'4 |
	c''2 d''4 c''4 |
	b'2 a'2 |
	g'1 ~ |
	g'2. r4 |
	\endBar
}
{% endif %}
