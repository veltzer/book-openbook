{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		aes1*3 | \myEndLine
		aes1*4 | \myEndLine
	} \alternative {
		{
			aes1 | \myEndLineVoltaNotLast
		}
		{
			aes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	g1*2:7 | \myEndLine
	c1*2:7 | f1*2:7 | \myEndLine
	bes1:7 | ees:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	aes1*4 | \myEndLine
	aes1*4 | \myEndLine
	\endPart

	\endSong
	\endChords
}
