{% if part == "VoiceFake" %}{
	\tempo "Allegro" 2 = 120
	\time 2/2
	\key aes \major

	\partial 4 b8 c |

	% part "A"
	\repeat volta 2 {
		ees8 c ees c ees f b, c | ees8 c ees c ees f b, c | ees8 f r4 r b,8 c |
		ees8 f r4 r b,8 c | ees8 c ees c ees f b, c | ees8 c ees c ees f b, c | ees8 aes, r4 r b8 c |
	} \alternative {
		{
			ees8 aes, r4 r8 aes b c |
		}
		{
			ees8 aes, r aes' des d! e! a! |
		}
	}

	% part "B"
	g4 \tuplet 3/2 { g,8 aes a! } des8 d! f aes | a!8 f d! b! g f d! b! |
	e!4 \tuplet 3/2 { e8 g bes } des8 d! a'! aes | g8 ges f e! g c, ees g | f2. r8 a! |
	c8 b! bes a! aes g f ees | d!4 aes'8 f des bes aes f | ees'8 g, bes c ees4 b,8 c |

	% part "A"
	ees8 c ees c ees f b, c | ees8 c ees c ees f b, c | ees8 f r4 r b,8 c | ees8 f r4 r b,8 c |
	ees8 c ees c ees f b, c | ees8 c ees c ees f b, c | ees8 aes, r4 r b8 c | ees8 aes, r4 r2 |
}
