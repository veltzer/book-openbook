	\tempo "Allegro" 4 = 150
	\time 4/4
	\key g \major

	% part "A"
	\repeat volta 2 {
		bes'8 bes bes g bes bes bes g | bes4 bes8 bes~ bes4 r8 g | bes4 bes8 g bes bes bes g | \tuplet 3/2 { bes4 bes bes } bes8 g bes c |
		d8 g,~ g2 bes8 c | d8 c4. bes4 g | g8 d~ d2.~ | d2. r4 | c'8 b c b c b c cis |
		d4 c bes8 a g4 | b!8 d,~ d2.~ | d2. r8 d'8 | d8 d4. r4 r8 d8 | d8 d4. r2 |
		\tuplet 3/2 { d4 d d } \tuplet 3/2 { d d d } | d4 r r g,8 g | bes8 g~ g2. | d'8 c4. bes8 a g4 | g8 d~ d2.~ |
		d2. r4 | c'8 b c b c b c cis | d8 c4. bes8 a g g~ | g1~ | g2. r4 |
	}

	% part "B"
	r1 | r1 | r1 | r1 | r1 | r1 | r1 | r1 | r1 | r1 | r1 |
	r2 r4 r8 d'8 | d8 d4. r4 r8 d8 | d8 d4. r2 | \tuplet 3/2 { d4 d d } \tuplet 3/2 { d d d } | d4 r r2 |
}
{% endif %}
