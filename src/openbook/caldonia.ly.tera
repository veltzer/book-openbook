{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g1*4 | \myEndLine
		c1*2:7 | g1*2 | d1:7 | \myEndLine
		d1:7 | g1*4 | \myEndLine
		g1*2 | c1*2 | g1 | \myEndLine
		g1 | d1*2:7 | g1*2 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	g1*4 | c1*2:9 | g1*2 | a1:m7 | d:7 | g | \myEndLine
	g1*5 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
