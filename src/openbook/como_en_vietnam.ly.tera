{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	bes1*4:m | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	bes1*4:m | \myEndLine
	e1*4:maj7 | \myEndLine
	e1*2:7 | a1*2:7.9- | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	ees1:7 | aes:7 | des:7 | ges:7 | \myEndLine
	ees:7 | aes:7 | des:7 | ges2:7 f:7 | \myEndLine
	\endPart

	\myMark "End"
	\startPart
	bes1:m | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Allegro" 4 = 180
	\time 4/4
	\key bes \minor

	% part "Intro"
	R1*4 |

	% part "A"
	r4 r8 des'8 des4 c8 c~ | c4 bes a c | c4. bes8~ bes2~ | bes1 |
	r4 r8 aes8 aes4 ges8 ges~ | ges4 fes fes2~ | fes2 fes8 fes4 fes8~ | fes1~ |
	fes2 e4 d8 d~ | d1 | r2 des4 des8 c~ | c1 |

	% part "B"
	ees4 f8 g \tuplet 3/2 { g4 aes bes } | c4 des8 ees \tuplet 3/2 { f4 f ges } | f4 des8 des des c4 bes8 | c1 |
	ees,4 f8 g \tuplet 3/2 { g4 aes bes } | c4 des8 ees \tuplet 3/2 { f4 f ges } | f4. des8~ des2 | des8-> des4-> des8-> des8-> c4.-> |

	% part "End"
	R1\fermata |
}
{% endif %}
