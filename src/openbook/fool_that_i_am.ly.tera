{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		g2 g:sus4 | d2:7sus4 d:7 | g2:sus4 f4 g:7 | \myEndLine
		c2 b:m7 | a2:m7 b:m | c2 b4:7sus4 b:7 | e2:m7 g | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2 d | g2 e:m7 | a2:m7 d:7 | \myEndLine
		g1 | c2 b:7 | e2.:m7 c4 | \myEndLine
	} \alternative {
		{
			a2:m7 d:7sus4 | g2 a:m7 | d1:7 | g | d:7 | \myEndLineVoltaNotLast
		}
		{
			a2:m7 d:7 | g1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "Coda"
	\startPart
	a2:m7 b:m7 | e2:m7 c4 b:m | \myEndLine
	a2:m7 d4:7sus4 d:7 | r1 | g1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Adagio" 4 = 66
	\time 4/4
	\key g \major

	\partial 4 g'16 a8. |

	\repeat volta 2 {

		% part "A"
		b4 b r a8 b16 c~ | c4 c16 b a8 r4 b8 d16 e~ | e16 d8 d16~ d2 b16 d8 e16~ |
		e2 r4 b16 a g8 | a8 b r4 r r8 d,16 e | c'16 c8.~ c8 b~ b4 a8 b16 a | g4 r b8 c d e~ |

		% part "B"
		e4^\markup { \musicglyph #"scripts.segno" } r a8 a16 fis~ fis8 e16 d | d4 r g,8 a b c~ | c4 g'8 fis~ fis4 e16 d d c |
		b4 r b8 c d e~ | e8 e r4 fis8 b,4 g'8~ | g2. a,16 b8.^\markup {To Coda \musicglyph #"scripts.coda"} |
	} \alternative {
		{
			c4~ c8. d16 b a g8~ g16 e d8 | a'16 g8.~ g2 r4 | r1 | r1 | r2 r4 g16 a8. |
		}
		{
			c4~ c8. d16 b4. a16 b | a16 g e g~ g4 b8 c d e^\markup {D.S. al Coda} |
		}
	}

	% part "Coda"
	c4~ c8. d16 b4. a16 b | a16 g e g~ g4 r a16 b8. |
	c2 b16 a g e d4\fermata | a'16 g8.~ g2. | r1 |
}
{% endif %}
