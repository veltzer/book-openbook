{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Swing" 4 = 144
	\time 4/4
	\key es \major

	r4 es'8 d'8 f'4 es'4 |
	\repeat volta 2 {
	g'1 ~ |
	g'4 es'8 d'8 f'4 es'4 |
	g'1 ~ |
	g'4 f'8 es'8 g'4 f'4 |
	c''2. c''4 |
	d''2. d''4 |
	bes'1 ~ |
	bes'4 es'8 d'8 f'4 es'4 |
	g'1 ~ |
	g'4 bes'8 a'8 c''4 bes'4 |
	d''1 ~ |
	d''4 d''8 c''8 es''4 d''4 |
	f''2. d''4 |
	c''2. d''4 |
	bes'1 ~ |
	bes'4 es'8 d'8 f'4 es'4 |
	g'1 ~ |
	g'4 es'8 d'8 f'4 es'4 |
	g'1 ~ |
	g'4 f'8 es'8 g'4 f'4 |
	c''2. c''4 |
	d''2. d''4 |
	bes'1 ~ |
	bes'4 c''8 d''8 es''4 c''4 |
	g'2. g'4 |
	es''2. es''4 |
	c''1 ~ |
	c''4 es'8 d'8 f'4 es'4 |
	g'1 |
	g'2. g'4 |
	} \alternative {
	{
	g'8 f'8 es'2. ~ |
	es'4 es'8 d'8 f'4 es'4 |
	}
	{
	g'8 f'8 es'2. ~ |
	es'4 r4 r2 |
	}
	}
	\endBar
}
