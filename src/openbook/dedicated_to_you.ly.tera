{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\repeat volta 2 {
	r8 d''8 c''8 bes'8 a'4 f'4 |
	g'8 a'4 g'8 ~ g'2 |
	r8 d''8 c''8 bes'8 a'4 f'4 |
	g'8 a'4 g'8 ~ g'4. g'8 |
	ges'4 ges'4 ges'4 as'8 ges'8 |
	f'4 g'4 a'2 |
	r4 bes'8 a'8 \times 2/3 { g'4 a'4 bes'4 } |
	c''2 cis''2 |
	r8 d''8 c''8 bes'8 a'4 f'4 |
	g'8 a'4 g'8 ~ g'2 |
	r8 d''8 c''8 bes'8 a'4 f'4 |
	g'8 a'4 g'8 ~ g'4. g'8 |
	ges'4 ges'4 ges'4 as'8 ges'8 |
	f'4 g'4 a'2 |
	r4 bes'8 a'8 \times 2/3 { d''4 d''4 d''4 } |
	bes'2. a'4 |
	d''2. cis''4 |
	e''4 d''4 cis''4 b'8 c''8 |
	a'8 a'4 fis'8 \times 2/3 { a'4 ais'4 b'4 } |
	a'2. bes'4 |
	c''2 ~ c''8 d''8 a'8 bes'8 |
	c''4 d''4 a'4. bes'8 |
	\times 2/3 { c''4 c''4 c''4 } c''4 c''8 c''8 |
	\times 2/3 { cis''4 cis''4 cis''4 } cis''2 |
	r8 d''8 c''8 bes'8 a'4 f'4 |
	g'8 a'4 g'8 ~ g'2 |
	r8 d''8 c''8 bes'8 a'4 f'4 |
	g'8 a'4 g'8 ~ g'4. g'8 |
	ges'4 ges'4 ges'4 as'8 ges'8 |
	f'4 g'4 a'2 |
	r4 bes'8 a'8 \times 2/3 { d''4 d''4 d''4 } |
	} \alternative {
	{
	bes'2. r4 |
	}
	{
	bes'2. r4 |
	}
	}
	\endBar
}
{% endif %}
