{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		a2:m f/a | a:m6 f/a | a:m f/a | a:m6 f/a | \myEndLine
		a2:m7 c:7.9- | f2:6 d4:m7 g:7.9- | c1*2:6 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		a2:m f/a | a:m6 f/a | a:m f/a | a:m6 f/a | \myEndLine
		a2:m7 c:7.9- | f2:6 d4:m7 g:7.9- | c1:6 | c1:9 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f1:7 | c:6 | f:7 | c:6 | \myEndLine
		f1:7 | a2:m7 a:m6 | f1:9 | e:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		a2:m f/a | a:m6 f/a | a:m f/a | a:m6 f/a | \myEndLine
		a2:m7 c:7.9- | f2:6 d4:m7 g:7.9- |
	} \alternative {
		{
			c1:6 | b2:m7.5- e:7.5+ | \myEndLineVoltaNotLast
		}
		{
			c2:6 aes:9 | c1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
