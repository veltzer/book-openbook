{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:maj7 | ees2:maj7 c:m7 | f1*2:7 | \myEndLine
		f1:m7 | bes2:9 bes:7.9- | \myEndLine
	} \alternative {
		{
			ees1:maj7 | f2:m7 bes:7.5+ | \myEndLineVoltaNotLast
		}
		{
			ees1 | ees2 ees:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	aes1:maj7 | a:dim7 | ees/bes | bes2:m7 ees:7 | \myEndLine
	aes1:maj7 | a:dim7 | ees2/bes c:7 | f:m7 bes:7.5+ | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	ees1*2:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Andante" 4 = 72
	\time 2/2
	\key ees \major

	\partial 2 bes'4 c |

	% part "A"
	\repeat volta 2 {
		d4^\markup { \musicglyph #"scripts.segno" } d d2~ | d2 ees | c1 | g2. c4 |
		c4 bes bes2~ | bes4 aes aes g^\markup { To Coda \musicglyph #"scripts.coda" } |
	} \alternative {
		{
			g1~ | g2 bes4 c |
		}
		{
			g1~ | g2~ g4. c8 |
		}
	}

	% part "B"
	ees8 c ees4 ees,4. c'8 | ees8 c ees4 ees,4. c'8 | ees8 c ees4 c g | f2~ f4. c'8 |
	ees8 c ees4 ees,4. c'8 | ees8 c ees4 ees,4. c'8 | ees8 c ees4 c c | c2 bes4 c^\markup { D.S. al Coda } |

	% part "Coda"
	g1~^\markup { \musicglyph #"scripts.coda" } | g1 |
}
{% endif %}
