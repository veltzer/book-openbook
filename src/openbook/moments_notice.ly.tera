{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		e2:m7 a:7 | f:m7 bes:7 | ees1:maj7 | aes2:m7 des:7 | \myEndLine
		d2:m7 g:7 | ees:m7 aes:7 | des1:maj7.11+ | d2:m7 g:7 | \myEndLine
		c2:m7 b:7.9- | bes:m7 ees:7 | aes1:maj7 | aes2:m7 des:7 | \myEndLine
	} \alternative {
		{
			g2:m7 c:7.13- | aes:m7 des:7 | ges1:6 | f2:m7 bes:7 | \myEndLineVolta
		}
		{
			g2:m7 c:7.9+ |
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f2:m7 bes:7 | ees1:6.9 | f:m7 | \myEndLine
	g1:m7 | f:m7 | ees2:6.9 f:m7 | g:m7 f:m7 | ees1*2 | \myEndLine
	\endPart

	\endSong
	\endChords
}
