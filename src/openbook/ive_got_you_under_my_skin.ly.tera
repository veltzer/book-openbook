{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1:m7 | bes:7 | ees:maj7 | g2:m7.5- c:7.9- | f1:m7 | bes:7 | ees:maj7 | \myEndLine
		c1:m7 | f:m7 | bes2:7 bes:7/aes | g1:m7 | c:7 | f:m7 | bes:7 | \myEndLine
		ees1:maj7 | g2:m7.5- c:7.9- |
		\endPart

		\myMark "B"
		\startPart
		f1:m7 | bes:7 | ees:maj7 | g2:m7.5- c:7 | f1:m7.5- | \myEndLine
		bes1:7.9- | d:/ees | ees:maj7 | d:m7 | g:7 | b2:/c c:maj7 | \myEndLine
		s1 | f:m7 | bes:7 | ees:maj7 | g2:m7.5- c:7 |
		\endPart

		\myMark "C"
		\startPart
		f1:m7 | \myEndLine
		bes2:7 bes:7/aes | g1:m7 | c:7 | f:m7 | \myEndLine
		bes2:7 bes:7/aes | g:m7 ges:7 | f:m7 bes:7 | a1:m7.5- | \myEndLine
		aes1:dim7 | g:m7 | c:7 | f:m7 | bes:7 | ees | \myEndLine
		bes2:m7 ees:7 |
		\endPart

		\myMark "D"
		\startPart
		aes1:maj7 | des:7 | ees:maj7 | g2:m7.5- c:7.9- | \myEndLine
		f1:m7 | bes:7.9- |
		\endPart

	} \alternative {
		{
			ees1 | g2:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			ees1 | f2:m7 e:9 | ees1:maj9 | \myEndLineVoltaLast
		}
	}

	\endSong
	\endChords
}
