{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	g1 |
	g1:maj7 |
	g2:6 bes2:dim7 |
	a4:m7 d2.:7 | \myEndLine
	s1 |
	a1:m7 |
	d2:7 d2:aug7 |
	g1:maj7 | \myEndLine
	g1:7 |
	f1:7 |
	e1:7 |
	a1:m7 | \myEndLine
	s2 f2:7 |
	g2:maj7 a2:7 |
	a2:m7 d2:7 |
	} \alternative {
	{
	g4:6 g2. | \myEndLineVoltaNotLast
	}
	{
	g4:6 g2. | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	\repeat volta 2 {
	b'8 b'8 b'8 b'8 b'2 |
	a'8 a'8 a'8 a'8 a'2 |
	g'8 g'8 g'8 g'8 g'4 fis'4 |
	e'4 d'2. |
	a'8 a'8 a'8 a'8 a'2 |
	g'8 g'8 g'8 g'8 g'2 |
	fis'8 fis'8 fis'8 fis'8 fis'4 e'4 |
	e'4 d'2. |
	d''8 d''8 d''8 d''8 d''2 |
	c''8 c''8 c''8 c''8 c''2 |
	b'8 b'8 b'8 b'8 d''4. c''8 |
	\once \omit TupletBracket \times 2/3 { b'8 ( c''8 b'8 ) } a'2 a'8 b'8 |
	c''4 a'8 b'8 c''4 b'8 a'8 |
	a'8 g'8 g'8 a'8 b'4 g'4 |
	e'4 d'4 d''4 b'4 |
	} \alternative {
	{
	a'4 g'2 r4 |
	}
	{
	a'4 g'2 r4 |
	}
	}
	\endBar
}
{% endif %}
