{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 4 {
		a2:m7.5- aes:7 | g2:m7 c:7.9- | b2:maj7 c4:m7.5- f:7.9+ | bes1:maj7 | \myEndLine
		b2:m7 e:7 | a2:maj7 fis:m7 | ees2:m7.5- aes:7.9+ | des1:maj7 | c2:7.9+ b:7.9+ |
	} \alternative {
		{
			bes1:maj7 | \myEndLineVoltaNotLast
		}
		{
			bes1:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
