{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees1:maj7 | aes:9 | d:m7 | g:7 | \myEndLine
		c1:9 | f:9 | bes:6 | f2:m7 bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1:maj7 | aes:9 | d:m7 | g:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2:m g:7 | c4.:m7 aes8:9 s2 | bes2 d:7 | g4.:m g8:m/f e4:m7 a:7.9- | \myEndLine
		d2:m7 g:m7 | c:m7 f:7 | bes1 |
	} \alternative {
		{
			f2:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			bes1:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
