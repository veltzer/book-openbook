{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1*4:7 | \myEndLine
		bes1*2:7 | f1*2:7 | \myEndLine
		g1:m7 | c:7 | f:7 | c:7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 130
	\time 4/4
	\key f \major

	\partial 4 f4 |

	% part "A"
	\repeat volta 2 {
		c'2. bes8 aes | bes4 aes8 f aes4 f8 ees | f4. ees8 r2 | r2 r4 f4 |
		c'2. bes8 aes | bes4 aes8 f aes4 f8 ees | f4. ees8 r2 | r2 r4 f4 |
		c'2. bes8 aes | bes4 aes8 f aes4 f8 ees | f4. ees8 r2 | r1 |
	}
}
{% endif %}
