		bes2 f:aug | bes g:7 | g1:7 | c2:7 a:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		d1:m6 | d:m6 | d:m6 | d:m6 | \myEndLine
		g:7 | c:7 |
