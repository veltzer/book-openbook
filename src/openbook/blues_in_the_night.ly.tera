{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "A"
	\startPart
	bes1*3 | bes1:7 | \myEndLine
	ees1*2:7 | bes1*2:7 | \myEndLine
	f1:7 | c2:7 f:7 | bes1*2 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	bes1:7 | ees:7 | bes1*2 | \myEndLine
	ees1:9 | ees2:9 f:7 | bes1*2 | \myEndLine
	f1:7 | c2:7 f:7 | bes1*2 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	\repeat volta 2 {
		ees1:9 | ees2:m6 f:7 | des1:7 | c2:5+ c:7 | \myEndLine
		g1:7.9- |
	} \alternative {
		{
			g2:m7.5- c:7 | f1:7 | c2:m7.5- f:7 | \myEndLineVoltaNotLast
		}
		{
			g2:m7.5- c:7 | f2:7 ees:m/ges | aes2.:m6 f4:7/a | bes1:7 | c2:7 f:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "Coda"
	\startPart
	bes1 | bes:7 | c2:7.9- f:7 | c2:7 f:7sus4 | bes1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
