{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees1 | f:7 | f2:m7 bes:7 | f2:m7 bes:7 | \myEndLine
		ees1 | f:7 | f2:m7 bes:7 | f2:m7 bes:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		bes1:m7 | ees:7 | bes2:m7 ees:7 | aes1 | \myEndLine
		c1:m7 | f:7 | b:7 | bes2:7.5+ bes:13 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1 | f:7 | f2:m7 bes:7 | f2:m7 bes:7 | \myEndLine
		bes1:m7 | ees:7 | aes | des:9 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		ees2 g:m7 | f:m7 bes:7 | ees c:m7 | f:9 f:7 | \myEndLine
		f1:m7 | ees2/bes f4:m7/bes bes:7 |
	} \alternative {
		{
			ees2 ges:dim7 | f:7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees1*2:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
