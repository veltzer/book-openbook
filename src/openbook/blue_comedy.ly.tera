{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:7 | aes:7 | ees:7 | d:7 | \myEndLine
		des:7 | des2:7 d:7 | e1:7 | fis:7.5+.9+ | \myEndLine
		b:7.5+.9+ | e:7.5+.9+ | f:7.9 | f:7.9 | \myEndLine
	}
	\endPart

	\myMark "Instr"
	\startPart
	a1:maj7.11+ | a:maj7.11+ | a:maj7.11+ | a:maj7.11+ | \myEndLine
	a:maj7.11+ | a:maj7.11+ | bes:7.9- | bes:7.9- | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
