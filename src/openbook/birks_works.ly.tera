{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	f1:m7 |
	g2:dim c2:7 |
	f1:m7 | \myEndLine
	c2:dim f2:7 |
	bes1:m7 |
	s1 |
	f1:m7 | \myEndLine
	s1 |
	aes2:m7 des2:9 |
	g1:7.5- |
	f1:m7 | \myEndLine
	} \alternative {
	{
	s1 | \myEndLineVoltaNotLast
	}
	{
	s1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key as \major

	r2 r8 f'8 as'8 bes'8 |
	\repeat volta 2 {
	b'8 c''8 b'8 bes'8 as'8 f'8 as'8 bes'8 |
	bes'4 as'8 c''8 r8 f'8 as'8 bes'8 |
	b'8 c''8 b'8 bes'8 as'8 f'8 as'8 bes'8 |
	r2 r8 f'8 as'8 bes'8 |
	b'8 c''8 b'8 bes'8 as'8 f'8 as'8 bes'8 |
	bes'4 as'8 b'8 r8 f'8 as'8 b'8 |
	b'8 c''8 b'8 bes'8 as'8 f'8 as'8 bes'8 |
	r2 r8 f'8 as'8 bes'8 ~ |
	bes'8 bes'4. r8 f'8 as'8 bes'8 ~ |
	bes'8 bes'4. \once \omit TupletBracket \times 2/3 { as'16 bes'16 as'16 } f'8 es'8 f'8 ~ |
	f'4 r4 r2 |
	} \alternative {
	{
	r2 r8 f'8 as'8 bes'8 |
	}
	{
	R1 |
	}
	}
	\endBar
}
{% endif %}
