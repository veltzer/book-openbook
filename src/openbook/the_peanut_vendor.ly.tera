{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g1 | d:7 | g | d:7 | g | \myEndLine
		d:7 | g | d:7 | g | d2.:7 g4 | \myEndLine
		g1 | d:7 | g | d:7 | g | \myEndLine
		d:7 | g | d:7 | g | d:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g | d:7 | g | d:7 | \myEndLine
		g | d:7 | g | d:7 | \myEndLine
		g | d:7 | g | d:7 | g | \myEndLine
		d:7 | g | d:7 | g | \myEndLine
		d:7 | \myEndLine
	}
	\endPart

	\myMark "Coda"
	\startPart
	g | d:7 | g | d:7 | \myEndLine
	g | d:7 | d:7 | d:7 | g | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
