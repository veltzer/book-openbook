{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 8 r8 |

	\myMark "Intro"
	\startPart
	\repeat volta 3 {
		r1*3 |
	} \alternative {
		{
			r1 | \myEndLineVoltaNotLast
		}
		{
			r1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		s1*3 | \myEndLine
		s1*4 |
	} \alternative {
		{
			s1 | \myEndLineVoltaNotLast
		}
		{
			s2.. g8:m | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f2../g f8/bes | s4 ees2/bes s8 d8:m7 | s2.. f8/c | s4 c2:m7 s8 f8/b | s4 e2:m s8 g8:m/c | s4 f2./ees | e4:m f8 ges g4 e4:m | \myEndLine
	g4:m/c f2./c | g1*4 | s1 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	\repeat volta 2 {
		s1*2 | \myEndLine
		s1*5 |
	} \alternative {
		{
			s1 | \myEndLineVoltaNotLast
		}
		{
			s1 | \myEndLineVoltaLast
		}
	}
	s1*3 | g1 | c4 g2. | s1*2 | s1 | \myEndLine
	c4 g2 b4:m7.5- | s1*2 |
	\endPart

	\myMark "D"
	\startPart
	\repeat volta 2 {
		g4 b4:m e4.:m g8/b | s4 c4:maj7 cis4.:m7.5- b8:m7 | s2 e2:7 | a8:m7 g4/b c4:6 c4/d g8 | s4 b4:m e4.:m c8:6 | \myEndLine
		s4 cis4:m7.5- d4.:sus4.7 c8:maj7 | s1 |
	} \alternative {
		{
			s8 a4:m c4:maj7/e a4.:m7/d | \myEndLineVoltaNotLast
		}
		{
			s8 a4:m c4:maj7/e a4:m7/d g8 | \myEndLineVoltaLast
		}
	}
	s4 b4:m e4.:m g8/d | s4 cis4:m7.5- c4.:9 b8:m7 | s2 e2:7 | a8:m g4/b c4:6 c4/d g8 | s4 b4:m e4.:m a8:m7/d | s4 cis4:m7.5- c4.:9 b8:m7 | \myEndLine
	s2 e2:7 | a8:m g4/b c4:6 c4./d | g1 | s1*3 | \myEndLine
	\endPart

	\myMark "Instr"
	\startPart
	\repeat volta 3 {
		s1*4 |
	}
	\repeat volta 7 {
		g4:7 ges:7 f:7 e:7 |
	} \alternative {
		{
			ees4:7 d:7 des:7 c:7 | \myEndLineVoltaNotLast
		}
		{
			ees4:7 d:7 des:7 c8:7 g8 | \myEndLineVoltaLast
		}
	}
	s1*2 |
	\endPart

	\myMark "Coda"
	\startPart
	s1 |
	\repeat volta 2 {
		g4 g4/b e4.:m g8/b | s4 c4:maj7 cis2:m7.5- | b2:m7 e2:7 | \myEndLine
		a8:m g4/b c4:6 c4/d g8 | s4 g4/b e4.:m c8:6 | s4 cis4:m7.5- g4./d g8/c | s1 | g8/c a4:m e4:m7 c4/d g8 | \myEndLine
	}
	\repeat volta 2 {
		s4 b4:m e4.:m g8/d | s4 cis4:m7.5- c4.:7 b8:m7 | s2 e2:7 | a8:m g4/b c4:6 c4/d g8 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
