	% part "B"
	bes4 a8 a r4 r8 a~ | a4 g8 g r4 r8 a~ | a4 f8 f r4 r8 a~ | a4 g8 g r4 r8 a~ | a4 g8 g r4 r8 bes~ | bes4 a2. | r8 g a bes b4 g |
	bes4 a2. | g1~ | g1~ | g1~ | g1~ | g2 r8 c, d f~ |

	% part "C"
	\repeat volta 2 {
		f4^\markup { G pedal } d c r8 c~ | c8 r c r r c d f~ |
		f4 d c r8 b~ | b8 r b4 r8 c d f~ | f4 d c r8 c~ | c8 r r4 r8 c d f~^\markup { To Coda \musicglyph #"scripts.coda" } | f4 d c r8 b~ |
	} \alternative {
		{
			b8 r b4 r8 c d f |
		}
		{
			b,8 r b4 r8 c' d f~ |
		}
	}
	f4 d c r8 c~ | c8 r c4 r8 c d f~ | f4 d c r8 b~ | b4. b8~ b4. b8 | c4 b8 d~ d4 d~ | d1~ | d1 | b4. b8~ b4. b8 |
	c4 b8 d~ d4 f~ | f1~ | f2~ f4. r8 |

	% part "D"
	\repeat volta 2 {
		b,4 d g, r8 g~ | g4 b g r8 d'~ | d1 | c8 b4 a8~ a g4 b8~ | b4 d g, r8 a~ |
		a4 b g r8 d'~ | d1 |
	} \alternative {
