{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	\repeat volta 2 {
		d1:m7 | d:m6 | d:m7 | d:m6 | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		d1:m | e2:m7.5- a:7.9- | d:m a:7.9+ | d1:m | \myEndLine
		g:m7 | d:m | e:m7.5- | a:7.9- | \myEndLine
		d:m7 | d:m6 | d:m7 | d:m6 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	f1 | g2:m7 c:7 | f1 | e2:m7.5- bes4:7 a:7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	d1:m | c:7sus4 | c:7sus4 | c:7sus4 | c:7sus4 | \myEndLine
	c:7sus4 | c2:7sus4 a:7.5+.9+ | g:m7 a:7.9- | d1:m | d:m | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key d \minor

	% part "Intro"
	\repeat volta 2 {
		r4 r8 e8~ e2 | r4 r8 e8~ e8 e4. | r4 r8 e8~ e2 | r4 r8 e8~ e8 e4. |
	}

	% part "A"
	\repeat volta 2 {
		d4^\markup { \musicglyph #"scripts.segno" } r8 e8 f4 g8 a8~ | a2 r4 d8 e8~ | e4 d8 c8~ c4 bes8 a8~ | a1 |
		a8 g fis g bes8. bes16 a8 g | f2~^\markup { \musicglyph #"scripts.coda" } f8 a f e~ | e1~ | e2 r8 ees4. |
		r4 r8 e8~ e2 | r4 r8 e8~ e8 e4. | r4 r8 e8~ e2 | r4 r8 e8~ e8 e4. |
	}

	% part "B"
	r8 f4. f8 e f a~ | a8 c bes g a2 | r8 f4. f8 e f c'~ | \tuplet 3/2 { c4 bes g } des'8 c4.^\markup { D.S. al Coda } |

	% part "Coda"
	f,2~ f8 c' f, c | r8 f4. f4-^ g-^ | a4. a8-^ r2 | r8 f4. f4-^ g-^ | a4. a8-^ r2 |
	r8 f4. f4 g | a4. g8~ g4. f8~ | f2 g4 r8 f8 | R1 | R1 |
}
{% endif %}
