{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		bes1*2 | a2:m7 d:7 | a2:m7 d:7 | \myEndLine
		d1:m7.5- | g1:7 | c1:9 | g2:m7 c:9 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c1:m7 | f1:7 | bes1*2:9 | \myEndLine
		ees1*2:9 | aes1:maj7 | a2:m7.5- d:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		g1:m | g1:m/fis | g1:m7/f | g1:m6/e | \myEndLine
		bes1*2 | aes1:7 | g1:7 | \myEndLine
		\endPart

		\myMark "D"
		\startPart
		c1:9 | f1:7 | bes1 | g1:m7 | \myEndLine
		c1:7 | c2:m7 f:7 |
	} \alternative {
		{
			bes1 | bes4 c:9 c:m7 f:7 | \myEndLineVoltaNotLast
		}
		{
			bes2 aes4:6 a:6 | bes1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 2 = 100
	\time 2/2
	\key bes \major

	\repeat volta 2 {
		% part "A"
		d4 cis d2~ | d4 cis d c | d cis d2~ | d4 cis d c |
		d4 cis d2~ | d4 cis d g | d1~ | d1 |

		% part "B"
		d4 cis d2~ | d4 cis d c | d cis d2~ | d4 cis d f |
		g4 fis g2~ | g4 fis g d' | c1~ | c1 |

		% part "C"
		bes4 a bes2~ | bes4 a bes a | bes c c d | d c c bes |
		g4 fis g2~ | g4 fis g d' | ees,1~ | ees8 r d4 f ees |

		% part "D"
		d4 cis d2~ | d4 cis d f | g fis g2~ | g4 fis g bes |
		c4 b! c d | bes2 c |
	} \alternative {
		{
			bes1~ | bes2 r |
		}
		{
			bes1~ | bes2. r4 |
		}
	}
}
{% endif %}
