{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes2:6 g:m7 | c:m7 f:7 | bes:maj7 g:m7 | c:m7 c4:m7/f f:7/ees | bes1:maj7/d | \myEndLine
		des1:dim7 | c:m7 | f2:7 c4:m7/f f:dim | c1:m7 | ees:m | bes:6 | \myEndLine
		g1:m7 | c:7 |
	} \alternative {
		{
			f1:9 | bes2:6 b:dim7 | c2:m7 c4:m7/f f:7.9- | \myEndLineVoltaNotLast
		}
		{
			f2:7 c4:m7/f f:7 | bes2 c4:m7 cis:dim7 | bes2/d ees:9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	d1*2:7 | ees:6 | \myEndLine
	ees1:m6 | ees2:m6/ges g:dim7 | bes1*2/f | ges2:7 bes/f | e1:m7.5- | \myEndLine
	e1:m7/a | a:7 | d2 a:7/cis | a2:m/c g4:m7/c c:7 | f1:7 | f2:7 c4:m7/f f:7.9- | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	c1:m7 | ees:m | bes:6 | g:m7 | \myEndLine
	c1:9 | f2:9 c4:m7/f f:7.9- | bes2 ges:6 | bes1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\partial 2 bes4 c |

	% part "A"
	\repeat volta 2 {
		d4^\markup { \musicglyph #"scripts.segno" } g g2~ | g4 r f ees | d bes bes2~ | bes4 r bes c | d a' a a |
		a4 bes a bes | g f f2~ | f4 r c d^\markup { To Coda \musicglyph #"scripts.coda" } | ees d' d2~ | d4 r c d | c bes bes2~ |
		bes4 r d c | bes2 c4 bes |
	} \alternative {
		{
			a2 bes4 a | g1~ | g4 r bes, c |
		}
		{
			a'2 bes4 c | bes1~ | bes4 r r c |
		}
	}

	% part "B"
	d1~ | d4 c \tuplet 3/2 { c4 bes a } | c2 g~ | g4 r a bes |
	c1~ | c4 bes \tuplet 3/2 { bes4 a g } | bes1~ | bes4 r r bes | bes1~ | bes4 a \tuplet 3/2 { a4 g fis } |
	a2 e!2~ | e4 e! fis g | a a a a | a e! f g | a1~ | a4 r bes, c^\markup { D.S. al Coda } |

	% part "Coda"
	ees4^\markup { \musicglyph #"scripts.coda" } d' d2~ | d4 r ees d | c bes bes2~ | bes4 r d c |
	bes2 c4 bes | a2 bes4 c | bes1~ | bes2 r |
}
{% endif %}
