{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 r4 |

	\myMark "A"
	\startPart
	r1*4 | \myEndLine
	s1*4 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		f1*2:7 | bes1:7 | f:7 | \myEndLine
		bes1*2:7 | f1*2:7 | \myEndLine
		c1:7 | bes:7 | f:7 |
	} \alternative {
		{
			c1:7 | \myEndLineVoltaNotLast
		}
		{
			r1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key f \major

	\partial 4 f'4 |

	% part "A"
	aes8^\markup { \musicglyph #"scripts.segno" } f4. ees4 c | ees8 c4. bes4 f | aes8 f4. ees2~ | ees2. f'4 |
	aes8 f4. ees4 c | ees8 c4. bes4 f | aes8 f4. ees2_\markup { \italic { Fine } } | r4 f8 c e! f4 b!8~ |

	% part "B"
	\repeat volta 2 {
		b2~ b4. c8 | r4 r8 f,8 e f4 bes8~ | bes2. \grace g8 a8 f | r4 r8 aes16 f aes8 f4 e'8~ |
		e2~ e4. f8 | r2 aes,8 f4 b!8~ | b2~ b4. c8 | r2 r8 a c d |
		ees8 ees d4 r des8 des | c4 r ces8 ces bes bes | aes2.~ aes8 bes |
	} \alternative {
		{
			r4 r8 f16 c e8 f4 b!8 |
		}
		{
			r2 r4 f'4^\markup { D.S. al Fine } |
		}
	}
}
{% endif %}
