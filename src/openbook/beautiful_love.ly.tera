{% if part == "ChordsReal" %}\chordmode {
\startChords
\startSong

   s4 s4 s4 s4 \repeat volta 2 {

      \myMark "A"
      |
      e2.:dim5m7 s4 |
      a4.:7.5+ s8 s4 s8 s8 |
      d1:m5 |
      d4:m5 s4 s4 s4 | \myEndLine
      g2.:m7 s4 |
      c4.:7 s8 s4 s8 s8 |
      f1:maj7 |
      e4:dim5m7 s4 a4:7 s4 | \myEndLine
      d4.:m5 s8 s4 s4 |
      g4.:m7 s8 s4 s4 |
      bes1:7.11+ |
      a4:7 s4 s4 s4 \myEndLine
   } \alternative {
      {
         |
         d2.:m5 s4 |
         g2.:7.11+ s4 |
         e1:dim5m7 | \myEndLine
         a4:7 s4 s4 s4 \myEndLineVoltaNotLast
      }
      {
         |
         d2:m5 b4:7 s4 \myEndLineVoltaLast
      }
   } |
   bes2:7 a2:7 |
   d1:m5 |
   s4 s4 s4 s4 \endBar

\endSong
\endChords
}
