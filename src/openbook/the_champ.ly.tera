{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		aes1*4:maj7 | \myEndLine
		des1*2 | aes1*2 | \myEndLine
		bes1:m7 | ees:7.5+ | aes1 |
	} \alternative {
		{
			aes1 | \myEndLineVoltaNotLast
		}
		{
			aes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	a1*4:m7 | d1*2:m7 | \myEndLine
	a1*7:m7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Presto" 4 = 280
	\time 4/4
	\key aes \major

	\partial 4 g4~ |

	% part "A"
	\repeat volta 2 {
		g aes b! c | d! ees b! g~ | g aes8 ees g aes r4 | r2 r4 g~ |
		g aes b! c | d! ees b! g~ | g aes8 ees g aes r4 | r2 r4 g~ |
		g aes b! c | d! ees b! g~ | g aes8 ees g aes r4 |
	} \alternative {
		{
			r2 r4 g |
		}
		{
			r1 |
		}
	}

	% part "B"
	\key c \major
	r8 a' c d c a g e | g e a4 g e | d e d e~ | e1 | r8 a c d c a g e | g e a4 g e |
	d e d e~ | e1 | r8 a c d c a g e | g e a4 g e | d1~ | d2. e4 | a r2. |
}
{% endif %}
