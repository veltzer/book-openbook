{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees1 | ees | ees2 c:m7 | f:m7.5- bes:7 | \myEndLine
		ees1:6 | ees:6 | f:m7 | bes:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1:6 | ees:6 | ees2.:6 c4:m7 | f2:m7.5- bes:7 | \myEndLine
		ees1:6 | ees2:6 f:m7 | g1:m7 | c:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		f2:m7 bes:9 | ees g8:m7 ges4.:m7 | f2:m7 bes:7.5+ | ees1:maj7 | \myEndLine
		ees2:m7 aes:7 | des:maj7 f8:m7 e4.:m7 | ees4:m7 ees:m/des c8:7.5+ f4.:9 | bes1:7.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1:6 | ees:6 | ees2:6 c:m7 | f:m7.5- bes:7 | \myEndLine
		ees1 | aes2. ees4 | ees2:/bes e:dim7 | f:m7 bes:9 | \myEndLine
		g1:m7 | c:7.5+ | f:9 | bes:9 | \myEndLine
	} \alternative {
		{
			ees2 ges:dim7 | f:m7 bes:7.5+ | \myEndLineVoltaNotLast
		}
		{
			ees2 aes | ees1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
