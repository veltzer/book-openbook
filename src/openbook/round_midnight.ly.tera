{% if part == "VoiceLaurent" %}{
	\tempo "Adagio" 4 = 60
	\time 4/4
	\key ges \major

	% part "Intro"
	r4 ees16 f g a \grace { cis8( } d8) a16 g \grace { cis8( } d8) a16 g |
	\grace { e'8( } f4)~ f16 e bes fis gis2 |
	r4 des16 ees f g \grace { b8( } c8) g16 f \grace { b8( } c8) g16 f |
	\grace { d'8( } ees4)~ ees16 d aes e fis2 |
	r4 ces16 des ees f \grace { a8( } bes8) f16 ees \grace { a8( } bes8) f16 ees |
	\grace { c'8( } des4)~ des16 c ges d e2 |
	\repeat unfold 3 { r16 <g, d' fis ais>16 <g d' fis ais>8 <g d' fis ais>8 <g d' fis ais>16 <g d' fis ais>16 }
	r16 <g d' fis ais>16 <g d' fis ais>8 <aes d e bes'>4 |

	% part "A"
	\repeat volta 2 {
		r4 bes16 ees f bes ges4. bes,8 | ees8 ees~ ees4~ ees8 ees bes'16 aes8. |
		r4 ees16 ges bes des c4. ges8 | a4 aes aes8 ges~ ges4 |
		r4 aes16 ces ees ges f4. ces8 | bes2. ees,8 f |
	} \alternative {
		{
			\tuplet 3/2 { ges8 f ges } f4~ f4. ees8 | d8 bes~ bes2. |
		}
		{
			ges'8 f4 ees8~ ees4 ees8 ees~ | ees2. ees8 f |
		}
	}

	% part "B"
	\tuplet 3/2 { ges8 f ges } f4~ f4. ees8 | d8 bes~ bes2 ees8 f |
	\tuplet 3/2 { ges8 f ges } f4~ f4. ees8 | d8 bes'8~ bes2. |
	ces4 ces8. ces16 bes8 bes~ bes4 | ges8. ges16 ges8 f~ f4. bes8 |
	ees4. ees16 ees des4. des16 des | ces4. des16 ces bes2 |

	% part "A"
	r4 bes,16 ees f bes ges4. bes,8 | ees8 ees~ ees4~ ees8 ees bes'16 aes8. |
	r4 ees16 ges bes des c4. ges8 | a4 aes aes8 ges~ ges4 |
	r4 aes16 ces ees ges f4. ces8 | bes2. ees,8 f |
	ges8 f4 ees8~ ees4 ees8 ees~ | ees2. r4 |

	% part "Coda"
	r8 bes \tuplet 3/2 { c8 d ees } f ees~ \tuplet 3/2 { ees8 des c } |
	ges'1~ | ges4~ \tuplet 3/2 { ges8 f ees } f8. d16 ees f ges aes |
	\tuplet 3/2 { a8 ces gis } a2.~ | a4~ \tuplet 3/2 { a8 gis fis } gis8. fis16 f fis gis a |
	b2.~ \tuplet 3/2 { b8 e, f } | bes4 \tuplet 3/2 { aes8 ees c } <b e g>4 r8 bes |
	ees4 bes' ees aes,! | des! ges,! ces! e, |
	\time 2/4
	bes'2 |
	\time 4/4
	<a fis d a>1\fermata |
}
{% endif %}
