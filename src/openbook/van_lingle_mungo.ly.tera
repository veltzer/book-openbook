{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	\repeat volta 2 {
		des1:maj7 | s1 | ges1:maj7 | s1 | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1 | e1:dim7 | d2:m7 c:m7 | bes4:maj7 a2.:7 | \myEndLine
		aes1:maj7 | s1 | f1:m7 | des1:maj7 |
	} \alternative {
		{
			s1 | f1:maj7 | \myEndLineVoltaNotLast
		}
		{
			ees1:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	aes1:maj7 | s1 | g1:m7.5- | s2 c:7 | f1:m | \myEndLine
	c2:7/e aes:7/ees | des1:maj7 | ges1:maj7 | f1:sus4 | e2:m9 a:9 | d2:m9 c:m7 | bes4:maj7 a2.:7 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	d2:m c:m7 | bes4:6 a2.:7 | d2:m9 c:m7 | bes4:maj7 a2.:7 | d2:m7 c:m9 | \myEndLine
	bes4:6 a2.:7 | aes1:maj7 | s1 | f1:m7 | des1:maj7 | ges1:maj7 | \myEndLine
	f1:maj7 | e2:m7.5- a:7.9- | d2:m f:7 | bes2 a:7 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	f1:m9 | s1 | \myEndLine
	des1:maj7 | s1 | s1 | s1 | c1:maj9 | s1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Adagio" 4 = 80
	\time 4/4
	\key f \major

	% part "Intro"
	\repeat volta 2 {
		c'4. bes8 f2~ | f2 bes | f4. ees8 bes2~ | bes4 c des ees |
	}

	% part "A"
	\repeat volta 2 {
		r8 c c c f4 c | r8 bes c des~ des4 c8 bes | a4 a8 a d4 f8 g,8~ | g8 f e2. |
		r2 \tuplet 3/2 { g4 g g } | c4 g2. | r2 \tuplet 3/2 { f'4 g aes } | aes1 |
	} \alternative {
		{
			c,1 | r1 |
		}
		{
			g'1 |
		}
	}

	% part "B"
	r2^\markup { \musicglyph #"scripts.segno" } \tuplet 3/2 { ees4 ees ees } | aes4 bes2. | r2 \tuplet 3/2 { g4 aes bes } | bes4 c2. | r4 c c c |
	\tuplet 3/2 { c2 c4 } \tuplet 3/2 { c4 des c } | c1 | bes2. c,4 | bes'1 | a1 | a4 d,8 e f4 g8 a~ | a8 bes a2. |

	% part "C"
	a,4 a8 a d4 f8 g,8~ | g8 f e2. | a'4 d,8 e f4 g8 a~ | a8 bes a2. | a,4 a8 a d4 f8 g,8~ |
	g8 f e2. | r2 \tuplet 3/2 { g4 g g } | c4 g2.^\markup {To Coda \musicglyph #"scripts.coda"} | r2 \tuplet 3/2 { f'4 g aes } | aes1 | c,1 |
	r1 | r1 | r1 | r1^\markup {D.S. al Coda} |

	% part "Coda"
	r2 \tuplet 3/2 { g4 g g } | c4 g2. |
	r2 \tuplet 3/2 { g'4 g g } | c4 g2.\fermata | r4 f g aes | aes1 | g1~ | g1\fermata |
}
{% endif %}
