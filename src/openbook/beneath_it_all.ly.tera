{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	aes2.*2:maj7.11+ | g2.*2:m7 | \myEndLine
	aes2.*2:maj7.11+ | c2.*2:m7+.5- | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	e2.*2:maj7.11+ | d2.*2:maj7 | \myEndLine
	bes2.*2:maj7.11+ | a2.*2:7.9+ | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	bes2.*2:maj7.11+ | c2.*2:maj7.11+ | \myEndLine
	des2.*4:maj7.11+ | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Andante" 4 = 90
	\time 3/4
	\key c \major

	% part "A"
	r2 ees4 | d'2 c4 | bes8 c d2~ | d2. |
	r2 ees,4 | d'2 c4 | b!2.~ | b2. |

	% part "B"
	r2 bes4 | a'2 g4 | gis8 e d2~ | d2 e4 |
	f!2. | e4. d | c2. | bes4. c |

	% part "C"
	a2.~ | a2 g4 | fis2.~ | fis2 e4 |
	ees2.~ | ees2.~ | ees2.~ | ees2. |
}
{% endif %}
