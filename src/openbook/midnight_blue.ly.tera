{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		c1*3 | c2.:7 c4:9 | \myEndLine
		f2 bes | f1 | c1*2 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1 | f1 | a1:m | g1:7sus4 | \myEndLine
		c1*2 | e1*2:m | \myEndLine
		a1:m | g2.:sus4 g4 | c1 | g1:sus4 | \myEndLine
	} \alternative {
		{
			g1 | \myEndLineVoltaNotLast
		}
		{
			g1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "C"
	\startPart
	c1*3 | c2.:7 c4:9 | \myEndLine
	f1*2 | c1*2 | \myEndLine
	g1 | f1 | a1:m | g1:7sus4 | \myEndLine
	\endPart

	\myMark "End"
	\startPart
	\repeat volta 2 {
		c1*4 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
