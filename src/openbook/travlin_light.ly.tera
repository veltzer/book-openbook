		\endPart

		\myMark "B"
		\startPart
		s1 | s2 a4:m7 f:maj7 | a4.:m7 f8:maj7 s2 | s4 b:9 f8:6/c bes4:9 a8:m7 | \myEndLine
		s2 aes:7 | g1:m7 | g1:m7/c | c4:9 f/a aes2:dim7 | \myEndLine
		\endPart

		\myMark "A"
