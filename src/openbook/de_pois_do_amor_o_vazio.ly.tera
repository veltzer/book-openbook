{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	e1:7.9+ | a2*5:7.9+ | aes1:5+.11+ | g2:7.5- fis:7.5- | \myEndLine
	f1:7.5+ | s1*4 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:maj7.11+ | ees:maj7.11+ | d:m7 | d:m7 | \myEndLine
		c:m7 | c:m7 | f:7 | f:7 | \myEndLine
		e:maj7.11+ | e:maj7.11+ | b:maj7 | bes:7 | \myEndLine
		ees:maj7.11+ | ees:maj7.11+ | d:7.9+ | d:7.9+ | \myEndLine
		g:m7 | g:m7 | a:7sus4 | a:7sus4 | \myEndLine
	} \alternative {
		{
			c:m7 | c:m7 | f:7 | f:7 | \myEndLine
			b:m7.5- | b:m7.5- | e:7.9- | e:7.9- | \myEndLine
			ees:m7 | ees:m7 | ees:m7 | ees:m7 | \myEndLineVoltaNotLast
		}
		{
			ees:m7 | ees:m7 | f:m7 | f:m7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	g1:m7 | g:m7 | a:7sus4 | a:7sus4 | \myEndLine
	d:m7 | d:m7 | d:m7 | d:m7 | \myEndLine
	\endPart

	\myMark "Instr"
	\startPart
	\repeat volta 2 {
		b1:m7+ | b:m7+ | b:m7+ | b:m7+ | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	% part "Intro"
	c'2^\markup { Rubato } e,4 g | \time 10/4 c2 ees b! ees d,4 e | \time 4/4 c'2 d | cis2 c! |
	cis1 | r1^\markup { A tempo } | r1 | r1 | r1 |

	% part "A"
	\repeat volta 2 {
		d1~^\markup { \musicglyph #"scripts.segno" } | d~ | d~ | d2 \tuplet 3/2 { r4 d,4 ees } |
		d'1~ | d~ | d~ | d |
		ais1~ | ais~ | ais~ | ais2 r8 d4 a8~ |
		a1~ | a~ | a | r2 \tuplet 3/2 { r4 g a } |
		bes1~ | bes | r1 | r2 \tuplet 3/2 { r4 d, ees } |
	} \alternative {
		{
			f1~ | f~ | f~ | f |
			f'1~ | f~ | f | r2 \tuplet 3/2 { r4 d bes } |
			des1~ | des~ | des~ | des |
		}
		{
			f,1 | f2.. bes8 | g4 bes8 g~ g2~ | g1 |
		}
	}

	% part "B"
	a'1~ | a~ | a~ | a2 \tuplet 3/2 { g4 e f } |
	d1~ | d~ | d~ | d |

	% part "Instr"
	\repeat volta 2 {
		r1^\markup { Solo } | r1 | r1 | r1^\markup { D.S. } |
	}
}
{% endif %}
