{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1 | c2:m7 f:7.9- | bes1 | c2:m7 f:7 | \myEndLine
		bes2 bes:7 | ees aes:7 | \myEndLine
	} \alternative {
		{
			d2:m7 des:7 | c:m7 f:7 | \myEndLineVoltaNotLast
		}
		{
			c2:m7 f:7.5+.9+ | bes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	a2:m7 d:7 | a:m7 d:7 | d1:m7 | g:7 | \myEndLine
	g1:m7 | c:7 | c:m7 | f:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	bes1 | c2:m7 f:7.9- | bes1 | c2:m7 f:7 | \myEndLine
	bes2 bes:7 | ees aes:7 | c:m7 f:7.5+.9+ | bes1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
