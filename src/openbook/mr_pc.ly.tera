	\tempo "Allegro" 4 = 220
	\time 4/4
	\key c \minor

	% part "A"
	c8 c d d ees ees f f | g g f f ees c4 bes8 | c2 bes4. c8~ | c2 r |
	f8 f g g aes aes bes bes | c c bes bes aes f4 ees8 | c2 bes4. c8 | r2 ees8 c ees ges |
	r8 f4.~ f4. ges8 | r f4 ees8 f4 ees | c2 bes4. c8~ | c2 r2 |
}
