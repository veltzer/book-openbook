{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	c1*2:m7 | c2:m7 bes | c1:m7 | \myEndLine
	f1*2:m7 | c2:m7 bes | c2.:m7 s8 d:7 | \myEndLine
	s8 g2.:7 d8:7 | s8 g4.:7 s2 | c2:m7 bes | c1:m7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
