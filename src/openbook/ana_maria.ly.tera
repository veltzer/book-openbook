{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	g1:m | g:m | g:m | g:m | \myEndLine
	g:m | g:m | g:m | g:m | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		g1:maj7 | c:m7/g | g:7sus4 | c:m7/g | \myEndLine
		des/f | ges:maj7.11+ | aes:m7 | bes/ees | \myEndLine

		\myMark "B"
		g:m | c:7sus4 | d/c | c:7sus4 | \myEndLine
		aes4./c bes4./c aes4/c | aes1/c | g:m | g:m | g:m | g:m | \myEndLine

		\myMark "A"
		g:maj7 | g:7sus4 | f2:7sus4 c:7/e | ees1:7sus4 | \myEndLine
		d2:maj7 f:7 | bes1:m7 | aes:m7 | bes/aes | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Allegro" 4 = 180
	\time 4/4
	\key c \major

	% part "Intro"
	\improvisationOn
	b'4^\markup { "(G phrygian, piano solo)" } b b b | b b b b | b b b b | b b b b |
	b b b b | b b b b | b b b b | b b b b |
	\improvisationOff

	\repeat volta 2 {
		% part "A"
		d1~ | \tuplet 3/2 { d4 ees d } \tuplet 3/2 { c bes a } | g2.. g8~ | g2. r4 |
		des'1~ | \tuplet 3/2 { des4 c bes } \tuplet 3/2 { aes g ges~ } | ges1 | f2 r2 |

		% part "B"
		bes1~ | \tuplet 3/2 { bes4 c g } \tuplet 3/2 { bes d e } | fis2 e4. d8 | d1 |
		ees4. d8~ d4 c | c1 |
		\improvisationOn
		b4^\markup { "(G phrygian)" } b b b | b b b b | b b b b | b b b b |
		\improvisationOff

		% part "A"
		d1~ | \tuplet 3/2 { d4 ees d } \tuplet 3/2 { c b bes~ } | bes1~ | bes2. r4 |
		cis2.. c!8~ | c4. bes8 \tuplet 3/2 { aes4 g ges~ } | ges1 | f2. r4 |
	}
}
{% endif %}
