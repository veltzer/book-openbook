{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2. s2. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1*4:7 | f1*2 | \myEndLine
		c1*2:7 | g1*2:7 |
	} \alternative {
		{
			c1*2 | \myEndLineVoltaNotLast
		}
		{
			c1 | c4 g:7 c2:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f1:7 | c:7 | f:7 | c2:7 f | \myEndLine
	s1 | c:7 | f:7 | \myEndLine
	c4.:7 f8 s2 |
	\endPart

	\myMark "C"
	\startPart
	g1:7 | g:dim7 | g2:7 g:dim7 | g1:7 | \myEndLine
	c1*4:7 | f1*2:7 | c1*2:7 | \myEndLine
	g1*2:7 | c1*2 | g1*2:7 | c1*2 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
