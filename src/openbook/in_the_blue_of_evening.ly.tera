{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1 | bes:m7 | f2/a aes:dim7 | g2:m7 g:m7.5- | \myEndLine
		c1:7.9- | f2 aes:dim7 | g1:m7 | \myEndLine
		c1:7.9- | f2./a aes4:dim7 | g4:m7 c:9 c2:7.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | bes:m7 | f2/a aes:dim7 | g2:m7 g:m7.5- | \myEndLine
		c1:7.9- | f2 aes:dim7 | g1:m7 | \myEndLine
		c1:7.9- | f1 | ees2:m aes:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		des1 | ees2:m7.5- aes:7 | ees2:m7.5- aes:7 | des1 | \myEndLine
		f1 | g2:m7.5- c:7 | g1:m7.5- | c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | bes:m7 | f2/a aes:dim7 | g2:m7 g:m7.5- | \myEndLine
		c1:7.9- | f2 aes:dim7 | g1:m7 | c2.:9 c4:7.9- |

	} \alternative {
		{
			f1 | g2:m7 c:7.5+ | \myEndLineVoltaNotLast
		}
		{
			f1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
