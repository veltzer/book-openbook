{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2.. s2.. |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		g2 g:maj7 | g1:7 | c:maj7 | f:9 | \myEndLine
		g2 a:m7 | d1:9 | g2 gis:dim7 | a:m7 d:9 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		g2 g:maj7 | g1:7 | c:maj7 | f:9 | \myEndLine
		g2 a:m7 | d1:9 | g2 c:7 | f:m7 bes:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees2 ees:maj7 | ees ees:maj7 | ees1:maj7 | ees2 ees:9 | \myEndLine
		a2:m7 d:7 | g e:9 | g4:m d a:7 d:7 | d1:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		g2 g:maj7 | g1:7 | c:maj7 | f:9 | \myEndLine
		g2 a:m7 | d1:9 |

	} \alternative {
		{
			g4 bes:7 ees:9 d:9 | r1 | \myEndLineVoltaNotLast
		}
		{
			g1 | s1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
