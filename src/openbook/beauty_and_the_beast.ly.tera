{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	f1*4:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1*3:7 | f2:7sus4 e:7.5+.9+ | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		a1:m7 | b2:7.5+.9+ e:7.5+.9+ | a1:m7 | g2:m7 c:7.9+ | \myEndLine
		f1:m7 | ees2:m7 aes:7 | des1:maj7 |
	} \alternative {
		{
			c1:7.5+.9+ | \myEndLineVoltaNotLast
		}
		{
			f1*3:7 | f2:7sus4 e:7.5+.9+ | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "C"
	\startPart
	c1:7.5+.9+ | b2:m7 e:7 | a2:m7 d:7 | c1:7.5+.9+ | \myEndLine
	s1 | f1*2:7 | \myEndLine
	\repeat volta 2 {
		f1:7 | \myEndLine
	}
	\endPart

	\myMark "Coda"
	\startPart
	a2:m7 d:7 | c1:7.5+.9+ | s1 | f1*2:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	% part "Intro"
	\improvisationOn
	b'4 b b b | b8 b b4 b b | b4 b b b | b8 b b4 b b |
	\improvisationOff

	% part "A"
	\repeat volta 2 {
		\improvisationOn
		b4^\markup { \musicglyph #"scripts.segno" } b b b | b4 b b b | b4^\markup { Stop Time } b b b |
		\improvisationOff
		r8. g16~ g8 a16 g bes8. g16 b!8. g16 |
	}

	% part "B"
	\repeat volta 2 {
		e1^\markup { Med. Bossa } | r4 r8 \tuplet 3/2 { g16 a g } bes8. g16 b!8. g16 | e1 | r4 r8 \tuplet 3/2 { c'16 d c } ees8. c16 ees8. c16 |
		aes1 | c8. a16 a2~ a16 c ees f | f8~ f8~ f16 c aes8~ aes2 |
	} \alternative {
		{
			\improvisationOn
			b4^\markup { Drum fill } b b b |
			\improvisationOff
		}
		{
			\improvisationOn
			b4^\markup { Funk } b b b | b4 b b b | b4^\markup { Stop Time } b b b |
			\improvisationOff
			r8. g16~ g8 a16 g bes8. g16 b!8. g16 |
		}
	}

	% part "C"
	r8. a!16 bes8. a16 b!8. a16 c8. ees16 | e!4.. b16 b4. c8^\markup { To Coda \musicglyph #"scripts.coda" } | d4.. a16 a4.. bes16 | c2. r4 |
	r1 |
	\improvisationOn
	b4^\markup { Funk } b b b | b4 b b b |
	\improvisationOff
	\repeat volta 2 {
		r1^\markup { Open solo on F7, D.S. al Coda } |
	}

	% part "Coda"
	d4..^\markup { \musicglyph #"scripts.coda" } a'16 a4.. bes16 | c2. r4 | r1 |
	\improvisationOn
	b,4 b b b | b4 b b b^\markup { Fade } |
	\improvisationOff
}
{% endif %}
