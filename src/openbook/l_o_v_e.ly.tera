{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	g1 |
	s1 |
	a1:m7 |
	d1:7 | \myEndLine
	d1:7 |
	s1 |
	g1 |
	s1 | \myEndLine
	g1:7 |
	s1 |
	c1 |
	s1 | \myEndLine
	a1:7 |
	s1 |
	d1:7 |
	s1 | \myEndLine
	g1 |
	s1 |
	a1:m7 |
	d1:7 | \myEndLine
	d1:7 |
	s1 |
	g1 |
	s1 | \myEndLine
	g1:7 |
	s1 |
	c1 |
	cis1:dim7 | \myEndLine
	g1 |
	d1:7 |
	} \alternative {
	{
	g1 |
	a2:m7 d2:7 | \myEndLineVoltaNotLast
	}
	{
	g1 | \myEndLineVoltaLast
	}
	}
	a2:m7 d2:7 |
	g1 |
	a2:m7 d2:7 | \myEndLine
	g1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	\repeat volta 2 {
	\mark \markup { \box { A } } g'2. fis'4 |
	fis'4 e'4 dis'4 e'4 |
	g'2. fis'4 |
	fis'1 |
	fis'2. e'4 |
	e'4 d'4 cis'4 d'4 |
	fis'2. e'4 |
	e'1 |
	b'2. a'4 |
	a'4 g'4 fis'4 g'4 |
	b'2. a'4 |
	a'4 g'4 fis'4 g'4 |
	b'2. a'4 |
	a'4 g'4 fis'4 g'4 |
	b'4 a'4 ^ "N.C." a'4 g'4 |
	g'4 fis'4 e'4 fis'4 |
	\mark \markup { \box { A } } g'2. fis'4 |
	fis'4 e'4 dis'4 e'4 |
	g'2. fis'4 |
	fis'1 |
	fis'2. e'4 |
	e'4 d'4 cis'4 d'4 |
	fis'2. e'4 |
	e'1 |
	b'2. a'4 |
	a'4 g'4 fis'4 g'4 |
	b'4 a'4 a'4 g'4 |
	g'4 fis'4 e'4 fis'4 |
	g'2. fis'4 |
	fis'4 e'4 fis'4 a'4 |
	} \alternative {
	{
	g'1 ~ |
	g'4 r4 r2 |
	}
	{
	g'1 ~ |
	}
	}
	g'4 e'4 fis'4 a'4 |
	g'1 ~ |
	g'4 e'4 fis'4 a'4 |
	g'1 |
	\endBar
}
{% endif %}
