	f1:7 |
	c2/e ees2:dim7 |
	g2:sus4.7 g2:7 | \myEndLine
	c1 |
	s1 |
	aes1:7 |
	s1 | \myEndLine
	c2 g2:aug7 |
	c2.:7 cis4:dim |
	d2:7 g2:sus4.7 |
	} \alternative {
	{
