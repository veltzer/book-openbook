{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		g4 d:7/a g2/b | b2:7 e:m7 | a4:7 e:7/b a2:7/cis | a1:7 | \myEndLine
		d4:7 a:7/e d2:7/fis | d1:9 |
	} \alternative {
		{
			g2 e:m7 | a2:m7 d:7 | \myEndLineVoltaNotLast
		}
		{
			a1:m7 | a8:9 d4:7 g8*5:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	b1:7 | fis2:m7 b:7 | fis2:m7 b:7 | e1:m | \myEndLine
	a1:7 | e2:m7 a:7 | e2:m7 a:7 | d1:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	g4 d:7/a g2/b | b2:7 e:m7 | a4:7 e:7/b a2:7/cis | a1:7 | \myEndLine
	d4:7 a:7/e d2:7/fis | d1:9 | a1:m7 | a8:9 d4:7 g8*5:6 | \myEndLine
	\endPart

	\endSong
	\endChords
