{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	\repeat volta 2 {
	a''4 g''8 d''8 ~ d''2 |
	g''4 f''8 c''8 ~ c''2 |
	a''4 g''8 d''8 ~ d''2 |
	f''16 ^ "no chord" g''8 f''16 g''8 f''16 g''16 r8 g'8 bes'8 c''8 |
	es''8. as'16 ~ as'4 ( as'8 ) es''8 d''8 c''8 |
	d''8. g'16 ~ g'4 ~ g'8 g'8 bes'8 c''8 |
	d''8 es''8 d''8 es''8 d''4 bes'8 g'8 |
	a'8 a'8 a'8 g'16 a'16 ~ a'8 g'8 bes'8 c''8 |
	es''8. as'16 ~ as'4 ~ as'8 es''8 d''8 c''8 |
	d''8. g'16 ~ g'4 ~ g'8 g'8 bes'8 c''8 |
	d''8 es''8 d''8 es''8 d''4 bes'8 fis'8 |
	g'8 a'8 bes'8 c''8 d''8 bes'8 g'8 d'8 |
	fis'8. a'16 ~ a'8 g'8 ( g'8 ) bes'8 g'8 d'8 |
	fis'8. a'16 ~ a'8 bes'8 ~ bes'8 r8 g'8 d'8 |
	es'16 f'8 g'16 ( g'8 ) a'16 bes'16 c''8 a'8 bes'8 c''8 |
	d''4 d''4 d''8 r8 c''8 d''8 |
	es''8. as'16 ~ as'4 ~ as'8 es''8 d''8 c''8 |
	d''4. c''8 ~ c''2 |
	as'8. bes'16 ~ bes'8 c''8 es''8. d''16 d''8 c''8 |
	d''8. g'16 r4 d''4. c''8 |
	es''8. as'16 ~ as'4 ~ as'8 es''8 d''8 c''8 |
	d''4. c''8 ~ c''2 |
	\times 2/3 { es''4 d''4 es''4 } \times 2/3 { d''4 c''4 d''4 } |
	\times 2/3 { c''4 bes'4 c''4 } d''8 bes'8 c''8 d''8 |
	es''4. c''8 ~ c''2 |
	es''4 d''2 c''4 |
	d''2 r2 |
	}
	\endBar
}
{% endif %}
