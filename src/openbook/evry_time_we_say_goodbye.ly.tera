{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:maj7 | f2:m7 bes:7 | g2:m7.5- c:7 | f2:m7 bes4:7 bes:7/aes | \myEndLine
		g2:m7.5- c:7.9- | f2:m7 bes:7 | bes2:m7 ees:7 | aes2:m7 des:9 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees2/g ges:dim7 | f2:m7.5- bes:7 | bes2:m7 ees:7 | aes1:maj7 | \myEndLine
		aes2:m7 des:9 | ees1:maj7 | b1:9 | f2:m7.5-/bes bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees1:maj7 | f2:m7 bes:7 | g2:m7.5- c:7 | f2:m7 bes4:7 bes:7/aes | \myEndLine
		g2:m7.5- c:7.9- | f2:m7 bes:7 | bes2:m7 ees:7 | aes2:maj7 des:9 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		ees2/g ges:dim7 | f2:m7.5- bes:7 | ees2:7 aes:maj7 | aes2:m7 des:7 | \myEndLine
		ees2:maj7 c:7 |
	} \alternative {
		{
			f2:9 aes4/bes bes:7 | ees2 ges:dim7 | f2:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			f2:9 f4:m7/bes b:dim7 | c2:m c:m/bes | a2:m7.5- d:7 | \myEndLine
			g2:m7.5- c:7 | f2:7 bes:7 | ees1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
