		ees1:m7.5- | aes:7.9- | des2:maj7 b:m7 | \myEndLine
		a2:maj7 aes4:maj7 aes:m7 | aes2:m7 des:7 | ges:7 f:7 | bes:7 a:7 | \myEndLine
		aes:7 g:7 | fis:m7 b:7 | e:maj7 a:maj7 | ees:m7 aes:7 | \myEndLine
	} \alternative {
		{
			des1:maj7 | \myEndLineVoltaNotLast
		}
		{
			des1:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	fis1:m7 | b:7.5+.9+ | e2:maj7 fis:m7 | aes:m7 des:7 | \myEndLine
	g:m7 c:7 | fis:m7 b:7 | e1:m7 | a:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
