{% if part == "VoiceLaurent" %}{
	\tempo "Allegro" 4 = 180
	\time 4/4
	\key f \major

	% part "Intro"
	\clef bass
	\repeat percent 2 { ees,8 a d ees~ ees d4 bes8 | d, f a b~ b a4 f8 | }
	\clef treble

	\partial 8 a8 |

	% part "A"
	\repeat volta 2 {
		\tuplet 3/2 { bes8 des f } c'2 bes8 f | gis a4.~ a a,8 |
		\tuplet 3/2 { bes des f } c'2 bes8 f | a2 r4 r8 a,8 |
		\tuplet 3/2 { bes des f } c'2 bes8 f | gis a4.~ a2 |
		a8 bes \tuplet 3/2 { a16 bes a } g8 ees4 cis8 d~ |
	} \alternative {
		{
			d2 r4 r8 a8 |
		}
		{
			d2. a'4 |
		}
	}

	% part "B"
	c2 a4. g8 | fis4 ees'8 d~ d4 c8 a | bes g4 fis8~ fis g a g~ | g2 r |
	bes2 g4. f8 | e4 des'8 c~ c4 bes8 gis | a4. f8 g4 f8 e~ | e2 r4 r8 a,8 |

	% part "A"
	\tuplet 3/2 { bes8 des f } c'2 bes8 f | gis a4.~ a a,8 |
	\tuplet 3/2 { bes des f } c'2 bes8 f | a2 r4 r8 a,8 |
	\tuplet 3/2 { bes des f } c'2 bes8 f | gis a4.~ a2 |
	a8 bes \tuplet 3/2 { a16 bes a } g8 ees4 cis8 d~ | d4. a'8 r a4 a8~ |

	% part "C"
	a4 g8 e a4 g8 e | a g e a r4 r8 a~ |
	a4 f8 des a'4 f8 des | a'8 f des a' r4 r8 a~ |
	a4 f8 d! a'4 f8 d | a'8 f d a' r4 r8 a~ |
	a4 f8 des a'4 f8 des | a'8 f des a' r4 r8 a~ |
	a4 fis8 d a'4 fis8 d | a'8 f! d a' r4 r8 a~ |
	a4 fes8 des a'4 fes8 des | a'8 fes des a' r4 a8 c |
	r1_\markup { \bold "Solo break" } | r1 | r1 | r1 |
}
{% endif %}
