{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	s4 c2. |
	f1 |
	g1:7 |
	c1 | \myEndLine
	s1 |
	f1 |
	g1:7 |
	s1 | \myEndLine
	c1 |
	f1 |
	g1:7 |
	c1 | \myEndLine
	c1:7 |
	f1 |
	g1:7 |
	} \alternative {
	{
	c1 | \myEndLineVoltaNotLast
	}
	{
	c1 | \myEndLineVoltaLast
	}
	}
	s1 |
	f1 |
	g1:7 | \myEndLine
	c1 |
	c1:7 |
	f1 |
	g1:7 | \myEndLine
	s1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 60
	\time 4/4
	\key c \major

	\repeat volta 2 {
	r4 _ "Country Pop" c''4 g'4 e'4 |
	d'4 e'8 f'8 ~ f'2 |
	r4 b'4 ~ b'8 g'8 a'8 g'8 |
	c'4 c'8 c'8 ~ c'2 |
	r4 c''4 g'4 e'4 |
	d'4 e'8 f'8 ~ f'2 |
	r8 g'8 g'4 b'4 c''4 |
	d''4 c''8 b'8 ~ b'8 g'8 a'4 |
	r4 c''4 g'4 e'4 |
	d'4 e'8 f'8 ~ f'4 f'8 d'8 |
	r4 b'4 ~ b'8 g'8 a'8 g'8 |
	c'4 c'8 c'8 ~ c'8 e'8 g'4 |
	r4 e''2 d''4 |
	c''4 c''4 c''8 a'8 ~ a'4 |
	r2 d''8 c''8 b'4 |
	} \alternative {
	{
	c''2 r2 ^ "Fine" |
	}
	{
	c''2 r8 c''8 c''4 |
	}
	}
	c''8 c''8 c''4 c''8 c''8 c''8 b'8 |
	a'8 c''8 a'8 f'8 ~ f'2 |
	b'8 b'8 b'4 a'8 g'8 g'4 |
	a'8 c''8 a'4 g'4. g'8 |
	g''8 g''8 e''4 d''4 c''8 a'8 |
	c''8 a'8 c''4 a'4. a'8 |
	g'8 g'8 g'8 g'8 b'4 b'8 b'8 |
	d''8 d''8 d''8 f''8 ~ f''8 e''8 d''4 ^ "D.C. al Fine" |
	\endBar
}
{% endif %}
