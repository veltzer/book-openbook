{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1 | f | f | f | \myEndLine
		bes1 | f | g:7 | c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | f | f | f | \myEndLine
		bes1 | f | c:7 | \myEndLine
	} \alternative {
		{
			f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\repeat volta 2 {

		\myMark "B"
		\startPart
		bes1 | f | c:7 | f | \myEndLine
		bes1 | f | g:7 | c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | f | f | f | \myEndLine
		bes1 | f | c:7 | \myEndLine
	} \alternative {
		{
			f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | f | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
