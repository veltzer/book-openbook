{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1 | f | f | f | \myEndLine
		bes1 | f | g:7 | c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | f | f | f | \myEndLine
		bes1 | f | c:7 | \myEndLine
	} \alternative {
		{
			f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\repeat volta 2 {

		\myMark "B"
		\startPart
		bes1 | f | c:7 | f | \myEndLine
		bes1 | f | g:7 | c:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f1 | f | f | f | \myEndLine
		bes1 | f | c:7 | \myEndLine
	} \alternative {
		{
			f1 | \myEndLineVoltaNotLast
		}
		{
			f1 | f | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 140
	\time 2/2
	\key f \major

	\repeat volta 2 {

		% part "A"
		r8 c' a4 a8 gis a g | a8 g!4 f8~ f d c r | r8 c' a4 a8 gis a g | a8 g!4 f8~ f4 g8 r |
		r8 g g f g f d c | f8 f4 f8~ f d c r | r4 g'2 f8 f | e4 c bes a |

		% part "A"
		r8 c' a4 a8 gis a g | a8 g!4 f8~ f d c r | r8 c' a4 a8 gis a g | a8 g!4 f8~ f4 g8 r |
		r8 g g f g f d c | f8 f4 f8~ f d c r | r4 bes'8 c a4 g |
	} \alternative {
		{
			a8 g f2 r4 |
		}
		{
			a8 g f2 r4 |
		}
	}

	\repeat volta 2 {

		% part "B"
		bes2. f4 | a4 f2. | g2. a4 | f1 |
		bes4 bes2. | a4 f2. | g4 g <g a> <f a> | <e c'>1 |

		% part "A"
		r8 c' a4 a8 gis a g | a8 g!4 f8~ f d c r | r8 c' a4 a8 gis a g | a8 g!4 f8~ f4 g8 r |
		r8 g g f g f d c | f8 f4 f8~ f d c r | r4 bes'8 c a4 g |
	} \alternative {
		{
			a8 g f2 r4 |
		}
		{
			a8 g f2.~ | f2. r4 |
		}
	}
}
{% endif %}
