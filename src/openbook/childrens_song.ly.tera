{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	\repeat volta 2 {
		s2.*4 | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		s2.*5 | \myEndLine
		s2.*5 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	\repeat volta 2 {
		s2.*5 | \myEndLine
		s2.*5 | \myEndLine
		s2.*2 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Andante" 4. = 60
	\time 6/8
	\key c \major

	% part "Intro"
	\repeat volta 2 {
		r2. | r2. | r2. | r2. |
	}

	% part "A"
	\repeat volta 2 {
		g''2.^\markup { \musicglyph #"scripts.segno" } | r8 bes,4~ bes4. | gis'2. | r8 b,!4~ b4. | e2. |
		r8 a,4~ a4.~ | a2.~ | a2.~ | a2. | r2.^\markup { \musicglyph #"scripts.coda" } |
	}

	% part "B"
	\repeat volta 2 {
		g'8 b,4 g'8 c, b | g'8 c,4 g'8 d4 | g8 b,4 g'8 c, b | g'8 c,4 g'8 d4 | g8 b,4 g'8 c, b |
		g'8 c,4 g'8 d4~ | d2.~ | d2. | a2.~ | a2.~ |
		a2. | r2.^\markup { \italic { D.S. al Coda } } |
	}
}
{% endif %}
