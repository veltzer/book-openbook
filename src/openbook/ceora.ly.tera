	\key aes \major

	\repeat volta 2 {

		% part "A"
		r8 ees8 d'8 ees8~ ees8 ees,4 ees'16 d16 | des1 | r8 ees,8 b'8 c8~ c8 ees,4 bes'8~ | bes1 |
		r8 aes,8 g'8 aes8 aes8 aes,4 aes'8 | g2.~ g8 g16 aes16 | ees2.~ ees8 c16 ees16 | aes4. ges8 \tuplet 3/2 { b16 c b } a8 aes8 g8 |
		f8 aes4 c8~ c8 des4 ees16 c16 | bes2. bes16 aes g f | g8 bes4 d8~ d8 ees4 f16 d16 | c2. c16 des bes c |
		a8 c4 e8~ e8 f8 e16 d16 c16 a16 | d4. e8 d4 \tuplet 3/2 { c16 d c } b8 | c4. f8 \tuplet 3/2 { des16 ees des } f,8 a8 c8 | bes4. des8 e16 fis16 ees8~ ees8 des8 |

		% part "B"
		r8 ees,8 d'8 ees8~ ees8 ees,4 ees'16 d16 | des1 | r8 ees,8 b'8 c8~ c8 ees,4 bes'8~ | bes1 |
		r8 aes,8 g'8 aes8 aes8 aes,4 aes'8 | g2.~ g8 g16 aes16 | ees2.~ ees8 c16 ees16 | aes4. ges8 \tuplet 3/2 { b16 c b } a8 aes8 g8 |
		f8 aes4 c8~ c8 des4 ees16 f16 | bes,2. bes16 aes g f | ges2 \tuplet 3/2 { g16 aes g } f8 e8 f8 | f'4. c8 \tuplet 3/2 { c8 f, aes } des8 c8 |
		aes2~ aes8 f8 aes16 bes16 aes8~ | aes2~ aes8 aes16 g16 bes16 aes16 ees16 f16 | g2. c,16 ees g ges |
	} \alternative {
