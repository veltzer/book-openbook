{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		aes1:maj7 | bes2:m7 ees:7 | aes1:maj7 | ees2:m7 aes:7 | \myEndLine
		des1:maj7 | d2:m7 g:7 | c1:m7 | f:7 | \myEndLine
		bes:m7 | ees:7 | c:m7 | f:7 | \myEndLine
		d:m7 | g:7 | c2:m7 f:7 | bes:m7 ees:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		aes1:maj7 | bes2:m7 ees:7 | aes1:maj7 | ees2:m7 d:7.5+ | \myEndLine
		des1:maj7 | d2:m7 g:7 | c1:m7 | f:7 | \myEndLine
		bes:m7 | ees:7 | c:m7.5- | f:7 | \myEndLine
		bes:m7 | ees:7sus4 | aes:maj7 |
	} \alternative {
		{
			bes2:m7 ees:7 | \myEndLineVoltaNotLast
		}
		{
			bes2:m7 ees:7 | aes1:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
