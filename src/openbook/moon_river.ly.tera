{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

	\myMark "A"
	\startPart
	c2.:maj7 | a:m7 | f:7.11+ | c/e | \myEndLine
	f:7.11+ | c/e | b:m7.5- | e:7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	a:m7 | c:7/g | f:maj7 | bes:9.11+ | \myEndLine
	a2:m a4:m7/g | fis4:m7.5- b2:7 | e4:m7 a2:7 | d4:m7 g2:9 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c2.:maj7 | a:m7 | f:7.11+ | c/e | \myEndLine
	f:7.11+ | c/e | b:m7.5- | e:7 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	a:m7 | a:m/g | fis:m7.5- | f:13 | \myEndLine
	c/e | f:7.11+ | c/e | f:7.11+ | \myEndLine
	c/e | a:m7 | d:m7 | g:9 |

	} \alternative {
		{
			c2.*2:maj7 | \myEndLineVoltaNotLast
		}
		{
			aes2.:maj7 | des:maj7 | c:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
