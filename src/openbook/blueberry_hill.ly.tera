{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2. ees2.:7 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		aes1*2 | ees1*2 | \myEndLine
		bes1*2:7 | ees2 ees:maj7 | ees2:6 ees:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		aes1*2 | ees1*2 | \myEndLine
		bes1*2:7 | ees2 des:7 | ees2 aes:6 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees1 | ees2:maj7 aes:6 | ees2 ees:maj7 | ees2:7 d:7 | \myEndLine
		g2:m d:7 | g2:m d:7 | g1 | bes4:7 ees2.:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		aes1*2 | ees1*2 | \myEndLine
		bes1*2:7 | ees2 des:7 |
	} \alternative {
		{
			ees2 ees:7 | \myEndLineVoltaNotLast
		}
		{
			ees2 aes:6 | ees1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 120
	\time 2/2
	\key ees \major

	\partial 2. ees4 g bes |

	\repeat volta 2 {

		% part "A"
		ees1~ | ees4 c \tuplet 3/2 { aes ees c' } | bes1~ | bes4 g \tuplet 3/2 { ees bes aes' } |
		f1~ | f4 f ees f | g1~ | g4 ees g bes |

		% part "A"
		ees1~ | ees4 c \tuplet 3/2 { aes ees c' } | bes1~ | bes4 g \tuplet 3/2 { ees bes aes' } |
		f1~ | f4 f ees d | ees1~ | ees4 bes' \tuplet 3/2 { f g aes } |

		% part "B"
		bes4. bes8 bes2~ | bes4 bes \tuplet 3/2 { f g aes } | bes1~ | bes4 bes \tuplet 3/2 { a! bes c } |
		d4. d8 d2~ | d4 d \tuplet 3/2 { a! b! c } | d1~ | d4 ees, g bes |

		% part "A"
		ees1~ | ees4 c \tuplet 3/2 { aes ees c' } | bes1~ | bes4 g \tuplet 3/2 { ees bes aes' } |
		f1~ | f4 f \tuplet 3/2 { f ees d } | ees1 |
	} \alternative {
		{
			r4 ees g bes |
		}
		{
			ees,1~ | ees2. r4 |
		}
	}
}
{% endif %}
