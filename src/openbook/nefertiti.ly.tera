{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		aes1:maj7 | des1:maj7 | g1:m7.5- | c1:7.9- | \myEndLine
		c1:7.9- | bes1:m7 | a1:maj7 | ees1:7.9-.11+ | \myEndLine
		e1:maj7 | a1:7sus4 | d1:7.5+.9- | e1:7 | \myEndLine
		e1:7sus4 | ees1:7.11+ | a1*2:13 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
