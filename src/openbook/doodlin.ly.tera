		ges1*2:7 | des1:7 | bes:7 | \myEndLine
		ees2:m7 ees:9 | aes1:9 | des |
	} \alternative {
		{
			s1 | \myEndLineVoltaNotLast
		}
		{
			s1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	s4 b:dim7 bes:dim7 a:dim7 | aes2:dim7 des4 aes:7 | des aes:dim7 g:dim7 ges:dim7 | f2:dim7 ges4 des:7 | \myEndLine
	ges4 e:dim7 ees:dim7 d:dim7 | des2:dim7 des4 aes:7 | des b:dim7 bes:dim7 a:dim7 | aes2:dim7 des | \myEndLine
	aes1*2:7 | des2 des4:dim7 c:dim7 | des1 | \myEndLine
	\endPart

	\endSong
