{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	s4 a8 bes c4 | a8 bes c4 bes | a4. bes8 c4 | a8 bes c4 bes | a2.*2 | \myEndLine
	bes2.*2 | a2.*2 | bes2.*2 | \myEndLine
	a2.*2 | bes2.*2/a | a2.*2 | \myEndLine
	bes2.*2/a | a2.*3 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	a1*2 | bes1*4 | \myEndLine
	a1*4 | \myEndLine
	bes1*2 | bes1*2:7.5- | \myEndLine
	a1*2 | bes1*2 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	a1*2 | bes1*2 | \myEndLine
	a1*2 | bes1*2 | a1*2 | \myEndLine
	bes1*2 | a1*2 | \myEndLine
	bes1*2 | a1*2 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	a2.*2 | bes2.*2 | \myEndLine
	a2.*2 | bes2.*2 | \myEndLine
	a2.*5 | \myEndLine
	d2:m g4:m | d2:m g4:m | d2.:m | s2. | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
