	\once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 |
	\once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 |
	\once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 \once \override NoteHead.style = #'slash bes'4 |
	\mark \markup { \box { B } } f'2 ~ f'8 c'4 d'8 |
	es'4 -. es'8 es'8 ~ es'8 d'8 c'8 as8 |
	b8 d'8 c'8 bes8 f'8 des'8 es'8 c'8 |
	r2 r8 as'4 ^^ as'8 ^^ |
	r8 c'4 d'8 ~ d'8 es'4 g'8 |
	r8 f'8 es'8 c'8 d'8 bes8 r4 |
	f'8 as'8 g'8 f'8 bes'8 g'8 as'8 f'8 |
	r2 r4 r8 c'8 |
	\once \omit TupletBracket \times 2/3 { f'8 g'8 f'8 } c'8 f'8 as'8 g'8 f'8 es'8 |
