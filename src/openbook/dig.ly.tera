	as4. c'16 es'16 g'8 f'8 r4 |
	r2 r8 es''4 es''8 ~ |
	es''8 des''4 c''8 c''8 bes'4 a'8 ~ |
	a'8 c''4 ges'8 ~ ges'8 f'4 r8 ^ "To Coda" |
	r8 c'8 \once \omit TupletBracket \times 2/3 { des'8 f'8 as'8 } c''4 -. g'8 as'8 |
	R1 _ "Solo break 1st x" |
	}
	\mark \markup { \musicglyph "scripts.coda" } r8 c'8 \once \omit TupletBracket \times 2/3 { des'8 f'8 as'8 } c''4 -. g'8 bes'8 ~ |
