	f'2 ~ f'8 a'4 c'8 |
	f'2 r8. c'16 d'8. dis'16 |
	e'8 c''4 bes'8 ~ bes'8. c''16 bes'8. g'16 |
	gis'8 a'8 gis'8 a'8 f'8 d'4. |
