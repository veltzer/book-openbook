			\grace s8 d2:m7 b:m7.5- | e:m7 a:7.9- | d:m7 e:m7 | f:m7 g:7.9- | \myEndLineVoltaNotLast
		}
		{
			\grace s8 d2:m7 d:m7/c | e:m7 a:7.9- | d:m7 e:m7 | f:m7 bes:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
