{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "Intro"
	\startPart
	\repeat volta 2 {
		s1 | s1 | s1 | s1 | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		s1 | s1 | s1 | s1 | \myEndLine
		s1 | s1 | s1 | s1 | \myEndLine
		s1 | s1 | s1 | s1 | \myEndLine
		s1 | s1 | s1 | s1 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Allegro" 4 = 176
	\time 4/4
	\key c \major

	\partial 4 r4 |

	% part "Intro"
	\repeat volta 2 {
		r1 | r1 | r1 | r2^\markup { Even 8ths } r8 c8 d f |
	}

	% part "A"
	\repeat volta 2 {
		g8 f d f aes2~ | aes2. r8 g | g f~ f2.~ | f2 f8 c d f |
		g8 f d f bes2 | b8 bes f a bes a r4 | c8 ees~ ees2. | f8 ees4. f8 ees f ees |
		c2. aes'4~ | aes2 bes | a8 f c g f b,4 b16 c | des2~ des8 c d f |
		d'1~ | d4 f8 g~ \tuplet 3/2 { g16 bes a } g8 f e |
		<< { e2~ e4 s4 } \\ { f,8 d4 f8 d4 g8 d } >> |
		<< { e'2 s2 } \\ { d,8 d cis4 r8 c d f_\markup { Free solos, or use F blues } } >> |
	}
}
{% endif %}
