{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1*3:6 | des1:6 | c1*2:6 | \myEndLine
		c1:6 | des:6 | d:9 | des:9 | c:6 | g:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		c1*3:6 | des1:6 | c1*2:6 | \myEndLine
		c1:6 | des:6 | d:9 | des:9 | c:6 |
	} \alternative {
		{
			g1:7 | \myEndLineVoltaNotLast
		}
		{
			c1:6.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
