		{
			g1:7 | d2:m a:7 | d1:m | d2:m c:7.5+ | f2 bes:9 | \myEndLine
			c4:6 b2.:7 | c4:6 e:m7.5- a2:7 | d1:m7 | d2:m7.5- g:7 | c1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

