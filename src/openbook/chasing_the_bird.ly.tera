{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1 | g2:m7 c:7 | f d:7 | g:m7 c:7 | \myEndLine
		f1:7 | bes2 b:dim7 |
	} \alternative {
		{
			f2 d:7 | g:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			g2:m7 c:7 | f1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	e1:m7 | a:7 | d1*2:7 | \myEndLine
	g1*2:7 | g1:m7 | c:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f1 | g2:m7 c:7 | f d:7 | g:m7 c:7 | \myEndLine
	f1:7 | bes2 b:dim7 | g:m7 c:7 | f1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
