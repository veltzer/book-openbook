		ees1:6 | g2.:m7.5- c4:7.9- | f1:m | f4:m7.5- bes2:7 fis4:dim7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees1:maj7/g | ges:dim7 | f:m7 | bes:7 | \myEndLine
		ees1:6 | ges:dim7 | f:m7 | bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees2.:6 c4:m7 | f1:9 | bes1:7 | f2:m7 bes:7 | \myEndLine
		ees1:6 | g2.:m7.5- c4:7.9- | f1:m | f4:m7.5- bes2:7 fis4:dim7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		ees1:maj7/g | d:7 | g:7 | g2.:m7.5- c4:7.9- | \myEndLine
