{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "A"
	\startPart
	bes1:7 | ees:7 | bes1*2:7 | \myEndLine
	ees2:m7 aes:m7 | des1:m7 | aes:7 | g2.:m7.5- gis4:dim7 | \myEndLine
	a2:dim7 bes:m7.5- | c4:7 f:7 bes des:7 | c:7 f2.:7 | bes1 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key bes \major

	\partial 8 f8 |

	% part "A"
	bes2 d16 bes r8 r8. bes16 | des2 ees16 des r8 r8. f,16 |
	bes2. \grace cis8 d8 d | bes4. aes8 r4 r8 f8 |
	bes8. bes16 des8. des16 \tuplet 3/2 { ees8 fes ees } \tuplet 3/2 { des8 bes des } |
	bes8. bes16 aes8. aes16 \tuplet 3/2 { ges8 ees ges } des8. ees16 |
	f2 r8 f \tuplet 3/2 { aes f aes } | ges2 r8 ges ces des |
	bes4 ~ \tuplet 3/2 { bes8 aes ges } bes4 ~ \tuplet 3/2 { bes8 aes ges } |
	a!8 r f'8. f16 \tuplet 3/2 { ees8 c a } f8 ees | d bes' ~ bes2. ~ | bes1 |
}
{% endif %}
