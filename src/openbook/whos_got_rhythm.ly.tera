{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1 | ees2 e:dim7 | bes/f g:m7 | c:7 b:7 | \myEndLine
		bes1 | ees2 e:dim7 | bes1 |
	} \alternative {
		{
			s1 | \myEndLineVoltaNotLast
		}
		{
			s1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	d1*2:7 | g1*2:7 | \myEndLine
	c1*2:7 | f1*2:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	bes1 | ees2 e:dim7 | bes/f g:m7 | c:7 b:7 | \myEndLine
	bes1 | ees2 e:dim7 | bes1 | s1 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	bes1*3 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 220
	\time 4/4
	\key bes \major

	% part "A"
	\repeat volta 2 {
		d2 f | g bes | c8 bes cis d bes f r4 | r1 |
		d2 f | g bes4. c8 | \tuplet 3/2 { des8 c bes } g8 bes r2 |
	} \alternative {
		{
			r1 |
		}
		{
			r2 r4 r8 bes8 |
		}
	}

	% part "B"
	\tuplet 3/2 { d8 e d } a8 b~ b2~ | b2 r4 r8 b8 | \tuplet 3/2 { d8 e d } a8 b~ b2~ | b2. r8 b8 |
	\tuplet 3/2 { d8 e d } a8 bes~ bes2~ | bes2. r8 bes8 | d8 c bes a~ a2~ | a1 |

	% part "A"
	d,2 f | g bes | c8 bes cis d bes f r4 | r1 |
	d2 f | g bes4. c8^\markup { To Coda \musicglyph #"scripts.coda" } | \tuplet 3/2 { des8 c bes } g8 bes r2 | r1^\markup { D.C. al Coda } |

	% part "Coda"
	\tuplet 3/2 { des8 c bes } g8 bes r4 \tuplet 3/2 { des8 c bes } | g8 bes r4 \tuplet 3/2 { des8 c bes } g8 bes~ | bes1 |
}
{% endif %}
