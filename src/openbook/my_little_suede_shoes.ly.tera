{% if part == "ChordsUnknown" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f2:m7 bes:7 | g:m7 c:7 | f:m7 bes:7 | ees:maj7 c:7 | \myEndLine
		f:m7 bes:7 | g:m7 c:7.9+.5+ | f:m7 bes:7 |
	} \alternative {
		{
			ees:maj7 c:7 | \myEndLineVoltaNotLast
		}
		{
			ees:maj7 ees:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	aes:maj7 aes:m7 | g:m7 c:7.9- | f:m7 bes:7 | ees:maj7 ees:7 | \myEndLine
	aes aes:m7 | g:m7 c:7.9- | f:m7 bes:7 | g:m7 c:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f:m7 bes:7 | ees:maj7 c:7 | f:m7 bes:7 | ees:maj7 c:7 | \myEndLine
	f:m7 aes:m7 | g:m7 c:7.9+.5+ | f:m7 bes:7 | ees1:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceUnknown" %}{
	\tempo "Moderato" 4 = 160
	\time 4/4
	\key ees \major

	\partial 4. bes8 ees g |

	% part "A"
	\repeat volta 2 {
		f f f f ees f r g | r2 r8 bes,8 ees g | f f f f ees f r ees | r2 r8 bes8 ees g | f f f f ees f r g |
		r bes4. a4 aes | g8 g g g f f r ees |
	} \alternative {
		{
			r2 r8 bes ees g |
		}
		{
			r2 r8 bes c d |
		}
	}

	% part "B"
	ees8 ees ees ees c aes r d | r d4. bes8 g r4 | c8 c c c aes f r bes~ |
	bes2 r8 bes c d | ees ees ees ees c aes r d | r d4. bes8 g r4 |
	c8 c c c aes f g ees~ | ees2 r8 bes8 ees g |

	% part "A"
	f f f f ees f r g | r2 r8 bes,8 ees g | f f f f ees f r ees | r2 r8 bes8 ees g | f f f f ees f r g |
	r bes4. a4 aes | g8 g g g f f r ees | r1 |
}
{% endif %}
