{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 160
	\time 4/4
	\key ees \major

	\partial 4. bes8 ees g |

	% part "A"
	\repeat volta 2 {
		f8[ f f f] ees f r g | r2 r8 bes,8 ees g | f[ f f f] ees f r ees | r2 r8 bes ees g |
		f[ f f f] ees f r g | r bes4. a4 aes | g8[ g g g] f f r ees |
	} \alternative {
		{
			r2 r8 bes ees g |
		}
		{
			r2 r8 bes c d |
		}
	}

	% part "B"
	ees8[ ees ees ees] c aes r d | r d4. bes8 g r4 | c8[ c c c] aes f r bes~ |
	bes2 r8 bes c d | ees[ ees ees ees] c aes r d | r d4. bes8 g r4 |
	c8[ c c c] aes f g ees~ | ees2 r8 bes ees g |

	% part "A"
	f[ f f f] ees f r g | r2 r8 bes, ees g | f[ f f f] ees f r ees | r2 r8 bes ees g |
	f[ f f f] ees f r g | r bes4. a4 aes | g8[ g g g] f f r ees | r1 |
}
