{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1*4 | \myEndLine
		bes1*3 |
	} \alternative {
		{
			bes1 | \myEndLineVoltaNotLast
		}
		{
			bes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	d1*2:7 | g1*2:7 | \myEndLine
	c1*2:7 | f1*2:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 220
	\time 4/4
	\key bes \major

	% part "A"
	\repeat volta 2 {
		r8 bes'4 f8 c'4. bes8~ | bes8 f d'4 r8 ees4 d8 | r8 bes r g d' ees d c | bes8 g aes a r bes4 f8 |
		c'4 r8 bes8~ bes g bes4 | r8 bes4 g8 ees' d a c | r4 r8 g r bes r g |
	} \alternative {
		{
			d'4 r8 c d c a f |
		}
		{
			des'8 g, c bes r2^\markup { \italic { Fine } } |
		}
	}

	% part "B"
	r1 | r1 | r1 | r1 |
	r1 | r1 | r1 | r1^\markup { \italic { D.C. al Fine (2nd ending) } } |
}
{% endif %}
