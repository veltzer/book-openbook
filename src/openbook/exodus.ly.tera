{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	\partial 4 r8 g8 |
	c'4. g'8 f'4. c'8 |
	es'8 f'8 d'8. bes16 c'4. g'8 |
	bes'4. a'8 bes'8 c''8 a'8. f'16 |
	g'2 r8 g'8 bes'8 d''8 |
	c''8. <g' g' g'>16 g'4 ~ g'8 c''8 g'8 c''8 |
	d''8. g'16 g'2 f'8 g'8 |
	as'8 bes'8 g'8. es'16 f'8 g'8 es'8. c'16 |
	d'2. r8 g8 |
	\repeat volta 2 {
	c'4. g'8 f'4. c'8 |
	es'8 f'8 d'8. bes16 c'4. g'8 |
	bes'4. a'8 bes'8 c''8 a'8. f'16 |
	g'2 r8 g'8 bes'8 d''8 |
	c''8. <g' g' g'>16 g'4 ~ g'8 c''8 g'8 c''8 |
	d''8. g'16 g'2 f'8 g'8 |
	as'8 bes'8 g'8. f'16 es'8 f'8 d'8 bes'8 |
	} \alternative {
	{
	c''2 r4 r8 g8 |
	}
	{
	c''2. c''4 |
	}
	}
	bes'16 c''16 bes'16 g'16 bes'4 ~ bes'4. g'8 |
	c''8 d''8 f''4 ~ f''8 es''8 d''8 c''8 |
	bes'16 c''16 bes'16 g'16 bes'4 ~ bes'4. g'8 |
	c''8 d''8 g''4 ~ g''8 f''8 d''8. c''16 |
	d''1 |
	\endBar
}
