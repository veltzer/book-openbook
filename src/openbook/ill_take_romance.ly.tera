{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f2. | d:m7 | g:m7 | c:7 | \myEndLine
		a:m7 | aes:7 | des:maj7 | g:m7 | \myEndLine
		c:7sus4 | d:7.9- | g:m7 | c:9 |

	} \alternative {
		{
			f2. | d:m7 | g:m7 | c:11 | \myEndLineVoltaNotLast
		}
		{
			f2. | g:m7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f2.*2 | ees2.:m7 | aes:7 | des:maj7 | \myEndLine
	bes:m7 | ees:m7 | aes:7sus4 | des2.*2:maj7 | \myEndLine
	ges2.*2:7 | ces2.*2:maj7 | \myEndLine
	f2. | d:7 | g:m7 | c:9 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f2. | d:m7 | g:m7 | c:7 | \myEndLine
	a:m7 | aes:7 | des:maj7 | g:m7 | \myEndLine
	c:7sus4 | d:7.9- | g:m7 | c:9 | \myEndLine
	f2. | d:m7 | g2.*2:m7 | \myEndLine
	e2.*2:7/c | f2.*2:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
