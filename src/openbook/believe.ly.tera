	r2 fis'4. cis'8 |
	es'4. bes8 ~ bes2 |
	r4 r8 cis'8 fis'8. gis'16 ~ gis'8 a'8 |
	gis'4. ( fis'8 ) fis'2 |
	e'4. b'8 ~ b'2 |
	dis'4. b'8 ~ b'2 |
	e'4 fis'8 gis'8 ~ gis'4 b8 dis'8 ~ |
	dis'2 r2 |
	r4 r8 cis'8 fis'4. cis'8 |
	es'4. bes8 ~ bes2 |
	r4 r8 cis'8 fis'8. gis'16 ~ gis'8 a'8 |
	gis'4. ( fis'8 ) fis'2 |
	gis'16 b'8 b'16 ~ b'8 b'16 b'16 ~ b'8 b'8 b'8 cis''8 |
	e'2. r8. cis'16 |
	a'8 a'16 a'16 ~ a'8 a'16 a'16 ~ a'8 gis'8 fis'8 e'16 ( fis'16 ) |
	fis'2. r8. gis'16 |
	\time 4/4 b'8 b'8 b'8 gis'16 b'16 ~ b'8 b'8 b'16 gis'8. |
	b'8 b'16 b'16 ~ b'16 dis''8 e''16 ~ e''8 dis''8 b'16 a'8. |
	gis'8 gis'8 gis'8 fis'16 gis'16 ( fis'4 ) \times 2/3 { r8 e'8 fis'8 } |
	gis'8. a'16 gis'8 a'16 gis'16 ~ gis'4 r8. gis'16 |
	b'8 b'8 b'8 gis'16 b'16 ~ b'8 b'8 b'16 ( gis'8 ) gis'16 |
	b'8 b'8 b'8 dis''16 e''16 ~ e''4. dis''8 |
	e''2. r4 |
	cis''8 dis''16 e''16 ~ e''8 fis''8 cis''8. dis''16 ~ dis''8 e''8 ~ |
	e''2 gis''8 fis''8 e''4 ~ ^ "To Coda" |
	e''8 dis''8 e''2. |
	R1 ^ "D.S. al Coda" |
	}
	\textMark \markup { \musicglyph "scripts.coda" } \textMark \markup { \musicglyph "scripts.coda" } e''8 dis''8 e''2. |
