	r2 gis''8 fis''8 e''4 ~ |
	e''8 dis''8 e''2. |
	r2 cis'8 b8 cis'4 ~ |
	cis'8 b8 b2. |
	r2 r8 cis''4 b'8 |
	b'1 |
	r2 r4 fis'4 ~ |
	fis'8 e'8 e'2. |
	r2 r2 |
	\repeat volta 2 {
	a''4 b'8 b8 b'4 b'4 |
	b'4 b'4 e''8 dis''8 cis''8 dis''8 |
	b'4 b'8 b8 b'4 b'4 |
	e''4 ^ "Repeat ad lib. and fade." b'8 b8 b'4 b'4 |
	}
	\endBar
}
