	\repeat volta 2 {
		ees1:m | ees:m | e:maj7 | \myEndLine
		e1*5/4:maj7 | ees1:m | \myEndLine
		ees:m | ees:m | ees:m | \myEndLine
		s1 | s1 | s1 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
