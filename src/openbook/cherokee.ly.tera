		d1 | f2 g | bes1 | g1 | f1 | d2 f | d1 | c1 | bes1 | d2 f | d'1 | bes1 | g1 |
	} \alternative {
		{
			f2 d | c1 | cis1 |
		}
		{
			d1 | bes1~ | bes1 |
		}
	}

	% part "B"
	dis'1~ | dis2 cis | cis4 ais fis2~ | fis2 cis' |
	cis4 a fis2~ | fis2 b | e,1~ | e1 |
	b'1~ | b2 a | a4 fis d2~ | d2 a' |
	a4 f d2~ | d2 g | c,1 | cis1 |

	% part "A"
	d1 | f2 g | bes1 | g1 | f1 | d2 f | d1 | c1 | bes1 | d2 f | d'1 | bes1 |
	g1 | d1 | bes1~ | bes1 |
}
