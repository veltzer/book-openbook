{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1:6 | f:7.5+ | f:m7 | bes:9 | \myEndLine
		ees1*2:maj7 | ees1:m | aes:7 | \myEndLine
		bes1:6 | g:m7 | c1*2:9 | \myEndLine
		c1:m7 |
	} \alternative {
		{
			g1:7.9- | c:m7 | f:7.5+ | \myEndLineVoltaNotLast
		}
		{
			f1:7 | bes1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	cis1:m7 | fis:7 | b:maj9 | b:7 | \myEndLine
	b1:m7 | e:7 | a | a2:maj7 a:6 | \myEndLine
	a1:m7 | d:7 | g1*2:maj7 | \myEndLine
	g1:m7 | c:9 | c:m7 | f:7.5+ | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	bes1:6 | f:7.5+ | f:m7 | bes:9 | \myEndLine
	ees1*2:maj7 | ees1:m | aes:7 | \myEndLine
	bes1:6 | g:m7 | c1*2:9 | \myEndLine
	c1:m7 | f:7 | bes | bes:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
