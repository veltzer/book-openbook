{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	\repeat volta 2 {
		d2:m7 g4.:7.9+ d8:m7 | g2:7.9+ d4:m7 g:7.9+ | c1*2:maj7.5- | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:maj7.5- | ees2:maj7.5- des:maj7.5- | c1*2:maj7.5- | \myEndLine
		ees1:maj7.5- | des:maj7.5- | c1*2:maj7.5- | \myEndLine
		d1*2:7 | des1*2:7 | \myEndLine
		c1*3:maj7.5- | c2:maj7.5- | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	f1:m7 | bes:7 | ees1*2:maj7 | \myEndLine
	ees1:m7 | aes:7 | des1*2:maj7 | \myEndLine
	d1:dim7 | g:7 | c | c4. b4:m7/a e:7/b bes8:7 | \myEndLine
	a2.:m7 d4:7 | d1:7 | g:7 | g:7.9+.5- | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	c1*2:maj7.5- | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 200
	\time 4/4
	\key c \major

	% part "Intro"
	\repeat volta 2 {
		r4 g' bes4. g8 | r8 bes4. g4 b!4 | fis4 r8 fis8 r4 fis4~ | fis4 \tuplet 3/2 { fis8 g a } \tuplet 3/2 { cis a g } fis4 |
	}

	% part "A"
	\repeat volta 2 {
		a4^\markup { \musicglyph #"scripts.segno" } r8 a8 r4 a4~ | a2 g4 a4 | fis4 r8 fis8 r4 fis4~ | fis8 a, b cis e fis a b |
		a4 r8 a8 r4 a4~ | a2 g4 a4 | fis4 r8 fis8 r4 fis4~ | fis8 a, b cis e fis a b |
		b4. b8~ b4 b4~ | b2 a4 b4 | bes4. bes8~ bes4 bes4~ | bes2 aes4 bes4 |
		fis4 \tuplet 3/2 { fis8 g a } \tuplet 3/2 { cis a g } fis4 | \tuplet 3/2 { fis8 g a } \tuplet 3/2 { cis a g } fis4 r8 c8^\markup { To Coda \musicglyph #"scripts.coda" } |
		\tuplet 3/2 { fis8 g a } \tuplet 3/2 { cis a g } fis4 r8 c8 |
		\time 2/4
		c4 r4 |
	}

	% part "B"
	\time 4/4
	aes'1 | \tuplet 3/2 { g8 aes g } e8 f r8 g8 r8 aes8 | bes1~ | bes1 |
	ges1 | \tuplet 3/2 { f8 ges f } d8 ees r8 f8 r8 g8 | \tuplet 3/2 { aes4 bes g } aes2~ | aes1 |
	d,8 e f g aes bes b! bes | aes8 g f e d c b d~ | d4 f8 c8 d2 | r4 r8 e8 r8 d8 r8 e8 |
	c2. c4~ | c4 r8 c'8 r8 d8 r8 c8 | \tuplet 3/2 { b8 c b } g2. | r4 bes2.^\markup { D.S. al Coda } |

	% part "Coda"
	\tuplet 3/2 { fis8^\markup { \musicglyph #"scripts.coda" } g a } \tuplet 3/2 { cis a g } fis4 r8 c8 | c4 r4 r2 |
}
{% endif %}
