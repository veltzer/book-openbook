{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c2.:maj7 | bes:9 | ees:maj7 | aes:7.9+ | des:maj7 | g:13 | c:maj7 | bes:9.5- | d:maj7 | a:m7 | \myEndLine
		fis:m7 | b:7.9- | e:m7 | aes:13 | des:maj7 | g:7.5+ | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	b2.:maj7 | aes:13 | des:maj7 | bes:13 | b:maj7 | g:13 | c:maj7 | aes:7 | \myEndLine
	des:maj7 | g:13 | c:maj7 | a:7.5-.9- | d:m7 | \myEndLine
	f4:6 g2:7 | d4:m7 e2:m7 | f2:maj7 g4:7 | f2:maj7 e4:m7 | d2:m7 c4:maj7 | b2.*2:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
