		b2 b,4 | c gis'2 | a2 a,4 | bes bes'4. aes8 | f2.~ | f2. |
	}

	% part "B"
	fis2 b,4 | bes f'2 | aes4. f8 ees des | c4 g'2 | ais2 cis,4 | c!4 a'!4. g8 | e2. | r2. |
	ees'2 aes,4 | e!4 b'2 | d2 g,4 | ees bes'2 | g2 e!4 |
	c4 d2 | g4 e2 | c2 d4 | g4. f8 e d~ | d4 c d | dis2.~ | dis2. |
}
{% endif %}
