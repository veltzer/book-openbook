{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	r1 | r2 g2/aes | g1/aes | g2./aes b4:sus4 | b1*2:sus4 | \myEndLine
	c1:maj7 | f:maj7 | e1*2:m7 | d4:maj7 b:maj7 aes:maj7 ges:13/e | c1*2:maj7 | \myEndLine
	r1 | r2 g2/aes | g1/aes | g2./aes b4:sus4 | \myEndLine
	\endPart

	\myMark "Instr"
	\startPart
	b2.:sus4 | c:maj7 | b:m7+ | c:maj7 | \myEndLine
	b:m7+ | c:maj7 | b:m7+ | c:maj7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	b2.:m7+ | c:maj7 | b:m7+ | c:maj7 | b4.:sus4 bes:sus4 | \myEndLine
	a:sus4 aes:sus4 | g:sus4 fis:sus4 | s2. | b2.:m7+ | c:maj7 | b:m7+ | c:maj7 | b4.:m aes | \myEndLine
	f4. d | c:5 b:sus4 | s2. | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	b4.:m7 a:maj7 | g:m7 f:maj7 | ees:m7 des:maj7 | \myEndLine
	fis:m7 aes:m7 | aes2.:7 | a:7 | aes:7 | a:7 | b:7 | \myEndLine
	aes:7 | f:7 | fis:7.5+.9+ | \myEndLine
	\endPart

	\myMark "Instr"
	\startPart
	b2.:m | c:maj7 | b:m | c:maj7 | b:m | c:maj7 | \myEndLine
	b:m | c:maj7/fis | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	b2.:m | c:maj7 | b:m | c:maj7 | b:m | \myEndLine
	c:maj7 | b:m | c2:maj7 b4:sus2 | \myEndLine
	\repeat volta 6 {
		b2.*3:sus2 |
	} \alternative {
		{
			s2. | \myEndLineVoltaNotLast
		}
		{
			s2. | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
