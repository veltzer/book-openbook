	\key d \major

	% part "Intro"
	b'4 g \grace { c!16 cis } d4. cis16 b | cis4 g b2~ | b1~ | b4. g16 e fis4 b,4 | b4 b2.~ | b2 b4. b'8 |
	g'4. fis16 e fis4. b,8 | e4. d16 c! d4 g,4~ | g1~ | g1 | cis'4 dis g, bes | g1~ | g1 |
	b,4 g \grace { c!16 cis } d4. cis16 b | cis4 g b2~ | b1~ | b4. g16 e fis4 b,4 |

	% part "Instr"
	\time 3/4
	b4^\markup { Jazz Waltz } b2 |
	\improvisationOn
	b'4^\markup { Fill } b b | b b b | b b b |
	b4 b b | b b b | b b b | b b
	\improvisationOff
	cis'8 d |

	% part "A"
	cis4.^\markup { \musicglyph #"scripts.segno" } b4.~ | b4 a e | e8 fis~ fis2~ | fis2 r8 e | d4 b8 aes4 d8 |
	b4 aes8 ges4 d8 | a'4. fis4.~ | fis2 cis''8 d | cis4. b4.~ | b4 a e | e8 fis~ fis2~ | fis2 r8 e | d4 b8 aes4 d8 |
	b4 gis8 e4 b8 | d4. b8~ b4~ | b2 b8 b |

	% part "B"
	d8 b d e~ \tuplet 3/2 { e cis e } | f!8 d f g~ \tuplet 3/2 { g e g } | aes8 f! aes bes~ \tuplet 3/2 { bes g bes } |
	b!8 gis b des~ \tuplet 3/2 { des bes des } | d2~ \tuplet 3/2 { d8 b! d } | b4 b2 | r8 d'8 r8 b4 g8 | \tuplet 3/2 { f16 g f } e8 f4 e | r8 d'8 r8 c!4. |
	b4. a | gis4. fis | \tuplet 3/2 { ais8 a! g } \tuplet 3/2 { a g fis } \tuplet 3/2 { g fis e^\markup { To Coda \musicglyph #"scripts.coda" } } |

	% part "Instr"
	fis8 b,8~ b2 |
	\improvisationOn
	b4^\markup { Fill } b b | b b b | b b b | b b b |
	b4 b b | b b b | b b
	\improvisationOff
	cis'8 d^\markup { D.S. al Coda } |

	% part "Coda"
	fis,8^\markup { \musicglyph #"scripts.coda" } b,8~ b2 |
	\improvisationOn
	b4^\markup { Fill } b b | b b b | b b b | b b b |
	b4 b b | b b b |
	\clef bass
	d,,4 d
	\improvisationOff
	\fixed c { <fis b cis'>4~ } |
	\repeat volta 6 {
		<<
			\fixed c { \voiceOne <fis b cis'>2.~ | <fis b cis'>2.~ | <fis b cis'>2.~ | }
			\new Voice \fixed c { \voiceTwo r8 fis,8 gis, b, cis4 | g,!8 f,! bes, c~ c e, | d,8 g, a,4 fis,8 b,, | }
		>>
	} \alternative {
		{
			<< \fixed c { \voiceOne <fis b cis'>2 <fis b cis'>4 } \new Voice \fixed c { \voiceTwo b,,4 b,,2 } >> \oneVoice |
		}
		{
			<< \fixed c { \voiceOne <fis b cis'>4 <fis b cis'>2\fermata } \new Voice \fixed c { \voiceTwo b,,4 b,,2 } >> \oneVoice |
		}
