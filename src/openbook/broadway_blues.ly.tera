{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		s1 | s1 | s1 | s1 | \myEndLine
		s1 | s1 | s1 | s1 | \myEndLine
		s1 | s1 | s1. | \myEndLine
		s1 | s1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		s1 | s1 | \myEndLine
		s1 | s1 | s1. | \myEndLine
		s1 | s1 | s1 | s1 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
