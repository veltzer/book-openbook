{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	d2.:m |
	f2.:aug/des |
	f2./c |
	d2:m/b g4:m/bes | \myEndLine
	d2.:m/a |
	e2.:7 |
	d2.:m |
	s4 aes4:dim g4:dim | \myEndLine
	f2. |
	a2.:m/e |
	f2.:7/ees |
	d2:m f4:aug/des | \myEndLine
	f2./c |
	des2.:m |
	d2.:m |
	e2.:sus4 | \myEndLine
	a2.:7 |
	s2. |
	f2.:dim |
	a2.:7/e | \myEndLine
	d2.:m |
	f2.:7 |
	g2.:m/bes |
	bes2 c4:9 | \myEndLine
	d2.:m/a |
	s2. |
	c2.:9/e |
	g2.:m/bes | \myEndLine
	d2.:m/a |
	a2.:7 |
	} \alternative {
	{
	d2:m c4 |
	a4:m g4:m a4:7 | \myEndLineVoltaNotLast
	}
	{
	s2. | \myEndLineVoltaLast
	}
	}
	s2. |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Swing" 4 = 144
	\time 3/4
	\key f \major

	\repeat volta 2 {
	d'2 ~ d'8 e'8 |
	f'2 ~ f'8 g'8 |
	a'2 ~ a'8 f'8 |
	a'2 ~ a'8 f'8 |
	f'2 ~ f'8 a'8 |
	e'2 ~ e'8 a'8 |
	d'2. ~ |
	d'2. |
	f'2 ~ f'8 g'8 |
	a'2 ~ a'8 bes'8 |
	c''2 ~ c''8 a'8 |
	c''2 ~ c''8 bes'8 |
	a'2 ~ a'8 c''8 |
	gis'2 ~ gis'8 c''8 |
	a'2. ~ |
	a'2. |
	a'2 ~ a'8 b'8 |
	cis''2 ~ cis''8 d''8 |
	f''2. |
	e''2. |
	d''2. |
	c''2 ~ c''8 a'8 |
	g'2. |
	f'2 g'4 |
	a'2 ~ a'8 gis'8 |
	a'2 ~ a'8 bes'8 |
	g'2 ~ g'8 fis'8 |
	g'2 a'8 g'8 |
	f'2 ~ f'8 a'8 |
	e'2 ~ e'8 a'8 |
	} \alternative {
	{
	d'4 d''4 c''4 |
	a'4 g'4 e'4 |
	}
	{
	d''2. ~ ^ "" ^ "Dm" |
	}
	}
	d''2. |
	\endBar
}
{% endif %}
