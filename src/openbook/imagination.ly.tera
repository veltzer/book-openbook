{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees2 e:m7.5- | f:m bes:7 | ees bes:m | c1:7.9- | \myEndLine
		f2:m c:7.5+.9- | f:m bes:7 |
	} \alternative {
		{
			g:m c:7.9- | f:m bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees1:7 | bes2:m ees:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	aes1 | a2:m d:7 | g1:m | c:7.9- | \myEndLine
	bes | c2:m f:7 | f1:m | bes:7.5+.9- | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	ees2 e:m7.5- | f:m bes:7 | ees bes:m | c1:7.9- | \myEndLine
	f2:m c:7.5+.9- | f:m bes:7 | g1:7.9+ | c:7.9- | \myEndLine
	f:m | f2:m/bes bes:7.9- | ees1 | f2:m bes:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Adagio" 4 = 60
	\time 4/4
	\key ees \major

	\partial 4. d8 ees f |

	% part "A"
	\repeat volta 2 {
		g4 g2 bes4 | aes aes2 c4 | bes bes \tuplet 3/2 { bes c des } | bes bes2. |
		aes4 aes \tuplet 3/2 { aes bes c } | aes aes c bes8 g~ |
	} \alternative {
		{
			g2 bes4 aes8 f~ | f2 r8 d ees f |
		}
		{
			g2 bes4 g8 f~ | f2. r4 |
		}
	}

	% part "B"
	r4 ees8 f g aes bes c | d4 d a4. bes8 | c4 c g4. a8 | bes4 r8 bes e,2 |
	r4 f8 g a bes c d | ees4 ees \tuplet 3/2 { a, bes c } | bes2. c4 | fis,2 r8 d ees f |

	% part "A"
	g4 g2 bes4 | aes aes2 c4 | bes bes \tuplet 3/2 { bes c des } | bes bes2. |
	aes4 aes \tuplet 3/2 { aes bes c } | aes aes \tuplet 3/2 { aes a bes } | g1~ | g4 bes aes g |
	f f \tuplet 3/2 { f g aes } | f f2 g4 | ees1~ | ees2 r |
}
{% endif %}
