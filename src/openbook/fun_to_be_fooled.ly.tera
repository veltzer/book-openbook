{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	g1:maj7 |
	s1 |
	d1:7 |
	s1 | \myEndLine
	g1:7 |
	s1 |
	c1:maj7 |
	c2:m6 f2:7 | \myEndLine
	g1:maj7 |
	s1 |
	d1:7 |
	d1:7.9+ | \myEndLine
	g1:maj7 |
	} \alternative {
	{
	a2:m7 d2:7 | \myEndLineVoltaNotLast
	}
	{
	d2:m7 g2:7 |
	c1:maj7 | \myEndLineVoltaLast
	}
	}
	c2:m6 f2:7 |
	g1:maj7 |
	s1 |
	a1:7 | \myEndLine
	s1 |
	a1:m7 |
	d1:7 |
	g1:maj7 | \myEndLine
	s1 |
	d1:7 |
	s1 |
	a1:7 | \myEndLine
	s2 d2:7 |
	g1:6 |
	s1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key g \major

	\repeat volta 2 {
	b'4. d'8 d'4 d'4 ~ |
	d'2. r4 |
	c''4. d'8 d'4 d'4 ~ |
	d'2. r4 |
	d''4. g'8 g'4 g'4 ~ |
	g'2 \times 2/3 { fis'4 g'4 e''4 } |
	d''1 |
	c''2. r4 |
	b'4. d'8 d'4 d'4 ~ |
	d'2. r4 |
	a'4. d'8 d'4 d'4 ~ |
	d'4 d'8 d'8 fis'4 e'4 |
	d'1 ~ |
	} \alternative {
	{
	d'2. r4 |
	}
	{
	d'4 r4 g'4 g'4 |
	d''2 g'4 g'4 |
	}
	}
	d''2 g'8 g'8 g'8 e''8 ~ |
	e''2 e'4 e'4 ~ |
	e'4 r8 g'8 g'8 g'8 g'8 e''8 ~ |
	e''2 e'4 e'4 |
	\times 2/3 { e'4 g'4 g'4 } \times 2/3 { g'4 g'4 g'4 } |
	e''2 e'4 e'4 ~ |
	e'2. r4 |
	d''4. d'8 d'4 d'4 ~ |
	d'2. r4 |
	c''4. d'8 d'4 d'4 ~ |
	d'2. r4 |
	e''4. e'8 e'4 e'4 ~ |
	e'2 a'2 |
	g'1 ~ |
	g'2. r4 |
	\endBar
}
{% endif %}
