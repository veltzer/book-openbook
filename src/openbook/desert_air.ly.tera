{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ges2.:maj7/f | aes:m7+/f | aes:m7+/f | ges:maj7/f | \myEndLine
		f:m | f:m | c:maj7 | des:maj7 | \myEndLine
		e:7.9+ | e:7.9+ | f:m7 | f:m7 | f:m7 | \myEndLine
		f:m7 | g:maj7 | c:m7+ | c:m7+ | \myEndLine
		g:maj7 | aes:maj7 | aes:maj7 | e:maj7 | \myEndLine
		a:m/e | a:m/e | e:maj7 | a:m/e | a:m/e | \myEndLine
		b:maj7 | c:maj7.11+/b | c:maj7.11+/b | c:maj7.11+/b | \myEndLine
	} \alternative {
		{
			bes:m7.5- | bes:m7.5- | bes:m7.5- | c:7.9- | \myEndLineVoltaNotLast
		}
		{
			bes:m7.5- | ees:7.9- | aes:m7.5- | des:7.9- | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	fis2.:m7.5- | a:m7 | c:m7+ | ees:dim | \myEndLine
	e:m | g:m | bes:m6 | des:m7.5- | \myEndLine
	d:m | b:m7.5- | bes:maj7.11+ | bes:m7 | \myEndLine
	f:m | f:m | f:m | f:m | \myEndLine
	f:m | f:m | f:m | f:m | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
