{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	f2:6 g:m7 | f:dim g4:m7 c:7 | f2:6 g:m7 | g:m9 c:7 | \myEndLine
	\endPart

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f2:maj7 ees:maj7 | f:maj7 ees:maj7 | f:maj7 ees:maj7 | f:maj7 f:6 | \myEndLine
		bes b:dim | g:m7 bes4:m6 f:6 | s1 | c:7.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f2:maj7 ees:maj7 | f:maj7 ees:maj7 | f:maj7 ees:maj7 | f:maj7 f:6 | \myEndLine
		bes b:dim | g:m7 bes4:m6 f:6 | s1 | e:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		a2:m e4:7 a:m | g2:m6 a4:aug a:7 | a1:m7 | d:7 | \myEndLine
		g2:9 g:9.5+ | g1:7 | c2.:7 g4:m7 | s2. c4:7.5+ | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		f2:maj7 ees:maj7 | f:maj7 ees:maj7 | f:maj7 ees:maj7 | f:maj7 f:6 | \myEndLine
		bes b:dim | g:m7 bes4:m6 f:6 |
	} \alternative {
		{
			s2 d:m7 | g4:m7 c2.:7.5+ | \myEndLineVoltaNotLast
		}
		{
			s1 | g4:m7 c:7.5+.9- f2:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
