{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1:m | g2:7 c:7 | f1:m | g2:7 c:7 | \myEndLine
		aes2 f:m7 | bes:7 ees:7 |
	} \alternative {
		{
			aes1 | c:7 | \myEndLineVoltaNotLast
		}
		{
			aes1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f1*2:7.9- | bes1*2:m7+.9 | \myEndLine
	ees1*2:7 | aes1 | c:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f1:m | g2:7 c:7 | f1:m | g2:7 c:7 | \myEndLine
	aes2 f:m | bes:7 ees:7 | aes1*2 | \myEndLine
	\endPart

	\myMark "Coda"
	\startPart
	aes2:maj7/c b:6 | bes:7 a:7 | aes1*2:maj7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 200
	\time 4/4
	\key aes \major

	% part "A"
	\repeat volta 2 {
		c8 d! f aes c aes f c | d!4. e!8~ e4 r | c8 d! f aes c aes f c | d!4. e!8~ e4 r |
		ees8 f aes c ees c aes ees | f4. g8~ g4 ees8 f |
	} \alternative {
		{
			aes8 bes aes aes~ aes4 r | r8 aes g g~ g4 r |
		}
		{
			aes8 bes aes aes~ aes2~ | aes2. r4 |
		}
	}

	% part "B"
	\improvisationOn
	b4 b b b | b b b b | b b b b | b b b b |
	b4 b b b | b b b b | b b b b | b b b b |
	\improvisationOff

	% part "A"
	c,8 d! f aes c aes f c | d!4. e!8~ e4 r | c8 d! f aes c aes f c | d!4. e!8~ e4 r |
	ees8 f aes c ees c aes ees | f4. g8~ g4 ees8 f^\markup { To Coda \musicglyph #"scripts.coda" } | aes8 bes aes aes~ aes2~ | aes2. r4^\markup { D.C. al Coda } |

	% part "Coda"
	aes8^\markup { \musicglyph #"scripts.coda" } bes aes aes~ aes bes aes aes~ | aes bes aes g~ g aes g g~ | g1~ | g2. r4 |
}
{% endif %}
