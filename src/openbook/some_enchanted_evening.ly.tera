{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1 | c | g:7 | g:7 | \myEndLine
		c1 | g2:m7 c:7.5+ | f1:maj7 | a:7.9- | \myEndLine
		d2:m7 d:m/c | b:m7.5- e:7 | a:m c:7/g | f:maj7 f/e | \myEndLine
		d1:m7 | g:7 |
	} \alternative {
		{
			c2 a:m7 | d:m9 g:7 | \myEndLineVoltaNotLast
		}
		{
			c1*2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	g2:7/d c | g:7 c:6 | g:7/d c | a:m7 d:7 | \myEndLine
	g2 a:m7.5- | bes:dim7 g:7/b | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1 | c | g:7 | g:7 | \myEndLine
	c1 | g2:m7 c:7.5+ | f1:maj7 | a:7.9- | \myEndLine
	d2:m7 d:m/c | b:m7.5- e:7 | a:m c:7/g | f:maj7 f/e | \myEndLine
	d1:m7 | d2.:m7/g g4:7 | c1*2 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	g2:7/d c | g:7 c:6 | g:7/d c | d1:m7 | d2:m7 d:m7/g | c1:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
