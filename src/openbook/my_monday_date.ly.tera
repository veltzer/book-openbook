		\endPart

		\myMark "A"
		\startPart
		bes1:6 | d2.:m7 bes4:dim7 | c1*2:m7 | \myEndLine
		f1*2:7 | bes2 c4:m7 f:7 | bes2:6 bes:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees1 | s2 ees:m | bes1*2 | \myEndLine
		c1*2:9 | f1*2:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
