{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		c1 | c2 cis:dim7 | g1*2:7 | \myEndLine
		c1 | c2 cis:dim7 | g1*2:9 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2 g/b | f/a g | f e:m7 | d:m cis4.:dim7 g8:7/d | \myEndLine
		g1:7 | g2:7 g4.:7.9- c8:6 | c2..:6 c8:7 |
	} \alternative {
		{
			c8:7 bes4:7.9- aes:7.9- g4.:13 | \myEndLineVoltaNotLast
		}
		{
			c8:7 bes4:7.9- aes:7.9- g4.:13 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 160
	\time 4/4
	\key c \major

	\repeat volta 2 {

		% part "A"
		fis'8 g-> r4 r f8 g-> | r2 fis8 g f g-> |
		\improvisationOn b,4^\markup { ad lib G7 solo } b b b | b b b b \improvisationOff |
		fis'8 g-> r4 r f8 g-> | r2 fis8 g f g-> |
		\improvisationOn b,4^\markup { ad lib G13 solo } b b b | b b b b \improvisationOff |

		% part "B"
		r4 e,8. e'16 r4 d,8. d'16 | r4 c,8. c'16 r4 b,8. b'16 |
		r4 a,8. a'16 r4 g,8. g'16 | r4 \tuplet 3/2 { a,8 d f } a4. g8-> |
		\improvisationOn b4^\markup { ad lib G7 solo } b b b | b b \improvisationOff e4.-> c8-^ |
		r8 b, bes a aes-> g4 c'8-^~ |
	} \alternative {
		{
			c8 d4-^ ees8-^~ ees e4-^ r8 |
		}
		{
			c8 d4-^ ees8-^~ ees e4-^ r8 |
		}
	}
}
