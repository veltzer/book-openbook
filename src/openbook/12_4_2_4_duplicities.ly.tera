{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	a2.:m7 | a:m7 | bes:maj7.11+ | c/bes | \myEndLine
	aes:maj7 | g:7.5+.9+ | ces:maj7/ges | a:maj7/e | \myEndLine
	e:m7 | a4.:m7 bes:m7 | d2.:m7 | des:maj7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	e2.:maj7/b | b:7sus4 | e:maj7/b | b:7sus4 | \myEndLine
	a:m7 | aes:maj7 | bes | bes:7sus4 | bes | bes:7sus4 | \myEndLine
	ees:maj7 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	\repeat volta 2 {
		ees2.:maj7/bes | ges:maj7/bes | a:m7 | bes4. c/bes | aes2.:maj7.11+ | \myEndLine
		g:7.5+.9+ | ces:maj7/ges | a:maj7/e | e:m7 | a:m | \myEndLine
		d:m | des:maj7.11+ | e:maj7/b | b:7sus4 | e:maj7/b | b:7sus4 | \myEndLine
		a:m7 | aes:maj7.11+ | c:maj7/g | g:7sus4 | c:maj7/g | g:7sus4 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Andante" 4. = 60
	\time 6/8
	\key c \major

	% part "A"
	r8.^\markup { Open feel } fis'8. b,4.~ | b4~ b16 fis'16 b,8. g'8. | c,8. d8. g,4.~ | g2. |
	r8. aes'8. ees4. | e8. f8. bes,4~ bes16 ees16 | aes,4~ aes16 des16 aes8. ges8. | ees2. |
	r4 r8 r8 e'8 fis8 | g8 b d, ees f bes, | c4. f,4~ \tuplet 3/2 { f16 fis g } | aes4.~ aes8 \tuplet 3/2 { des,16 ees f } \tuplet 3/2 { ges aes bes } |

	% part "B"
	b4.~^\markup { Latin } b8. e,8. | fis4. r8 e'8 fis8 | b,4.~ b8. e,8. | fis4. r8 b8 cis8 |
	d4~ d16 b16 g8. a8. | bes4. ees,4. | f2. | r2. | r2. | r4. ees'8 f8 g8 |
	bes,2.\fermata^\markup { Ending only, Fine } |

	% part "C"
	\repeat volta 2 {
		bes2.^\markup { Solos } |
		\improvisationOn
		b4. b | b4. b | b4. b | b4. b |
		b4. b | b4. b | b4. b | b4. b | b4. b |
		b4. b | b4. b | b4.^\markup { Latin } b | b4. b | b4. b | b4. b |
		\improvisationOff
		b2. | b2. |
		\improvisationOn
		b4. b | b4. b | b4. b | b4. b^\markup { D.C. al Fine } |
		\improvisationOff
	}
}
{% endif %}
