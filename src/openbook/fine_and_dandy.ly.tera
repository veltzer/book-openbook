{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	f1 |
	aes1:dim7 |
	g2.:m7 c4:7 |
	s1 | \myEndLine
	f1 |
	aes1:dim7 |
	g2.:m7 c4:7 |
	s1 | \myEndLine
	f1:7 |
	s1 |
	bes1:7 |
	s1 | \myEndLine
	ees1:7 |
	s1 |
	aes1:7 |
	c1:7 | \myEndLine
	f1 |
	aes1:dim7 |
	g2.:m7 c4:7 |
	s1 | \myEndLine
	f1 |
	aes1:dim7 |
	g2.:m7 c4:7 |
	s1 | \myEndLine
	c2.:m7 f4:7 |
	s1 |
	bes2. bes4:m |
	s1 | \myEndLine
	f2 d2:m |
	g4:7 c2.:7 |
	} \alternative {
	{
	f2 ees2 |
	aes2 c2:7 | \myEndLineVoltaNotLast
	}
	{
	f2 bes2:7 |
	f1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
