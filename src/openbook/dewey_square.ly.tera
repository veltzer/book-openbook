		ees1 | aes:m | ees2:7 des:7 | c1:7 | \myEndLine
		f1:7 | f2:m7 bes:7 |
	} \alternative {
		{
			ees2 c:7 | f:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees1 | ees2:7 ees:7.5+ | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	aes1:maj7 | aes2:m7 des:7 | ees1 | ees2 c:7 | \myEndLine
	f1*2:7 | f1:m7 | bes:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	ees1 | aes:m | ees2:7 des:7 | c1:7 | \myEndLine
	f1:7 | f2:m7 bes:7 | ees1 | ees:maj7 | \myEndLine
	\endPart


	\endSong
	\endChords
}
