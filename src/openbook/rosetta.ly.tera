{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		f1:9 | e:9.5+ | ees:9.11+ | d:9 | \myEndLine
		g:9 |
	} \alternative {
		{
			c2:7 c:7.5+ | f1:6 | g2:9 c:7 | \myEndLineVoltaNotLast
		}
		{
			c2:7 c:7.5+ | f1 | e:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	a1:m | e:7 | a:m | a:m/gis | \myEndLine
	c/g | g:7 | g:m7 | c:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f:9 | e:9.5+ | ees:9.11+ | d:9 | \myEndLine
	g:9 | c2:7 c:7.5+ | f1*2 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 2 = 100
	\time 2/2
	\key f \major

	\partial 4 a'4 |

	\repeat volta 2 {
		% part "A"
		c4 c2.~ | c2 e4 d | a4 a2.~ | a2 e'4 d |
		a4 a2 d,4 |
	} \alternative {
		{
			a'4 a2 e4 | d1~ | d2 r4 a'4 |
		}
		{
			a4 a2 d,4 | f1 | r1 |
		}
	}

	% part "B"
	a2 a4 a | b!2 b4 b | c1~ | c2 r |
	e2 e4 e | d2 g,4 g | c1~ | c4 r r a |

	% part "A"
	c4 c2.~ | c2 e4 d | a4 a2.~ | a2 e'4 d |
	a4 a2 d,4 | a'4 a2 d,4 | f1~ | f2 r |
}
{% endif %}
