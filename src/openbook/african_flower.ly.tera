{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees1:m7 | ees:m7 | ees:m7 | \myEndLine
		ees:m7 | aes:m7 | ges:m7 | ees:m7 | ees:m7 | \myEndLine
		bes:m7 | bes:m7 | ees:m7 | ees:m7 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	ges1:maj7 | ges2.:maj7 ges4:7 | ces1:7 | ces:7 | ges:maj7 | ges:maj7 | \myEndLine
	ges:7.11+ | ges:7.11+ | aes:7 | aes:7 | ges:m7 | \myEndLine
	ees:m7 | d:7 | bes:7 | ees:m7 | ees:m7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key des \major

	% part "A"
	\repeat volta 2 {
		aes'8 bes aes bes aes2~ | aes1 | ges8 aes ges aes ges2~ |
		ges1 | fes8 ges fes ges fes2~ | fes1 | ees8 f! ees f ees2~ | ees1 |
		fes8^\markup { 2. \musicglyph #"scripts.coda" } ges fes ges fes2~ | fes4 fes \tuplet 3/2 { ges des' ces } | ges8 aes aes bes ees,2~ | ees1^\markup { \italic { Fine } } |
	}

	% part "B"
	<bes' des'>1~ | <bes des'>2. des4 | ees1~ | ees | <bes des'>1~ | <bes des'>2. des4 |
	<e e'>1~ | <e e'>2. r4 | r4 des8 aes'~ aes ces,4.~ | ces4. bes8 aes ges'4. | r4 ces,8 aes'~ aes2 |
	r4 des,8 bes'~ bes4 c,8 c'~ | c2~ \tuplet 3/2 { c4 b bes } | bes2~ \tuplet 3/2 { bes4 aes ges } | ees1~ | ees |
}
{% endif %}
