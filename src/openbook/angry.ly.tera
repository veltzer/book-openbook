	ees1 |
	ees1:m | \myEndLine
	bes1 |
	s2. g4:7 |
	c1:7 |
	s2 c2:dim | \myEndLine
	f1:7 |
	fis2:7 f2:7 |
	} \alternative {
	{
	bes2 g2:m7 |
	c2:m7 f2:7 | \myEndLineVoltaNotLast
	}
