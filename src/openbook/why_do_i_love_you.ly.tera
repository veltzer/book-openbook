{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		aes1 | b:dim7 | ees:7/bes | ees:7 | \myEndLine
		aes1 | f:7 | bes:m7 | ees:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		aes1:maj9 | aes2/c b:dim7 | bes1:m7 | ees:7 | \myEndLine
		aes1:6 | f:m7 | bes:m7 | ees:7.9- | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		aes1 | b:dim7 | ees:7/bes | ees:7 | \myEndLine
		aes1 | f:7 | bes:m7 | ees:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		aes1:maj7 | aes:7 | des:maj7 | ges:9 | \myEndLine
		aes1 | bes2:m7 ees:7 |
	} \alternative {
		{
			aes1*2 | \myEndLineVoltaNotLast
		}
		{
			aes2 des | aes1 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Andante" 4 = 100
	\time 2/2
	\key aes \major

	\repeat volta 2 {
		% part "A"
		aes'4 ees d! ees | aes1 | aes4 ees d! ees | g1 |
		c4 ees, d! ees | c'1 | c4 ees des bes~ | bes1 |

		% part "B"
		bes4 c bes2~ | bes4 aes f aes | ees'1 | g,1 |
		f4 aes f2~ | f4 ees f aes | c1 | bes1 |

		% part "A"
		aes4 ees d! ees | aes1 | aes4 ees d! ees | g1 |
		c4 ees, d! ees | c'1 | c4 ees des bes~ | bes1 |

		% part "C"
		bes4 c bes2~ | bes4 aes bes c | f1 | des |
		c4 ees, d! ees | ees'2 c |
	} \alternative {
		{
			aes1~ | aes4 r r2 |
		}
		{
			aes1~ | aes4 r r2 |
		}
	}
}
{% endif %}
