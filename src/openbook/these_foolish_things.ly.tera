{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees2:6 c:m7 | f:m9 bes:7 | ees:6 c:m7 | f:9 bes:7 | \myEndLine
		ees:9 ees:7.5+ | aes:6 c:7 | f1:7 | f2:m7 bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees:6 c:m7 | f:m9 bes:7 | ees c:m7 | f:9 bes:7 | \myEndLine
		ees:9 ees:7.5+ | aes c:7 | f:9 bes:7 | ees d:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		g1:m7 | c2:m6 d:9 | g1:m7 | c:9 | \myEndLine
		bes2/f g:m7 | c:m7 f:7 | bes:7 e:dim7 | f:m7 bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees:6 c:m7 | f:m9 bes:7 | ees:6 c:m7 | f:9 bes:7 | \myEndLine
		ees:9 ees:7.5+ | aes:maj7 c:7 | f:9 bes:7 |
	} \alternative {
		{
			ees4 e:dim7 f:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees4 aes:7 ees2:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
