{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	r1 | d:9sus4 | r1 | d:9sus4 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	g1:maj7 | c:maj7 | g:maj7 | c4:maj7 bes:maj7 g2:maj7 | \myEndLine
	g1:maj7 | c:maj7 | g:maj7 | c4:maj7 bes:maj7 g2:maj7 | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	d1*2:9sus4 | g1:maj7 | c:maj7 | \myEndLine
	g1:maj7 | c4:maj7 bes:maj7 g2:maj7 | g1:m9 | c:7 | f:maj7 | \myEndLine
	d1:m9 | f:m9 | bes:7sus4 | d:9sus4 | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	s1 | g:maj7 | c:maj7 | g:maj7 | c4:maj7 bes:maj7 g2:maj7 | \myEndLine
	\endPart

	\myMark "Instr"
	\startPart
	\repeat volta 2 {
		g1*4:7 | \myEndLine
	}
	\repeat volta 2 {
		g1:maj7 | c:maj7 | \myEndLine
	}
	\endPart

	\myMark "Coda"
	\startPart
	d1:9sus4 | ees1*2:9sus4 | \myEndLine
	\repeat volta 2 {
		aes1:maj7 | ees:9sus4 |
	}
	\repeat volta 2 {
		aes1:maj7 | ees:9sus4 | \myEndLine
	}
	\repeat volta 2 {
		aes1:maj7 | ees:9sus4 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
