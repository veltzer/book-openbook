	fis8. d16~ d2 r4 | e8 e16 e e16 e8 e16 r16 e e e g8 g | fis8. d16~ d2 r4 | e8 e16 c r16 e d8~ d2 |

	% part "B"
	a16^\markup { \musicglyph #"scripts.segno" } c c a c8 c16 a c16 a c a c8 d | a16 c c a c8 c16 a c16 a c a c16 d e g | fis8. d16~ d2 r4 | e16 e8 e16 e8 e16 e r16 e e e g8 g |
	fis8. d16~ d2 r4 | e8 e16 c r16 e d8~ d2 | a'2 d4 c | a2 g4 f! | e2 f!4 g |
	e2 d4 c | g'2 aes4 bes | c2 d4 ees | d1^\markup { To Coda \musicglyph #"scripts.coda" } |

	% part "C"
	r2 r4 g,8 g | fis8. d16~ d2 r4 | e16 e8 e16 e8 e16 e r16 e e e g8 g | fis8. d16~ d2 r8 d16 d | e8 e16 c r16 e d8~ d2 |

	% part "Instr"
	\repeat volta 2 {
