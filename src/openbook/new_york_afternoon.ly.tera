	}
	\repeat volta 2 {
		r1 | r2 r16^\markup { (Last x only) } ees16 f g aes bes c des |
	}
	\repeat volta 2 {
		ees16 ees ees ees ees c8 des16 r16 f ees8~ ees4 | r2 r16^\markup { Vamp and fade } ees,16 f g aes bes c des |
	}
}
