{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	d1:m |
	s1 |
	a2:m f2 |
	a1:7 | \myEndLine
	\repeat volta 2 {
	d1:m |
	s1 |
	ees1 |
	s1 | \myEndLine
	d1:m |
	f1 |
	ees1 |
	s1 | \myEndLine
	d1 |
	s1 |
	ees1 |
	s1 | \myEndLine
	} \alternative {
	{
	d1 |
	d1:m |
	s1 |
	a2:m f2 | \myEndLine
	a1:7 | \myEndLineVoltaNotLast
	}
	{
	d1 | \myEndLineVoltaLast
	}
	}
	d1:m |
	s1 | \myEndLine
	a2:m f2 |
	a2:7 a2 |
	\endBar
	\endPart

	\endSong
	\endChords
}
