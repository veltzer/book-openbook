{% endif %}
{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1.*4:m9 | \myEndLine
		aes1.*2:maj7 | c1.*2:m9 | \myEndLine
		f2.:7.5- f:13 | e:9.5- a:9 | c1.*2:m9 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 144
	\time 6/4
	\key c \minor

	% part "A"
	\repeat volta 2 {
		bes'4 bes bes bes8 c~ c4. a8 | \tuplet 5/3 { bes4 a g f d~ } d2 c4 | r2 r8 d~ d2 c4 | r2 r8 d~ d2 c4 |
		bes'4 bes bes bes8 c~ c4. d8 | \tuplet 5/3 { ees4 d c bes g~ } g2 f4 | \tuplet 5/3 { bes4 a g f d~ } d2 c4 | r2 r8 d~ d2 c4 |
		b'4 b b b8 d~ d4 g,8 bes~ | bes2. g | f1.~ | f1. |
	}
}
{% endif %}
{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	c1.*4:m7 | \myEndLine
	f1.*2:m7 | c1.*2:m7 | \myEndLine
	fis1:m7.5- b2:7.9+ | e2.:7.9+ a:7.5+.9+ | c1.*2:m7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 144
	\time 6/4
	\key c \minor

	% part "A"
	bes'4-- bes-- bes-- bes8\( c~ c4. a8 | \tuplet 5/6 { bes a g f d~ } d2 c4\)-. |
	r2 r8 d~ d2 c4-. | r2 r8 d~ d2 c4-. |
	bes'-- bes-- bes-- bes8\( c~ c4. d8 | \tuplet 5/6 { ees d c bes g~ } g2 f4\)-. |
	\tuplet 5/6 { bes8\( a g f d~ } d2 c4\)-. | r2 r8 d~ d2 c4-. |
	b'\( b b b8 d~ d4 g,8 bes~ | bes2~ \tuplet 3/2 { bes8 a aes } g2~ g16 c g ges |
	f1.~ | f\) |
}
{% endif %}
