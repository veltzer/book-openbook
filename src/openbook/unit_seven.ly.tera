		bes1 ~ | bes2 r8 g8 a bes ~ | bes1 ~ | bes2 r8 c d ees ~ |
		ees1 ~ | ees2 r8 bes a g ~ | g2 ~ g8 g g( a) | r2 r8 c, ees c |
	} \alternative {
		{
			g' c, ees c' ~ c2 ~ | c2 bes8 g f g ~ | g1 ~ | g2 r8 g a bes\laissezVibrer |
		}
		{
			g c, ees c' ~ c2 ~ | c2 bes8 g b c | r1 | r8 e, r f e d cis a |
		}
	}

	% part "B"
	e'8 cis d e f g a c! | b4-. r8 d8 ~ d4 a8 g ~ | g1 | r8 fis g bes ~ bes4 a8 f ~ |
	f1 | r8 e f aes ~ aes4 g8 e ~ | e1 | bes''8( a) r4 r8 g, a bes ~ |

	% part "A"
	bes1 ~ | bes2 r8 g8 a bes ~ | bes1 ~ | bes2 r8 c d ees ~ |
	ees1 ~ | ees2 r8 bes a g ~ | g2 ~ g8 g g( a) | r2 r8 c, ees c |
	g' c, ees c' ~ c2 ~ | c2 bes8 g b c | r1^"Solo break" | r1 |

	% part "End"
	\repeat volta 2 {
		g8 c, ees c' ~ c2 ~ | c2 bes8 g b c | r1 | r2 r8 c, f c |
	}
	g' c, ees c' ~ c2 ~ | c2 bes8 g b c | r1^"Break" | r2 <d, fis a c>2:32 |
}
