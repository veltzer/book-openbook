{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1*2:7 | c1*2:7 | \myEndLine
		f1*2:7 | c1:7 | a:7.5+ | \myEndLine
	} \alternative {
		{
			aes1:maj7 | des:maj7 | c:maj7 | g:7 | \myEndLineVoltaNotLast
		}
		{
			aes1:maj7 | des:maj7 | c:maj7 | a:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	a1:m7 | g:7 | c:maj7 | a:7.9- | \myEndLine
	d1:m7 | g:7.9- | a2:7 a:7.5+ | d1:m7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	c1*2:7 | c1*2:7 | \myEndLine
	f1*2:7 | c1:7 | a:7.5+ | \myEndLine
	aes1:maj7 | des2.:maj7 s8 c8:6 | s1 | s1 | \myEndLine
	\endPart

	\myMark "End"
	\startPart
	\repeat volta 2 {
		aes1:maj7 | des:maj7 | c:maj7 | a:7 |
	}
	aes1:maj7 | des2.:maj7 s8 c8:6 | s1 | s2 c:7.9+ | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
