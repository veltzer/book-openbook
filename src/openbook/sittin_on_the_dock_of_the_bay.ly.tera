	b'4 r4 b'8 b'8 b'8 e''8 ( ~ |
	e''8 d''8 b'16 a'16 g'8 ) a'4 g'8 b'8 ~ |
	b'4 r8 e''8 ( ~ e''8 b'8 ) b'4 |
	e'8 g'8 g'8 e'8 g'8 g'8 g'8 a'8 ~ |
	a'4 r4 a'8 g'8 e'8 g'8 ( ~ ^ "To Coda" |
	} \alternative {
