	r4 r8 e''8 ~ e''8 d''8 d''4 |
	b'8 g'8 b'8 a'8 a'8 ( g'4. ) |
	r2 g''8 e''8 e''8 d''8 |
	\once \omit TupletBracket \times 2/3 { g''8 e''8 d''8 } \once \omit TupletBracket \times 2/3 { e''8 d''8 b'8 } a'8 ( g'4. ) |
	r4 f''8 f''8 f''8 f''8 d''8 f''8 ~ |
