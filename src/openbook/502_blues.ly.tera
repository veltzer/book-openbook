{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 3/4
	\key c \major

	\partial 8 e''8 |
	\repeat volta 2 {
	a''2 ~ \once \omit TupletBracket \times 2/3 { a''8 b''8 a''8 } |
	c'''2 ~ \once \omit TupletBracket \times 2/3 { c'''8 b''8 a''8 } |
	g''8 e''4. ~ e''4 ~ |
	e''4 r4 r8 e''8 |
	a''2 ~ \once \omit TupletBracket \times 2/3 { a''8 b''8 a''8 } |
	c'''2 ~ \once \omit TupletBracket \times 2/3 { c'''8 b''8 a''8 } |
	g''8 e''4. ~ e''4 ~ |
	e''4 r4 r8 g''8 |
	c'''2 ~ \once \omit TupletBracket \times 2/3 { c'''8 d'''8 c'''8 } |
	es'''2 ~ \once \omit TupletBracket \times 2/3 { es'''8 d'''8 f''8 } |
	bes''4 c'''8 bes''8 a''8 bes''8 |
	des'''4 es''8 bes''8 ~ bes''4 |
	} \alternative {
	{
	b''8 a''8 gis''8 a''8 c'''4 ~ |
	\times 3/4 { c'''4 dis''4 gis''4 c'''4 } |
	dis'''2. ~ |
	dis'''4 r4 \times 2/3 { r8 d'''8 c'''8 } |
	}
	{
	b''8 a''8 gis''8 a''8 c'''8 dis'''8 |
	\times 3/4 { gis'''4 c'''4 dis'''4 gis''4 } |
	g''2. ~ |
	g''2. |
	}
	}
	\endBar
}
