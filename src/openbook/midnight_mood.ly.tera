	des'''2 as''4 |
	as''2 ges''4 |
	des'''2 ges''4 |
	ges''2 f''4 |
	des'''2 ~ des'''8 ~ des'''8 |
	bes''4 c'''4 des'''4 |
	es'''4. des'''8 c'''8 bes''8 |
	bes''2 as''4 |
	des'''2 f''4 |
	f''2 ges''4 |
