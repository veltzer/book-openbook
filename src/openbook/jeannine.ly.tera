{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	\repeat volta 2 {
		c1:m | c:m6 | c:m7 | c:m6 | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1:m | c:m | c:m7 | c:m7 | \myEndLine
		c:m7 | c:m7 | c:m7 | c:m7 | \myEndLine
		bes:m9 | ees:7.9- | aes:maj7 | des:9 | \myEndLine
		d:m11 | g:7.9- | g:7.9- |
	} \alternative {
		{
			g1:7.9- | \myEndLineVoltaNotLast
		}
		{
			g1:7.9- | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	g2:m9 c:7 | f1 | b2:m7 e:7 | a1:maj7 | \myEndLine
	a:6 | a:m7 | d:7 | g:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
