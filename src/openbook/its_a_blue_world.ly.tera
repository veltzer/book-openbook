		\endPart

		\myMark "C"
		\startPart
		bes1:maj9 | bes2:m9 ees:9 | f:maj7 g:m7 | a:m7.5- d:7 | g1:9 | \myEndLine
		g2:m9 c:7.9- |
	} \alternative {
