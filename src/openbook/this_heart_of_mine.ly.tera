{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s1 |
	\repeat volta 2 {
	f1 |
	s2. e4 |
	g2:m7 c2:7 | \myEndLine
	s1 |
	a1:m7 |
	f2 a4:m7 c4:dim |
	g2.:m7 c4:7 | \myEndLine
	s2 g4:m des4:7 |
	f1 |
	} \alternative {
	{
	aes1:7 |
	des1 | \myEndLine
	g2.:m7 c4:7 |
	f1 |
	e2.:m7 a4:7 |
	d4:m g4:m d4:m g4:7 | \myEndLine
	c1:9 | \myEndLineVoltaNotLast
	}
	{
	a2:m7.5- d2:7.9- | \myEndLineVoltaLast
	}
	}
	c2:dim g2:m |
	bes1:m | \myEndLine
	f2 d2:m7 |
	g2:9 bes4:m6 c4:7 |
	f1 |
	s1 | \myEndLine
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key f \major

	r4 c'4 d'4 e'4 |
	\repeat volta 2 {
	e'1 ~ |
	e'4 c'4 d'4 e'4 |
	f'4 g'4 e'2 ~ |
	e'4 f'4 g'4 a'4 |
	a'1 ~ |
	a'4 f'4 g'4 a'4 |
	bes'2 c''4 g'4 ~ |
	g'4 a'4 bes'4 b'4 |
	c''4 c''4 c''4 c''4 |
	} \alternative {
	{
	c''4 c''4 c''4 c''4 |
	c''4 des''4 as'4 bes'4 |
	c''2. bes'4 |
	a'4 a'4 a'4 a'4 |
	a'4 a'4 ~ a'4 a'8 a'8 |
	a'4 bes'4 d'4 f'4 |
	g'4 c'4 d'4 e'4 |
	}
	{
	es''4 es''4 es''4. d''8 |
	}
	}
	c''4 c''4 c''4 bes'4 |
	a'4. g'8 f'4 e'4 |
	c''4 f'4 f'4 f'4 |
	a'4 g'4 f'4 e'4 |
	f'1 ~ |
	f'1 |
	\endBar
}
{% endif %}
