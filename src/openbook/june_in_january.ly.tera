{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	s2. b4:m |
	\repeat volta 2 {
	ees1 |
	s2 c2:7 |
	f1:m7 | \myEndLine
	s1 |
	bes1:7 |
	f2:m7 bes2:7 |
	g2:m7 c2:7 | \myEndLine
	f2.:m7 bes4:7 |
	ees1 |
	c1:7 |
	f1:m7 | \myEndLine
	s1 |
	bes1:7 |
	f2:m7 bes2:7 |
	s1 | \myEndLine
	d2:m7.5- g2:7 |
	c1:m7 |
	c1:dim7 |
	c1:m7 | \myEndLine
	d2:m7.5- g2:7 |
	c1:m7 |
	s1 |
	f1:7 | \myEndLine
	bes2.:7 b4:m |
	ees1 |
	s2 c2:7 |
	f1:m | \myEndLine
	s1 |
	bes1:7 |
	f2.:m7 bes4:7 |
	} \alternative {
	{
	ees2 ges2 | \myEndLine
	bes2.:7 b4:m | \myEndLineVoltaNotLast
	}
	{
	ees2 aes2 | \myEndLineVoltaLast
	}
	}
	ees1 |
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	r2 r4 b'4 |
	\repeat volta 2 {
	c''2. bes'4 |
	as'4 g'4 fis'4 g'4 |
	r4 bes'4 \times 2/3 { bes'4 a'4 as'4 } |
	c'2. r4 |
	r4 bes'4 \times 2/3 { bes'4 a'4 as'4 } |
	\times 2/3 { c'4 cis'4 d'4 } g'4. f'8 |
	\times 2/3 { f'4 d'4 es'4 } bes'2 ~ |
	bes'2. b'4 |
	c''2. bes'4 |
	as'4 g'4 fis'4 g'4 |
	r4 bes'4 \times 2/3 { bes'4 a'4 as'4 } |
	c'2. r4 |
	r4 bes'4 \times 2/3 { bes'4 a'4 as'4 } |
	\times 2/3 { c'4 cis'4 d'4 } g'4. f'8 |
	\times 2/3 { f'4 d'4 f'4 } es'2 ~ |
	es'2 r2 |
	r4 g'4 as'4. g'8 |
	fis'1 |
	r4 g'4 as'4. g'8 |
	f'1 |
	r4 g'4 as'4 g'4 |
	c''4. g'8 g'4 c''4 |
	d''4 d''2 f'8 g'8 |
	bes'2. b'4 |
	c''2. bes'4 |
	as'4 g'4 fis'4 g'4 |
	r4 bes'4 \times 2/3 { bes'4 a'4 as'4 } |
	c'2. r4 |
	r4 bes'4 \times 2/3 { bes'4 a'4 as'4 } |
	\times 2/3 { c'4 cis'4 d'4 } c''4 d'4 |
	} \alternative {
	{
	es'1 ~ |
	es'4 r4 r4 b'4 |
	}
	{
	es''1 ~ |
	}
	}
	es''1 |
	\endBar
}
{% endif %}
