		d1:7 | e2:m7 g:m6/bes | a:7 ees:7 | d:9 d:7.9- | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		g2 fis4:m7 b:7 | e1:7 | a4:m7 a:m7/g fis:m7.5- c:7 | b1:7 | \myEndLine
		c2:6 cis:dim7 | g4:7 f:7 e2:7 | a:7 d:7 |
	} \alternative {
		{
			g2 a4:7 aes:9 | \myEndLineVoltaNotLast
		}
		{
			g4 b:7 e2:7 | a:m7 d4:7 aes:7 | g1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
