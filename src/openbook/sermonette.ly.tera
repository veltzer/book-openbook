{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 8*5 s8*5 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1 | f2 f4:6 d:7.5-/fis | c1/g | c2:7 a4:m/c a:7/cis | \myEndLine
		d2:m f4./a bes8 | bes8 f4./a g4:m7 fis:dim7 | g2 g:7 | c1:7 | f1 | \myEndLine
		f2 f4:6 d:7.5-/fis | c1/g | c2:7 a4:m/c a:7/cis | d2:m bes | f2/a g:m7 | \myEndLine
		f2 g4:m7 c:7.9- | f1 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c2:7 c4.:7.5- c8:7 | c1:7 | f2 bes | \myEndLine
		f2. a4:7/cis | d2:m a4.:m bes8:6 | bes8:6 f4.:6/a g4:m7 fis:dim7 | g2 g:7 | c1:7 | \myEndLine
		f2 f4.:maj7 f8:7 | f1:7 | bes2:6 b:dim7 | f2:6/c bes4/d g:m7.5- | f2 d4.:m7 g8:9 | \myEndLine
		g2:7 c:7 | f4 f:7 bes:6/d b8:dim7 f8 |
	} \alternative {
		{
			f1 |
		}
		{
			f1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
