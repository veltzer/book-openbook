{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 2 cis4:m7 fis:7 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		b2:maj7 e4:m7 a:7 | d2:maj7 bes4:m7 ees:7 | aes2:maj7 g4:m7 c:7 | f2:maj7 cis4:m7 fis:7 | b2:maj7 e4:m7 a:7 | \myEndLine
		d2:maj7 cis4:m7 fis:7 | b1:maj7 | cis2:m7 fis:7 | b1:maj7 | cis2:m7 fis:7 | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Adagio" 4 = 66
	\time 4/4
	\key c \major

	\partial 2 dis4 cis |

	% part "A"
	\repeat volta 2 {
		fis4 fis8 fis fis4 fis | fis2 aes4 bes | c4 c8 c c4 c | a2 dis,4 cis | fis4 fis8 fis fis4 fis |
		fis2 dis4. cis8 | dis2 \tuplet 3/2 { gis4 fis dis } | cis2 b4 cis | dis2 \tuplet 3/2 { ais'4 fis dis } | cis2 dis4 cis |
	}
}
{% endif %}
