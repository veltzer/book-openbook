{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	\repeat volta 2 {
	g'8 a'8 c''8 a'8 e''4 g'4 |
	g'1 |
	g'8 a'8 c''8 a'8 e''4 g'4 |
	g'1 |
	\textMark \markup { \musicglyph "scripts.segno" } f''8 e''8 e''8 d''8 d''4. a'8 |
	} \alternative {
	{
	f''4 e''8 f''8 e''4 d''4 |
	f''8 e''8 e''8 e''8 d''4. g'8 |
	f''4 g''4 e''4. d''8 |
	}
	{
	f''4 e''4 e''4 d''8 a'8 |
	}
	}
	\repeat volta 2 {
	f''8 g''8 f''8 e''8 d''4. g'8 |
	f''8 e''8 d''4 f''8 g''8 e''4 |
	d''4 c''4 r8 r8 g'8 e''8 |
	d''8 c''8 e''4 d''8 c''8 e''4 |
	d''4 g'2 g'8 g'8 |
	f''8 e''8 f''8 e''8 d''4 e''4 ^ "To Coda" |
	d''4 c''4 ^ "Chorus" r4 g'8 e''8 |
	d''8 c''8 e''4 d''8 c''8 e''4 |
	d''8 b'8 g'4 r4 g'8 g'8 |
	f''8 e''8 f''8 e''8 d''4 e''4 |
	} \alternative {
	{
	d''4 c''2. |
	r4 r4 r4 g'4 |
	}
	{
	d''4 c''2. |
	}
	}
	R1 |
	f''8 e''8 e''8 d''8 d''4. a'8 |
	f''4 e''4 e''4 d''8 a'8 |
	f''8 g''8 f''8 e''8 d''4. g'8 |
	f''8 e''8 d''4 f''8 g''8 e''4 ^ "D.S. al Coda" |
	\repeat volta 2 {
	\textMark \markup { \musicglyph "scripts.coda" } d''4 c''4 g'4 e''4 |
	d''8 c''8 e''4 d''8 c''8 e''4 |
	d''4 g'4 g'4 g'4 |
	f''8 e''8 f''8 e''8 d''4 e''4 |
	d''4 c''4 g'4 e''4 |
	d''8 c''8 c''4 d''8 c''8 c''4 |
