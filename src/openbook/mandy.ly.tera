	s1 | \myEndLine
	d1:m |
	} \alternative {
	{
	f1 |
	bes1 |
	g1:7 | \myEndLineVoltaNotLast
	}
	{
	s1 | \myEndLineVoltaLast
	}
	}
	\repeat volta 2 {
	bes1 |
	g1:7 |
	c1 | \myEndLine
	a2:m f2 |
	g1 |
	s1 |
	c1 | \myEndLine
	a2:m f2 |
	g1 |
	s1 |
	} \alternative {
	{
	c1 | \myEndLine
	s1 | \myEndLineVoltaNotLast
	}
	{
	a1:m | \myEndLineVoltaLast
	}
	}
	s1 |
	d1:m | \myEndLine
	s1 |
	bes1 |
	g1 |
	\repeat volta 2 {
	c1 | \myEndLine
	a2:m f2 |
	g1 |
	s1 |
	c1 | \myEndLine
	a2:m f2 |
	d1 |
	s1 |
	}
