{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	s1 |
	ees2:maj7 ees2 |
	s1 |
	ees4.:6 ees1*5/8:maj7 | \myEndLine
	s1 |
	ees4. ees1*5/8:6 |
	e1:dim7 |
	bes1:7 | \myEndLine
	s1 |
	bes2:7 aes2/bes |
	s1 |
	bes1:7 | \myEndLine
	s1 |
	c4.:aug c1*5/8:7 |
	f1:7 |
	bes1:7 | \myEndLine
	s1 |
	ees2:maj7 ees2 |
	s1 |
	ees2:6 ees2:maj7 | \myEndLine
	s1 |
	e2:dim7 c2:7/e |
	c1:7 |
	f2:m c2:7 | \myEndLine
	f1:m |
	aes4.:6 aes1*5/8:maj7 |
	s2. a4:dim7 |
	ees2/bes bes2:m6/des | \myEndLine
	c1:7 |
	f1:7 |
	bes1:7 |
	} \alternative {
	{
	ees4 ees2:6 e4:dim7 | \myEndLine
	bes1:7 | \myEndLineVoltaNotLast
	}
	{
	ees1 |
	s1 | \myEndLineVoltaLast
	}
	}
	\endBar
	\endPart

	\endSong
	\endChords
}
