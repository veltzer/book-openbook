{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key es \major

	r2 r4. bes8 |
	\repeat volta 2 {
	g'4 ~ \once \omit TupletBracket \times 2/3 { g'8 f'8 es'8 } c'4 ~ \once \omit TupletBracket \times 2/3 { c'8 es'8 f'8 } |
	g'4 ~ \once \omit TupletBracket \times 2/3 { g'8 f'8 es'8 } c'4 ~ \once \omit TupletBracket \times 2/3 { c'8 es'8 f'8 } |
	g'8 bes'8 c''8 es''8 d''4. bes'8 |
	as'2 ~ as'4. bes'8 |
	d''4. es''8 d''4. des''8 |
	c''4. d''8 c''2 |
	r4 c''8 bes'8 as'4. bes'8 |
	g'2 ~ g'4. bes8 |
	g'4 ~ \once \omit TupletBracket \times 2/3 { g'8 f'8 es'8 } c'4 ~ \once \omit TupletBracket \times 2/3 { c'8 es'8 f'8 } |
	g'8 bes'8 \once \omit TupletBracket \times 2/3 { g'8 f'8 c'8 ~ } c'4 ~ \once \omit TupletBracket \times 2/3 { c'8 es'8 f'8 } |
	g'8 bes'8 c''8 es''8 d''4. bes'8 |
	as'2 ~ as'4. bes'8 |
	d''4. es''8 d''4. des''8 |
	c''4. d''8 c''2 |
	r4 c''4 bes'4 a'4 |
	bes'2 ~ bes'4 ~ \once \omit TupletBracket \times 2/3 { bes'8 d'8 es'8 } |
	\times 2/3 { c''4 c''4 c''4 } es'4. es'8 |
	\times 2/3 { c''4 des''4 es''4 } es''4. c''8 |
	\times 2/3 { bes'4 bes'4 bes'4 } bes'4 as'8 g'8 |
	bes'2 ~ bes'4. c''8 |
	\times 2/3 { a'4 bes'4 a'4 } c'4. c'8 |
	\times 2/3 { a'4 bes'4 c''4 } c''4. b'8 |
	c''4 c''8 d''8 es''4. a'8 |
	bes'2 ~ bes'4. bes8 |
	g'4 ~ \once \omit TupletBracket \times 2/3 { g'8 f'8 es'8 } c'4 ~ \once \omit TupletBracket \times 2/3 { c'8 es'8 f'8 } |
	g'4 ~ \once \omit TupletBracket \times 2/3 { g'8 f'8 es'8 } c'4 ~ \once \omit TupletBracket \times 2/3 { c'8 es'8 f'8 } |
	g'8 bes'8 c''8 es''8 d''4. bes'8 |
	as'2 ~ as'4. bes'8 |
	d''4. es''8 d''4. des''8 |
	c''4. d''8 c''2 |
	} \alternative {
	{
	r4 c''8 bes'8 as'4. d'8 |
	es'2 ~ es'4 r8 bes8 |
	}
	{
	es'1 |
	}
	}
	\endBar
}
