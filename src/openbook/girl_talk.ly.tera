{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		ees2:maj7 a:7.9 | aes:maj7 f4:m7 bes:7.9- | g2:m7 c:7.9- | f4:m7 g:m7 aes:6 bes:7.9 | \myEndLine
		ees2:maj7 aes:m7 | f:7.5-.9- f4:m7/bes bes:7.9- | g2:m7 c:7.9- | g4:m7 aes:6 bes:m6 c:7 | \myEndLine
		c2:m7/f f:7.9 | f:m7/bes aes:m7 | g:m7 c:m7.9 |
	} \alternative {
		{
			f2:m7 bes:7.9 | \myEndLineVoltaNotLast
		}
		{
			s4 f2:m7 bes4:7.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "End"
	\startPart
	ees2:maj7 ges:maj7 | f:m7 bes:7.9- | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Andante" 4 = 80
	\time 4/4
	\key ees \major

	% part "A"
	\repeat volta 2 {
		r8 g' g g g g g g | g g c, c ees ees f4 | r8 g g g g g g g | aes aes g g ees ees c4 |
		r8 ges' ges ges ges ges ges ges | ges ges ces, ces ees ees f4 | r8 g g g g g g g | bes bes aes aes g g c,4 |
		\repeat unfold 3 { r8 g' \tuplet 3/2 { g8 c, ees } } r8 ges f ees | bes'2 g4 r |
	} \alternative {
		{
			ees2 c4 r |
		}
		{
			r4 ees2 c4 |
		}
	}

	% part "End"
	ees1~ | ees2 r |
}
{% endif %}
