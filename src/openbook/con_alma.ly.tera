{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		e2:maj7 gis:7/dis | cis2:m7 b:7 | bes1:7 | ees2:maj7 ees4:m7 aes:7 | \myEndLine
		des2:maj7 f:7/c | bes2:m7 aes:7 | g1:7 | c1:maj7 | \myEndLine
	}
	\endPart

	\myMark "B"
	\startPart
	c1:m7.5- | f1:7.9- | fis1:m7 | b1:7 | \myEndLine
	e1*2:maj7 | f1:m7 | bes1:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	% part "A"
	\repeat volta 2 {
		gis'2 gis | gis gis | gis4. ais16 b ais4 gis | g!2 ges4 aes |
		f2 f | f f | f4. g16 aes g4 f | e1^\markup { \italic { Fine } } |
	}

	% part "B"
	ges8. f16 ees des ees8~ ees2~ | ees2 \tuplet 3/2 { f4 ges aes } | a8. aes16 ges fes ges8~ ges2~ | ges2 aes4 a |
	b1~ | b1 | bes1~ | bes1^\markup { \italic { D.C. al Fine } } |
}
{% endif %}
{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
		e2:maj7 gis:7/dis | cis:m7 b:7 | bes1:7 | ees2:maj7 ees4:m7 aes:7 | \myEndLine
		des2:maj7 f:7/c | bes:m7 aes:7 | g1:7 |
	} \alternative {
		{
			c2:maj7 fis4:m7 b:7 | \myEndLineVoltaNotLast
		}
		{
			c1:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	c1:m7.5- | f:7.9- | fis:m7 | b:7 | \myEndLine
	e1*2:maj7 | f1:m7 | bes:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceLaurent" %}{
	\tempo "Moderato" 4 = 100
	\time 4/4
	\key bes \major

	% part "A"
	\repeat volta 2 {
		gis'2 gis | gis gis | gis4 bes8 b bes4 gis | g!2 ges4 aes |
		f2 f | f f | f4 g8 aes g4 f8 g |
	} \alternative {
		{
			e2 r |
		}
		{
			e2 \tuplet 3/2 { r4 ees f } |
		}
	}

	% part "B"
	\tuplet 3/2 { ges4 f ees8 d } ees2~ | ees ees8 f ges aes |
	\tuplet 3/2 { a!4 gis fis8 f } fis2~ | fis~ fis8 fis gis a |
	b1~ | b2 \tuplet 3/2 { e,4 gis b8 cis } |
	bes1~ | bes |
}
{% endif %}
