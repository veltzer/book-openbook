{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 2 s2 |

	\repeat volta 2 {

		\myMark "A"
		\startPart
		c1*2 | b2:7sus4 b:7 | e:7 a:7 | \myEndLine
		d1:m | d2:m d:m7 | g1*2:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		c1 | a:7.9- | d:m7 | g2:7 gis:dim7 | \myEndLine
		a2:m a:m7 | d1:7 | d:m7 | g2:7 g:7.9- | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		c1*2 | b2:7sus4 b:7 | e:7 a:7 | \myEndLine
		d1*2:m | e2:7 f:7.11+ | e1:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		a1:m | c2.:7/g c4:7.5+ | f1 | f:m6 | \myEndLine
		c2 a:7.9- | d:m7 g:7 |
	} \alternative {
		{
			c2 ees:dim7 | d:m7 g:7.9- | \myEndLineVoltaNotLast
		}
		{
			c2:6 f:9 | c1:6.9 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
