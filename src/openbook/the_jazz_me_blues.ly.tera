{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	\repeat volta 2 {
		ees1 | bes2:7 ees | ees1 | f2:7 bes:7 | \myEndLine
		ees1 | bes2:7 ees | ees4:aug aes ees2 |
	} \alternative {
		{
			f4:7 bes:7 ees bes:7 | \myEndLineVoltaNotLast
		}
		{
			f4:7 bes:7 ees2 | \myEndLineVoltaLast
		}
	}
	bes1:7 | bes:dim7 | bes2:7 f:7 | bes g:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		c1 | c | f:7 | f:7 | \myEndLine
	} \alternative {
		{
			bes1:7 | bes:7 | ees | f2:7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees1 | g | f:7 | c:7 | \myEndLine
			f:7 | bes:9 | ees | ees | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
