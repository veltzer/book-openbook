{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	bes2:7.5- b:m7 | b1:m7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	ees1:m7 | e:maj7.11+ | ees:m7 | e:maj7.11+ | \myEndLine
	\endPart

	\myMark "B"
	\startPart
	ees1:m7 | e:maj7.11+ | ees:m7 | e:maj7.11+ | \myEndLine
	ees1:m7 | e:maj7.11+ | ees:m7 | e:maj7.11+ | \myEndLine
	\endPart

	\myMark "C"
	\startPart
	\repeat volta 2 {
		aes1:7.11+ | fis2:m7 b:7 | ees1:m7 | a:7.11+ | \myEndLine
		aes1:7.11+ | fis2:m7 b:7 | ees1:m7 | e:maj7.11+ | \myEndLine
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key c \major

	% part "Intro"
	f8^\markup { Rubato } bes ees ces bes4\glissando cis'4\fermata | b,8 b' bes bes, aes'4 r4 |

	% part "A"
	ges4 r8 ees8~ ees2~ | ees1 | R1 | r2 r4 r8 ees8 |

	% part "B"
	ees'4. des,8 des'4. bes,8 | bes'4. aes,8 aes'2 | ges4 r8 ees8~ ees2~ | ees2.. ees8 |
	ees'4. des,8 des'4. bes,8 | bes'4. aes,8 aes'2 | ges4 r8 ees8~ ees2~ | ees2. r8 f16 ges |

	% part "C"
	\repeat volta 2 {
		d2.. ees16 ges | a8 ges a4 g ees | des4 r8 ees8~ ees2~ | ees2.. f16 ges |
		d2.. ees16 ges | a8 ges a4 g ees | des4 r8 ees8~ ees2~ | ees1 |
	}
}
{% endif %}
