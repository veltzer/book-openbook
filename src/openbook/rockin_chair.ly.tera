{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		ees2 ees:maj7 | bes:m7 ees:9 | aes1:maj7 | des:7 | \myEndLine
		g:m7 | c:7 | f2:7 f:7.5-/ces | f:m7 bes:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		ees1:6 | c:m7 | a2:m7.5- d:7 | g1:m | \myEndLine
		c:m7.5- | f:7 | ees2/bes bes:7 | ees ees:7 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		aes1*2:9 | ees1*2:maj7 | \myEndLine
		a2:m7.5- d:7 | g1:m7 | c2:m7 f:9 | f:m7 bes:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		ees2 ees:maj7 | bes:m7 ees:9 | aes1:maj7 | des:9 | \myEndLine
		g2:m7 c:7 | f:m7 e:maj7 |
	} \alternative {
		{
			ees1 | f2:m7 bes:7 | \myEndLineVoltaNotLast
		}
		{
			ees2 aes:9 | ees1:6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
