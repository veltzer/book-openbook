	bes'4 as'2. |
	r4 d'8 d'8 ~ d'8 es'8 f'4 |
	as'4 ges'2. |
	r4 g'8 g'8 ~ g'8 as'8 bes'4 |
	des''4 ces''2. |
	r8 as'8 as'8 as'8 as'8 ges'4 bes'8 ~ |
	bes'1 |
	r4 es'8 es'8 ~ es'8 f'8 ges'4 |
	bes'4 as'2. |
