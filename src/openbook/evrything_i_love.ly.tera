	es''4 des''2 des''4 |
	r8 d''4 d''8 ~ d''4 c''8 bes'8 |
	des''4 des''8 des''8 ~ des''4 c''8 bes'8 |
	c''4 c''4 c''8 bes'8 g'4 |
	bes'1 |
	r4 ^ "Refrain" g'4 g'2 |
	r4 g'4 g'2 |
	g'2. c'4 |
	c'1 |
	r4 c''4 c''2 |
	r4 c''4 c''2 |
	c''2. g'4 |
	g'1 |
	r4 es''4 es''2 |
	r4 es''4 es''2 |
