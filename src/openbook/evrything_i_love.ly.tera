	des''2. bes'4 |
	bes'2. r4 |
	r4 g'4 g'2 |
	r4 g'4 g'2 |
	g'2. c'4 |
	c'1 |
	r4 c''4 c''2 |
	r4 a'8 bes'8 c''4 d''4 ~ |
	d''4 d''2 g'4 |
	g'1 |
	r4 es''4 es''4. d''8 |
	des''8 es''4 c''8 ~ c''4. b'8 |
	\times 2/3 { bes'4 c''4 es''4 } \times 2/3 { fis'4 g'4 c''4 } |
	f'1 |
	r4 g'4 g'2 |
	} \alternative {
	{
	r8 as'4 f'8 es'4 d'4 |
	es'1 ~ |
	es'4 r4 r2 |
	}
	{
