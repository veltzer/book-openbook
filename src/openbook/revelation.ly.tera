{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f1 | bes2 c:7 | f f:7 | c:m7 f:7 | \myEndLine
		bes1 | bes:m7 | a2:m7 a:m6 | a:m7.5- d:7.5+ | g1:m7 | \myEndLine
		g2:m7 c:7 | c1:7 | c1:7 | \myEndLine
	}
	\endPart

	\myMark "Coda"
	\startPart
	bes2 b:m7.5- | bes:m7 ees:7 | a1:m7 | d2:7 d:7.5+.9+ | \myEndLine
	g2:m7 c:7 | g:m7 c4:7 e8:7 f8:maj9 | f1:maj9 | f1:maj9 | \myEndLine
	\endPart

	\endSong
	\endChords
}
