			g4 f2. | r4 d' d c |
		}
	}

	% part "B"
	c2 bes | r4 d8 d~ d des c4 | bes1~ | bes4 bes bes a |
	a2 g | r4 bes bes a | a4. d,8~ d e f4 | g2 gis |

	% part "A"
	a4 c,8 d~ d2 | bes'4. d,8~ d dis e4 | c' e,8 f~ f2 | d'4. f,8~ f g gis4 |
