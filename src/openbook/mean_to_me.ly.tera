{% if part == "ChordsLaurent" %}\chordmode {
	\startChords
	\startSong

	\partial 4 s4 |

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f2:maj7 d:m7 | g:m7 c:7 | f:maj7 d:m7 | bes:maj7 ees:7 | \myEndLine
		a:m7 d:7.9+ | g:m7 c:7 |
	} \alternative {
		{
			a2:m7 d:m7 | g:7 c:7 | \myEndLineVoltaNotLast
		}
		{
			f1:maj7 | g2:7 c:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	bes1:maj7 | c2:m7 f:7 | bes1:maj7 | a2:m7.5- d:7.9+ | \myEndLine
	g1:m7 | a2:7.9- d:7 | g1:7 | c:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f2:maj7 d:m7 | g:m7 c:7 | a:m7 d:m7 | bes:maj7 ees:7 | \myEndLine
	f:maj7 d:7.9+ | g:m7 c:7 | f1:maj7 | g2:m7 c:7 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
