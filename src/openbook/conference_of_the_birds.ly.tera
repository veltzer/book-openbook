{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\myMark "Intro"
	\startPart
	d4*5:m | \myEndLine
	\repeat volta 4 {
		d2.:m f2 | bes2. ees2 |
	}
	\myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		d2.:m f2 | bes2. ees2 | d2.:m f2 | \myEndLine
		bes2. ees2 | d2.:m f2 | bes2. ees2 | d4.:m c g2/b | \myEndLine
	} \alternative {
		{
			d4*5:m | s2 | \myEndLineVoltaNotLast
		}
		{
			d4*5:m | s2 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Moderato" 4 = 120
	\time 5/4
	\key c \major

	% part "Intro"
	\clef bass
	R4*5^\markup { Open bass solo (no time) } |
	\repeat volta 4 {
		<d, a'>4.^\markup { 4x } <d a'>4. <c f>4 <c f>-. | <f bes>4. <f bes>4. <bes, ees>4 <bes ees> |
	}

	% part "A"
	\clef treble
	\repeat volta 2 {
		\once \omit Staff.TimeSignature \time 5/4 d''4. a4. a8 bes a4 | d4. f8~ f4 ees8 d bes4 | d4. a4. a8 bes a4 |
		d4. f8~ f4 ees8 d bes4 | d4. a4. a8 bes a4 | d4. f8~ f4 ees8 d bes4 | f4. e'4. d2~ |
	} \alternative {
		{
			d1~ d4~ | \time 2/4 d4 r4 |
		}
		{
			\time 5/4 d1~ d4~ | \time 2/4 d4\fermata^\markup { \italic { Fine } } r4 |
		}
	}
}
{% endif %}
