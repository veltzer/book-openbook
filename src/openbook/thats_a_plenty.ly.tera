{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Swing" 4 = 144
	\time 2/2
	\key f \major

	\repeat volta 2 {
	d''4 cis''4 d''4 cis''4 |
	d''4 cis''8 c''8 ~ c''8 c''8 b'8 b'8 |
	bes'4 a'4 bes'4 a'4 |
	bes'4 a'8 g'8 ~ g'8 g'8 f'8 f'8 |
	e'8 bes'4 a'8 ~ a'4 r4 |
	r8 e'4 bes'8 a'4 r8 a'8 ~ |
	} \alternative {
	{
	a'8 d''4 a'8 \once \omit TupletBracket \times 2/3 { f'8 g'8 gis'8 } a'8. f'16 |
	d'8 f'8 d'8 e'8 ~ e'8 a'4 r8 |
	}
	{
	a'8 d''4 a'8 g'4 f'8 d'8 ~ |
	}
	}
	d'2 d''4 \once \omit TupletBracket \times 2/3 { dis'8 fis'8 a'8 } ^ "Fine" |
	bes'8 g'4 bes'8 ~ bes'4 r8 g'8 |
	bes'8 g'8 bes'8 g'8 ~ g'8 c''4 bes'8 |
	a'4 f'4 a'4 r8 f'8 |
	a'8 f'8 a'8 f'8 ~ f'8 d''4 c''8 |
	bes'4 g'8 bes'8 ~ bes'4 r8 g'8 |
	bes'8 g'8 bes'8 g'8 ~ g'8 c''4 bes'8 |
	r8 c''4 d''8 f''8 d''4 f''8 |
	des''8 bes'4 g'8 f'4 r4 |
	bes'8 g'4 bes'8 ~ bes'4 r8 g'8 |
	bes'8 g'8 bes'8 g'8 ~ g'8 c''4 bes'8 |
	a'4 f'4 a'4 r8 f'8 |
	a'8 f'8 a'8 f'8 ~ f'8 d''4 c''8 |
	b'4 gis'8 f'8 d'8 f'8 gis'8 b'8 |
	c''8 b'8 bes'8 a'8 ~ a'8 e''4 d''8 |
	c''8 bes'8 c''8 bes'8 a'8 a'4 f'8 ~ |
	f'4. bes'4 a'4 r8 ^ "D.C. al Fine" |
	\endBar
}
