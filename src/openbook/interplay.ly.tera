{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key f \minor

	\repeat volta 2 {
	f'4. ^\markup{ \bold {Medium swing} } c''8 r8 as'4 -. f'8 |
	bes'8 c''8 ~ \times 2/3 { c''8 g'8 es'8 } f'4 r8 as'8 |
	g'8 f'8 bes'8 as'8 des''8 c''8 as'8 f'8 |
	des'8 f'8 \times 2/3 { g'8 es'8 f'8 } r4 f''4 ~ -> |
	f''4. c''8 bes'4 des''8 f''8 |
	c''8 bes'8 ~ \times 2/3 { bes'8 es''8 f''8 } bes'4 -. r8 des''8 |
	es''8 f''8 c''8 des''8 bes'8 es''8 \times 2/3 { c''8 as'8 f''8 ~ } |
	\times 2/3 { f''8 des''8 bes'8 } \times 2/3 { c''8 as'8 f'8 } r4 c''4 ~ -> |
	c''4 bes'4 ~ bes'8 g'8 c''4 ~ |
	c''8 des''8 ~ \times 2/3 { des''8 bes'8 g'8 } c''4 -. r4 |
	des''8 c''8 \times 2/3 { as'8 f'8 c'8 } \times 2/3 { des'8 f'8 as'8 } \times 2/3 { c''8 g'8 f'8 } |
	\times 2/3 { bes'8 as'8 f'8 } \times 2/3 { g'8 as'8 f'8 } r2 - "Fine" |
	}
