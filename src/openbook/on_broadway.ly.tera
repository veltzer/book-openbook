{% if part == "ChordsWikifonia" %}\chordmode {
	\startChords
	\startSong

	\myMark "A"
	\startPart
	\repeat volta 2 {
	s8 des4. b2/des |
	des4. b1*5/8/des |
	des4. b1*5/8/des |
	des2 b2/des | \myEndLine
	des2 b2/des |
	des4. b1*5/8/des |
	des1 |
	des1 | \myEndLine
	ges2 e2/ges |
	ges4. e1*5/8/ges |
	ges2 e2/ges |
	ges4. aes1*5/8 | \myEndLine
	des2 b2/des |
	} \alternative {
	{
	des4. b1*5/8/des |
	des2. b4/des |
	des4. b1*5/8/des | \myEndLineVoltaNotLast
	}
	{
	des4. b1*5/8/des | \myEndLineVoltaLast
	}
	}
	s4. des1*5/8 |
	s1 |
	s1 | \myEndLine
	\endBar
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceWikifonia" %}\absolute {
	\tempo "Moderato" 4 = 120
	\time 4/4
	\key des \major

	\repeat volta 2 {
	r8 as8 f'8 des'8 es'8 as'4. |
	f'4 des'8 c'4. es'4 |
	des'4. as8 ~ as2 ~ |
	as1 |
	r8 as8 f'8 des'8 es'8 as'4. |
	f'4 des'8 ces'4. des'8 as8 ~ |
	as1 ~ |
	as1 |
	r8 des'8 bes'8 ges'8 as'8 des''4. |
	bes'4 ges'8 as'8 ~ as'2 |
	r8 des'8 bes'8 ges'8 as'8 des''4. |
	bes'4 ges'8 as'8 ~ as'2 |
	r8 as8 f'8 des'8 es'8 as'4. |
	} \alternative {
	{
	f'4 des'8 ces'4. des'8 as8 ~ |
	as2. es'4 |
	des'4. as8 ~ as2 |
	}
	{
	f'4 des'8 ces'4. as4 |
	}
	}
	ces'4. des'2 r8 |
	r1 |
	r1 |
	\endBar
}
{% endif %}
