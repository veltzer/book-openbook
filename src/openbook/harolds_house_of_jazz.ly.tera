{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\partial 4. s4. |

	\myMark "Intro"
	\startPart
	bes2:6 bes:dim7 | c4.:m7/bes b:maj7/bes bes4:6 | s1 | s1 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		bes1*2:maj7 | f1:m7 | bes:7 | \myEndLine
		ees1*2:maj7 | ees1:m7 | aes:7 | \myEndLine
		bes1*2:maj7 | c1:7 | \myEndLine
	} \alternative {
		{
			s1 | c:m7 | g:7 | c:m7 | f2:7 f:7.5+ | \myEndLineVoltaNotLast
		}
		{
			c1:7 | c2:m7 f:7 | c:m7 f:7.5+ | bes1*2:maj7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	cis1:m7 | fis:7 | b1*2:maj7 | \myEndLine
	b1:m7 | e:7 | a1*2:maj7 | \myEndLine
	a1:m7 | d:7 | g1*2:maj7 | \myEndLine
	g1:m7 | c:7 | c:m7 | f:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	bes1*2:maj7 | f1:m7 | bes:7 | \myEndLine
	ees1*2:maj7 | ees1:m7 | aes:7 | \myEndLine
	bes1*2:maj7 | c1*2:7 | \myEndLine
	c1:m7 | f:7 | d:m7 | g:7 | \myEndLine
	c:m7 | f2.:7sus4 bes4:6 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
