{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		d1:m6 | d:m6 | bes:7.5- | bes:7.5- | \myEndLine
		a1:7 | a:7 | d:m6 | d:m6 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		d1:m6 | d:m6 | bes:7.5- | bes:7.5- | \myEndLine
		a1:7 | a:7 | d:m6 | d:m6 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		bes1:7 | f2:m7 bes:7 | bes1:7 | f:m7 | \myEndLine
		bes1:7 | f2:m7 bes:7 | a1:7 | a:7 | \myEndLine
		\endPart

		\myMark "A"
		\startPart
		d1:m6 | d:m6 | bes:7.5- | bes:7.5- | \myEndLine
	} \alternative {
		{
			a1:7 | a:7 | d:m6 | d:m6 | \myEndLineVoltaNotLast
		}
		{
			a1:7 | a:7 | d:m6 | d:m6 | \myEndLineVoltaLast
		}
	}
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Moderato" 4 = 150
	\time 4/4
	\key f \major

	\repeat volta 2 {
		% part "A"
		r8 a'4 gis8 a4. a8~ | a8 gis a4 a,8 d f a | gis2.~ gis8 e~ | e4 r r2 |
		r8 g4 fis8 g4. g8~ | g8 fis g4 a,8 cis e g | f2.~ f8 d~ | d4 r r2 |

		% part "A"
		r8 a'4 gis8 a4. a8~ | a8 gis a4 a,8 d f a | gis2.~ gis8 e~ | e4 r r2 |
		r8 g4 fis8 g4. g8~ | g8 fis g4 a,8 cis e g | f2.~ f8 d~ | d4 r r2 |

		% part "B"
		bes4 bes g'8 f d c~ | c4. d8~ d4 r | bes4 bes g'8 f d c~ | c1 |
		bes4 bes g'8 f d c~ | c4. d8~ d4 r | r8 a'4 a8 a2~ | a2. r4 |

		% part "A"
		r8 a4 gis8 a4. a8~ | a8 gis a4 a,8 d f a | gis2.~ gis8 e~ | e4 r r2 |
	} \alternative {
		{
			r8 g4 fis8 g4. g8~ | g8 fis g4 a,8 cis e g | f2.~ f8 d~ | d4 r r2 |
		}
		{
			r8 g4 fis8 g4. g8~ | g8 fis g4 a8 a a a | d1~ | d2 r2 |
		}
	}
}
{% endif %}
{% if part == "LyricsFake" %}\lyricmode {

	% part "A"
	In the park, in __ the dark, un -- der -- neath the moon. __ _
	Heard a boy and __ a girl hum -- min' Ber -- nie's Tune. __ _

	% part "A"
	Went to sleep count -- in' sheep, by a blue la -- goon. __ _
	Heard a frog, on __ a log, croak -- in' Ber -- nie's Tune. __ _

	% part "B"
	It's so ea -- sy to whist -- le, __ it's so ea -- sy to sing. __
	E -- ven hum -- ming -- birds hum __ it, __ it's the thing. __

	% part "A"
	Of -- fice clerks, so -- da jerks picked it up so soon. __ _

	% part "Volta"
	Mil -- lion -- aires, e -- ven squares, whis -- tle Ber -- nie's Tune. __ _
	Take a tip, man __ get hip, make it Ber -- nie's Tune. __
}
{% endif %}
{% if part == "LyricsmoreFake" %}\lyricmode {

	% part "A"
	Hark the lark, in __ the park, cra -- zy as a loon. __ _
	In a tree skill -- ful -- ly sing -- in' Ber -- nie's Tune. __ _

	% part "A"
	Lit -- tle kids go __ to school sing -- in' Ber -- nie's Tune. __ _
	Gurg -- lin' brooks, bub -- lin' pools, bab -- ble Ber -- nie's Tune. __ _

	% part "B"
	You don't have to read mu -- sic, __ you don't have to be smart. __
	Ber -- nie said you can sing __ it, __ from the heart. __

	% part "A"
	So if you hap -- pen to get the urge to croon. __ _
}
{% endif %}
