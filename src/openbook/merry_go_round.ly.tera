{% if part == "ChordsFake" %}\chordmode {
	\startChords
	\startSong

	\repeat volta 2 {

		\myMark "A"
		\startPart
		bes1 | bes2 f:7 | bes2 g:7 | c2:m7 f:7 | \myEndLine
		f2:m7 bes:7 | ees1 | bes1 | f1:7 | \myEndLine
		\endPart

		\myMark "B"
		\startPart
		bes1 | c2:m7 f:7 | d2:m7 des:m7 | c2:m7 f:7 | \myEndLine
		f2:m7 bes:7 | ees2 e:dim7 | bes1*2 | \myEndLine
		\endPart

		\myMark "C"
		\startPart
		f1:m7 | bes1:7 | ees1*2 | \myEndLine
		c1*2:7 | c1:m7 | f1:7 | \myEndLine
		\endPart
	}

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceFake" %}{
	\tempo "Allegro" 4 = 220
	\time 4/4
	\key bes \major

	\repeat volta 2 {
		% part "A"
		r4 f8 g a bes c a | bes8 f d bes fis' g ees c | f8 ees d c b aes' g f | ees8 g, bes d c bes a16 c ees ges |
		f8 ees d c bes a aes bes | g8 bes c d f ees d c | a8 bes c a bes d4. | r1 |

		% part "B"
		r2 f8 g bes des | d8 bes c2~ c8 cis, | \tuplet 3/2 { d8 f a } c8 bes b! aes e! des | bes'8 a g ges f ees d c |
		bes8 a aes bes bes' aes g f | ees8 a, bes c des bes g a | c8 bes a bes d f r4 | r1 |

		% part "C"
		r4 f8 aes c ees d bes | c8 aes f g bes g \tuplet 3/2 { aes bes aes } | g8 f ees b! bes aes \tuplet 3/2 { g bes d } | f8 d \tuplet 3/2 { ees g bes } d8 c4. |
		r2 r8 fis,8 \tuplet 3/2 { g bes d } | f8 d ees e! c cis d c! | bes8 a g f ees g, bes d | c8 bes a c ees ges ees c |
	}
}
{% endif %}
