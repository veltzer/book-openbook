{% if part == "ChordsReal" %}\chordmode {
	\startChords
	\startSong

	\partial 8 s8 |

	\myMark "Intro"
	\startPart
	\repeat volta 3 {
		f1 | s1 | \myEndLine
	}
	\endPart

	\myMark "A"
	\startPart
	\repeat volta 2 {
		f2:maj7 g:m7 | a:m7 g:m7 | ees:7 d:7 | g:m7.5- c:7 | \myEndLine
		f1:7 | bes2:7 b:dim7 | f:7/c d:7 |
	} \alternative {
		{
			g2:m7 c:7 | \myEndLineVoltaNotLast
		}
		{
			g2:m7 c:7 | \myEndLineVoltaLast
		}
	}
	\endPart

	\myMark "B"
	\startPart
	f1*2:7 | bes1*2:7 | \myEndLine
	g1*2:7 | c1*2:7 | \myEndLine
	\endPart

	\myMark "A"
	\startPart
	f2:maj7 g:m7 | a:m7 g:m7 | ees:7 d:7 | g:m7.5- c:7 | \myEndLine
	f1:7 | bes2:7 b:dim7 | f:7/c d:7 | g:m7 c4. f8 | \myEndLine
	\endPart

	\endSong
	\endChords
}
{% endif %}
{% if part == "VoiceReal" %}{
	\tempo "Presto" 4 = 260
	\time 4/4
	\key f \major

	\partial 8 c8 |

	% part "Intro"
	\repeat volta 3 {
		f8 a g f bes4 g8 f | \tuplet 3/2 { a8 bes bes } c bes a f d c |
	}

	% part "A"
	\repeat volta 2 {
		f8 a g f bes4 g8 f | \tuplet 3/2 { a8 bes bes } c bes a f d c | ees g f ees d c a a | bes des c bes g4 c |
		r4 bes'8 f gis a r8 \grace c8 f~ | f4 ees8 bes b! d r8 f, | \tuplet 3/2 { bes8 c bes } g e f f' d c |
	} \alternative {
		{ bes8 g' ges f e4 r8 c, | }
		{ bes'8 g' ges f e4 r4 | }
	}

	% part "B"
	\improvisationOn
	b4 b b b | b b b b | b b b b | b b b b |
	b4 b b b | b b b b | b b b b | b b b r8
	\improvisationOff
	c,8 |

	% part "A"
	f8 a g f bes4 g8 f | \tuplet 3/2 { a8 bes bes } c bes a f d c | ees g f ees d c a a | bes des c bes g4 c |
	r4 bes'8 f gis a r8 \grace c8 f~ | f4 ees8 bes b! d r8 f, | \tuplet 3/2 { bes8 c bes } g e f f' d c | bes8 g' ges f e4 r8 f^\markup { \italic { Fine } } |
}
{% endif %}
