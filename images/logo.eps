378 192 m 378 294.727 294.727 378 192 378 c 89.273 378 6 294.727 6 192 
c 6 89.273 89.273 6 192 6 c 294.727 6 378 89.273 378 192 c h
378 192 m f
q
0 0 384 384 re W n
% Fallback Image: x=0 y=0 w=384 h=384 res=300ppi size=7680000
[ 384 0 0 -384 0 384 ] concat
/cairo_ascii85_file currentfile /ASCII85Decode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Width 1600
  /Height 1600
  /Interpolate false
  /BitsPerComponent 8
  /Decode [ 0 1 0 1 0 1 ]
  /DataSource cairo_ascii85_file /FlateDecode filter
  /ImageMatrix [ 1600 0 0 -1600 0 1600 ]
